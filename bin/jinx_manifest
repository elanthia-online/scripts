#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the jinx repository index for the scripts folder:
#
#   bin/jinx_manifest [input_dir] [output_dir]    (defaults: scripts dist)
#
# Writes <output>/manifest.json and <output>/headers/. Assets are not copied;
# the Pages workflow serves the input folder at /assets via a symlink.
require_relative "../lib/jinx_manifest"

input  = ARGV[0] || "scripts"
output = ARGV[1] || "dist"

abort "#{input} is not a directory" unless File.directory?(input)

manifest = JinxManifest.build(input: input, output: output)
count = manifest["available"].size
abort "no assets found in #{input}" if count.zero?

puts "built #{count} assets into #{output}"
