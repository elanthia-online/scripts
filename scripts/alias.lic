=begin

   Implements aliases for Lich.

   Start the script and type ;alias help

   author: elanthia-online
   contributors: Tillmen
   game: Gemstone
   tags: core, alias
   required: Lich > 5.0.1
   version: 1.1.0

  Help Contribute: https://github.com/elanthia-online/scripts

   changelog:
      1.1.0 (2026-11-09)
         ;alias setup is a Lich WebUI window instead of GTK: this character's and
         global aliases on two tabs; edit, delete and add, then Save & Close
         Each tab is one table with in-place editing and type-ahead by trigger,
         so any number of aliases shows; typing no longer redraws the window
      1.0.5 (2026-06-30)
         Updated for 5.19.0 Lich to include new hook registry semantics
      1.0.4 (2025-01-31)
        Bugfix in .include? syntax for stopping upstreamhook
      1.0.3 (2024-05-08)
        Update for sqlite3 gem version 2.0+ support
      1.0.2 (2023-03-04)
        Rubucop code cleanup
        Replace script.vars with Script.current.vars
      1.0.1 (2022-11-24)
        Removed references to $SAFE
      1.0 (2021-12-09)
         Baselined GTK3 variant for consistency
      0.9 (2020-03-19):
         fixes for GTK3
      0.8 (2018-08-29):
         fixes for compatibility with Ruby >= 2.3
      0.7 (2015-08-31):
         make triggers case-insensitive
      0.6 (2015-03-10):
         don't allow the script to run as trusted
         update trigger regex after deleting a trigger
      0.5 (2015-02-01):
         add gui
      0.4 (2014-11-13):
         remove leading spaces before sending the alias target
      0.3 (2014-11-07):
         sort ;alias list
      0.2 (2014-10-05):
         don't crash from recursive aliases

=end

# ;alias setup: a native Lich WebUI settings form with two tabs, this
# character's aliases and global ones, each one table. Targets are edited in
# place, aliases deleted and new ones added. Nothing is written until Save &
# Close; Cancel or closing the window discards the changes. The form's
# lifecycle is Lich's SettingsForm. The window belongs to its own run of
# this script, started by ;alias setup: the alias service (the upstream
# hook) keeps running and is told to reload after a save.
class AliasSetup
  # Lich keeps this class between runs in a session; start each run clean.
  constants(false).each { |name| remove_const(name) }

  PAGE_ID = 'alias-setup'

  def self.available?
    defined?(Lich::WebUI::SettingsForm) && Lich::WebUI.respond_to?(:presentation_enabled?) &&
      Lich::WebUI.presentation_enabled?
  end

  # key: the table row identity (triggers may hold any character). added: a
  # new alias, written on Save.
  Row = Struct.new(:key, :trigger, :original, :target, :deleted, :added) do
    def changed? = added || deleted || target != original

    def note
      if added then 'new, added when you save'
      elsif deleted then 'deleted when you save'
      elsif target != original then 'changed'
      else ''
      end
    end
  end

  # One tab: a table in the alias database, its rows, and the selected row.
  class List
    attr_reader :table, :label, :rows
    attr_accessor :new_rev, :selected, :next_added

    def initialize(db, table, label, n)
      @table = table
      @label = label
      @rows = []
      db.execute("SELECT trigger,target FROM #{table};") { |r| @rows << [r[0].to_s, r[1].to_s] }
      @rows = @rows.sort_by { |t, _| t.downcase }.each_with_index.map { |(t, v), i| Row.new("t#{n}-#{i}", t, v, v, false, false) }
      @new_rev = 0
      @next_added = 0
      @selected = nil
    end

    def row(key) = @rows.find { |r| r.key == key }
    def changes = @rows.count(&:changed?)
  end

  def initialize(db, character)
    @db = db
    @lists = [List.new(db, character, "#{Char.name}'s Aliases", 0), List.new(db, 'global', 'Global Aliases', 1)]
    @status = ''
  end

  attr_reader :lists, :status

  def changes = @lists.sum(&:changes)

  # Returns whether the aliases were saved.
  def run
    setup = self
    @form = Lich::WebUI::SettingsForm.new(
      owner: Script.current, id: PAGE_ID, title: 'Lich - Aliases', values: {}, fields: [],
      props: { size: [800, 580], viewport: true },
      layout: ->(ui, _field, save) { setup.render(ui, save) }
    )
    if @form.show.wait
      apply
      true
    else
      pending = changes
      respond "\n--- alias window closed#{pending.positive? ? " WITHOUT saving #{pending} change(s)" : ''}\n\n"
      false
    end
  ensure
    # This run may go on as the alias service, so release the window now
    # rather than at script death.
    begin
      Lich::WebUI.terminate_owner(Script.current)
    rescue StandardError
      nil
    end
  end

  def refresh
    Lich::WebUI.refresh(@form.page) if @form&.page
  end

  def edit(list, key, text)
    row = list.row(key)
    return if row.nil? || row.deleted

    row.target = text.to_s
    refresh
  end

  # Delete or undo the selected alias; a new one is simply removed.
  def toggle_selected(list)
    row = list.row(list.selected)
    if row.nil?
      @status = 'Select an alias first.'
    elsif row.added
      list.rows.delete(row)
      list.selected = nil
      @status = ''
    else
      row.deleted = !row.deleted
      @status = ''
    end
    refresh
  end

  # The trigger is case-insensitive, as the service matches it.
  def add(list, trigger, target)
    trigger = trigger.to_s.strip
    if trigger.empty?
      @status = 'Type a trigger for the new alias.'
    elsif (row = list.rows.find { |r| r.trigger.casecmp?(trigger) })
      @status = row.added ? "#{trigger} is already waiting to be added." : "#{trigger} is already an alias here; edit it in the list."
    elsif target.to_s.strip.empty?
      @status = "Type what #{trigger} should send."
    else
      list.rows << Row.new("a#{@lists.index(list)}-#{list.next_added += 1}", trigger, nil, target.to_s, false, true)
      list.new_rev += 1
      @status = ''
    end
    refresh
  end

  # The old window's save, table by table.
  def apply
    count = changes
    @lists.each do |list|
      list.rows.each do |row|
        if row.added
          if @db.get_first_value("SELECT target FROM #{list.table} WHERE trigger=? COLLATE NOCASE;", row.trigger.encode('UTF-8'))
            respond "[alias: warning: new alias #{row.trigger} already exists; ignoring]"
          else
            @db.execute("INSERT INTO #{list.table} (trigger,target) VALUES(?,?);", [row.trigger.encode('UTF-8'), row.target.encode('UTF-8')])
          end
        elsif row.deleted
          @db.execute("DELETE FROM #{list.table} WHERE trigger=?", [row.trigger.encode('UTF-8')])
        elsif row.changed?
          @db.execute("INSERT OR REPLACE INTO #{list.table} (trigger,target) VALUES(?,?);",
                      [row.trigger.encode('UTF-8'), row.target.encode('UTF-8')])
        end
      end
    end
    respond "\n--- aliases saved#{count.positive? ? " (#{count} change(s))" : ''}\n\n"
  end

  def cancel
    @form.close
  end

  def table_rows(list)
    list.rows.map do |row|
      cells = { 'trigger' => row.trigger, 'target' => row.target, 'note' => row.note }
      row.deleted ? { key: row.key, cells: cells, cell_disabled: ['target'] } : { key: row.key, cells: cells }
    end
  end

  def render(ui, save)
    setup = self
    lists = @lists
    ui.stack(key: 'alias', gap: 6, margin: 8, fill: true) do
      ui.tabs(key: 'tabs', names: lists.map(&:label), selected: 0, on: { select: proc {} }) do
        lists.each_with_index do |list, n|
          ui.stack(slot: list.label, key: "tab#{n}", gap: 6, fill: true) { setup.render_list(ui, list, n) }
        end
      end
      ui.text(key: 'status', content: setup.status, tone: :caution, wrap: true) unless setup.status.empty?
      ui.columns(key: 'footer', count: 3, weights: [5, 1, 1], compact: true, row_align: :center, gap: 6) do
        pending = setup.changes
        ui.text(slot: '0', key: 'summary', emphasis: :subtle, wrap: true,
                content: "#{pending.zero? ? 'No changes.' : "#{pending} unsaved change(s)."} " \
                         'A target may use \\r between commands and \\? for what follows the trigger. ' \
                         'Cancel or closing the window discards changes.')
        ui.button(slot: '1', key: 'cancel', label: 'Cancel', on: { activate: ->(_ev) { setup.cancel } })
        save.call(ui, slot: '2', variant: :primary)
      end
    end
  end

  def render_list(ui, list, n)
    setup = self
    ui.table(key: "rows#{n}", headers: true, fill: true, selection: :single, sortable: true, search_column: 'trigger',
             columns: [{ key: 'trigger', label: 'Trigger', sortable: true, resizable: true, width: 160 },
                       { key: 'target', label: 'Sends (double-click to edit)', expand: true, editor: { type: :text } },
                       { key: 'note', label: 'Note', width: 200 }],
             rows: setup.table_rows(list),
             on: { cell_edit: ->(ev) { setup.edit(list, ev.payload[:row], ev.payload[:value]) },
                   selection_change: ->(ev) { list.selected = Array(ev.payload[:rows]).first } })
    ui.group(key: "new#{n}", label: 'New alias') do
      ui.columns(key: "new-row#{n}-#{list.new_rev}", count: 4, weights: [2, 4, 1, 2], compact: true, row_align: :end, gap: 6) do
        # Read once, on Add or Enter, through a submission: typing does not
        # call back or re-render.
        trigger = target = nil
        add = ->(ev) { setup.add(list, ev.submission[trigger.cid], ev.submission[target.cid]) }
        trigger = ui.text_input(slot: '0', key: "nt#{n}", label: 'Trigger', value: '')
        target = ui.text_input(slot: '1', key: "nv#{n}", label: 'Sends', value: '', on: { submit: add })
        ui.submit(target, [trigger, target])
        ui.button(slot: '2', key: "na#{n}", label: 'Add', submit: [trigger, target], on: { activate: add })
        ui.button(slot: '3', key: "nd#{n}", label: 'Delete / Undo selected',
                  tooltip: 'Marks the selected alias for deletion when you save, or undoes that.',
                  on: { activate: ->(_ev) { setup.toggle_selected(list) } })
      end
    end
  end
end

if Script.current.vars[1] =~ /^stop/i
  if UpstreamHook.list.include?('alias-service')
    UpstreamHook.remove('alias-service')
    respond "\n--- Lich: alias service stopped\n\n"
  else
    respond "\n--- Lich: alias service is not running\n\n"
  end
  exit
end

db = Script.open_file('db3')
character = "#{XMLData.game.downcase}_#{XMLData.name.downcase}".gsub(/[^a-z_]/, '').encode('UTF-8')

db.execute("CREATE TABLE IF NOT EXISTS global (trigger TEXT NOT NULL, target TEXT NOT NULL, UNIQUE(trigger));")
db.execute("CREATE TABLE IF NOT EXISTS #{character} (trigger TEXT NOT NULL, target TEXT NOT NULL, UNIQUE(trigger));")

character_regex = nil
global_regex = nil

update_regex = proc {
  global_regex = Array.new
  db.execute("SELECT trigger FROM global;") do |row|
    global_regex.push(Regexp.escape(row[0]))
  end
  if global_regex.empty?
    global_regex = nil
  else
    global_regex = /^(?:<c>)?(#{global_regex.join('|')})(?:\s+|$)(.*)/i
  end

  character_regex = Array.new
  db.execute("SELECT trigger FROM #{character};") do |row|
    character_regex.push(Regexp.escape(row[0]))
  end
  if character_regex.empty?
    character_regex = nil
  else
    character_regex = /^(?:<c>)?(#{character_regex.join('|')})(?:\s+|$)(.*)/i
  end
  true
}

update_regex.call

if Script.current.vars[1] =~ /^setup$/i
  if AliasSetup.available?
    saved = AliasSetup.new(db, character).run
    do_client("#{$lich_char}alias reload") if saved && UpstreamHook.list.include?('alias-service')
  else
    respond "\n--- alias setup needs the Lich WebUI. Use ;alias add, ;alias remove and ;alias list instead.\n\n"
  end
  # With the service already running this run is only the window; without
  # it, carry on and start the service as a plain ;alias would.
  exit if UpstreamHook.list.include?('alias-service')
end

hook_proc = proc { |client_string|
  if client_string =~ /^(?:<c>)?#{$lich_char}alias\s+(.*)/
    args = $1
    if args == 'setup'
      # The window needs a running script to own it, and this hook outlives the
      # script that added it, so the window gets its own run of the script.
      if running?('alias')
        respond "\n--- alias setup is already open\n\n"
      else
        Script.start('alias', 'setup')
      end
    elsif args =~ /^(\-\-global\s+)?(?:add|set)\s+(\-\-global\s+)?([^=]+)=\s*(.+)$/i
      if ($1 || $2)
        table = 'global'
      else
        table = character
      end
      trigger = $3.strip
      target = $4
      if (old_target = db.get_first_value("SELECT target FROM #{table} WHERE trigger=? COLLATE NOCASE;", trigger.encode('UTF-8')))
        db.execute("UPDATE #{table} SET target=? WHERE trigger=?;", [target.encode('UTF-8'), trigger.encode('UTF-8')])
        respond "\n--- Alias updated.  (old alias was: #{old_target})\n\n"
      else
        db.execute("INSERT INTO #{table} (trigger,target) VALUES(?,?);", [trigger.encode('UTF-8'), target.encode('UTF-8')])
        respond "\n--- Alias saved\n\n"
      end
      update_regex.call
    elsif args =~ /^(\-\-global\s+)?(?:rem(?:ove)?|del(?:ete)?)\s+(\-\-global\s+)?(.+)/i
      if ($1 || $2)
        table = 'global'
      else
        table = character
      end
      trigger = $3
      if (target = db.get_first_value("SELECT target FROM #{table} WHERE trigger=? COLLATE NOCASE;", trigger.encode('UTF-8')))
        db.execute("DELETE FROM #{table} WHERE trigger=?", [trigger.encode('UTF-8')])
        update_regex.call
        respond "\n--- Alias deleted (#{trigger} => #{target})\n\n"
      else
        respond "\n--- Alias was not found in #{if table == 'global'; 'global'; else; "#{XMLData.name}'s"; end} list\n\n"
      end
    elsif args =~ /^list$/i
      output = "\nGlobal Aliases:\n\n"
      list = Array.new
      db.execute("SELECT trigger,target FROM global;") do |row|
        list.push "   #{row[0]} => #{row[1]}\n"
      end
      if list.empty?
        output.concat "   (none)\n"
      else
        output.concat list.sort.join
      end
      output.concat "\n#{XMLData.name}'s Aliases:\n\n"
      list.clear
      db.execute("SELECT trigger,target FROM #{character};") do |row|
        list.push "   #{row[0]} => #{row[1]}\n"
      end
      if list.empty?
        output.concat "   (none)\n"
      else
        output.concat list.sort.join
      end
      output.concat "\n"
      respond output
    elsif args =~ /^reload/i
      update_regex.call
      respond "\n--- Alias data reloaded\n\n"
    elsif args =~ /^stop/i
      UpstreamHook.remove('alias-service')
      begin
        db.close
      rescue
        respond "\n--- Lich: alias service failed db close\n\n"
      end
      respond "\n--- Lich: alias service stopped\n\n"
    else
      output = "\n"
      output.concat "Usage:\n"
      output.concat "\n"
      if AliasSetup.available?
        output.concat "     #{$clean_lich_char}alias setup\n"
        output.concat "          Opens a window to configure aliases.\n"
      end
      output.concat "     #{$clean_lich_char}alias add <trigger> = <target>\n"
      output.concat "     #{$clean_lich_char}alias add --global <trigger> = <target>\n"
      output.concat "          Creates a new alias.  When you send a command that starts with <trigger>, it will be replaced\n"
      output.concat "          with <target>.  If --global is specified, the alias will be active for all characters.\n"
      output.concat "          \\r and \\? in the target are treated special.\n"
      output.concat "\n"
      output.concat "     #{$clean_lich_char}alias remove <trigger>\n"
      output.concat "     #{$clean_lich_char}alias remove --global <trigger>\n"
      output.concat "          Deletes the given alias\n"
      output.concat "\n"
      output.concat "     #{$clean_lich_char}alias list\n"
      output.concat "          Lists the currently active aliases\n"
      output.concat "\n"
      output.concat "Examples:\n"
      output.concat "\n"
      output.concat "     ;alias add zap = ;eq cast(901, \"\\?\")\n"
      output.concat "     ;alias add --global ;code = ;lnet chat on code\n"
      output.concat "     ;alias add --global ls = look\n"
      output.concat "\n"
      respond output
    end
    nil
  elsif caller.count { |x| x =~ /do_client/ } < 2
    if character_regex and (client_string =~ character_regex)
      trigger, extra = $1, $2
      if (target = db.get_first_value("SELECT target FROM #{character} WHERE trigger=? COLLATE NOCASE;", trigger.encode('UTF-8')))
        target = target.split('\\r')
        if extra.empty?
          target.collect! { |line| line.gsub('\\?', '') }
        elsif target.any? { |line| line.include?('\\?') }
          target.collect! { |line|
            if line =~ /^;e.*"\\\?"/
              line.gsub('"\\?"', extra.inspect)
            elsif line.include?('\\?')
              line.gsub('\\?', extra)
            else
              line
            end
          }
        elsif target.length == 1
          target.first.concat(" #{extra}")
        end
        target.each { |line| do_client("#{line.chomp}\n") }
      else
        respond "[alias: fixme 1]"
      end
      nil
    elsif global_regex and (client_string =~ global_regex)
      trigger, extra = $1, $2
      if (target = db.get_first_value("SELECT target FROM global WHERE trigger=? COLLATE NOCASE;", trigger.encode('UTF-8')))
        target = target.split('\\r')
        if extra.empty?
          target.collect! { |line| line.gsub('\\?', '') }
        elsif target.any? { |line| line.include?('\\?') }
          target.collect! { |line|
            if line =~ /^;e.*"\\\?"/
              line.gsub('"\\?"', extra.inspect)
            elsif line.include?('\\?')
              line.gsub('\\?', extra)
            else
              line
            end
          }
        elsif target.length == 1
          target.first.concat(" #{extra}")
        end
        target.each { |line| do_client("#{line.chomp}\n") }
      else
        respond "[alias: fixme 2]"
      end
      nil
    else
      client_string
    end
  else
    client_string
  end
}

# v5.19.0 introduces a shared hook registry. Hooks are either
# removed when their owning script exits, or explicitly marked
# to persist and are cleaned up separately.
if UpstreamHook.method(:add).parameters.any? { |_t, n| n == :persist }
  UpstreamHook.add('alias-service', hook_proc, persist: true)
else
  UpstreamHook.add('alias-service', hook_proc)
end
respond "--- Lich: alias service started"
