module ::Lich
  module Common
    module Jinx
      module Setup
        def self.apply()
          # setup jinx folder
          unless Dir.exist?(Folder.jinx_data_dir)
            Log.out("creating %s" % Folder.jinx_data_dir, label: %i(setup))
            Dir.mkdir(Folder.jinx_data_dir)
          end
          # setup repo source list
          unless File.exist? Folder.path("repos.yaml")
            Log.out("creating %s" % Folder.path("repos.yaml"), label: %i(setup))
            FileUtils.touch Folder.path("repos.yaml")
          end
          # seed core repos
          repos_to_seed = [Seed::ElanthiaOnlineExtras, Seed::FFNGLichRepoArchiveMirror]
          case XMLData.game
          when /^GS/
            repos_to_seed.push(Seed::MapdbBackupGS)
          when /^DR/
            repos_to_seed.push(Seed::MapdbBackupDR)
          end

          repos_to_seed.each { |repo|
            Repo.create(**repo) unless Repo.exists?(repo[:name])
          }

          # prune deprecated repos
          repos_to_prune = [Seed::Gtk3ScriptUpdates, Seed::ElanthiaOnlineCore]
          case XMLData.game
          when /^GS/
            repos_to_prune.push(Seed::MapdbBackupDR)
          when /^DR/
            repos_to_prune.push(Seed::MapdbBackupGS)
          end

          repos_to_prune.each { |repo|
            Repo.remove(**repo) if Repo.exists?(repo[:name])
          }
          # setup script metadata
          unless File.exist? Folder.path("scripts.yaml")
            Log.out("creating %s" % Folder.path("scripts.yaml"), label: %i(setup scripts))
            FileUtils.touch Folder.path("scripts.yaml")
          end
          # setup data file metadata
          unless File.exist? Folder.path("data.yaml")
            Log.out("creating %s" % Folder.path("data.yaml"), label: %i(setup data))
            FileUtils.touch Folder.path("data.yaml")
          end
          # setup engine metadata
          unless File.exist? Folder.path("engine.yaml")
            Log.out("creating %s" % Folder.path("engine.yaml"), label: %i(setup engine))
            FileUtils.touch Folder.path("engine.yaml")
          end
        end
      end
    end
  end
end

module ::Lich
  module Common
    module Jinx
      module Service
        # for runnign in non-lich envs easier
        def self.vars()
          if defined?(Script)
            Script.current.vars
          else
            vars = (@vars || [])
            [vars.join(" "), *vars]
          end
        end

        # for running string commands
        def self.run(cmd)
          main cmd.split(" ")
        end

        # main cli entry-point
        def self.main(args)
          @vars = args
          argv = Opts.parse(args)
          # flags parsed on their own, so a bare word such as "repo" or "all"
          # (easily a search term) is never mistaken for --repo or --all
          flags = Opts.parse(args.select { |arg| arg.start_with?(Opts::FLAG_PREFIX) })
          scope_repo = flags.repo
          if scope_repo.eql?(true) || scope_repo.is_a?(Array)
            fail Jinx::Error, "--repo needs exactly one repo name, e.g. --repo=elanthia-online"
          end
          all = flags.all.eql?(true)
          # prune flags
          args = args.reject { |arg| arg.start_with?("--") }

          # help
          if (argv.help.eql?(true) && args.length.eql?(1)) || args.empty?
            return CLI.help()
          end

          # searches are matched on the positional words, ahead of everything else,
          # because their pattern can be any word (list, info, gui, ...)
          # script search <pattern>
          if args.length.eql?(3) && args[0].eql?("script") && args[1].eql?("search")
            return CLI.script_search(args.last, scope_repo, all: all)
          end
          # search <pattern> - search all asset types
          if args.length.eql?(2) && args[0].eql?("search")
            return CLI.search_all(args.last, scope_repo, all: all)
          end

          # repo default [<repo_name>] [--clear]
          if args[0].eql?("repo") && args[1].eql?("default")
            return CLI.repo_default(args[2], clear: flags.clear.eql?(true))
          end

          # === ORIGINAL NAMESPACED COMMANDS (backward compatibility) ===
          # Check these FIRST to maintain backward compatibility

          # repo list
          if argv.repo.eql?(true) && argv.list.eql?(true)
            return CLI.repo_list()
          end
          # repo info <repo_name>
          if argv.repo.eql?(true) && argv.info.eql?(true)
            return CLI.repo_info(args.last)
          end
          # repo add <repo_name> <repo_url>

          if argv.repo.eql?(true) && argv.add.eql?(true)
            url = args.at(-1)
            repo_name = args.at(-2)
            unless url.start_with?("http://") or url.start_with?("https://")
              fail Jinx::Error,
                   "invalid scheme only http/https supported\nurl=%s" % url
            end
            return CLI.repo_add(repo_name, url)
          end

          if argv.repo.eql?(true) && argv.change.eql?(true)
            url = args.at(-1)
            repo_name = args.at(-2)
            (url.start_with?("http://") or url.start_with?("https://") or
              fail Jinx::Error,
                   "invalid scheme only http/https supported\nurl=%s" % url)

            return CLI.repo_change(repo_name, url)
          end

          # repo rm <repo_name>
          if argv.repo.eql?(true) && argv.rm.eql?(true)
            repo_name = args.at(-1)
            return CLI.repo_rm(repo_name)
          end
          # script list
          if argv.script.eql?(true) && argv.list.eql?(true)
            return CLI.script_list(scope_repo, all: all)
          end
          # script info <script_name>
          if argv.script.eql?(true) && argv.info.eql?(true)
            return CLI.script_info(args.last, scope_repo, all: all)
          end
          # script install <script_name>
          if argv.script.eql?(true) && argv.install.eql?(true)
            return CLI.script_install(args.last, scope_repo, all: all, force: argv.force)
          end
          # script update <script_name>
          if argv.script.eql?(true) && argv.update.eql?(true)
            return CLI.script_update(args.last, scope_repo, all: all, force: argv.force)
          end
          # data list
          if argv.data.eql?(true) && argv.list.eql?(true)
            return CLI.data_list(scope_repo, all: all)
          end
          # data info <data_name>
          if argv.data.eql?(true) && argv.info.eql?(true)
            return CLI.data_info(args.last, scope_repo, all: all)
          end
          # data install <data_name>
          if argv.data.eql?(true) && argv.install.eql?(true)
            return CLI.data_install(args.last, scope_repo, all: all, force: argv.force)
          end
          # data update <data_name>
          if argv.data.eql?(true) && argv.update.eql?(true)
            return CLI.data_update(args.last, scope_repo, all: all, force: argv.force)
          end
          # engine list
          if argv.engine.eql?(true) && argv.list.eql?(true)
            return CLI.engine_list(scope_repo, all: all)
          end
          # engine update <engine_name>
          if argv.engine.eql?(true) && argv.update.eql?(true)
            return CLI.engine_update(args[2], scope_repo, all: all, force: argv.force)
          end

          # === NEW UNIFIED COMMANDS (no namespace required) ===
          # These only trigger if no namespaced command matched

          # jinx list - show all assets
          if argv.list.eql?(true) && args.length.eql?(1)
            return CLI.list_all(scope_repo, all: all)
          end

          # jinx info <asset_name> - smart info detection
          if argv.info.eql?(true) && args.length.eql?(2)
            return CLI.smart_info(args.last, scope_repo, all: all)
          end

          # jinx install <asset_name> - smart install
          if argv.install.eql?(true) && args.length.eql?(2)
            return CLI.smart_install(args.last, scope_repo, all: all, force: argv.force, type: argv.type)
          end

          # jinx update <asset_name> - smart update
          if argv.update.eql?(true) && args.length.eql?(2)
            return CLI.smart_update(args.last, scope_repo, all: all, force: argv.force, type: argv.type)
          end

          # jinx auto-update - check and update all installed assets
          if argv.auto_update.eql?(true) || (argv.auto.eql?(true) && argv.update.eql?(true)) || args.include?("auto-update")
            return CLI.auto_update(force: argv.force, dry_run: argv.dry_run || argv.dry, repo_name: scope_repo, all: all)
          end

          # jinx gui - launch GUI interface
          if argv.gui.eql?(true) && args.length.eql?(1)
            if (reason = ::Lich::Common::Jinx::GUI.unavailable_reason)
              Log.mono reason
              return
            end
            begin
              return ::Lich::Common::Jinx::GUI.start!
            rescue => e
              Log.out(e, label: %i(gui error))
              return
            end
          end

          Log.out("unknown command", label: %i(cli))
          CLI.help()
        end
      end
    end
  end
end

module ::Lich
  module Common
    module Jinx
      module CLI
        def self.help()
          Log.mono <<~HELP

        <b>jinx(mode=#{Jinx.mode})</b>

        A federated script repository manager

        Usage: ;jinx &lt;subcommand&gt; [&lt;args&gt;...] [options]

        Asset Commands:
          list                                             list all available assets
          info    &lt;name&gt;                                  show details about an asset
          install &lt;name&gt;                                  install an asset
          update  &lt;name&gt;                                  update an installed asset
          search  &lt;pattern&gt;                               search for assets by name or tag
          auto-update                                      check and update all installed assets
          gui                                              launch graphical user interface

        Repository Commands:
          repo list                                        list all configured repositories
          repo add    &lt;name&gt; &lt;url&gt;                        add a new repository
          repo info   &lt;name&gt;                              show repository details
          repo rm     &lt;name&gt;                              remove a repository
          repo change &lt;name&gt; &lt;url&gt;                        change repository URL
          repo default [&lt;name&gt;]                            show or set the default repository
          repo default --clear                             stop using a default repository

        Options:
          --repo=&lt;name&gt;                                   target a specific repository
          --all                                            use every repository, ignoring the default
          --type={script|data|engine}                      override auto-detected asset type
          --force                                           overwrite without confirmation
          --dry-run                                         check for updates without installing

        Examples:
          ;jinx gui                                        launch graphical interface#{GUI.webui_lich? ? '' : ' (needs Lich 5.26.0+)'}
          ;jinx install go2                                install the go2 script
          ;jinx update spell-list.xml                      update spell data file
          ;jinx search map                                 find all assets with "map" in the name or tags
          ;jinx install go2 --repo=elanthia-online         install from specific repository
          ;jinx repo default elanthia-online               only use elanthia-online unless told otherwise
          ;jinx search loot --all                          search every repository, not just the default
          ;jinx auto-update                                check and update all installed assets
          ;jinx auto-update --dry-run                      preview available updates without installing

        Notes:
          - Asset type (script/data/engine) is automatically detected from repository metadata
          - Use --type flag only when you need to override the auto-detection
          - Use --repo flag when the same asset exists in multiple repositories
          - With a default repository set, commands only use it; add --all to use every repository
          - auto-update follows the default too; with --all it updates each asset from the repo it was installed from
          - Legacy namespaced commands (script/data/engine) are still supported for compatibility

        HELP
        end

        def self.repo_list()
          Repo.each { |repo| Repo.dump(repo) }
        end

        def self.repo_add(repo_name, repo_url)
          Repo.create(name: repo_name, url: repo_url)
        end

        def self.repo_info(repo_name)
          repo = Repo.lookup(repo_name)
          Repo.dump(
            Repo.manifest(repo),
            scripts: true, data: true, engines: true
          )
        end

        def self.repo_rm(repo_name)
          Repo.remove(name: repo_name)
        end

        def self.repo_default(repo_name = nil, clear: false)
          if clear
            Repo.clear_default
            return Log.mono("<b>default repo cleared</b>; commands use every repo unless you pass --repo")
          end

          if repo_name.nil?
            default = Repo.default_name
            if default
              return Log.mono("<b>default repo: %s</b>\nadd --all to a command to use every repo, or clear the default with ;jinx repo default --clear" % default)
            end
            return Log.mono("<b>no default repo set</b>; commands use every repo\nset one with ;jinx repo default &lt;name&gt;")
          end

          repo = Repo.set_default(repo_name)
          Log.mono("<b>default repo set to %s</b>\ncommands now use only this repo unless you pass --repo=&lt;name&gt; or --all" % repo[:name])
        end

        def self.repo_change(repo_name, repo_url)
          repo = Repo.lookup(repo_name)
          Repo.atomic { |repos|
            repos[repo[:name]] = repo.merge({ url: repo_url })
            Log.mono("<b>repo(%s) has been changed from</b>\nold=%s\nnew=%s" % [
              repo_name,
              repo[:url],
              repo_url
            ])
            repos
          }
        end

        def self.script_list(repo_name = nil, all: false)
          # Log.out(repo_name, label: %i(script_list))
          Repo
            .resolve(repo_name, all: all)
            .map    { |repo| repo.merge(Repo.manifest(repo)) }
            .each   { |repo| Repo.dump(repo, scripts: true) }
        end

        def self.script_info(script_name, repo_name = nil, all: false)
          repos = Repo.resolve(repo_name, all: all)
          repo = Installer.ensure_specific(script_name, repos)
          script_metadata = Repo.scripts(repo).find { |asset|
            File.basename(asset[:file])
                .eql?(Installer.normalize_filename(script_name))
          }

          Log.mono("<b>%s (repo: %s, modified: %s)</b>" %
            [script_name, repo[:name],
             Util.ago(script_metadata[:last_commit]) + " ago"])
          if script_metadata[:header]
            Log.mono Repo.header(repo, script_metadata)
          else
            Log.mono "no documentation"
          end
        end

        def self.script_install(script, repo_name = nil, all: false, force: false)
          sources = Repo.resolve(repo_name, all: all)
          env = defined?(Urnon) ? Jinx::UrnonScript : Jinx::LichScript
          env.install(script, sources, overwrite: force, force: force)
        end

        def self.script_update(script, repo_name = nil, all: false, force: false)
          sources = Repo.resolve(repo_name, all: all)
          env = defined?(Urnon) ? Jinx::UrnonScript : Jinx::LichScript
          env.install(script, sources, overwrite: true, force: force)
        end

        def self.script_search(pattern, repo_name = nil, all: false)
          pattern = Regexp.compile(pattern, Regexp::IGNORECASE)
          candidate_repos = Repo.resolve(repo_name, all: all)
          matches = candidate_repos
                    .each { |repo| Repo.manifest(repo) }
                    .select { |repo| repo[:available].is_a?(Array) }
                    .map { |repo| Repo.scripts(repo).map { |script| script.merge({ repo: repo[:name] }) } }
                    .flatten(1)
                    .select { |script| Lookup.matches_search?(script, pattern) }

          Log.mono "<b>found %s #{matches.size == 1 ? "match" : "matches"}</b>%s" % [matches.size, search_scope_note(candidate_repos)]
          matches.each { |script|
            Log.mono "%s> %s (last updated: %s ago)%s" % [
              script[:repo].to_s.rjust(15),
              File.basename(script[:file]).rjust(20),
              Util.ago(script[:last_commit]),
              Lookup.format_tags(script)
            ]
          }
        end

        # tells the user when a search only looked at their default repo
        def self.search_scope_note(candidate_repos)
          hint = Repo.default_scope_hint(candidate_repos)
          hint.empty? ? "" : "\n(searched only repo(#{candidate_repos.first[:name]}), your default repo; add --all to search every repo)"
        end

        def self.data_list(repo_name = nil, all: false)
          Log.out(repo_name, label: %i(data_list))
          Repo
            .resolve(repo_name, all: all)
            .map    { |repo| repo.merge(Repo.manifest(repo)) }
            .each   { |repo| Repo.dump(repo, data: true) }
        end

        def self.data_info(datafile_name, repo_name = nil, all: false)
          repos = Repo.resolve(repo_name, all: all)
          repo = Installer.ensure_specific(datafile_name, repos)
          datafile_metadata = Repo.data(repo).find { |asset|
            File.basename(asset[:file])
                .eql?(Installer.normalize_filename(datafile_name))
          }

          Log.mono("<b>%s (repo: %s, modified: %s)</b>" %
            [datafile_name, repo[:name],
             Util.ago(datafile_metadata[:last_commit]) + " ago"])
          if datafile_metadata[:header]
            Log.mono Repo.header(repo, datafile_metadata)
          else
            Log.mono "no documentation"
          end
        end

        def self.data_install(datafile, repo_name = nil, all: false, force: false)
          sources = Repo.resolve(repo_name, all: all)
          env = defined?(Urnon) ? Jinx::UrnonData : Jinx::LichData
          env.install(datafile, sources, overwrite: force, force: force)
        end

        def self.data_update(datafile, repo_name = nil, all: false, force: false)
          sources = Repo.resolve(repo_name, all: all)
          env = defined?(Urnon) ? Jinx::UrnonData : Jinx::LichData
          env.install(datafile, sources, overwrite: true, force: force)
        end

        def self.engine_list(repo_name = nil, all: false)
          Log.out(repo_name, label: %i(engine_list)) if repo_name
          Repo
            .resolve(repo_name, all: all)
            .map    { |repo| repo.merge(Repo.manifest(repo)) }
            .each   { |repo| Repo.dump(repo, engines: true) }
        end

        def self.engine_update(engine, repo_name = nil, all: false, force: false)
          sources = Repo.resolve(repo_name, all: all)
          env = defined?(Urnon) ? Jinx::UrnonEngine : Jinx::LichEngine
          env.install(engine, sources, overwrite: true, force: force)
        end

        # === NEW UNIFIED COMMAND IMPLEMENTATIONS ===

        def self.list_all(repo_name = nil, all: false)
          Repo
            .resolve(repo_name, all: all)
            .map    { |repo| repo.merge(Repo.manifest(repo)) }
            .each   { |repo|
              Repo.dump(repo, scripts: true, data: true, engines: true)
            }
        end

        def self.smart_info(asset_name, repo_name = nil, all: false)
          repos = Repo.resolve(repo_name, all: all)
          matches = Lookup.find_asset_across_repos(asset_name, repos)

          if matches.empty?
            Log.mono <<~ERROR
          No asset named '#{asset_name}' found.#{Repo.default_scope_hint(repos)}

          Try:
          - ;jinx search #{asset_name}    to find similar names
          - ;jinx list                    to see all available assets
        ERROR
            return
          end

          if matches.size > 1 && repo_name.nil?
            Log.mono "<b>Asset '#{asset_name}' found in multiple repositories:</b>"
            matches.each do |match|
              type_str = match[:asset][:type] || "script"
              Log.mono "  #{match[:repo][:name]} (type: #{type_str})"
            end
            Log.mono "\nSpecify a repository with --repo=<name> to see specific info"
            return
          end

          match = matches.first
          asset = match[:asset]
          repo = match[:repo]
          type_str = asset[:type] || "script"

          Log.mono("<b>%s (repo: %s, type: %s, modified: %s)</b>" %
            [asset_name, repo[:name], type_str,
             Util.ago(asset[:last_commit]) + " ago"])

          if asset[:header]
            Log.mono Repo.header(repo, asset)
          else
            Log.mono "no documentation"
          end
        end

        def self.smart_install(asset_name, repo_name = nil, all: false, force: false, type: nil)
          sources = Repo.resolve(repo_name, all: all)
          SmartInstaller.install(asset_name, sources, overwrite: false, force: force, type: type)
        end

        def self.smart_update(asset_name, repo_name = nil, all: false, force: false, type: nil)
          sources = Repo.resolve(repo_name, all: all)
          SmartInstaller.install(asset_name, sources, overwrite: true, force: force, type: type)
        end

        def self.search_all(pattern, repo_name = nil, all: false)
          pattern = Regexp.compile(pattern, Regexp::IGNORECASE)
          candidate_repos = Repo.resolve(repo_name, all: all)

          all_matches = []

          candidate_repos.each do |repo|
            Repo.manifest(repo)
            next unless repo[:available].is_a?(Array)

            repo[:available].each do |asset|
              if Lookup.matches_search?(asset, pattern)
                type_str = asset[:type] || "script"
                all_matches << {
                  repo: repo[:name],
                  file: File.basename(asset[:file]),
                  type: type_str,
                  tags: asset[:tags],
                  last_commit: asset[:last_commit]
                }
              end
            end
          end

          if all_matches.empty?
            Log.mono "<b>No matches found for pattern: #{pattern.source}</b>#{search_scope_note(candidate_repos)}"
            return
          end

          # Group by type
          by_type = all_matches.group_by { |m| m[:type] }

          Log.mono "<b>Found #{all_matches.size} #{all_matches.size == 1 ? "match" : "matches"}:</b>#{search_scope_note(candidate_repos)}"

          by_type.each do |type, matches|
            Log.mono "\n<b>#{type.capitalize}s:</b>"
            matches.sort_by { |m| m[:file] }.each do |match|
              Log.mono "%s> %s (updated: %s ago)%s" % [
                match[:repo].to_s.rjust(15),
                match[:file].ljust(25),
                Util.ago(match[:last_commit]),
                Lookup.format_tags(match)
              ]
            end
          end
        end

        def self.auto_update(force: false, dry_run: false, repo_name: nil, all: false)
          AutoUpdater.update_all(force: force, dry_run: dry_run, repo_name: repo_name, all: all)
        end
      end
    end
  end
end

# ===========================
# GUI MODULE
# ===========================

module ::Lich
  module Common
    module Jinx
      # Graphical front end on Lich's WebUI.
      #
      # WebUI callbacks run on a Lich host thread, not on this script's thread,
      # so they only push commands onto @commands. The script thread pops them,
      # does the slow work (manifest downloads, installs), updates the state, and
      # publishes a frozen snapshot (@view) that the render block reads.
      module GUI
        extend self

        PAGE_ID = "jinx" unless defined?(PAGE_ID)
        TAB_NAMES = %w[Log Repos Scripts Data].freeze unless defined?(TAB_NAMES)
        KIND_TABS = { script: "Scripts", data: "Data" }.freeze unless defined?(KIND_TABS)
        MAX_LOG_LINES = 2_000 unless defined?(MAX_LOG_LINES)
        MAX_LOG_LINE_LENGTH = 1_000 unless defined?(MAX_LOG_LINE_LENGTH)
        PUBLISH_INTERVAL = 0.15 unless defined?(PUBLISH_INTERVAL)
        QUIET_COMMANDS = %i[select repo_select].freeze unless defined?(QUIET_COMMANDS)
        NOISE = /uberbar|dialogData|progressBar|anchor_left|Target Window|label id=/i unless defined?(NOISE)

        @alive = false unless defined?(@alive)

        # Lich::API.webui_page is loaded only from Lich 5.26.0, so it tells an old
        # Lich (where Lich::WebUI can exist once another script required it) from
        # one running with --no-gui.
        def webui_lich?
          defined?(::Lich::API) && ::Lich::API.respond_to?(:webui_page) ? true : false
        end

        # nil when the window can open, otherwise why not
        def unavailable_reason
          if !webui_lich?
            "<b>jinx gui needs Lich 5.26.0 or later</b>\nIt uses Lich's WebUI window. Please update Lich; every GUI action is also a command (;jinx help)."
          elsif !::Lich::WebUI.presentation_enabled?
            "<b>jinx gui has no window while Lich runs with --no-gui</b>\nEvery GUI action is also a command (;jinx help)."
          end
        end

        def available?
          unavailable_reason.nil?
        end

        def alive?
          @alive
        end

        # whether the caller is the run that owns the window (see Log.gui)
        def owner_thread?
          @script_thread.equal?(Thread.current)
        end

        # the WebUI carries only valid UTF-8; repo headers arrive as raw bytes
        def utf8(text)
          text.to_s.dup.force_encoding(Encoding::UTF_8).scrub("?")
        end

        # =====================
        # App bootstrap
        # =====================
        def start!
          if @alive && @script_thread&.alive? && !@script_thread.equal?(Thread.current)
            Log.out("already open; close that window first", label: %i(jinx gui))
            return
          end
          if (reason = unavailable_reason)
            Log.mono reason
            return
          end
          reset_state!
          @script_thread = Thread.current
          @page = ::Lich::API.webui_page(
            owner: Script.current, id: PAGE_ID, title: "Jinx - Package Manager",
            props: { size: [1100, 700], viewport: true, density: :compact },
            on: { close: proc { GUI.enqueue(:close) } }
          ) { |ui| GUI.render(ui) }
          @alive = true
          append_log("[jinx.gui] Starting up...")
          publish!(force: true)
          ::Lich::API.webui_start
          unless ::Lich::API.webui_open(page: @page)
            @alive = false
            Log.mono "<b>jinx gui could not open a window</b>\nLich could not open a browser window for it."
            return
          end
          enqueue(:reload)
          run_loop
          Log.out("GUI closed", label: %i(jinx gui))
        ensure
          # only the run that owns the window tears it down; a refused second run
          # (;force jinx gui) must not close the live page
          if @script_thread.equal?(Thread.current)
            @alive = false
            if @page && defined?(::Lich::WebUI) && ::Lich::WebUI.respond_to?(:close)
              begin
                ::Lich::WebUI.close(@page)
              rescue StandardError
                nil
              end
            end
          end
        end

        def reset_state!
          @commands = Queue.new
          @log = []
          @busy = nil
          @dirty = true
          @last_publish = Time.at(0)
          @publishing = false
          @manifests = {}
          @repo_rows = []
          @repo_selected = nil
          # a refresh keeps each viewer's typed text, so clearing an input means
          # giving it a new key (generation) rather than rendering an empty value
          @input_generation = { repo_form: 0, script: 0, data: 0 }
          @assets = { script: [], data: [] }
          @asset_index = { script: {}, data: {} }
          @filter = { script: "", data: "" }
          @selected = { script: nil, data: nil }
          @info = {
            script: "Select a script and click Info to see details",
            data: "Select a data file and click Info to see details"
          }
          @view = nil
        end

        # =====================
        # Script-thread command loop
        # =====================
        def enqueue(*command)
          @commands << command if @commands
          nil
        end

        def run_loop
          while @alive
            command = @commands.pop(timeout: PUBLISH_INTERVAL)
            perform(*command) if command
            publish!
          end
        end

        def perform(name, *args)
          case name
          when :close then @alive = false
          when :reload then reload(fetch: true)
          when :refresh_manifests then (@manifests.clear; reload(fetch: true))
          when :filter then apply_filter(args[0], args.length > 1 ? args[1] : @filter[args[0]])
          when :clear_filter then apply_filter(args[0], "", clear: true)
          when :clear_log then @log = ["Log cleared at #{Time.now}"]
          when :select then select_asset(args[0], args[1])
          when :info then show_info(args[0])
          when :install then install(args[0], overwrite: false, force: args[1])
          when :update then install(args[0], overwrite: true, force: args[1])
          when :repo_select then @repo_selected = Array(args[0]).first
          when :repo_add then repo_add(args[0], args[1])
          when :repo_change then repo_change(args[0])
          when :repo_remove then repo_remove
          when :repo_default then repo_default(clear: args[0])
          end
          # selecting a row changes nothing on screen; republishing for it would
          # bump the page generation and make WebUI refuse a click already in flight
          @dirty = true unless QUIET_COMMANDS.include?(name)
        rescue Jinx::Error => e
          append_log("[jinx.gui] #{e.message.strip}")
        rescue StandardError => e
          append_log("[jinx.gui] #{name} failed: #{e.message}")
          e.backtrace.to_a.first(5).each { |frame| append_log("  #{frame}") }
        ensure
          @busy = nil
        end

        def busy(message)
          @busy = message
          append_log("[jinx.gui] #{message}")
          publish!(force: true)
        end

        # =====================
        # Data loading
        # =====================
        def reload(fetch:)
          busy("Loading repository data, this may take a little while...")
          repos = Repo.to_a
          @manifests.select! { |name, _| repos.any? { |repo| repo[:name].to_s.eql?(name) } }
          rows = repos.map do |repo|
            name = repo[:name].to_s
            status = "ok"
            if fetch || !@manifests.key?(name)
              busy("Fetching manifest for #{name}...")
              begin
                @manifests[name] = manifest_with_retries(repo)
              rescue StandardError => e
                @manifests[name] = repo.merge(available: [], err: e.message)
              end
            end
            manifest = @manifests[name]
            status = "error: #{manifest[:err]}" if manifest[:err]
            { name: name, url: repo[:url].to_s, status: status, default: Repo.default?(repo) }
          end
          @repo_rows = rows.sort_by { |row| row[:name] }
          @repo_selected = nil unless @repo_rows.any? { |row| repo_key(row[:name]).eql?(@repo_selected) }
          rebuild_assets
          append_log("[jinx.gui] Loaded #{@assets[:script].size} scripts and #{@assets[:data].size} data files from #{repos.size} repos")
        end

        def manifest_with_retries(repo, attempts: 3, delay: 1.0)
          last_error = nil
          attempts.times do |i|
            manifest = Repo.manifest(repo.dup)
            return manifest if manifest.is_a?(Hash) && (manifest[:err] || manifest[:available].is_a?(Array))

            last_error = "invalid manifest structure"
            append_log("[jinx.gui] #{repo[:name]}: attempt #{i + 1}/#{attempts} failed: #{last_error}")
            sleep(delay) if i < attempts - 1
          end
          raise last_error
        end

        # rebuilds the Scripts and Data rows from the cached manifests (no network)
        def rebuild_assets
          @assets = { script: [], data: [] }
          @asset_index = { script: {}, data: {} }
          @manifests.each do |repo_name, manifest|
            { script: Repo.scripts(manifest), data: Repo.data(manifest) }.each do |kind, assets|
              assets.each do |asset|
                file = File.basename(CGI.unescape(asset[:file].to_s))
                next if file.empty?

                row = {
                  key: asset_key(repo_name, file), file: file, repo: repo_name,
                  tags: Lookup.tags_of(asset), asset: asset,
                  installed: installed_status(kind, file),
                  modified: modified_status(kind, file, asset),
                  updated: safe_ago(asset[:last_commit])
                }
                @assets[kind] << row
                @asset_index[kind][row[:key]] = row
              end
            end
          end
          @assets.each_value { |rows| rows.sort_by! { |row| [row[:file], row[:repo]] } }
          @selected.each_key { |kind| @selected[kind] = nil unless @asset_index[kind].key?(@selected[kind]) }
        end

        def visible_assets(kind)
          text = @filter[kind].to_s.strip
          return @assets[kind] if text.empty?

          pattern = Regexp.new(Regexp.escape(text), Regexp::IGNORECASE)
          @assets[kind].select { |row| row[:file] =~ pattern || row[:tags].any? { |tag| tag =~ pattern } }
        end

        # Clear always gets a new input key, even with no filter applied, so text typed
        # but never submitted is discarded too
        def apply_filter(kind, text, clear: false)
          @input_generation[kind] += 1 if clear || (text.to_s.empty? && !@filter[kind].to_s.empty?)
          @filter[kind] = text.to_s
          found = visible_assets(kind).size
          @info[kind] =
            if @filter[kind].strip.empty?
              "Showing all #{@assets[kind].size} #{kind} files"
            else
              "Found #{found} #{kind} file(s) matching '#{@filter[kind].strip}' by name or tag\n\nSelect an item and click Info to see details"
            end
        end

        def select_asset(kind, rows)
          key = Array(rows).first
          @selected[kind] = @asset_index[kind].key?(key) ? key : nil
        end

        # the selection survives a filter (so clearing the filter restores it, in step
        # with the browser's highlight), but a row the filter hides is not acted on
        def selected_row(kind)
          row = @asset_index[kind][@selected[kind]]
          row = nil unless row && visible_assets(kind).include?(row)
          append_log("[jinx.gui] Select a #{kind} in the table first") unless row
          row
        end

        # =====================
        # Actions
        # =====================
        def show_info(kind)
          row = selected_row(kind) or return
          busy("Fetching info for #{row[:file]}...")
          lines = capture_output do
            if kind == :script
              CLI.script_info(row[:file], row[:repo])
            else
              CLI.data_info(row[:file], row[:repo])
            end
          end
          @info[kind] = lines.any? ? lines.join("\n") : "No info available"
        end

        def install(kind, overwrite:, force:)
          row = selected_row(kind) or return
          force = force ? true : false
          busy("#{overwrite ? 'Updating' : 'Installing'} #{row[:file]} from #{row[:repo]}...")
          if kind == :script
            overwrite ? CLI.script_update(row[:file], row[:repo], force: force) : CLI.script_install(row[:file], row[:repo], force: force)
          else
            overwrite ? CLI.data_update(row[:file], row[:repo], force: force) : CLI.data_install(row[:file], row[:repo], force: force)
          end
          rebuild_assets
        end

        def selected_repo
          row = @repo_rows.find { |r| repo_key(r[:name]).eql?(@repo_selected) }
          append_log("[jinx.gui] Select a repo in the table first") unless row
          row
        end

        def repo_add(name, url)
          name = name.to_s.strip
          url = url.to_s.strip
          if name.empty? || url.empty?
            return append_log("[jinx.gui] Enter both a repo name and a URL to add a repo")
          end
          unless url.start_with?("http://", "https://")
            return append_log("[jinx.gui] Repo URLs must start with http:// or https://")
          end

          CLI.repo_add(name, url)
          @input_generation[:repo_form] += 1
          reload(fetch: false)
        end

        def repo_change(url)
          row = selected_repo or return
          url = url.to_s.strip
          return append_log("[jinx.gui] Enter the new URL first") if url.empty?

          CLI.repo_change(row[:name], url)
          @manifests.delete(row[:name])
          @input_generation[:repo_form] += 1
          reload(fetch: false)
        end

        def repo_remove
          row = selected_repo or return
          CLI.repo_rm(row[:name])
          @manifests.delete(row[:name])
          reload(fetch: false)
        end

        def repo_default(clear:)
          if clear
            CLI.repo_default(nil, clear: true)
          else
            row = selected_repo or return
            CLI.repo_default(row[:name])
          end
          reload(fetch: false)
        end

        # =====================
        # Rendering
        # =====================
        def publish!(force: false)
          return unless @alive && @page && !@publishing
          return unless @dirty || force
          return if !force && (Time.now - @last_publish) < PUBLISH_INTERVAL
          return unless Thread.current.equal?(@script_thread)

          @publishing = true
          @dirty = false
          view = snapshot
          return if !force && view == @view # nothing visible changed

          @view = view
          @last_publish = Time.now
          ::Lich::API.webui_refresh(@page)
        rescue StandardError => e
          # the page is gone (closed, or the script is shutting down), or it did not render
          @alive = false
          Log.out(e, label: %i(jinx gui))
        ensure
          @publishing = false
        end

        def snapshot
          {
            busy: @busy,
            log: @log.dup.freeze,
            repos: @repo_rows.map(&:dup).freeze,
            assets: { script: visible_assets(:script).dup.freeze, data: visible_assets(:data).dup.freeze }.freeze,
            filter: @filter.dup.freeze,
            info: @info.dup.freeze,
            generation: @input_generation.dup.freeze
          }.freeze
        end

        # runs on whichever thread WebUI renders on; reads only the frozen @view
        def render(ui)
          view = @view || snapshot
          ui.stack(key: "root", gap: 6, fill: true) do
            ui.text(key: "status", content: view[:busy] || "Ready", tone: view[:busy] ? :caution : :neutral)
            # the browser keeps each viewer's own tab; binding select is what lets tabs switch
            ui.tabs(key: "tabs", names: TAB_NAMES, selected: 0, on: { select: proc {} }) do
              GUI.render_log_tab(ui, view)
              GUI.render_repos_tab(ui, view)
              KIND_TABS.each { |kind, tab| GUI.render_assets_tab(ui, view, kind, tab) }
            end
          end
        end

        def GUI.render_log_tab(ui, view)
          ui.stack(slot: "Log", key: "log_tab", gap: 6, fill: true) do
            ui.button(key: "clear_log", label: "Clear Log", align: :start, on: { activate: proc { GUI.enqueue(:clear_log) } })
            ui.log(key: "log", lines: view[:log], max_lines: MAX_LOG_LINES, follow: true, wrap: :word_char)
          end
        end

        def GUI.render_repos_tab(ui, view)
          ui.stack(slot: "Repos", key: "repos_tab", gap: 6, fill: true) do
            name = url = nil
            ui.stack(key: "controls", orientation: :horizontal, gap: 6) do
              name = ui.text_input(key: "name_#{view[:generation][:repo_form]}", value: "", placeholder: "repo name")
              url = ui.text_input(key: "url_#{view[:generation][:repo_form]}", value: "", placeholder: "https://...")
              ui.button(key: "add", label: "Add", submit: [name, url], on: { activate: proc { |ev|
                GUI.enqueue(:repo_add, ev.submission[name.cid], ev.submission[url.cid])
              } })
              ui.button(key: "change", label: "Change URL", submit: [url], on: { activate: proc { |ev|
                GUI.enqueue(:repo_change, ev.submission[url.cid])
              } })
            end
            ui.stack(key: "repo_actions", orientation: :horizontal, gap: 6) do
              ui.button(key: "remove", label: "Remove", variant: :danger, confirm: "Remove the selected repo?",
                        on: { activate: proc { GUI.enqueue(:repo_remove) } })
              ui.button(key: "set_default", label: "Set Default", on: { activate: proc { GUI.enqueue(:repo_default, false) } })
              ui.button(key: "clear_default", label: "Clear Default", on: { activate: proc { GUI.enqueue(:repo_default, true) } })
              ui.button(key: "refresh", label: "Refresh Manifests", on: { activate: proc { GUI.enqueue(:refresh_manifests) } })
            end
            ui.text(key: "hint", emphasis: :subtle,
                    content: "The default repo is the one ;jinx commands use unless you pass --repo or --all. This window always lists every repo.")
            ui.table(
              key: "repos", fill: true, scrollable: true, grid_lines: :both, selection: :single,
              columns: [
                { key: "name", label: "Name", sortable: true, resizable: true, min_width: 150 },
                { key: "url", label: "URL", sortable: true, resizable: true, expand: true },
                { key: "status", label: "Status", sortable: true, resizable: true },
                { key: "default", label: "Default", resizable: true }
              ],
              rows: view[:repos].map { |row|
                { key: GUI.repo_key(row[:name]),
                  cells: { "name" => row[:name], "url" => row[:url], "status" => row[:status], "default" => row[:default] ? "yes" : "" } }
              },
              on: { selection_change: proc { |ev| GUI.enqueue(:repo_select, ev.payload[:rows]) } }
            )
          end
        end

        def GUI.render_assets_tab(ui, view, kind, tab)
          ui.stack(slot: tab, key: "#{kind}_tab", gap: 6, fill: true) do
            ui.stack(key: "controls", orientation: :horizontal, gap: 6) do
              search = ui.text_input(
                key: "search_#{view[:generation][kind]}", value: view[:filter][kind], search: true,
                placeholder: "search by name or tag... (empty = show all)",
                on: { submit: proc { |ev| GUI.enqueue(:filter, kind, ev.submission[search.cid]) } }
              )
              ui.submit(search, [search]) # Enter submits the box's own text
              ui.button(key: "search_btn", label: "Search", submit: [search], on: { activate: proc { |ev|
                GUI.enqueue(:filter, kind, ev.submission[search.cid])
              } })
              ui.button(key: "clear", label: "Clear", on: { activate: proc { GUI.enqueue(:clear_filter, kind) } })
              ui.button(key: "info", label: "Info", on: { activate: proc { GUI.enqueue(:info, kind) } })
              force = ui.checkbox(key: "force", label: "Force overwrite", checked: false)
              ui.button(key: "install", label: "Install", variant: :primary, submit: [force], on: { activate: proc { |ev|
                GUI.enqueue(:install, kind, ev.submission[force.cid])
              } })
              ui.button(key: "update", label: "Update", submit: [force], on: { activate: proc { |ev|
                GUI.enqueue(:update, kind, ev.submission[force.cid])
              } })
            end
            ui.split(key: "body", orientation: :horizontal, position: 65, fill: true) do
              ui.table(
                slot: "first", key: "assets", fill: true, scrollable: true, grid_lines: :both, selection: :single,
                columns: [
                  { key: "name", label: "Name", sortable: true, resizable: true, min_width: 170 },
                  { key: "repo", label: "Repo", sortable: true, resizable: true, min_width: 120 },
                  { key: "installed", label: "Installed", sortable: true, resizable: true },
                  { key: "modified", label: "Modified", sortable: true, resizable: true },
                  { key: "updated", label: "Updated (ago)", sortable: true, resizable: true, min_width: 110 },
                  { key: "tags", label: "Tags", resizable: true, expand: true }
                ],
                rows: view[:assets][kind].map { |row|
                  { key: row[:key],
                    cells: { "name" => row[:file], "repo" => row[:repo], "installed" => row[:installed],
                             "modified" => row[:modified], "updated" => row[:updated], "tags" => row[:tags].join(", ") } }
                },
                on: { selection_change: proc { |ev| GUI.enqueue(:select, kind, ev.payload[:rows]) },
                      cursor_change: proc { |ev| GUI.enqueue(:select, kind, [ev.payload[:row]]) },
                      row_activate: proc { |ev| GUI.enqueue(:select, kind, [ev.payload[:row]]); GUI.enqueue(:info, kind) } }
              )
              ui.group(slot: "second", key: "info", label: "Information", fill: true) do
                ui.scroll(key: "info_scroll", fill: true) do
                  ui.text(key: "info_text", content: view[:info][kind], wrap: true, font_family: "monospace")
                end
              end
            end
          end
        end

        # table row keys must be short identifiers; repo and file names can hold anything
        def asset_key(repo_name, file)
          "a" + Digest::SHA1.hexdigest("#{repo_name}/#{file}")[0, 20]
        end

        def repo_key(repo_name)
          "r" + Digest::SHA1.hexdigest(repo_name.to_s)[0, 20]
        end

        # =====================
        # Log bridge
        # =====================
        def append_log(line)
          text = utf8(line)
          return if text.strip.empty? || text =~ NOISE

          text = text[0, MAX_LOG_LINE_LENGTH] + "..." if text.length > MAX_LOG_LINE_LENGTH
          (@log ||= []) << text
          @log.shift(@log.size - MAX_LOG_LINES) if @log.size > MAX_LOG_LINES
          @dirty = true
          publish!
        end

        # collects what Jinx::Log.mono prints while the block runs (used for Info)
        def capture_output
          Thread.current[:jinx_gui_capture] = []
          yield
          Thread.current[:jinx_gui_capture]
        ensure
          Thread.current[:jinx_gui_capture] = nil
        end

        # receives Log.mono output while the window is open (see Log.gui)
        def mono(text)
          clean = CGI.unescapeHTML(utf8(text).gsub(/<[^>]+>/, ""))
          if (buffer = Thread.current[:jinx_gui_capture])
            buffer << clean
          else
            clean.each_line { |l| append_log(l.chomp) }
          end
          nil
        end

        # =====================
        # Helpers
        # =====================
        def safe_ago(ts)
          return "-" if ts.nil?

          Util.ago(ts)
        rescue StandardError
          "-"
        end

        def asset_dir(kind)
          kind == :script ? Folder.script_dir : Folder.data_dir
        rescue StandardError
          nil
        end

        def installed_status(kind, filename)
          dir = asset_dir(kind)
          return "unknown" unless dir.is_a?(String) && !dir.empty?

          File.exist?(File.join(dir, filename)) ? "yes" : "no"
        end

        def modified_status(kind, filename, asset)
          dir = asset_dir(kind)
          return "-" unless dir.is_a?(String) && !dir.empty?

          path = File.join(dir, filename)
          return "-" unless File.exist?(path)

          remote = asset[:md5].to_s # upstream digest field is :md5 (base64 SHA1)
          return "unknown" if remote.empty?

          Digest::SHA1.base64digest(File.binread(path)) == remote ? "clean" : "modified"
        rescue StandardError
          "unknown"
        end
      end
    end
  end
end

if defined?(Lich::Util) or defined?(Urnon)
  ::Lich::Common::Jinx::Setup.apply()
  ::Lich::Common::Jinx::Util.unwrap {
    ::Lich::Common::Jinx::Service.main(Script.current.vars.slice(1..-1))
  } if defined?(script.name)
end
