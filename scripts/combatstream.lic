=begin

    Moves combat messaging out of your main story window and into its own "combat" stream, so a
    frontend window set up for that stream shows the fight and the story window stays readable.

    Combat lines are recognized with Lich's own Gemstone combat definitions (the same ones the
    combat tracker uses): attacks, AS/DS and CS/TD rolls, damage, crits, flares, evades/blocks/
    parries, status effects and spell wear-offs. Nothing is squelched and no other script is
    affected -- scripts still see every line exactly as the game sent it.

    USAGE:
        ;combatstream                       - start routing combat, using previous settings

    OPTIONAL PARAMETERS:
        --block                             - (default) once a combat line is seen, everything up to the next
                                              prompt goes to the combat stream too (catches death messages,
                                              crit flavor and roundtime that follow an attack)
        --line                              - only move the individual lines Lich recognizes as combat
        --stream=<id>                       - stream id to send combat to (default: combat)

        --debug                             - echo which kind of combat each moved line was, for this run only
        --help                              - show this help and exit
        --list                              - show current settings and exit

    FRONTEND SETUP:
        Wrayth/Stormfront                   - a "combat" window is created for you when the script starts
        ProfanityFE                         - add a window to your layout whose value includes the stream id
        Wizard/Avalon                       - not supported (no stream windows)

        If your frontend has no window for the stream, it may drop the text rather than show it in the
        main window -- open the window first. Note that ;targetlist also writes to (and clears) the
        "combat" stream; use --stream=<id> to pick another id if you run both.

        author: elanthia-online
  contributors: Tysong
          game: Gemstone
          name: combatstream
          tags: combat, stream, window, frontend
      required: Lich >= 5.21.0
       version: 1.0.0

    changelog:
      1.0.0 (2026-09-22)
        - Initial release

=end

module CombatStream
  # Recognizes combat lines with lich-5's Gemstone combat definitions.
  #
  # Each family is called directly and synchronously. Combat::Tracker is not
  # used: its hook only observes, and it parses after the prompt on a worker
  # thread, so its events arrive after the line has already reached the
  # frontend. The def tables themselves are plain, gated pattern lookups that
  # need neither the tracker enabled nor its settings loaded.
  #
  # Built from whatever the running lich-5 actually provides, so a release
  # that lacks a family (e.g. Definitions::Messages, newer than 5.21) just
  # classifies without it instead of failing to start.
  module Classifier
    # [family, constant path under Lich::Gemstone::Combat, method], cheapest
    # and most frequent first -- the first family to match wins.
    CANDIDATES = [
      [:resolution, 'Definitions::Resolutions', :parse],
      [:damage,     'Definitions::Damage',      :parse],
      [:attack,     'Parser',                   :parse_attack],
      [:outcome,    'Definitions::Outcomes',    :parse],
      [:flare,      'Definitions::Flares',      :parse],
      [:status,     'Definitions::Statuses',    :parse],
      [:ucs,        'Definitions::UCS',         :parse],
      [:spell_loss, 'Definitions::SpellLosses', :parse],
      [:sequence,   'Definitions::Sequences',   :parse_start],
      [:sequence,   'Definitions::Sequences',   :parse_end],
      [:assault,    'Definitions::Assaults',    :parse_start],
      [:assault,    'Definitions::Assaults',    :parse_end],
      [:crit_rider, 'Definitions::Resolutions', :crit_rider_line?]
    ].freeze

    # @param gemstone [Module] the Lich::Gemstone namespace to read defs from
    # @return [Array<Array(Symbol, #call)>] the available [family, matcher] pairs
    def self.build(gemstone = Lich::Gemstone)
      combat = gemstone.const_get(:Combat, false)
      families = CANDIDATES.filter_map do |family, path, meth|
        mod = lookup(combat, path)
        [family, mod.method(meth)] if mod.respond_to?(meth)
      end

      # Scattered combat messages (disarms, ambushes, rooting ...); only in
      # lich-5 newer than 5.21.
      messages = lookup(combat, 'Definitions::Messages')
      families << [:message, ->(line) { messages.scan(line).any? }] if messages.respond_to?(:scan)

      # Crit description text ("Torn muscle in ...'s left leg!"). Returns a
      # Hash of matches, empty when none.
      crits = lookup(gemstone, 'CritRanks')
      families << [:crit, ->(line) { crits.parse(line).any? }] if crits.respond_to?(:parse)

      families
    end

    # @return [Module, nil] the constant at path under root, nil if absent
    def self.lookup(root, path)
      path.split('::').reduce(root) do |ns, name|
        ns&.const_defined?(name, false) ? ns.const_get(name, false) : nil
      end
    end

    # @return [Symbol, nil] the first family that recognizes line, or nil
    def self.classify(families, line)
      families.each do |family, matcher|
        return family if matcher.call(line)
      end
      nil
    end
  end

  # The DownstreamHook body: decides, one server string at a time, whether
  # it goes to the combat stream.
  #
  # Only what the frontend sees changes. DownstreamHooks run after Lich has
  # parsed the line and fed it to every script's buffer, so waitfor/matchwait/
  # Flags and the combat tracker still see the original text.
  class Router
    PROMPT = '<prompt'
    PUSH_STREAM = /<pushStream\b/.freeze
    POP_STREAM = /<popStream\b/.freeze

    # Strings carrying frontend structure (room, stream, dialog or mono
    # state) are never wrapped -- the structure would move with them -- and
    # they end any combat block, since combat does not span a room change.
    # The last alternative catches a tag split across two strings.
    STRUCTURAL = %r{</?(?:clearStream|streamWindow|exposeStream|compDef|compass|component|dialogData|openDialog|nav|app|mode|style|output|resource|playerID|settingsInfo|indicator|progressBar|spell|left|right)\b|<[^>]*\z}.freeze

    # Conversation stays in the story window even when it lands mid-fight.
    CONVERSATION = /<preset id=['"](?:speech|whisper|thought)['"]/.freeze

    attr_reader :stream, :mode

    # @param classifier [#call] line -> family Symbol or nil
    # @param stream [String] stream id to route combat into
    # @param mode [Symbol] :block or :line (see the script help)
    # @param debug [#call, nil] called with (family, line) for each routed line
    def initialize(classifier, stream: 'combat', mode: :block, debug: nil)
      @classifier = classifier
      @stream = stream
      @mode = mode
      @debug = debug
      @in_block = false
      @stream_depth = 0
    end

    # @param line [String] one raw server string
    # @return [String] the string, wrapped in the combat stream or unchanged
    def call(line)
      return line unless line.is_a?(String)

      if line.include?(PROMPT)
        # Lich core closes a server stream left open at the prompt, so ours
        # resets here too rather than getting stuck.
        @in_block = false
        @stream_depth = 0
        return line
      end

      # Track streams the server opens itself (its own combat, thoughts,
      # familiar ...). Lines inside one already go to a window; wrapping them
      # again would nest streams.
      if PUSH_STREAM.match?(line) || POP_STREAM.match?(line)
        @stream_depth = [@stream_depth + line.scan(PUSH_STREAM).size - line.scan(POP_STREAM).size, 0].max
        return line
      end
      return line if @stream_depth.positive?

      if STRUCTURAL.match?(line)
        @in_block = false
        return line
      end
      return line if CONVERSATION.match?(line)

      family = if @in_block
                 :block
               elsif line.strip.empty?
                 nil
               else
                 @classifier.call(line)
               end
      return line unless family

      @in_block = true if @mode == :block
      @debug&.call(family, line)
      wrap(line)
    end

    # Each line is its own push/pop pair rather than one stream held open
    # across strings: a lost prompt can never leave the story window stuck
    # inside our stream, and bold/mono tags stay balanced within the pair.
    def wrap(line)
      "<pushStream id=\"#{@stream}\"/>#{line.chomp}\r\n<popStream/>\r\n"
    end
  end

  HOOK_NAME = 'combatstream'
  STREAM_ID_PATTERN = /\A[a-zA-Z][\w-]*\z/.freeze

  def self.show_help
    respond <<~HELP
      combatstream - moves combat messaging into its own stream/window

        ;combatstream                 start, using previous settings
        ;combatstream --block         (default) route everything from a combat line to the next prompt
        ;combatstream --line          route only lines recognized as combat
        ;combatstream --stream=<id>   stream id to use (default: combat)
        ;combatstream --debug         echo the kind of each routed line (this run only)
        ;combatstream --list          show settings
        ;combatstream --help          show this help

      Wrayth/Stormfront get a "combat" window created automatically. ProfanityFE needs a window
      in its layout for the stream id. ;targetlist also uses (and clears) the "combat" stream;
      pick another id with --stream if you run both.
    HELP
  end

  def self.show_settings
    respond "combatstream settings:"
    respond "  mode:   #{CharSettings['mode'] || 'block'}"
    respond "  stream: #{CharSettings['stream'] || 'combat'}"
  end

  def self.run(args)
    if args.include?('--help') || args.include?('-h')
      show_help
      return
    end

    unless XMLData.game =~ /^GS/ && defined?(Lich::Gemstone::Combat::Parser)
      echo 'combatstream needs Gemstone IV and Lich 5.21.0 or newer (the Gemstone combat definitions).'
      return
    end

    if Frontend.respond_to?(:supports_streams?) && !Frontend.supports_streams?
      echo "Your frontend (#{Frontend.client}) has no stream windows, so there is nowhere to move combat to."
      return
    end

    CharSettings['mode'] = 'block' if args.include?('--block')
    CharSettings['mode'] = 'line' if args.include?('--line')
    if (stream_arg = args.find { |a| a.start_with?('--stream=') })
      stream = stream_arg.split('=', 2).last
      unless STREAM_ID_PATTERN.match?(stream)
        echo "Invalid stream id #{stream.inspect}: use letters, digits, - or _, starting with a letter."
        return
      end
      CharSettings['stream'] = stream
    end

    if args.include?('--list')
      show_settings
      return
    end

    stream = CharSettings['stream'] || 'combat'
    mode = CharSettings['mode'] == 'line' ? :line : :block
    families = Classifier.build
    debug = ->(family, line) { respond "[combatstream] #{family}: #{line.gsub(/<[^>]+>/, '').strip}" } if args.include?('--debug')

    if %w[stormfront wrayth].include?(Frontend.client.to_s)
      _respond("<streamWindow id=\"#{stream}\" title=\"Combat\" location=\"center\" save=\"true\" />")
      _respond("<exposeStream id=\"#{stream}\"/>")
    end

    router = Router.new(->(line) { Classifier.classify(families, line) }, stream: stream, mode: mode, debug: debug)
    warned = false
    hook = proc do |server_string|
      router.call(server_string)
    rescue StandardError => e
      # DownstreamHook removes a hook that raises. One odd line must not
      # silently turn routing off for the rest of the session.
      unless warned
        warned = true
        Lich.log "combatstream: #{e.class}: #{e.message}\n\t#{e.backtrace&.first(5)&.join("\n\t")}"
      end
      server_string
    end

    before_dying { DownstreamHook.remove(HOOK_NAME) }
    DownstreamHook.add(HOOK_NAME, hook)
    respond "[combatstream] routing combat to stream '#{stream}' (#{mode} mode, #{families.size} combat families). ;kill combatstream to stop."
    sleep
  end
end

CombatStream.run(Script.current.vars[1..] || [])
