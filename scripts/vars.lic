=begin

  edit variables shared by all scripts

  ;vars help

   original author: Tillmen (tillmen@lichproject.org)
   maintained by: Elanthia-Online
   game: Gemstone
   tags: core
   required: Lich > 5.0.1 (setup window: Lich with the WebUI)
   version: 1.3.0

  changelog:
    1.3.0 (2026-11-09)
      ;vars setup is a Lich WebUI window instead of GTK: edit values, delete
      and add variables, then Save & Close. Cancel or closing the window discards.
      One table with in-place editing and type-ahead by name, so any number of
      variables shows; typing no longer redraws the window.
    1.2.0 (2023-12-04)
      Allowed setting of vars to boolean values true/false
    1.1 (2023-09-07)
      Remove #quiet to prevent script being ran quietly
      Rubocop cleanup
    1.0 (2021-12-09)
      Baselined GTK3 variant for consistency
    0.9 (2021-03-01):
      Updated menu elements to support GTK3 in Lich5
    0.8 (2020-03-20:
      updated to support GTK3
    0.7 (2015-04-26):
      prompt to save in GUI when new vars are added
    0.6 (2015-02-01):
      add default text to new var textboxes
    0.5 (2015-02-01):
      sort vars alphabetically in gui
    0.4 (2015-02-01):
      add gui
    0.3 (2015-01-06):
      fix bug when updating a setting
    0.2 (2014-12-17):
      don't use Vars.send

=end

# ;vars setup: a native Lich WebUI settings form listing every variable in
# one table. Values are edited in place, variables deleted and new ones
# added. Nothing is written until Save & Close; Cancel or closing the window
# discards the changes. The form's lifecycle (Save, Cancel, close, waiting
# on this script's thread) is Lich's SettingsForm; this class supplies the
# table and applies the result.
class VarsSetup
  # Lich keeps this class between runs in a session; start each run clean.
  constants(false).each { |name| remove_const(name) }

  PAGE_ID = 'vars-setup'

  def self.available?
    defined?(Lich::WebUI::SettingsForm) && Lich::WebUI.respond_to?(:presentation_enabled?) &&
      Lich::WebUI.presentation_enabled?
  end

  # key: the table row identity (names may hold any character). added: a
  # new variable, written on Save.
  Row = Struct.new(:key, :name, :original, :value, :deleted, :added) do
    # Only text values are edited here, as in the old window; true/false
    # and other values are shown and can be deleted, set with ;vars set.
    def editable? = !deleted && (added || original.is_a?(String))
    def changed? = added || deleted || (original.is_a?(String) && value != original)

    def shown
      added || original.is_a?(String) ? value : original.inspect
    end

    def note
      if added then 'new, added when you save'
      elsif deleted then 'deleted when you save'
      elsif !original.is_a?(String) then "#{original.class}; change it with ;vars set"
      elsif value != original then 'changed'
      else ''
      end
    end
  end

  def initialize
    @rows = Vars.list.to_a.sort_by { |name, _| name.to_s.downcase }.each_with_index
                .map { |(name, value), i| Row.new("v#{i}", name.to_s, value, value.is_a?(String) ? value.dup : value, false, false) }
    @next_added = 0
    @new_rev = 0 # a new key clears the add boxes after Add
    @selected = nil
    @status = ''
  end

  attr_reader :rows, :status, :new_rev

  def changes = @rows.count(&:changed?)

  def run
    setup = self
    @form = Lich::WebUI::SettingsForm.new(
      owner: Script.current, id: PAGE_ID, title: "Lich - #{Char.name}'s Vars", values: {}, fields: [],
      props: { size: [760, 560], viewport: true },
      layout: ->(ui, _field, save) { setup.render(ui, save) }
    )
    if @form.show.wait
      apply
    else
      pending = changes
      respond "\n--- vars window closed#{pending.positive? ? " WITHOUT saving #{pending} change(s)" : ''}\n\n"
    end
  end

  def refresh
    Lich::WebUI.refresh(@form.page) if @form&.page
  end

  def row(key) = @rows.find { |r| r.key == key }

  def edit(key, text)
    row = row(key)
    return unless row&.editable?

    row.value = text.to_s
    refresh
  end

  def select(key)
    @selected = key
  end

  # Delete or undo the selected variable; a new one is simply removed.
  def toggle_selected
    row = row(@selected)
    if row.nil?
      @status = 'Select a variable first.'
    elsif row.added
      @rows.delete(row)
      @selected = nil
      @status = ''
    else
      row.deleted = !row.deleted
      @status = ''
    end
    refresh
  end

  def add(name, value)
    name = name.to_s.strip
    if name.empty?
      @status = 'Type a name for the new variable.'
    elsif (row = @rows.find { |r| r.name == name })
      @status = row.added ? "#{name} is already waiting to be added." : "Variable #{name} already exists; edit it in the list."
    else
      @rows << Row.new("a#{@next_added += 1}", name, nil, value.to_s, false, true)
      @new_rev += 1
      @status = ''
    end
    refresh
  end

  # The old window's save: deleted variables go, edited text values change,
  # new variables are added.
  def apply
    count = changes
    @rows.each do |row|
      if row.added
        Vars[row.name] = row.value unless Vars.list.key?(row.name)
      elsif row.deleted
        Vars[row.name] = nil
      elsif row.changed?
        Vars[row.name] = row.value
      end
    end
    respond "\n--- vars saved#{count.positive? ? " (#{count} change(s))" : ''}\n\n"
  end

  def cancel
    @form.close
  end

  def table_rows
    @rows.map do |row|
      cells = { 'name' => row.name, 'value' => row.shown, 'note' => row.note }
      row.editable? ? { key: row.key, cells: cells } : { key: row.key, cells: cells, cell_disabled: ['value'] }
    end
  end

  def render(ui, save)
    setup = self
    ui.stack(key: 'vars', gap: 6, margin: 8, fill: true) do
      ui.table(key: 'rows', headers: true, fill: true, selection: :single, sortable: true, search_column: 'name',
               columns: [{ key: 'name', label: 'Name', sortable: true, resizable: true, width: 200 },
                         { key: 'value', label: 'Value (double-click to edit)', expand: true, editor: { type: :text } },
                         { key: 'note', label: 'Note', width: 230 }],
               rows: setup.table_rows,
               on: { cell_edit: ->(ev) { setup.edit(ev.payload[:row], ev.payload[:value]) },
                     selection_change: ->(ev) { setup.select(Array(ev.payload[:rows]).first) } })
      ui.group(key: 'new', label: 'New variable') do
        ui.columns(key: "new-row-#{setup.new_rev}", count: 4, weights: [2, 4, 1, 2], compact: true, row_align: :end, gap: 6) do
          # Read once, on Add or Enter, through a submission: typing does
          # not call back or re-render.
          name = value = nil
          add = ->(ev) { setup.add(ev.submission[name.cid], ev.submission[value.cid]) }
          name = ui.text_input(slot: '0', key: 'new-name', label: 'Name', value: '')
          value = ui.text_input(slot: '1', key: 'new-value', label: 'Value', value: '', on: { submit: add })
          ui.submit(value, [name, value])
          ui.button(slot: '2', key: 'add', label: 'Add', submit: [name, value], on: { activate: add })
          ui.button(slot: '3', key: 'delete', label: 'Delete / Undo selected',
                    tooltip: 'Marks the selected variable for deletion when you save, or undoes that.',
                    on: { activate: ->(_ev) { setup.toggle_selected } })
        end
      end
      ui.text(key: 'status', content: setup.status, tone: :caution, wrap: true) unless setup.status.empty?
      ui.columns(key: 'footer', count: 3, weights: [5, 1, 1], compact: true, row_align: :center, gap: 6) do
        pending = setup.changes
        ui.text(slot: '0', key: 'summary', emphasis: :subtle, wrap: true,
                content: "#{setup.rows.count { |r| !r.added }} variable(s). #{pending.zero? ? 'No changes.' : "#{pending} unsaved change(s)."} " \
                         'Cancel or closing the window discards changes.')
        ui.button(slot: '1', key: 'cancel', label: 'Cancel', on: { activate: ->(_ev) { setup.cancel } })
        save.call(ui, slot: '2', variant: :primary)
      end
    end
  end
end

if (script.vars[1] == 'set') and (script.vars[0] =~ /^set\s+([^\s]+)\s*=\s*(.+)/)
  name = $1
  value = $2.strip
  old_value = Vars[name]
  if value.to_s.downcase == 'true'
    Vars[name] = true
  elsif value.to_s.downcase == 'false'
    Vars[name] = false
  else
    Vars[name] = value
  end
  if old_value.nil?
    respond "\n--- variable \"#{name}\" set to: \"#{value}\"\n\n"
  else
    respond "\n--- variable #{name} changed to: #{value} (was #{old_value})\n\n"
  end
elsif (script.vars[1] =~ /^del(ete)?$|^rem(?:ove)?$/) and script.vars[2]
  if Vars[script.vars[2]].nil?
    respond "\n--- variable #{script.vars[2]} does not exist\n\n"
  else
    Vars[script.vars[2]] = nil
    respond "\n--- variable #{script.vars[2]} was deleted\n\n"
  end
elsif script.vars[1] == 'list'
  if Vars.list.empty?
    respond "\n--- no variables are set\n\n"
  else
    output = "\n--- #{XMLData.name}'s variables:\n\n"
    max_name = 0; Vars.list.keys.each { |k| max_name = [max_name, k.length].max }
    Vars.list.each { |vars_name, vars_value|
      output.concat "   #{vars_name.rjust(max_name)}:  #{vars_value}\n"
    }
    output.concat "\n"
    respond output
  end
elsif script.vars[1] == 'setup'
  if VarsSetup.available?
    VarsSetup.new.run
  else
    respond "\n--- vars setup needs the Lich WebUI. Use ;vars set NAME=VALUE, ;vars delete NAME and ;vars list instead.\n\n"
  end
else
  output = "\n"
  output.concat "   #{$clean_lich_char}#{script.name} setup              open a window to edit variables\n" if VarsSetup.available?
  output.concat "   #{$clean_lich_char}#{script.name} set NAME=VALUE     add or change a variable\n"
  output.concat "   #{$clean_lich_char}#{script.name} delete NAME        delete a variable\n"
  output.concat "   #{$clean_lich_char}#{script.name} list               show current variables\n"
  output.concat "\n"
  respond output
end
