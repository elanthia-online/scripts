# frozen_string_literal: true

=begin
    Ebon Gate Fishing Script

      Fishes the Ebon Gate dock using the FISH CAST / FISH REEL fishing system.
      Casts, waits for a bite, reels the catch in, fillets it, and stores
      anything found inside to your lootsack.

      Requires your lootsack to be set for storing loot
      ;vars set lootsack=cloak

      ;TFISH BYPASS
      Fish right where you're standing instead of at Ebon Gate.

      ;TFISH LIST
      Show your current settings.

      ;TFISH CHECK
      Check that your pole, line, lures, weights and knife are found for your settings.

      ;TFISH HELP
      Show additional help.

         todo: none
       author: elanthia-online
 contributors: Tysong
         name: tfish
         tags: EG, Ebon Gate, fish, fishing
      version: 2.0.0
      website: https://github.com/elanthia-online/scripts/

    changelog:
        2.0.0 (2026-10-06)
            updated for the new fishing system (FISH CAST / FISH REEL, lures instead of bait)
            new option to choose cast distance, default far
            new ;tfish bypass to fish anywhere, not just at Ebon Gate
            new dock setting to pick which Ebon Gate dock to fish
            waits out overfished spots, then moves to another spot on the dock
            new ;tfish list to show your current settings
            fix: lure left at your feet after replacing a worn line
            new lure settings to use the best lure for each depth
            new ;tfish check to confirm your gear is found for your settings
            new lure setting, replaces the old bait setting
            weight cycling now off by default, no weight with a surface lure is best
            warns if your lure is better deep down while fishing with no weight
            script rewrite for reliability
        1.9.1 (2025-11-03)
            handle long description fishing poles, argh!
        1.9.0 (2024-10-10)
            add default option to trash fish
        1.8.7 (2024-10-07)
            bugfix for Ruby 3.x regex comparisons
        1.8.6 (2023-10-01)
            bugfix caught fish detection or bo longer in fishing room
        1.8.5 (2023-10-01)
            bugfix for long description weights, curse you!!
        1.8.4 (2023-10-01)
            Rubocop code cleanup
            Update default weights to current EG 2023 glass/glaes weights
        1.8.3 (2022-10-13)
            Toggle silence_me with UserVars.tfish[:debug_my_script]
        1.8.2 (2022-10-06)
            Update some regex matching
        1.8.1 (2022-10-06)
            Add additional container messaging
        1.8 (2022-10-05)
            Initial 2022 EG updates
        1.7 (2020-10-18)
            Add additional get messaging.
        1.6 (2020-10-13)
            Fix for supplies readout regex issue.
        1.5 (2020-10-13)
            Cleanup on weight cycling.
        1.4 (2020-10-13)
            Added some cleanup when killing script to store supplies
        1.3 (2020-10-13)
            Fixes for lure descriptions and other things, credit to Ziled
        1.2 (2019-10-17)
            Handling an issue where you attempt to GO PATHWAY but are prone, causing the script to exit
            Modifying the knife functionality to specify a specific container for the knife (variables: fillet_knife and knife_container)
        1.1 (2018-10-07)
            Updated UserVars to allow you to change weight descriptors
            Changed regex for 25->50 for seashell cost
        1.0 (2017-10-08)
            Initial Release, based on Taleph's 3.3.3 script.
=end

module TFish
  # Drop constants left by an earlier run this session so a restart loads the
  # current definitions without already-initialized warnings.
  %i[HELP_TEXT].each { |name| remove_const(name) if const_defined?(name, false) }

  # Every `UserVars.tfish` key the script reads, with defaults and accessors.
  module Config
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[DEFAULTS CAST_DISTANCES].each { |name| remove_const(name) if const_defined?(name, false) }

    # @return [Hash{Symbol => Object}] defaults applied to unset keys
    DEFAULTS = {
      pause_me: true,
      familiar_debug: false,
      debug_my_script: false,
      cast_total: 0,
      fish_total: 0,
      snap_total: 0,
      squelch_script: true,
      supplies_container: "cloak",
      supplies_lure: "lure",
      supplies_pole: "rod",
      supplies_line: "wire",
      fillet_knife: "dagger",
      knife_container: "cloak",
      cycle_weights: false,
      weight_noncycle: "",
      weight_depths: "blown glass weight",
      weight_bottom: "glaes weight",
      lure_surface: "",
      lure_middle: "",
      lure_deep: "",
      use_cman: false,
      supplies_minimum: 5,
      cast_timer: 60,
      cast_distance: "far",
      overfished_wait: 30,
      dock: 1,
      fav_room: 0,
      trash_cut: true,
    }.freeze

    # @return [Array<String>] valid FISH CAST distances
    CAST_DISTANCES = %w[near middle far].freeze

    module_function

    # Fills in unset `UserVars.tfish` keys. Idempotent.
    #
    # @return [Hash] the settings store
    def setup!
      UserVars.tfish ||= {}
      store = UserVars.tfish
      # Pre-2.0 tfish saved cycle_weights = true for everyone. The new system
      # levels fastest with a surface lure and no weight, so reset it once.
      store[:cycle_weights] = false unless store[:v2_settings]
      store[:v2_settings] = true
      DEFAULTS.each { |key, value| store[key] = value if store[key].nil? }
      store
    end

    # @return [Hash] the settings store
    def store = UserVars.tfish

    # @param key [Symbol]
    # @return [Object] the configured value
    def [](key) = store[key]

    # @return [String] cast distance, falling back to "far" if misconfigured
    def cast_distance
      distance = store[:cast_distance].to_s.downcase
      CAST_DISTANCES.include?(distance) ? distance : "far"
    end

    # @return [Boolean] whether a single constant weight is configured instead of cycling
    def constant_weight? = !store[:cycle_weights] && !store[:weight_noncycle].to_s.empty?

    # @return [String] every setting and its current value, flagging ones
    #   changed from the default
    def listing
      width = DEFAULTS.keys.map(&:length).max
      lines = DEFAULTS.map do |key, default|
        value = store[key]
        changed = value == default ? "" : "  (default #{default.inspect})"
        "  #{key.to_s.ljust(width)}  #{value.inspect}#{changed}"
      end
      ["tfish settings (change with ;e UserVars.tfish[:setting] = value):", *lines].join("\n")
    end
  end

  # Game messaging the script reacts to, and pure helpers that classify it.
  module Messages
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[HOOKED CAUGHT LOST EMPTY REEL_REPLY CAST_OK CAST_FAIL OVERFISHED AT_FEET WEIGHT INSPECT_ALERT GET_OK GET_FAIL DOCK_NO_SHARDS DOCK_CONFIRM].each { |name| remove_const(name) if const_defined?(name, false) }

    # A fish took the lure and the hook is set.
    HOOKED = /^You feel a brief jerk on your line before it begins to reel out wildly\./
    # The fish is landed and in hand. Captures the fish name.
    CAUGHT = /^You give your .+? one final tug and the (?<fish>.+?) comes wriggling to the surface!/
    # The line snapped: fighting a fish too long, or walking away from a cast
    # line ("You have strayed too far from where you were fishing.").
    LOST = /^The line of your .+? strains and breaks with a sharp \*SNAP\*!/
    # The line came back in with nothing on it (the fish got away, or nothing was hooked).
    EMPTY = Regexp.union(
      /^You reel the line of your .+? in\./,
      /^But the .+? is already reeled in!/,
    )
    # Every reel reply the reel loop waits on. Roundtime ends every reel that's still fighting.
    REEL_REPLY = Regexp.union(CAUGHT, LOST, EMPTY, /^Roundtime: \d+ sec\.$/)
    # FISH CAST worked, or a line was already out.
    CAST_OK = /\*WHOOSH!\*|^You've already cast the line/
    # FISH CAST failed.
    CAST_FAIL = /^You must be holding a fishing rod\.|^You can't cast without a free hand\./
    # FISH CAST refused because this spot needs time to recover.
    OVERFISHED = /^It looks like this area has been heavily overfished\./
    # Cutting the line drops whatever was on it at your feet, which blocks
    # walking until it's picked up. Captures the item's id (from the XML link)
    # and noun when present.
    AT_FEET = /Your (?:<a exist="(?<id>[^"]+)" noun="(?<noun>[^"]+)">)?(?<name>[^<]+?)(?:<\/a>)? falls to the ground at your feet\./
    # Weighing the pole (with a fish on) or a fish in hand.
    WEIGHT = /^You carefully examine the .+? and determine that the weight is about (?<pounds>[\d,]+) pounds\./
    # Fillet turned up something worth inspecting (T5+).
    INSPECT_ALERT = /probably deserves a close inspection/
    # GET succeeded.
    GET_OK = /^You (?:remove|already|grab|reach|retrieve)/
    # GET failed.
    GET_FAIL = /^Get what\?|^Hey, that doesn't|^That's almost certainly a bad idea/
    # Dock entry when you can't afford it.
    DOCK_NO_SHARDS = /You do not have enough soul shards to enter the dock/
    # Dock entry fee confirmation.
    DOCK_CONFIRM = /If you wish to pay the cost and continue, GO dock again/

    module_function

    # @param line [String, nil] a reel reply, nil if none arrived in time
    # @return [Symbol, nil] :caught, :lost, :empty, :reeling, or nil for no reply
    def reel_outcome(line)
      case line
      when nil then nil
      when CAUGHT then :caught
      when LOST then :lost
      when EMPTY then :empty
      else :reeling
      end
    end

    # @param line [String, nil]
    # @return [String, nil] the pounds figure from a WEIGHT reply
    def pounds(line) = line&.match(WEIGHT)&.[](:pounds)
  end

  # What's rigged on the pole, parsed from LOOK output.
  module Pole
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[State LOOK_START BONUS_DEPTHS].each { |name| remove_const(name) if const_defined?(name, false) }

    # @!attribute line [String, nil] line condition ("excellent", "decent",
    #   "showing signs of wear", "frayed and in danger of snapping soon"), nil if there is no line
    # @!attribute lure [String, nil] attached lure, nil if none
    # @!attribute weight [String, nil] strung weight or sinker, nil if none
    # @!attribute lure_bonus [Hash{Symbol => Integer}] lure bonus per depth
    #   (:surface, :middle, :deep), empty if no lure or not shown
    State = Data.define(:line, :lure, :weight, :lure_bonus) do
      def initialize(line:, lure:, weight:, lure_bonus: {}) = super

      # @return [Boolean] whether the line is about to snap and should be replaced
      def frayed? = line.to_s.include?("frayed")

      # @return [Symbol, nil] depth the lure attracts best at, nil if unknown
      def best_depth = lure_bonus.max_by { |_depth, bonus| bonus }&.first

      # @return [Boolean] whether the lure is at least as good at the surface
      #   as anywhere else (true when unknown, so nothing is flagged on a guess)
      def surface_lure? = lure_bonus.empty? || lure_bonus[:surface].to_i >= lure_bonus.values.max

      # @return [String, nil] noun of the strung weight ("weight", "sinker", ...)
      def weight_noun = weight&.split&.last
    end

    # First line of LOOK output for a pole, used to start capturing it.
    LOOK_START = /line|weight|lure|nothing unusual/i

    # Lure quality lines in LOOK output, mapped to depth.
    BONUS_DEPTHS = {
      "near the surface" => :surface,
      "at middle depths" => :middle,
      "in deep water"    => :deep,
    }.freeze

    module_function

    # @param text [String] LOOK output for the pole
    # @return [State]
    def parse(text)
      State.new(
        line: text[/The (?:line itself|\S+'s line) looks (?:to be )?(?:in )?(.+?)(?: condition)?\./, 1],
        lure: text[/^(?:An?|Some) (.+?) is currently attached near the hook/, 1],
        weight: text[/^(?:An?|Some) (.+?) is currently strung from the line of the .+? to serve as a weight\./, 1],
        lure_bonus: text.scan(/^\s*([+-]\d+) to attracting fish (#{BONUS_DEPTHS.keys.join('|')})/)
                        .to_h { |bonus, depth| [BONUS_DEPTHS[depth], bonus.to_i] },
      )
    end
  end

  # Weight rotation: surface, then middle depths, then bottom.
  module Weights
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[DEPTHS DEPTH_LURES].each { |name| remove_const(name) if const_defined?(name, false) }

    # Depth labels, in rotation order.
    DEPTHS = %w[Top Middle Bottom].freeze
    # Setting holding the lure to use at each depth.
    DEPTH_LURES = { "Top" => :lure_surface, "Middle" => :lure_middle, "Bottom" => :lure_deep }.freeze

    module_function

    # @param cast_index [Integer] 0-based cast count this session
    # @return [String] depth label for that cast
    def depth(cast_index) = DEPTHS[cast_index % DEPTHS.size]

    # @param cast_index [Integer] 0-based cast count this session
    # @return [String, nil] depth this cast fishes: rotating when cycling
    #   weights, the surface with no weight, unknown with a constant weight
    def fishing_depth(cast_index)
      return depth(cast_index) if Config[:cycle_weights]

      "Top" unless Config.constant_weight?
    end

    # @param depth [String, nil]
    # @return [String, nil] lure name (or part of it) set for that depth, nil if none
    def lure_for(depth)
      lure = Config[DEPTH_LURES[depth]].to_s if depth
      lure unless lure.nil? || lure.empty?
    end

    # @param cast_index [Integer] 0-based cast count this session
    # @return [String, nil] weight name to put on the pole, nil for no weight
    def for_cast(cast_index)
      case depth(cast_index)
      when "Middle" then Config[:weight_depths]
      when "Bottom" then Config[:weight_bottom]
      end
    end
  end

  # Checks the supplies container for enough line and weights.
  module Supplies
    module_function

    # Matches the way you'd refer to an item in game: every word given has to
    # start a word in its name, in any order ("grey lure" finds a "leaf-topped
    # grey mandrake lure", "skull lure" a "pale carved skull-shaped lure").
    #
    # @param name [String, nil] item name (GameObj#name)
    # @param wanted [String] words to look for
    # @return [Boolean]
    def named?(name, wanted)
      words = name.to_s.downcase.split
      wanted.to_s.downcase.split.all? { |part| words.any? { it.start_with?(part) } }
    end

    # @param contents [Array<#noun, #name>] supplies container contents
    # @return [Array<String>] one "item - have/need" line per missing supply, empty if stocked
    # Checks everything the current settings need, for `;tfish check`.
    #
    # @param supplies [Array<#noun, #name>] supplies container contents
    # @param knife_box [Array<#noun, #name>] knife container contents
    # @param pole [Pole::State, nil] what's rigged on the pole, nil if no pole
    # @return [Array<Array(Symbol, String)>] [:ok, :missing or :warn, description]
    def check(supplies, knife_box, pole)
      supplies = Array(supplies)
      count = ->(&match) { supplies.count(&match) }
      rows = []
      add = ->(ok, text, warn: false) { rows << [ok ? :ok : (warn ? :warn : :missing), text] }

      add.(pole, "Pole (#{Config[:supplies_pole]}) in your #{Config[:supplies_container]}")
      line_spares = count.() { named?(it.name, Config[:supplies_line]) }
      add.(line_spares.positive?, "Spare line (#{Config[:supplies_line]}): #{line_spares}")
      if pole
        line = pole.line || "none, will be restrung"
        line += ", will be cut and replaced before fishing" if pole.frayed?
        add.(!pole.frayed?, "Line on the pole: #{line}", warn: true)
      end
      add.(Array(knife_box).any? { named?(it.name, Config[:fillet_knife]) }, "Knife (#{Config[:fillet_knife]}) in your #{Config[:knife_container]}")

      default_lures = count.() { named?(it.name, Config[:supplies_lure]) }
      add.(pole&.lure || default_lures.positive?,
           "Lure: #{pole&.lure ? "#{pole.lure} on the pole" : 'none on the pole'}, #{default_lures} spare #{Config[:supplies_lure]}")

      minimum = Config[:supplies_minimum]
      if Config[:cycle_weights]
        [Config[:weight_depths], Config[:weight_bottom]].each do |weight|
          have = count.() { named?(it.name, weight) }
          add.(have >= minimum, "Weight #{weight}: #{have}/#{minimum}")
        end
      elsif Config.constant_weight?
        weight = "#{Config[:weight_noncycle]} weight"
        have = count.() { named?(it.name, weight) } + (named?(pole&.weight, weight) ? 1 : 0)
        add.(have >= minimum, "Weight #{weight}: #{have}/#{minimum}")
      elsif pole&.weight
        add.(true, "Weight: #{pole.weight} on the pole will come off (fishing the surface)")
      end

      depths = Config[:cycle_weights] ? Weights::DEPTHS : [Weights.fishing_depth(0)]
      depths.each do |depth|
        lure = Weights.lure_for(depth) or next
        found = supplies.find { named?(it.name, lure) }&.name || (pole&.lure if named?(pole&.lure, lure))
        add.(found, "#{depth} lure (#{lure}): #{found || 'not found'}")
      end

      if depths == ["Top"] && pole&.lure && !Weights.lure_for("Top") && !pole.surface_lure?
        add.(false, "#{pole.lure} is better at #{pole.best_depth} depth than the surface", warn: true)
      end
      rows
    end

    def shortages(contents)
      contents = Array(contents)
      minimum = Config[:supplies_minimum]
      needs = { "Fishing Line - #{Config[:supplies_line]}" => [contents.count { named?(it.name, Config[:supplies_line]) }, 1] }
      if Config[:cycle_weights]
        [Config[:weight_depths], Config[:weight_bottom]].each do |weight|
          needs[weight] = [contents.count { named?(it.name, weight) }, minimum]
        end
      elsif Config.constant_weight?
        weight = Config[:weight_noncycle]
        needs["Constant Weight - #{weight}"] = [contents.count { named?(it.name, "#{weight} weight") }, minimum]
      end
      depths = Config[:cycle_weights] ? Weights::DEPTHS : [Weights.fishing_depth(0)]
      depths.filter_map { Weights.lure_for(it) }.uniq.each do |lure|
        needs["Lure - #{lure}"] = [contents.count { named?(it.name, lure) }, 1]
      end
      needs.filter_map { |label, (have, need)| "#{label} - #{have}/#{need}" if have < need }
    end
  end

  # Ebon Gate docks and picking the least crowded spot on one.
  module Rooms
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[Dock DOCKS BOTS].each { |name| remove_const(name) if const_defined?(name, false) }

    # @!attribute name [String] dock name, from the fishing rooms' title
    # @!attribute entrance [Integer] room you GO DOCK from
    # @!attribute spots [Array<Integer>] fishing rooms on the dock
    Dock = Data.define(:name, :entrance, :spots) do
      def initialize(entrance:, spots:, name: "Custom") = super
      # @param room_id [Integer, nil]
      # @return [Boolean] whether the room is one of this dock's fishing spots
      def fishing?(room_id) = spots.include?(room_id)

      # @param room_id [Integer, nil]
      # @return [Boolean] whether the room is this dock's entrance or one of its spots
      def here?(room_id) = room_id == entrance || fishing?(room_id)

      # @param room_id [Integer, nil] current room
      # @return [Integer] the spot after this one, wrapping around (the first
      #   spot if the room isn't on this dock)
      def next_spot(room_id) = spots[((spots.index(room_id) || -1) + 1) % spots.size]
    end

    # Known Ebon Gate docks, selected with the `dock` setting. Numbered to
    # match the entrances' fishing/fishing2/fishing3/fishing4 map tags.
    DOCKS = {
      1 => Dock.new(name: "Stream of Reflections", entrance: 31834, spots: [32116, 32117, 32118].freeze),
      2 => Dock.new(name: "Misty Waters", entrance: 31846, spots: [32126, 32127, 32128].freeze),
      3 => Dock.new(name: "Mold Marsh", entrance: 32074, spots: [32120, 32121, 32122].freeze),
      4 => Dock.new(name: "Moss Pond", entrance: 32073, spots: [32123, 32124, 32125].freeze),
    }.freeze

    # Bots that don't count toward a room being crowded.
    BOTS = /Fishmon|Ilten/

    module_function

    # @param setting [Integer, String, Hash] a DOCKS number, part of a dock's
    #   name ("moss"), or a custom `{ entrance: id, spots: [id, ...] }`
    # @return [Dock] the configured dock, dock 1 if it isn't recognized
    def dock(setting = Config[:dock])
      return Dock.new(entrance: setting[:entrance].to_i, spots: Array(setting[:spots]).map(&:to_i)) if setting.is_a?(Hash)
      return DOCKS.fetch(setting.to_i, DOCKS[1]) if setting.to_s.match?(/\A\d+\z/)

      wanted = setting.to_s.strip.downcase
      (DOCKS.values.find { it.name.downcase.include?(wanted) } unless wanted.empty?) || DOCKS[1]
    end

    # @param room_id [Integer, nil]
    # @return [Dock, nil] the known dock this room belongs to, if any
    def dock_at(room_id) = DOCKS.values.find { it.here?(room_id) }

    # @param pcs [Array<#noun>, nil] players in a room
    # @return [Integer] players that aren't fishing bots
    def crowd(pcs) = Array(pcs).count { it.noun !~ BOTS }

    # @param counts [Hash{Integer => Integer}] room id => crowd
    # @return [Integer] the least crowded room id (first wins on ties)
    def least_crowded(counts) = counts.min_by { |_room, count| count }.first
  end

  HELP_TEXT = <<~HELP
    SYNTAX - ;tfish            fish the Ebon Gate dock
             ;tfish bypass     fish right where you're standing (no Ebon Gate travel, dock fee or squelching)
             ;tfish list       show your current settings
             ;tfish check      check your gear is found for the fishing your settings describe

      Does NOT automatically sell. Empty your containers by selling/lockering yourself.

      Requires your lootsack to be set for storing loot
      ;vars set lootsack=cloak

      Settings are changed with ;e UserVars.tfish[:setting] = value

      Setting              Default               Description
      pause_me             true                  pause the script after each catch
      familiar_debug       false                 send catch stats to the familiar window
      debug_my_script      false                 verbose log for diagnosing fishing: shows script commands,
                                                 timestamped cast/hook/reel lines, FISH STATUS/TOTAL, and
                                                 LOOKs at the pole after casting, each minute waiting, at
                                                 the hook, every 5 reels and when the fish is landed/lost
      squelch_script       true                  run ;tsquelch to hide other fishers' spam
      trash_cut            true                  trash the fillet after cutting the fish
      supplies_container   "cloak"               container holding pole, lure, line and weights
      supplies_minimum     5                     minimum weights needed to keep fishing
      supplies_pole        "rod"                 noun of your fishing pole
      supplies_lure        "lure"                noun of your fishing lure (lure, squid, ...)
      supplies_line        "wire"                noun of your fishing line
      fillet_knife         "dagger"              noun of your fillet knife
      knife_container      "cloak"               container holding your knife
      cast_distance        "far"                 near, middle or far
      cast_timer           60                    seconds per castbar refresh while waiting for a bite
      overfished_wait      30                    seconds to wait before recasting when a spot is overfished,
                                                 then the next spot on the dock is tried
      use_cman             false                 use CMAN SURGE before reeling
      cycle_weights        false                 rotate no weight / depths weight / bottom weight
                                                 (no weight + a surface lure levels fastest and wears line least)
      weight_depths        "blown glass weight"  weight used for middle depths
      weight_bottom        "glaes weight"        weight used for the bottom
      lure_surface         ""                    lure for surface fishing (e.g. "grey lure"), "" uses supplies_lure
      lure_middle          ""                    lure for middle depths, used when cycling weights (e.g. "skull lure")
      lure_deep            ""                    lure for the bottom, used when cycling weights (e.g. "ebon gate lure")
      weight_noncycle      ""                    constant weight descriptor (needs cycle_weights false)
      dock                 1                     which dock to fish (number or name), if you're not already at one:
                                                 1 Stream of Reflections - entrance 31834
                                                 2 Misty Waters          - entrance 31846
                                                 3 Mold Marsh            - entrance 32074
                                                 4 Moss Pond             - entrance 32073
                                                 or a dock not listed: { entrance: 12345, spots: [12346, 12347] }
      fav_room             0                     0 picks the least crowded spot on the dock, or a spot's room number
                                                 (dock 1: 32117 Main Entrance, 32118 Northwest, 32116 Southeast)
  HELP

  # Drives the fishing loop against the live game.
  class Runner
    # @param bypass [Boolean] fish the current room, skipping Ebon Gate travel and dock entry
    def initialize(bypass: false)
      @bypass = bypass
      @home_room = Room.current.id
      # Already at a dock? Fish that one; otherwise the configured one.
      @dock = Rooms.dock_at(@home_room) || Rooms.dock
      @cast_index = 0
      @pole = nil
      @weight_noun = nil
      multifput "fish status", "fish total" if Config[:debug_my_script] # level, perks and tallies, for the log
    end

    # Main loop: restock check, travel, rig, fish, process the catch, repeat.
    #
    # @return [void]
    def run
      loop do
        check_supplies!
        travel_to_ebon_gate! unless @bypass
        @pole = fetch_pole!
        rig_pole!
        enter_dock! unless @bypass || @dock.fishing?(Room.current.id)

        case fish
        when :caught
          process_catch
          pause_script if Config[:pause_me]
        when :lost
          Config.store[:snap_total] += 1
          familiar("*SNAP*")
          waitrt?
          stow_pole
        else
          stow_pole
        end
      end
    end

    private

    def container = Config[:supplies_container]

    def familiar(message)
      return unless Config[:familiar_debug]

      Lich::Messaging.stream_window("#{Time.now.strftime('%H:%M:%S')} - #{message}", "familiar")
    end

    # Timestamped, so the log shows how long each part of a fight takes.
    def debug(message)
      echo("#{Time.now.strftime('%H:%M:%S')} #{message}") if Config[:debug_my_script]
    end

    # Debug only: LOOK at the pole so the log shows the line's distance,
    # depth and condition at this point.
    def debug_look(label)
      return unless Config[:debug_my_script]

      debug(label)
      fput "look ##{@pole.id}"
    end

    def fail!(*lines)
      lines.each { Lich::Messaging.msg("error", it) }
      exit
    end

    def supplies_contents
      GameObj[container]&.contents || []
    end

    # Gear settings are names the way you'd describe the item ("grey mandrake
    # lure"), which the game won't always accept in a command, so gear is
    # found in the container and always fetched by #id.
    #
    # @param wanted [String] gear setting (pole, line, lure, knife name)
    # @param from [String] container noun
    # @return [GameObj, nil] the item now in hand, nil if none matched
    def get_gear(wanted, from: container, refreshed: false)
      item = (GameObj[from]&.contents || []).find { Supplies.named?(it.name, wanted) }
      line = dothistimeout("get ##{item.id} from my #{from}", 2, Regexp.union(Messages::GET_OK, Messages::GET_FAIL)) if item
      return item if line =~ Messages::GET_OK
      return if refreshed

      # Lich's view of the container can be stale; look again and retry once.
      fput "look in my #{from}"
      pause 0.5
      get_gear(wanted, from:, refreshed: true)
    end

    def check_supplies!
      shortages = Supplies.shortages(supplies_contents)
      return if shortages.empty?

      fail!("YOU NEED MORE SUPPLIES!", *shortages)
    end

    def travel_to_ebon_gate!
      Script.run("go2", @dock.entrance.to_s) unless @dock.here?(Room.current.id)
      return if @dock.here?(Room.current.id)

      fail!("You aren't at Ebon Gate, you should probably travel there first before running this")
    end

    # @return [GameObj] the pole, now in hand
    def fetch_pole!
      pole = get_gear(Config[:supplies_pole])
      return pole if pole

      fail!(
        "CAN'T FIND YOUR FISHING POLE, CHECK THAT YOU HAVE THE FOLLOWING:",
        "   Fishing Pole: #{Config[:supplies_pole]}",
        "   Supplies Container: #{container}",
        "Set them with:",
        "   ;e UserVars.tfish[:supplies_pole] = \"pole\"",
        "   ;e UserVars.tfish[:supplies_container] = \"cloak\"",
      )
    end

    # @return [Pole::State]
    def look_pole
      lines = Lich::Util.issue_command("look ##{@pole.id}", Pole::LOOK_START, usexml: false, quiet: !Config[:debug_my_script])
      fail!("Couldn't read your fishing pole's description.") if lines.empty?
      Pole.parse(lines.join("\n"))
    end

    # Restrings, attaches a lure and sets the weight as needed.
    def rig_pole!
      state = look_pole
      if state.line.nil? || state.frayed?
        restring(cut_old: !state.line.nil?)
        state = look_pole
      end
      @lure_name = state.lure || attach_lure

      @weight_noun = state.weight_noun
      if state.weight && (!Config.constant_weight? || !Supplies.named?(state.weight, Config[:weight_noncycle]))
        remove_weight
        state = state.with(weight: nil)
      end
      put_weight_on("#{Config[:weight_noncycle]} weight") if Config.constant_weight? && state.weight.nil?
      warn_deep_lure(state)
      debug("Pole: #{state.inspect}")
    end

    # Warns once per run when fishing the surface (no weight) with a lure
    # that's better deeper down.
    def warn_deep_lure(state)
      return if @lure_warned || Config[:cycle_weights] || Config.constant_weight? || Weights.lure_for("Top")
      return if state.lure.nil? || state.surface_lure?

      @lure_warned = true
      best = state.best_depth
      Lich::Messaging.msg("warn", "Your #{state.lure} is best #{Pole::BONUS_DEPTHS.key(best)} (+#{state.lure_bonus[best]}) " \
                                  "but you're fishing the surface with no weight (+#{state.lure_bonus[:surface]}). " \
                                  "A surface lure levels faster and wears your line less.")
    end

    # PULL on the spool snaps a length of line off into the other hand; that
    # piece goes on the pole and the spool goes back in the container.
    #
    # @param cut_old [Boolean] cut off the worn line already on the pole first
    def restring(cut_old: false)
      cut_line if cut_old
      fput "put ##{@pole.id} in my #{container}"
      spool = get_gear(Config[:supplies_line])
      fail!("Couldn't find your #{Config[:supplies_line]} in your #{container}.") unless spool
      fput "pull ##{spool.id}"
      piece = held_besides(spool.id, @pole.id)
      fail!("Pulling your #{Config[:supplies_line]} didn't give a length of line.") unless piece
      fput "put ##{spool.id} in my #{container}"
      fput "put ##{piece.id} on ##{@pole.id}"
      fput "get ##{@pole.id}"
    end

    # Cuts the worn line off the pole. Anything that was on it (the lure, a
    # weight) drops at your feet, so pick it up and put it back with the
    # supplies; rigging the pole puts it back on afterwards.
    def cut_line
      lines = Lich::Util.issue_command("cut ##{@pole.id}", /snap the line/, usexml: true, quiet: !Config[:debug_my_script])
      waitrt?
      lines.join("\n").scan(Messages::AT_FEET) do
        drop = Regexp.last_match
        item = drop[:id] ? "##{drop[:id]}" : (drop[:noun] || drop[:name].split.last)
        fput "get #{item}"
        fput "put #{drop[:id] ? item : "my #{item}"} in my #{container}"
      end
    end

    # @return [String, nil] name of the lure attached
    def attach_lure
      lure = get_gear(Config[:supplies_lure])
      unless lure
        stow_pole
        fail!(
          "You ran out of lures or have the wrong lure set for your character.",
          "Set your lure with: ;e UserVars.tfish[:supplies_lure] = \"grey lure\"",
        )
      end
      fput "put ##{lure.id} on ##{@pole.id}"
      lure.name
    end

    def remove_weight
      return unless @weight_noun

      fput "get #{@weight_noun} from ##{@pole.id}"
      fput "put my #{@weight_noun} in my #{container}"
      @weight_noun = nil
    end

    # @param name [String] weight name (or descriptor) to fetch from the container
    def put_weight_on(name)
      weight = supplies_contents.find { Supplies.named?(it.name, name) }
      fail!("Couldn't find a #{name} in your #{container}.") unless weight
      fput "get ##{weight.id} from my #{container}"
      fput "put ##{weight.id} on ##{@pole.id}"
      @weight_noun = weight.noun
    end

    def cycle_weight
      return unless Config[:cycle_weights]

      remove_weight
      weight = Weights.for_cast(@cast_index)
      put_weight_on(weight) if weight
    end

    # Swaps in the lure set for this depth (lure_surface/middle/deep), if one
    # is set and it isn't already on the pole.
    #
    # @param depth [String, nil]
    def match_lure(depth)
      wanted = Weights.lure_for(depth)
      return if wanted.nil? || Supplies.named?(@lure_name, wanted)

      lure = supplies_contents.find { Supplies.named?(it.name, wanted) }
      fail!("Couldn't find a #{wanted} in your #{container} for #{depth.downcase} fishing.") unless lure
      if @lure_name
        noun = @lure_name.split.last
        fput "get #{noun} from ##{@pole.id}"
        fput "put my #{noun} in my #{container}"
      end
      fput "get ##{lure.id} from my #{container}"
      fput "put ##{lure.id} on ##{@pole.id}"
      @lure_name = lure.name
      debug("Lure for #{depth}: #{lure.name}")
    end

    # Casts, lets the line sit until a bite, then reels until it resolves.
    #
    # @return [Symbol] :caught, :lost (snapped), :empty (got away) or :left (walked off the dock)
    def fish
      waitrt?
      cycle_weight
      depth = Weights.fishing_depth(@cast_index)
      match_lure(depth)
      @cast_index += 1
      Config.store[:cast_total] += 1
      cast!
      debug_look("Cast #{Config.cast_distance} in room #{Room.current.id}")

      return :left unless wait_for_bite

      @hooked_at = Time.now
      debug_look("Hooked")

      waitrt?
      pounds = Messages.pounds(dothistimeout("weigh ##{@pole.id}", 2, Messages::WEIGHT))
      if pounds
        echo "Fish Weight: #{pounds}"
        familiar("#{depth || "Weighted"} - Fish Weight: #{pounds}")
      end

      waitrt?
      CMan.use("surge_of_strength") if Config[:use_cman] && !Effects::Buffs.active?("Surge of Strength")
      reel
    end

    # Casts the line. If the spot is overfished, waits and tries again, then
    # moves on to the next spot on the dock (in bypass mode it just keeps waiting).
    def cast!
      waited = false
      loop do
        waitrt?
        reply = dothistimeout("fish cast #{Config.cast_distance}", 3, Regexp.union(Messages::CAST_OK, Messages::CAST_FAIL, Messages::OVERFISHED))
        case reply
        when Messages::CAST_OK
          return
        when Messages::OVERFISHED
          if waited && !@bypass
            spot = @dock.next_spot(Room.current.id)
            Lich::Messaging.msg("warn", "Still overfished, moving to the next fishing spot (#{spot}).")
            Script.run("go2", spot.to_s)
            waited = false
          else
            Lich::Messaging.msg("warn", "This spot is overfished, waiting #{Config[:overfished_wait]} seconds before casting again.")
            pause Config[:overfished_wait]
            waited = true
          end
        else
          fail!("Couldn't cast: #{reply || 'no reply'}")
        end
      end
    end

    # @return [Boolean] whether we're still where we should be fishing
    def on_fishing_spot?
      @bypass ? Room.current.id == @home_room : @dock.fishing?(Room.current.id)
    end

    # @return [Boolean] true once hooked, false if we left the fishing spot
    def wait_for_bite
      loop do
        _respond "<castTime value='#{Time.now.to_i - XMLData.server_time_offset + Config[:cast_timer]}'/>"
        hooked = matchtimeout(Config[:cast_timer], Messages::HOOKED)
        _respond "<castTime value='#{Time.now.to_i - XMLData.server_time_offset}'/>" if hooked
        return true if hooked
        return false unless on_fishing_spot?

        debug_look("Still waiting for a bite")
      end
    end

    # Reels until the fish is landed, snaps the line, or gets away (the line
    # comes back empty). No reply at all three times in a row counts as away.
    #
    # @return [Symbol] :caught, :lost or :empty
    def reel
      reels = 0
      silent = 0
      loop do
        waitrt?
        outcome = Messages.reel_outcome(dothistimeout("fish reel", 5, Messages::REEL_REPLY))
        reels += 1
        outcome = :caught if catch_in_hand
        debug("Reel #{reels}: #{outcome || 'no reply'}")
        case outcome
        when :caught, :lost, :empty
          debug_look("#{outcome.to_s.capitalize} after #{reels} reels, #{(Time.now - @hooked_at).round}s on the line")
          fput "fish total" if Config[:debug_my_script]
          familiar("Reels: #{reels}") if outcome == :caught
          return outcome
        when nil
          silent += 1
          return :empty if silent >= 3
        else
          silent = 0
          debug_look("Line check after #{reels} reels") if (reels % 5).zero?
        end
      end
    end

    # @return [GameObj, nil] whatever is in hand that isn't the pole
    def catch_in_hand
      TFish.hands.find { it.id != @pole&.id }
    end

    # What's in hand besides the given items. Lich updates hands a moment
    # after the game's reply, so this checks again for up to `wait` seconds.
    #
    # @param ids [Array<String, nil>] ids of items to ignore
    # @return [GameObj, nil]
    def held_besides(*ids, wait: 2)
      deadline = Time.now + wait
      loop do
        item = TFish.hands.find { !ids.include?(it.id) }
        return item if item || Time.now > deadline

        sleep 0.1
      end
    end

    def stow_pole
      waitrt?
      fput "put ##{@pole.id} in my #{container}" if TFish.hands.any? { it.id == @pole&.id }
    end

    # Weighs, fillets and stores the catch and anything found inside it.
    def process_catch
      pause 1
      waitrt?
      fish = catch_in_hand
      Config.store[:fish_total] += 1
      stow_pole

      pounds = Messages.pounds(dothistimeout("weigh ##{fish.id}", 2, Messages::WEIGHT))
      waitrt?
      knife = get_gear(Config[:fillet_knife], from: Config[:knife_container])
      line = dothistimeout(knife ? "cut ##{fish.id} with ##{knife.id}" : "cut ##{fish.id}", 2, Regexp.union(/^Roundtime: \d+ sec\./, Messages::INSPECT_ALERT))
      if line =~ Messages::INSPECT_ALERT
        3.times { Lich::Messaging.msg("error", "POSSIBLE T5+ FOUND, LOOK AT ME!") }
        pause_script
      end
      pause 1
      waitrt?

      trashed = Config[:trash_cut] ? trash_fillets : []
      fput "put ##{knife.id} in my #{Config[:knife_container]}" if knife

      # Hands can still list the knife for a moment after it's put away.
      found = held_besides(knife&.id, @pole&.id, *trashed, wait: 1)
      if found
        multifput "analyze ##{found.id}", "inspect ##{found.id}", "look at ##{found.id}", "look in ##{found.id}"
        fput "put ##{found.id} in my #{Vars.lootsack}"
      end
      familiar("#{Config[:fish_total]}/#{Config[:cast_total]} - #{fish.name}(#{found&.name}) - #{pounds}#s")
    end

    # @return [Array<String>] ids of what was trashed
    def trash_fillets
      fillets = TFish.hands.select { it.name =~ /fillet/ } + Array(GameObj.loot).select { it.noun == "fish" }
      fillets.each { fput "trash ##{it.id}" }
      fillets.map(&:id)
    end

    def enter_dock!
      fput "stand" until standing? || checkdead
      exit if checkdead

      line = dothistimeout("go dock", 2, Regexp.union(Messages::DOCK_NO_SHARDS, Messages::DOCK_CONFIRM))
      case line
      when Messages::DOCK_NO_SHARDS
        stow_pole
        fail!("You need to redeem more soul shards!")
      when Messages::DOCK_CONFIRM
        fput "go dock"
      else
        fail!("Couldn't get onto the dock. Unexpected reply: #{line.inspect}")
      end

      room = Config[:fav_room].to_i
      unless @dock.fishing?(room)
        counts = @dock.spots.to_h do |id|
          Script.run("go2", id.to_s)
          [id, Rooms.crowd(GameObj.pcs)]
        end
        room = Rooms.least_crowded(counts)
      end
      Script.run("go2", room.to_s)
    end
  end

  module_function

  # @return [Array<GameObj>] items currently held, empty hands excluded
  def hands = [GameObj.right_hand, GameObj.left_hand].compact.select(&:id)

  # `;tfish check`: looks in the containers and at the pole, then reports
  # whether everything the current settings need was found.
  #
  # @return [void]
  def check_setup
    containers = [Config[:supplies_container], Config[:knife_container]].uniq
    containers.each { fput "look in my #{it}" }
    pause 0.5
    supplies = GameObj[Config[:supplies_container]]&.contents || []
    knife_box = GameObj[Config[:knife_container]]&.contents || []
    pole = supplies.find { Supplies.named?(it.name, Config[:supplies_pole]) }
    state = (Pole.parse(Lich::Util.issue_command("look ##{pole.id}", Pole::LOOK_START, usexml: false, quiet: true).join("\n")) if pole)

    rows = Supplies.check(supplies, knife_box, state)
    rows << [Vars.lootsack.to_s.empty? ? :missing : :ok, "Lootsack: #{Vars.lootsack.to_s.empty? ? 'not set (;vars set lootsack=...)' : Vars.lootsack}"]
    rows << [Script.exists?("tsquelch.lic") ? :ok : :missing, "Squelching needs ;tsquelch installed"] if Config[:squelch_script]
    mode = if Config[:cycle_weights] then "cycling weights (top, middle, bottom)"
           elsif Config.constant_weight? then "constant #{Config[:weight_noncycle]} weight"
           else "surface, no weight"
           end
    dock = Rooms.dock

    labels = { ok: "  OK  ", missing: "MISSING", warn: " WARN " }
    Lich::Messaging.mono(<<~CHECK)
      tfish check: #{mode}, cast #{Config.cast_distance}, dock #{dock.name}
      #{rows.map { |status, text| "  [#{labels[status]}] #{text}" }.join("\n")}
      #{rows.any? { it.first == :missing } ? 'Fix the MISSING items before fishing (;tfish list shows your settings).' : 'Everything needed was found.'}
    CHECK
  end

  # Script entry point.
  #
  # @return [void]
  def start
    Config.setup!
    arg = Script.current.vars[1]&.downcase
    if arg == "help"
      respond "\n#{HELP_TEXT}"
      return
    end
    if arg == "list"
      Lich::Messaging.mono(Config.listing)
      return
    end
    if arg == "check"
      check_setup
      return
    end
    bypass = arg == "bypass"

    silence_me unless Config[:debug_my_script]
    if hands.any?
      Lich::Messaging.msg("error", "Please empty your hands before running this script.")
      return
    end
    if Vars.lootsack.to_s.empty?
      Lich::Messaging.msg("error", "Set your lootsack first: ;vars set lootsack=cloak")
      return
    end
    # ;tsquelch only knows Ebon Gate's fishing rooms
    return unless bypass || start_squelch

    register_shutdown_hook
    # So Lich knows what's in them, for fetching gear by #id.
    [Config[:supplies_container], Config[:knife_container]].uniq.each { fput "look in my #{it}" }
    pause 0.5
    Runner.new(bypass:).run
  end

  # Starts ;tsquelch if enabled and not already running.
  #
  # @return [Boolean] false if squelching is enabled but tsquelch isn't installed
  def start_squelch
    return true unless Config[:squelch_script]

    unless Script.exists?("tsquelch.lic")
      Lich::Messaging.msg("error", "You need ;tsquelch to squelch. Either ;repo download tsquelch, or disable it with ;e UserVars.tfish[:squelch_script] = false")
      return false
    end
    @started_squelch = !Script.running?("tsquelch")
    Script.start("tsquelch") if @started_squelch
    true
  end

  # Stops ;tsquelch if we started it, and stores fishing gear left in hand.
  #
  # @return [void]
  def register_shutdown_hook
    before_dying do
      Script.kill("tsquelch") if @started_squelch && Script.running?("tsquelch")
      gear = {
        Config[:supplies_pole] => Config[:supplies_container],
        "weight"               => Config[:supplies_container],
        Config[:supplies_lure] => Config[:supplies_container],
        Config[:supplies_line] => Config[:supplies_container],
        Config[:fillet_knife]  => Config[:knife_container],
      }
      hands.each do |item|
        destination = gear.find { |wanted, _| Supplies.named?(item.name, wanted) }&.last
        fput "put ##{item.id} in my #{destination}" if destination
      end
    end
  end
end

TFish.start
