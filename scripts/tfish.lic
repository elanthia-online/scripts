# frozen_string_literal: true

=begin
    Ebon Gate Fishing Script

      Fishes the Ebon Gate dock using the FISH CAST / FISH REEL fishing system.
      Casts, waits for a bite, reels the catch in, fillets it, and stores
      anything found inside to your lootsack.

      Requires your lootsack to be set for storing loot
      ;vars set lootsack=cloak

      ;TFISH LIST
      Show your current settings.

      ;TFISH CHECK
      Check that your pole, line, lures, weights and knife are found for your settings.

      ;TFISH SETUP
      Change your settings in a window.

      TOGGLETFISH
      While tfish is fishing, turn pausing after each catch on or off.

      ;TFISH HELP
      Show additional help.

         todo: none
       author: elanthia-online
 contributors: Tysong
         name: tfish
         tags: EG, Ebon Gate, fish, fishing
      version: 2.2.0
      website: https://github.com/elanthia-online/scripts/

    changelog:
        2.2.0 (2026-10-14)
            supports the Super-Fish-All Tackle Box as your supplies container
            fix: a fillet knife was trashed along with the fillet
            no longer weighs the pole when a fish bites, so reeling starts right away
        2.1.0 (2026-10-14)
            new ;tfish setup window
            pick which depths and cast distances to fish, with a lure for each depth
            bypass is now a setting instead of ;tfish bypass
            type toggletfish while fishing to turn pausing on or off
            minimum supplies now counts lures too
            removed CMAN SURGE, since Strength no longer affects fishing
        2.0.0 (2026-10-06)
            updated for the new fishing system (cast, reel, lures)
            choose your cast distance and which Ebon Gate dock to fish
            fish anywhere with bypass
            new ;tfish list and ;tfish check
            shows what you find in each fish and its rarity
            replaces worn lines before they snap
            fix: gear left at your feet after cutting a line
=end
=begin
        1.9.1 (2025-11-03)
            handle long description fishing poles, argh!
        1.9.0 (2024-10-10)
            add default option to trash fish
        1.8.7 (2024-10-07)
            bugfix for Ruby 3.x regex comparisons
        1.8.6 (2023-10-01)
            bugfix caught fish detection or bo longer in fishing room
        1.8.5 (2023-10-01)
            bugfix for long description weights, curse you!!
        1.8.4 (2023-10-01)
            Rubocop code cleanup
            Update default weights to current EG 2023 glass/glaes weights
        1.8.3 (2022-10-13)
            Toggle silence_me with UserVars.tfish[:debug_my_script]
        1.8.2 (2022-10-06)
            Update some regex matching
        1.8.1 (2022-10-06)
            Add additional container messaging
        1.8 (2022-10-05)
            Initial 2022 EG updates
        1.7 (2020-10-18)
            Add additional get messaging.
        1.6 (2020-10-13)
            Fix for supplies readout regex issue.
        1.5 (2020-10-13)
            Cleanup on weight cycling.
        1.4 (2020-10-13)
            Added some cleanup when killing script to store supplies
        1.3 (2020-10-13)
            Fixes for lure descriptions and other things, credit to Ziled
        1.2 (2019-10-17)
            Handling an issue where you attempt to GO PATHWAY but are prone, causing the script to exit
            Modifying the knife functionality to specify a specific container for the knife (variables: fillet_knife and knife_container)
        1.1 (2018-10-07)
            Updated UserVars to allow you to change weight descriptors
            Changed regex for 25->50 for seashell cost
        1.0 (2017-10-08)
            Initial Release, based on Taleph's 3.3.3 script.
=end

module TFish
  # Drop constants left by an earlier run this session so a restart loads the
  # current definitions without already-initialized warnings.
  %i[HELP_TEXT].each { |name| remove_const(name) if const_defined?(name, false) }

  # Every `UserVars.tfish` key the script reads, with defaults and accessors.
  module Config
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[DEFAULTS CAST_DISTANCES OLD_KEYS].each { |name| remove_const(name) if const_defined?(name, false) }

    # @return [Hash{Symbol => Object}] defaults applied to unset keys
    DEFAULTS = {
      pause_me: true,
      familiar_debug: false,
      announce_finds: false,
      debug_my_script: false,
      cast_total: 0,
      fish_total: 0,
      snap_total: 0,
      squelch_script: true,
      supplies_container: "cloak",
      tackle_box: false,
      supplies_pole: "rod",
      supplies_line: "wire",
      fillet_knife: "dagger",
      knife_container: "cloak",
      depths: %w[surface],
      lure_surface: "lure",
      lure_middle: "lure",
      lure_bottom: "lure",
      weight_middle: "blown glass weight",
      weight_bottom: "glaes weight",
      distances: %w[far],
      supplies_minimum: 5,
      cast_timer: 60,
      overfished_wait: 30,
      fishing_mode: "ebon_gate",
      dock: 1,
      fav_room: 0,
      trash_cut: true,
      replace_line_at: "frayed",
    }.freeze

    # @return [Array<String>] valid FISH CAST distances, in rotation order
    CAST_DISTANCES = %w[near middle far].freeze

    # Settings from before 2.1, replaced by depths, distances and a lure and
    # weight per depth, plus use_cman (Strength no longer affects fishing).
    # migrate! carries them over once.
    OLD_KEYS = %i[supplies_lure cycle_weights weight_noncycle weight_depths lure_deep cast_distance cycle_distance use_cman].freeze

    module_function

    # Fills in unset `UserVars.tfish` keys, carrying pre-2.1 settings over
    # first. Idempotent.
    #
    # @return [Array<String>] notes for the player about carried-over settings
    def setup!
      UserVars.tfish ||= {}
      store = UserVars.tfish
      # Pre-2.0 tfish saved cycle_weights = true for everyone. The new system
      # levels fastest with a surface lure and no weight, so reset it once.
      store[:cycle_weights] = false if !store[:v2_settings] && store.key?(:cycle_weights)
      store[:v2_settings] = true
      notes = migrate!(store)
      DEFAULTS.each { |key, value| store[key] = value if store[key].nil? }
      notes
    end

    # Carries pre-2.1 settings over to depths, distances and a lure and weight
    # per depth, then removes them.
    #
    # @param store [Hash] UserVars.tfish
    # @return [Array<String>] notes for the player, empty if nothing needed one
    def migrate!(store)
      return [] unless OLD_KEYS.any? { store.key?(it) }

      notes = []
      lure = store[:supplies_lure].to_s.strip
      lure = "lure" if lure.empty?
      store[:weight_middle] = store[:weight_depths] if store[:weight_middle].to_s.strip.empty? && !store[:weight_depths].to_s.strip.empty?
      store[:lure_bottom] = store[:lure_deep] if store[:lure_bottom].to_s.strip.empty?
      %i[lure_surface lure_middle lure_bottom].each { store[it] = lure if store[it].to_s.strip.empty? }

      constant = store[:weight_noncycle].to_s.strip
      store[:depths] ||=
        if store[:cycle_weights] then Weights::DEPTHS.dup
        elsif constant.empty? then %w[surface]
        elsif Supplies.named?(store[:weight_bottom] || DEFAULTS[:weight_bottom], constant) then %w[bottom]
        elsif Supplies.named?(store[:weight_middle] || DEFAULTS[:weight_middle], constant) then %w[middle]
        else
          store[:weight_bottom] = "#{constant} weight"
          notes << "Your constant #{constant} weight is now the bottom weight. Run ;tfish check to confirm it sinks to the bottom."
          %w[bottom]
        end
      distance = store[:cast_distance].to_s.downcase
      store[:distances] ||= store[:cycle_distance] ? CAST_DISTANCES.dup : [CAST_DISTANCES.include?(distance) ? distance : "far"]

      OLD_KEYS.each { store.delete(it) }
      notes << "tfish settings updated for 2.1: depths #{store[:depths].join('/')}, cast #{store[:distances].join('/')}. ;tfish list shows them all."
    end

    # @return [Hash] the settings store
    def store = UserVars.tfish

    # @param key [Symbol]
    # @return [Object] the configured value
    def [](key) = store[key]

    # The values of a list setting that are allowed, in rotation order. Takes
    # an Array or words in a String, so ;e UserVars.tfish[:depths] = "surface middle" works too.
    #
    # @param value [Array, String, nil]
    # @param allowed [Array<String>]
    # @param fallback [String] used when nothing allowed is given
    # @return [Array<String>]
    def pick(value, allowed, fallback)
      wanted = Array(value).flat_map { it.to_s.downcase.split(/[\s,]+/) }
      picked = allowed & wanted
      picked.empty? ? [fallback] : picked
    end

    # @param from [Hash] settings store
    # @return [Array<String>] depths to fish, in rotation order
    def depths(from = store) = pick(from[:depths], Weights::DEPTHS, "surface")

    # @param from [Hash] settings store
    # @return [Array<String>] cast distances, in rotation order
    def distances(from = store) = pick(from[:distances], CAST_DISTANCES, "far")

    # Each distance is held for a full rotation of the depths, so every
    # distance and depth pair comes up.
    #
    # @param cast_index [Integer] 0-based cast count this session
    # @return [String] distance for that cast
    def cast_distance_for(cast_index) = distances[(cast_index / depths.size) % distances.size]

    # @return [Boolean] whether fishing_mode is bypass: fish where you stand, not at Ebon Gate
    def bypass? = store[:fishing_mode].to_s == "bypass"

    # @return [String] every setting and its current value, flagging ones
    #   changed from the default
    def listing
      width = DEFAULTS.keys.map(&:length).max
      lines = DEFAULTS.map do |key, default|
        value = store[key]
        changed = value == default ? "" : "  (default #{default.inspect})"
        "  #{key.to_s.ljust(width)}  #{value.inspect}#{changed}"
      end
      ["tfish settings (change with ;tfish setup, or ;e UserVars.tfish[:setting] = value):", *lines].join("\n")
    end
  end

  # Game messaging the script reacts to, and pure helpers that classify it.
  module Messages
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[HOOKED FISH_ON BITE_WAIT CAUGHT LOST EMPTY REEL_REPLY CAST_OK CAST_FAIL OVERFISHED AT_FEET ITEM_LINK CUT_REPLY RESTRUNG RESTRING_REPLY WEIGHT INSPECT_ALERT FOUND CUT_FISH TOTAL_LINE QUALITY GET_OK GET_FAIL HANDS_FULL DOCK_NO_SHARDS DOCK_CONFIRM DOCK_BLOCKED TOGGLE].each { |name| remove_const(name) if const_defined?(name, false) }

    # A fish took the lure and the hook is set.
    HOOKED = /^You feel a brief jerk on your line before it begins to reel out wildly\./
    # A fish already on your line (its own turns in the fight), in case the
    # hook message was missed. Only your lines say "your"; a neighbour's say
    # "her catch", "Lakishiie's rod", and so on.
    FISH_ON = /\A(?=.*\byour\b)(?=.*\b(?:your catch|the catch|the fish at the end of your line)\b)/i
    # The fish is landed and in hand. Captures the fish name.
    CAUGHT = /^You give your .+? one final tug and the (?<fish>.+?) comes wriggling to the surface!/
    # The line snapped: fighting a fish too long, or walking away from a cast
    # line ("You have strayed too far from where you were fishing.").
    LOST = /^The line of your .+? strains and breaks with a sharp \*SNAP\*!/
    # The line came back in with nothing on it (the fish got away, or nothing was hooked).
    EMPTY = Regexp.union(
      /^You reel the line of your .+? in\./,
      /^But the .+? is already reeled in!/,
    )
    # What ends the wait for a bite: the hook, a fish already fighting, or a snap.
    BITE_WAIT = Regexp.union(HOOKED, FISH_ON, LOST)
    # Every reel reply the reel loop waits on. Roundtime ends every reel that's still fighting.
    REEL_REPLY = Regexp.union(CAUGHT, LOST, EMPTY, /^Roundtime: \d+ sec\.$/)
    # FISH CAST worked, or a line was already out.
    CAST_OK = /\*WHOOSH!\*|^You've already cast the line/
    # FISH CAST failed.
    CAST_FAIL = /^You must be holding a fishing rod\.|^You can't cast without a free hand\./
    # FISH CAST refused because this spot needs time to recover.
    OVERFISHED = /^It looks like this area has been heavily overfished\./
    # What you type to turn pause_me on or off while fishing.
    TOGGLE = /\A(?:<c>)?;?toggletfish\s*\z/i
    # Cutting the line drops whatever was on it at your feet, which blocks
    # walking until it's picked up. Captures the item's id (from the XML link)
    # and noun when present.
    # Everything that was on the line: "Your skull-shaped lure and blown glass
    # weight fall to the ground at your feet."
    AT_FEET = /Your (?<items>.+?) falls? to the ground at your feet\./
    # An item's XML link: id, noun and name.
    ITEM_LINK = %r{<a exist="(?<id>[^"]+)" noun="(?<noun>[^"]+)">(?<name>[^<]+)</a>}
    # Weighing the pole (with a fish on) or a fish in hand.
    WEIGHT = /^You carefully examine the .+? and determine that the weight is about (?<pounds>[\d,]+) pounds\./
    # Fillet turned up something worth inspecting (T5+).
    INSPECT_ALERT = /probably deserves a close inspection/
    # Something found inside a fish when cutting it. Captures the item.
    FOUND = /In addition, you find (?<item>.+?) inside the .+?'s belly\./
    # One rarity's count in FISH TOTAL. A catch bumps exactly one of these, so
    # comparing before and after gives its rarity. (Ebon Gate fish don't show
    # a quality line on LOOK, so this is the reliable source everywhere.)
    TOTAL_LINE = /^\s*(Common|Uncommon|Rare|Epic|Legendary) Fish Caught:\s+(\d+)/
    # LOOK at a caught fish outside Ebon Gate: its rarity. Ebon Gate fish
    # don't have this line.
    QUALITY = /It is of (?<rarity>\w+) quality\./
    # First line of cutting a fish (or failing to).
    CUT_FISH = /^You cut into|^Cut what\?|^Try holding/
    # GET succeeded.
    GET_OK = /^You (?:remove|already|grab|reach|retrieve)/
    # GET failed.
    GET_FAIL = /^Get what\?|^Hey, that doesn't|^That's almost certainly a bad idea|^You need a free hand to pick that up\./
    # GET refused because both hands are full.
    HANDS_FULL = /^You need a free hand to pick that up\./
    # CUT on the pole: the line came off, or there was nothing to cut. CUT
    # only works with a lure on the line (seen in logs).
    CUT_REPLY = /snap the line of your|isn't currently strung/
    # New line went on the pole.
    RESTRUNG = /^You coil some of your .+? around the reel of your/
    # Restring replies: it worked, or the old line is still on (the game won't
    # replace a line that hasn't snapped or been cut).
    RESTRING_REPLY = Regexp.union(RESTRUNG, /^The line of your .+? is intact\./)
    # Dock entry when you can't afford it.
    DOCK_NO_SHARDS = /You do not have enough soul shards to enter the dock/
    # Dock entry fee confirmation.
    DOCK_CONFIRM = /If you wish to pay the cost and continue, GO dock again/
    # Something is still at your feet, which stops you walking anywhere.
    DOCK_BLOCKED = /you remember the .+? still placed alongside you/

    module_function

    # @param text [String] FISH TOTAL output
    # @return [Hash{String => Integer}] rarity ("common", ...) => fish caught
    def totals(text) = text.scan(TOTAL_LINE).to_h { |rarity, count| [rarity.downcase, count.to_i] }

    # @param before [Hash{String => Integer}] totals before the catch
    # @param after [Hash{String => Integer}] totals after it
    # @return [String, nil] the rarity whose count went up, nil if unknown
    def new_rarity(before, after)
      return if before.empty? || after.empty?

      after.find { |rarity, count| count > before.fetch(rarity, 0) }&.first
    end

    # @param text [String] CUT output, with or without XML
    # @return [Array<Hash{Symbol => String, nil}>] each item dropped at your
    #   feet: id and noun from its XML link (nil without XML), and name
    def dropped(text)
      items = text[AT_FEET, :items] or return []
      links = items.scan(ITEM_LINK).map { |id, noun, name| { id:, noun:, name: } }
      return links if links.any?

      items.split(/, (?:and )?| and /).map { { id: nil, noun: it.split.last, name: it } }
    end

    # @param line [String, nil] a reel reply, nil if none arrived in time
    # @return [Symbol, nil] :caught, :lost, :empty, :reeling, or nil for no reply
    def reel_outcome(line)
      case line
      when nil then nil
      when CAUGHT then :caught
      when LOST then :lost
      when EMPTY then :empty
      else :reeling
      end
    end

    # @param line [String, nil]
    # @return [String, nil] the pounds figure from a WEIGHT reply
    def pounds(line) = line&.match(WEIGHT)&.[](:pounds)
  end

  # What's rigged on the pole, parsed from LOOK output.
  module Pole
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[State LOOK_START BONUS_DEPTHS].each { |name| remove_const(name) if const_defined?(name, false) }

    # @!attribute line [String, nil] line condition ("excellent", "decent",
    #   "showing signs of use", "frayed and in danger of snapping soon"), nil if there is no line
    # @!attribute lure [String, nil] attached lure, nil if none
    # @!attribute weight [String, nil] strung weight or sinker, nil if none
    # @!attribute lure_noun [String, nil] the attached lure's noun, for taking it off
    # @!attribute weight_noun [String, nil] the strung weight's noun ("weight", "sinker")
    # @!attribute lure_bonus [Hash{Symbol => Integer}] lure bonus per depth
    #   (:surface, :middle, :deep), empty if no lure or not shown
    State = Data.define(:line, :lure, :weight, :lure_bonus, :lure_noun, :weight_noun) do
      def initialize(line:, lure:, weight:, lure_bonus: {}, lure_noun: nil, weight_noun: nil) = super

      # @return [Boolean] whether the line is about to snap and should be replaced
      def frayed? = line.to_s.include?("frayed")

      # @param at [String] replace_line_at setting: "frayed" or "worn"
      # @return [Boolean] whether the line should be replaced now
      # The game says "showing signs of use"; the wiki calls it "signs of wear".
      def replace?(at) = frayed? || (at.to_s == "worn" && line.to_s.match?(/signs of (?:use|wear)/))

      # @return [Symbol, nil] depth the lure attracts best at, nil if unknown
      def best_depth = lure_bonus.max_by { |_depth, bonus| bonus }&.first

      # @return [Boolean] whether the lure is at least as good at the surface
      #   as anywhere else (true when unknown, so nothing is flagged on a guess)
      def surface_lure? = lure_bonus.empty? || lure_bonus[:surface].to_i >= lure_bonus.values.max
    end

    # First line of LOOK output for your pole, in XML (tags allowed before and
    # inside it). Tight on purpose: on a shared dock, other players' lines
    # ("The line of Kenzsii's rod...") arrive in the same stream.
    LOOK_START = %r{^(?:<[^>]*>)*(?:You take a closer look at|The (?:<a [^>]*>)?\S+'s(?:</a>)? line looks|The line (?:of the|itself)|An? .+ is currently (?:attached|strung)|You see nothing unusual)}

    # Lure quality lines in LOOK output, mapped to depth.
    BONUS_DEPTHS = {
      "near the surface" => :surface,
      "at middle depths" => :middle,
      "in deep water"    => :deep,
    }.freeze

    module_function

    # LOOKs at the pole. Captured as XML so the prompt ends the capture right
    # away (as plain text there's no prompt tag to match, so it waits out the
    # timeout), then the tags are stripped for parsing.
    #
    # @param id [String] the pole's GameObj id
    # @param quiet [Boolean] hide the output
    # @return [State, nil] nil if nothing came back
    def look(id, quiet:)
      lines = Lich::Util.issue_command("look ##{id}", LOOK_START, usexml: true, quiet:, include_end: false)
      parse(lines.join("\n")) unless lines.empty?
    end

    # @param text [String] LOOK output for the pole, as XML or plain text
    # @return [State]
    def parse(text)
      lines = text.lines
      plain = text.gsub(/<[^>]*>/, "")
      lure = plain[/^(?:An?|Some) (.+?) is currently attached near the hook/, 1]
      weight = plain[/^(?:An?|Some) (.+?) is currently strung from the line of the .+? to serve as a weight\./, 1]
      State.new(
        line: plain[/The (?:line itself|\S+'s line) looks (?:to be )?(?:in )?(.+?)(?: condition)?\./, 1],
        lure:, weight:,
        lure_bonus: plain.scan(/^\s*([+-]\d+) to attracting fish (#{BONUS_DEPTHS.keys.join('|')})/)
                         .to_h { |bonus, depth| [BONUS_DEPTHS[depth], bonus.to_i] },
        lure_noun: noun(lines.find { it.include?("is currently attached near the hook") }, lure),
        weight_noun: noun(lines.find { it.include?("to serve as a weight") }, weight),
      )
    end

    # The item's noun from its XML link; long descriptions ("...lure dangling
    # a tiny gold key") don't end with the noun.
    #
    # @param line [String, nil] the LOOK line describing the item
    # @param name [String, nil] the item's name, for a guess without XML
    # @return [String, nil]
    def noun(line, name) = line&.[](/<a [^>]*noun="([^"]+)"/, 1) || name&.split&.last
  end

  # Depths: the lure and weight for each, and the rotation through the ones
  # being fished.
  module Weights
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[DEPTHS SINKS].each { |name| remove_const(name) if const_defined?(name, false) }

    # Depths, in rotation order.
    DEPTHS = %w[surface middle bottom].freeze
    # Where a weight for each depth should sink the line, as LOOK words it.
    SINKS = { "middle" => "middle depths", "bottom" => "bottom" }.freeze

    module_function

    # @param cast_index [Integer] 0-based cast count this session
    # @return [String] depth that cast fishes, rotating through the depths setting
    def depth(cast_index) = Config.depths[cast_index % Config.depths.size]

    # @param depth [String] surface, middle or bottom
    # @return [String] lure name (or part of it) set for that depth
    def lure_for(depth)
      lure = Config[:"lure_#{depth}"].to_s.strip
      lure.empty? ? "lure" : lure
    end

    # @param depth [String] surface, middle or bottom
    # @return [String, nil] weight name set for that depth, nil at the surface
    def weight_for(depth)
      weight = Config[:"weight_#{depth}"].to_s.strip unless depth == "surface"
      weight unless weight.nil? || weight.empty?
    end

    # @param text [String, nil] LOOK at a weight
    # @return [String, nil] where it sinks a line ("middle depths", "bottom")
    def sink_depth(text) = text.to_s[/heavy enough to sink a line to the (.+?) of a body of water/, 1]

    # @param weight [String, nil] name of the weight on the pole, nil for none
    # @param wanted [String, nil] weight setting, nil for no weight
    # @return [Boolean] whether that weight is the one wanted
    def matches?(weight, wanted) = wanted.to_s.empty? ? weight.nil? : Supplies.named?(weight, wanted)

    # Where the rotation starts, so the first cast keeps the weight already
    # on the pole if its depth is one being fished.
    #
    # @param weight [String, nil] name of the weight on the pole, nil for none
    # @return [Integer] starting cast index
    def start_index(weight) = Config.depths.index { matches?(weight, weight_for(it)) }.to_i
  end

  # Checks the supplies container for enough line, lures and weights.
  module Supplies
    module_function

    # Matches the way you'd refer to an item in game: every word given has to
    # start a word in its name, in any order ("grey lure" finds a "leaf-topped
    # grey mandrake lure", "skull lure" a "pale carved skull-shaped lure").
    #
    # @param name [String, nil] item name (GameObj#name)
    # @param wanted [String] words to look for
    # @return [Boolean]
    def named?(name, wanted)
      words = name.to_s.downcase.split
      wanted.to_s.downcase.split.all? { |part| words.any? { it.start_with?(part) } }
    end

    # Checks everything the current settings need, for `;tfish check`.
    #
    # @param supplies [Array<#noun, #name>] supplies container contents
    # @param knife_box [Array<#noun, #name>] knife container contents
    # @param pole [Pole::State, nil] what's rigged on the pole, nil if no pole
    # @param sinks [Hash{String => String}] weight setting => where a LOOK at
    #   that weight says it sinks ("middle depths", "bottom")
    # @return [Array<Array(Symbol, String)>] [:ok, :missing or :warn, description]
    def check(supplies, knife_box, pole, sinks = {})
      supplies = Array(supplies)
      count = ->(&match) { supplies.count(&match) }
      rows = []
      add = ->(ok, text, warn: false) { rows << [ok ? :ok : (warn ? :warn : :missing), text] }

      add.(pole, "Pole (#{Config[:supplies_pole]}) #{Config[:tackle_box] ? 'on' : 'in'} your #{Config[:supplies_container]}")
      line_spares = count.() { named?(it.name, Config[:supplies_line]) }
      add.(line_spares.positive?, "Spare line (#{Config[:supplies_line]}): #{line_spares}")
      if pole
        line = pole.line || "none, will be restrung"
        replace = pole.replace?(Config[:replace_line_at])
        line += ", will be replaced before fishing" if replace
        add.(!replace, "Line on the pole: #{line}", warn: true)
      end
      add.(Array(knife_box).any? { named?(it.name, Config[:fillet_knife]) }, "Knife (#{Config[:fillet_knife]}) in your #{Config[:knife_container]}")

      minimum = Config[:supplies_minimum]
      add.(true, "Lure on the pole: #{pole.lure || 'none'}") if pole
      lures_in_use.each do |lure, depths|
        have = count.() { named?(it.name, lure) }
        add.(have >= minimum, "Lure #{lure} (#{depths.join(', ')}): #{have}/#{minimum}")
      end

      weights_in_use.each do |weight, depth|
        have = count.() { named?(it.name, weight) } + (named?(pole&.weight, weight) ? 1 : 0)
        add.(have >= minimum, "Weight #{weight} (#{depth}): #{have}/#{minimum}")
        next unless (sinks_to = sinks[weight])

        expected = Weights::SINKS[depth]
        add.(sinks_to == expected, "Weight #{weight} sinks to the #{sinks_to}#{", expected the #{expected}" unless sinks_to == expected}", warn: true)
      end
      add.(true, "Weight: #{pole.weight} on the pole will come off (fishing the surface)") if pole&.weight && weights_in_use.empty?

      if Config.depths == %w[surface] && pole&.lure && !pole.surface_lure?
        add.(false, "#{pole.lure} is better at #{pole.best_depth} depth than the surface", warn: true)
      end
      rows
    end

    # @return [Hash{String => Array<String>}] lure setting => depths it's used at
    def lures_in_use = Config.depths.group_by { Weights.lure_for(it) }

    # @return [Hash{String => String}] weight setting => its depth, for the depths fished
    def weights_in_use = Config.depths.filter_map { |depth| [Weights.weight_for(depth), depth] if Weights.weight_for(depth) }.to_h

    # @param contents [Array<#noun, #name>] supplies container contents
    # @return [Array<String>] one "item - have/need" line per missing supply, empty if stocked
    def shortages(contents)
      contents = Array(contents)
      minimum = Config[:supplies_minimum]
      needs = { "Fishing Line - #{Config[:supplies_line]}" => [contents.count { named?(it.name, Config[:supplies_line]) }, 1] }
      weights_in_use.each_key { |weight| needs["Weight - #{weight}"] = [contents.count { named?(it.name, weight) }, minimum] }
      lures_in_use.each_key { |lure| needs["Lure - #{lure}"] = [contents.count { named?(it.name, lure) }, minimum] }
      needs.filter_map { |label, (have, need)| "#{label} - #{have}/#{need}" if have < need }
    end
  end

  # Reading a Super-Fish-All Tackle Box: its trays (GAZE), which tray WHISPER
  # (or TINKER, on boxes without WHISPER) moved to the top, and the pole on its loops. Gear comes out of the top
  # tray with PLUCK and goes back with PUT ... IN, which sorts it into its
  # tray; the pole goes ON the box.
  module Tackle
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[Tray GAZE_START TRAY_LINE WHISPERED TINKERED PLUCKED LINK].each { |name| remove_const(name) if const_defined?(name, false) }

    # @!attribute number [Integer] GAZE line number
    # @!attribute name [String] what the tray holds, e.g. "pale carved skull-shaped lure with granite-inset eyes"
    # @!attribute count [Integer] pieces in it
    # @!attribute ready [Boolean] whether PLUCK takes from this tray now
    Tray = Data.define(:number, :name, :count, :ready) do
      # @return [String] last word of the name, close enough to a noun for supply counts
      def noun = name.split.last
    end

    # GAZE's reply starts with this.
    GAZE_START = /^Sifting through the .+? trays of your/
    # e.g. "1.  a leaf-topped grey mandrake lure with tiny thorn teeth (25 pieces, one of which is ready for plucking)",
    # or "(1 piece, which is ready for plucking)" for the last one. Trays renumber when one empties.
    TRAY_LINE = /^(?<number>\d+)\.\s+(?:an?|some)\s+(?<name>.+?)\s*\((?<count>\d+) pieces?(?<ready>, (?:one of )?which is ready for plucking)?\)/
    # WHISPER MY BOX <number>'s reply, naming the tray it moved to the top.
    WHISPERED = /find the one with (?:an?|some) (?<name>.+?) inside and move it to the top/
    # PLUCK's reply, naming what it took.
    PLUCKED = /and pluck (?:an?|some) (?<name>.+?) from the one that is currently opened/
    # TINKER's reply, naming the tray it cycled to the top.
    TINKERED = /shifting the one storing (?:an?|some) (?<name>.+?) \([^)]*\) to the top/
    # An item link in XML.
    LINK = %r{<a exist="(?<id>[^"]+)" noun="(?<noun>[^"]+)">(?<name>[^<]+)</a>}

    module_function

    # @param text [String, nil] GAZE output (XML tags are ignored)
    # @return [Array<Tray>]
    def trays(text)
      text.to_s.gsub(/<[^>]*>/, "").lines.filter_map do |line|
        next unless (match = line.match(TRAY_LINE))

        Tray.new(number: match[:number].to_i, name: match[:name], count: match[:count].to_i, ready: !match[:ready].nil?)
      end
    end

    # @param line [String, nil] WHISPER's reply
    # @return [String, nil] name of the tray it moved to the top
    def whispered(line) = line.to_s.gsub(/<[^>]*>/, "")[WHISPERED, :name]

    # @param line [String, nil] PLUCK's reply
    # @return [String, nil] full name of what it took
    def plucked(line) = line.to_s.gsub(/<[^>]*>/, "")[PLUCKED, :name]

    # @param line [String, nil] TINKER's reply
    # @return [String, nil] name of the tray it cycled to the top
    def tinkered(line) = line.to_s.gsub(/<[^>]*>/, "")[TINKERED, :name]

    # The same gear can fill several trays (25 per tray), so a tray that's
    # already ready for plucking is preferred over WHISPERing another.
    #
    # @param trays [Array<Tray>]
    # @param wanted [String] gear setting
    # @return [Tray, nil]
    def pick(trays, wanted, &only)
      matching = trays.select { Supplies.named?(it.name, wanted) && (only.nil? || only.(it)) }
      matching.find(&:ready) || matching.first
    end

    # One entry per piece, so supply counts work the same as for a container.
    #
    # @param trays [Array<Tray>]
    # @return [Array<Tray>]
    def items(trays) = trays.flat_map { |tray| Array.new(tray.count, tray) }

    # @param text [String, nil] LOOK ON the box, as XML
    # @return [Array<Hash>] :id, :noun and :name of each item on the box
    def on_box(text)
      on = text.to_s[/On the .*/m].to_s
      on.scan(LINK).map { |id, noun, name| { id:, noun:, name: } }.uniq
    end
  end

  # Ebon Gate docks and picking the least crowded spot on one.
  module Rooms
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[Dock DOCKS BOTS].each { |name| remove_const(name) if const_defined?(name, false) }

    # @!attribute name [String] dock name, from the fishing rooms' title
    # @!attribute entrance [Integer] room you GO DOCK from
    # @!attribute spots [Array<Integer>] fishing rooms on the dock
    Dock = Data.define(:name, :entrance, :spots) do
      def initialize(entrance:, spots:, name: "Custom") = super
      # @param room_id [Integer, nil]
      # @return [Boolean] whether the room is one of this dock's fishing spots
      def fishing?(room_id) = spots.include?(room_id)

      # @param room_id [Integer, nil]
      # @return [Boolean] whether the room is this dock's entrance or one of its spots
      def here?(room_id) = room_id == entrance || fishing?(room_id)
    end

    # Known Ebon Gate docks, selected with the `dock` setting. Numbered to
    # match the entrances' fishing/fishing2/fishing3/fishing4 map tags.
    DOCKS = {
      1 => Dock.new(name: "Stream of Reflections", entrance: 31834, spots: [32116, 32117, 32118].freeze),
      2 => Dock.new(name: "Misty Waters", entrance: 31846, spots: [32126, 32127, 32128].freeze),
      3 => Dock.new(name: "Mold Marsh", entrance: 32074, spots: [32120, 32121, 32122].freeze),
      4 => Dock.new(name: "Moss Pond", entrance: 32073, spots: [32123, 32124, 32125].freeze),
    }.freeze

    # Bots that don't count toward a room being crowded.
    BOTS = /Fishmon|Ilten/

    module_function

    # @param setting [Integer, String, Hash] a DOCKS number, part of a dock's
    #   name ("moss"), or a custom `{ entrance: id, spots: [id, ...] }`
    # @return [Dock] the configured dock, dock 1 if it isn't recognized
    def dock(setting = Config[:dock])
      return Dock.new(entrance: setting[:entrance].to_i, spots: Array(setting[:spots]).map(&:to_i)) if setting.is_a?(Hash)
      return DOCKS.fetch(setting.to_i, DOCKS[1]) if setting.to_s.match?(/\A\d+\z/)

      wanted = setting.to_s.strip.downcase
      (DOCKS.values.find { it.name.downcase.include?(wanted) } unless wanted.empty?) || DOCKS[1]
    end

    # @param pcs [Array<#noun>, nil] players in a room
    # @return [Integer] players that aren't fishing bots
    def crowd(pcs) = Array(pcs).count { it.noun !~ BOTS }

    # The dock to fish from here: one you're already standing on (the fee is
    # paid, so stay), otherwise the configured one. Each catch teleports you
    # to an entrance, so the setting takes over from the next entry.
    #
    # @param room_id [Integer, nil] current room
    # @return [Dock]
    def dock_for(room_id) = DOCKS.values.find { it.fishing?(room_id) } || dock

    # @param counts [Hash{Integer => Integer}] room id => crowd
    # @return [Integer] the least crowded room id (first wins on ties)
    def least_crowded(counts) = counts.min_by { |_room, count| count }.first
  end

  # familiar_debug lines: one per fight, with what FISH TOTAL can't show.
  module Familiar
    module_function

    # @param cast [String] cast distance (far, middle, near)
    # @param depth [String, nil] depth fished (surface, middle, bottom)
    # @return [String] e.g. "#6 13:16 far/surface"
    def heading(number, at, cast, depth) = "##{number} #{at.strftime('%H:%M')} #{[cast, depth].compact.join('/')}"

    # @return [String] e.g. "#6 13:16 far/surface tentacled aberration (legendary) 5lb | bite 25s, fight 252s / 40 reels | pitted grey scoria"
    def catch_line(number:, at:, cast:, depth:, fish:, bite:, fight:, reels:, rarity: nil, pounds: nil, prize: nil)
      name = [fish, ("(#{rarity})" if rarity), ("#{pounds}lb" if pounds)].compact.join(" ")
      ["#{heading(number, at, cast, depth)} #{name}", "bite #{bite}s, fight #{fight}s / #{reels} reels", prize].compact.join(" | ")
    end

    # @param outcome [Symbol] :lost (snapped) or :empty (got away)
    # @return [String] e.g. "#7 13:22 far/surface SNAP after 48s / 8 reels"
    # @param pounds [String, nil] the fish's weight, if the pole was weighed at the hook
    def loss_line(number:, at:, cast:, depth:, outcome:, fight:, reels:, pounds: nil)
      lost = [outcome == :lost ? "SNAP" : "got away", ("(#{pounds}lb fish)" if pounds)].compact.join(" ")
      "#{heading(number, at, cast, depth)} #{lost} after #{fight}s / #{reels} reels"
    end
  end

  # What the ;tfish setup window shows: each setting's field and tooltip in
  # its section, which settings apply given the others, and validation.
  # Pure, so the rules are specced without GTK; SetupWindow only draws them.
  module Setup
    # Drop constants left by an earlier run this session so a restart loads the
    # current definitions without already-initialized warnings.
    %i[Field SECTIONS FIELDS TICKS NAME_CHARS].each { |name| remove_const(name) if const_defined?(name, false) }

    # @!attribute key [Symbol] UserVars.tfish key, or a TICKS key
    # @!attribute label [String]
    # @!attribute type [Symbol] :text, :check, :number or :choice
    # @!attribute tip [String] tooltip
    # @!attribute range [Range, nil] allowed values of a :number
    Field = Data.define(:key, :label, :type, :tip, :range) do
      def initialize(key:, label:, type:, tip:, range: nil) = super
    end

    # List settings shown as a tick box per value: setting => tick box key per value.
    TICKS = {
      depths: Weights::DEPTHS.to_h { [it, :"depth_#{it}"] },
      distances: Config::CAST_DISTANCES.to_h { [it, :"distance_#{it}"] },
    }.freeze

    depth_tip = "Ticking more than one depth rotates through them each cast, starting from the weight already on the pole."
    distance_tip = "Ticking more than one distance rotates through them, each held for a full rotation of the depths.\n" \
                   "Middle lands the most fish per hour; far wears the line fastest."
    name_tip = "Name it as you would in game; \"lure\" uses any lure."

    # @return [Hash{String => Array<Field>}] window section => its fields, in order
    SECTIONS = {
      "Gear"    => [
        Field.new(key: :supplies_container, label: "Supplies container", type: :text,
                  tip: "Container holding your pole, line, lures and weights, as you'd name it in game (e.g. cloak, green sack)."),
        Field.new(key: :tackle_box, label: "Super-Fish-All Tackle Box", type: :check,
                  tip: "Tick if your supplies container is a Super-Fish-All Tackle Box. The pole hangs on its loops,\n" \
                       "and lures, weights and line are taken from its trays (GAZE, WHISPER, PLUCK).\n" \
                       "Your fillet knife has to be in another container."),
        Field.new(key: :supplies_pole, label: "Fishing pole", type: :text,
                  tip: "Your fishing pole, as you'd name it in game (e.g. rod, black pole)."),
        Field.new(key: :supplies_line, label: "Fishing line", type: :text,
                  tip: "Your spool of fishing line (e.g. wire). Spare \"length of\" pieces are used before pulling a new one."),
        Field.new(key: :supplies_minimum, label: "Minimum supplies", type: :number, range: 1..50,
                  tip: "Spare lures and weights of each kind in use to keep in your supplies container.\n" \
                       "tfish stops when you have fewer. Line needs one spool (50 lengths)."),
        Field.new(key: :fillet_knife, label: "Fillet knife", type: :text,
                  tip: "Knife to cut the fish open with (e.g. dagger)."),
        Field.new(key: :knife_container, label: "Knife container", type: :text,
                  tip: "Container holding your fillet knife."),
      ],
      "Depths"  => [
        Field.new(key: :depth_surface, label: "Surface", type: :check,
                  tip: "Fish the surface, with no weight. Each depth has its own fish.\n#{depth_tip}"),
        Field.new(key: :lure_surface, label: "Surface lure", type: :text,
                  tip: "Lure for the surface (e.g. grey lure). #{name_tip}"),
        Field.new(key: :depth_middle, label: "Middle", type: :check,
                  tip: "Fish the middle depths, with the middle weight. Each depth has its own fish.\n#{depth_tip}"),
        Field.new(key: :lure_middle, label: "Middle lure", type: :text,
                  tip: "Lure for the middle depths (e.g. skull lure). #{name_tip}"),
        Field.new(key: :weight_middle, label: "Middle weight", type: :text,
                  tip: "Weight that sinks the line to the middle depths (e.g. blown glass weight).\n;tfish check confirms where it sinks."),
        Field.new(key: :depth_bottom, label: "Bottom", type: :check,
                  tip: "Fish the bottom, with the bottom weight. Each depth has its own fish.\n#{depth_tip}"),
        Field.new(key: :lure_bottom, label: "Bottom lure", type: :text,
                  tip: "Lure for the bottom (e.g. ebon gate lure). #{name_tip}"),
        Field.new(key: :weight_bottom, label: "Bottom weight", type: :text,
                  tip: "Weight that sinks the line to the bottom (e.g. glaes weight).\n;tfish check confirms where it sinks."),
      ],
      "Fishing" => [
        Field.new(key: :fishing_mode, label: "Fishing mode", type: :choice,
                  tip: "Ebon Gate: travel to the dock, pay the fee and fish there.\n" \
                       "Bypass: fish right where you're standing, with no Ebon Gate travel, dock fee or squelching."),
        Field.new(key: :dock, label: "Dock", type: :choice,
                  tip: "Ebon Gate dock to fish. If you're already standing on a dock's fishing spot, it fishes there instead.\nEbon Gate mode only."),
        Field.new(key: :fav_room, label: "Fishing spot", type: :choice,
                  tip: "Least crowded picks the spot with the fewest other fishers each time, or pick a room.\nEbon Gate mode only."),
        Field.new(key: :distance_near, label: "Near", type: :check, tip: "Cast near (lands about 90 feet out).\n#{distance_tip}"),
        Field.new(key: :distance_middle, label: "Middle", type: :check, tip: "Cast middle (lands about 180 feet out).\n#{distance_tip}"),
        Field.new(key: :distance_far, label: "Far", type: :check, tip: "Cast far (lands about 270 feet out).\n#{distance_tip}"),
        Field.new(key: :replace_line_at, label: "Replace line at", type: :choice,
                  tip: "Replace the line once it's frayed, or a stage earlier (showing signs of use) so it can't fray mid-fight."),
        Field.new(key: :cast_timer, label: "Castbar seconds", type: :number, range: 10..300,
                  tip: "Seconds per castbar refresh while waiting for a bite."),
        Field.new(key: :overfished_wait, label: "Overfished wait", type: :number, range: 0..600,
                  tip: "Seconds to wait before recasting on an overfished spot.\nBypass mode only: there's no overfishing at Ebon Gate."),
        Field.new(key: :trash_cut, label: "Trash fillets", type: :check,
                  tip: "Trash the fillet after cutting the fish open."),
      ],
      "Output"  => [
        Field.new(key: :pause_me, label: "Pause after each catch", type: :check,
                  tip: "Pause the script after each catch (;unpause tfish to continue)."),
        Field.new(key: :announce_finds, label: "Announce finds", type: :check,
                  tip: "Send what you find inside each fish, and its rarity, to the familiar window."),
        Field.new(key: :familiar_debug, label: "Fight log", type: :check,
                  tip: "Send a line per fight to the familiar window: cast, depth, fish, rarity, weight, bite and fight time, reels and find."),
        Field.new(key: :squelch_script, label: "Squelch other fishers", type: :check,
                  tip: "Run ;tsquelch to hide other fishers' messages. Ebon Gate mode only."),
        Field.new(key: :debug_my_script, label: "Debug log", type: :check,
                  tip: "Verbose log for diagnosing fishing: script commands, timestamped fight lines and extra LOOKs at the pole.\n" \
                       "Also weighs the pole when a fish bites, so the fight log shows how big a fish that snapped the line was.\n" \
                       "That costs about 5 seconds at the start of each fight."),
      ],
    }.freeze

    # @return [Hash{Symbol => Field}]
    FIELDS = SECTIONS.values.flatten.to_h { [it.key, it] }.freeze

    # Characters an item name can have.
    NAME_CHARS = /\A[\w' -]*\z/

    module_function

    # @param store [Hash] UserVars.tfish
    # @return [Hash{Symbol => Object}] each field's value, cleaned up so every
    #   one is valid for its widget (a dock name becomes its number, a spot
    #   that isn't on the dock becomes 0, numbers are kept in range), with a
    #   tick box value for each depth and distance
    def values_from(store)
      values = FIELDS.to_h do |key, field|
        value = store[key]
        [key, case field.type
              when :check then value ? true : false
              when :number then value.to_i.clamp(field.range)
              when :text then value.to_s
              else value
              end]
      end
      { depths: Config.depths(store), distances: Config.distances(store) }.each do |setting, ticked|
        TICKS[setting].each { |value, key| values[key] = ticked.include?(value) }
      end
      values[:replace_line_at] = values[:replace_line_at].to_s == "worn" ? "worn" : "frayed"
      values[:fishing_mode] = values[:fishing_mode].to_s == "bypass" ? "bypass" : "ebon_gate"
      values[:dock] = Rooms::DOCKS.key(Rooms.dock(values[:dock])) unless values[:dock].is_a?(Hash)
      values[:fav_room] = values[:fav_room].to_i
      values[:fav_room] = 0 unless Rooms.dock(values[:dock]).fishing?(values[:fav_room])
      values
    end

    # @param key [Symbol] a :choice field
    # @param values [Hash] current field values
    # @return [Array<Array(Object, String)>] [value, label] options
    def choices(key, values)
      case key
      when :replace_line_at then [["frayed", "Frayed"], ["worn", "Showing signs of use"]]
      when :fishing_mode then [["ebon_gate", "Ebon Gate docks"], ["bypass", "Bypass (fish where you stand)"]]
      when :dock
        docks = Rooms::DOCKS.map { |number, dock| [number, "#{number}. #{dock.name}"] }
        values[:dock].is_a?(Hash) ? [[values[:dock], "Custom (entrance #{values[:dock][:entrance]})"], *docks] : docks
      when :fav_room then [[0, "Least crowded"], *Rooms.dock(values[:dock]).spots.map { [it, "Room #{it}"] }]
      end
    end

    # @param key [Symbol]
    # @param values [Hash] current field values
    # @return [Boolean] whether the setting is used with the other settings as they are
    def enabled?(key, values)
      case key
      when :dock, :fav_room, :squelch_script then values[:fishing_mode] != "bypass"
      when :overfished_wait then values[:fishing_mode] == "bypass"
      when /\A(?:lure|weight)_(\w+)\z/ then values[TICKS[:depths][Regexp.last_match(1)]]
      else true
      end
    end

    # Only settings that apply are checked: a disabled one keeps whatever it has.
    #
    # @param values [Hash] current field values
    # @return [Hash{Symbol => String}] key => what's wrong with it
    def errors(values)
      errors = FIELDS.each_value.with_object({}) do |field, found|
        next unless field.type == :text && enabled?(field.key, values)

        error = text_error(field.key, values[field.key].to_s.strip, values)
        found[field.key] = error if error
      end
      errors[:depth_surface] = "tick at least one depth" if TICKS[:depths].values.none? { values[it] }
      errors[:distance_near] = "tick at least one cast distance" if TICKS[:distances].values.none? { values[it] }
      errors
    end

    # @return [String, nil] what's wrong with a text setting, nil if it's fine
    def text_error(key, text, values)
      return "Required" if text.empty?
      return "Letters, numbers, spaces, hyphens and apostrophes only (no quotes)" unless text.match?(NAME_CHARS)
      return "Leave out \"my\": just the item's name" if text.match?(/\Amy\b/i)
      if key == :knife_container && values[:tackle_box] && text.casecmp?(values[:supplies_container].to_s.strip)
        return "A tackle box can't hold your knife; use another container"
      end
      if key == :weight_bottom && enabled?(:weight_middle, values) && text.casecmp?(values[:weight_middle].to_s.strip)
        return "Must be a different weight from the middle weight"
      end

      nil
    end

    # Saves every field, including disabled ones, so switching a setting back
    # on restores what was there. Tick boxes become the depths and distances lists.
    #
    # @param values [Hash] field values
    # @param store [Hash] UserVars.tfish
    def save(values, store)
      ticks = TICKS.values.flat_map(&:values)
      values.each { |key, value| store[key] = value.is_a?(String) ? value.strip : value unless ticks.include?(key) }
      TICKS.each { |setting, keys| store[setting] = keys.filter_map { |value, key| value if values[key] } }
    end
  end

  HELP_TEXT = <<~HELP
    SYNTAX - ;tfish            fish the Ebon Gate dock
             ;tfish list       show your current settings
             ;tfish check      check your gear is found for the fishing your settings describe
             ;tfish setup      change settings in a window
             toggletfish       while tfish is fishing, turn pause after each catch on or off

      Does NOT automatically sell. Empty your containers by selling/lockering yourself.

      Requires your lootsack to be set for storing loot
      ;vars set lootsack=cloak

      Settings are changed with ;tfish setup, or ;e UserVars.tfish[:setting] = value

      Setting              Default               Description
      pause_me             true                  pause the script after each catch
      familiar_debug       false                 send a line per fight to the familiar window: cast distance,
                                                 depth, fish, rarity, weight, bite and fight time, reels, find
      announce_finds       false                 send what you find inside each fish to the familiar window
      debug_my_script      false                 verbose log for diagnosing fishing: shows script commands,
                                                 timestamped cast/hook/reel lines, FISH STATUS/TOTAL, and
                                                 LOOKs at the pole after casting, each minute waiting, at
                                                 the hook, every 5 reels and when the fish is landed/lost.
                                                 Also weighs the pole at the hook, so a snapped fish's weight
                                                 is known, at the cost of ~5s at the start of each fight
      squelch_script       true                  run ;tsquelch to hide other fishers' spam
      trash_cut            true                  trash the fillet after cutting the fish
      replace_line_at      "frayed"              replace the line once it's "frayed", or "worn" to replace it
                                                 earlier (showing signs of use) so it can't fray mid-fight
      supplies_container   "cloak"               container holding pole, lures, line and weights
      tackle_box           false                 true if the supplies container is a Super-Fish-All Tackle Box:
                                                 the pole goes on its loops and gear comes from its trays
      supplies_minimum     5                     spare lures and weights of each kind in use needed to keep fishing
      supplies_pole        "rod"                 your fishing pole
      supplies_line        "wire"                your fishing line
      fillet_knife         "dagger"              your fillet knife
      knife_container      "cloak"               container holding your knife
      depths               ["surface"]           depths to fish: any of surface, middle, bottom. More than one
                                                 rotates through them each cast, starting from the weight on the pole
                                                 e.g. ;e UserVars.tfish[:depths] = %w[surface middle bottom]
                                                 (or as words: ;e UserVars.tfish[:depths] = "surface bottom")
      lure_surface         "lure"                lure for the surface (e.g. "grey lure"); "lure" uses any lure
      lure_middle          "lure"                lure for the middle depths (e.g. "skull lure")
      lure_bottom          "lure"                lure for the bottom (e.g. "ebon gate lure")
      weight_middle        "blown glass weight"  weight that sinks the line to the middle depths
      weight_bottom        "glaes weight"        weight that sinks the line to the bottom
      distances            ["far"]               cast distances: any of near, middle, far. More than one rotates,
                                                 each held for a full rotation of the depths
                                                 e.g. ;e UserVars.tfish[:distances] = %w[middle]
      cast_timer           60                    seconds per castbar refresh while waiting for a bite
      fishing_mode         "ebon_gate"           "ebon_gate" fishes the Ebon Gate docks; "bypass" fishes right where
                                                 you're standing (no Ebon Gate travel, dock fee or squelching)
      overfished_wait      30                    seconds to wait before recasting when a spot is overfished
                                                 (bypass mode only; there's no overfishing at Ebon Gate)
      dock                 1                     which dock to fish (number or name):
                                                 1 Stream of Reflections - entrance 31834
                                                 2 Misty Waters          - entrance 31846
                                                 3 Mold Marsh            - entrance 32074
                                                 4 Moss Pond             - entrance 32073
                                                 (already standing on a dock's fishing spot? it fishes there)
                                                 or a dock not listed: { entrance: 12345, spots: [12346, 12347] }
      fav_room             0                     0 picks the least crowded spot on the dock, or a spot's room number
                                                 (dock 1: 32117 Main Entrance, 32118 Northwest, 32116 Southeast)
  HELP

  # The ;tfish setup window. Widgets are built from Setup::SECTIONS, and every
  # change re-applies Setup's rules: settings that don't apply are greyed
  # out, invalid ones are marked, and Save waits until they're fixed. All
  # GTK calls run through Gtk.queue, per Lich5's threading rules.
  class SetupWindow
    def initialize
      # Read here, on the script's thread: Script.current is nil in Gtk.queue.
      @version = Script.version(Script.current.name)
      @lootsack = Vars.lootsack.to_s
      @values = Setup.values_from(Config.store)
      @widgets = {}
      @labels = {}
      @choices = {}
      @action = nil
    end

    # Shows the window and blocks until it's closed.
    #
    # @return [Boolean] whether the settings were saved
    def show
      Gtk.queue do
        build
        @window.show_all
        refresh
      end
      before_dying { Gtk.queue { @window&.destroy } }
      wait_while { @action.nil? }
      undo_before_dying
      Gtk.queue { @window&.destroy }
      Setup.save(@values, Config.store) if @action == :save
      @action == :save
    end

    private

    def build
      @window = Gtk::Window.new
      @window.title = "TFish Setup v#{@version}"
      @window.border_width = 10
      @window.keep_above = true
      @window.signal_connect("delete_event") { @action ||= :cancel; true } # destroyed after show returns

      # Sections in two columns: Gear and Depths, then Fishing and Output.
      sections = Gtk::Box.new(:horizontal, 10)
      Setup::SECTIONS.each_slice(2) do |pair|
        column = Gtk::Box.new(:vertical, 10)
        pair.each do |title, fields|
          frame = Gtk::Frame.new(title)
          grid = title == "Depths" ? depths_table : section(fields)
          lootsack_row(grid, fields.size) if title == "Gear"
          frame.add(grid)
          column.pack_start(frame, expand: false, fill: true, padding: 0)
        end
        sections.pack_start(column, expand: true, fill: true, padding: 0)
      end

      @status = Gtk::Label.new("")
      @status.xalign = 0
      @status.wrap = true
      @save = Gtk::Button.new(label: "Save")
      @save.signal_connect("clicked") { @action = :save }
      cancel = Gtk::Button.new(label: "Cancel")
      cancel.signal_connect("clicked") { @action = :cancel }

      buttons = Gtk::Box.new(:horizontal, 5)
      buttons.pack_start(@status, expand: true, fill: true, padding: 0)
      buttons.pack_end(@save, expand: false, fill: false, padding: 0)
      buttons.pack_end(cancel, expand: false, fill: false, padding: 0)

      box = Gtk::Box.new(:vertical, 8)
      box.pack_start(sections, expand: true, fill: true, padding: 0)
      box.pack_start(buttons, expand: false, fill: false, padding: 0)
      @window.add(box)
    end

    # @param fields [Array<Setup::Field>]
    # @return [Gtk::Grid] a label and widget per row, both with the tooltip;
    #   the cast distance tick boxes share one row
    def section(fields)
      grid = new_grid
      ticks = Setup::TICKS[:distances].values
      fields.chunk_while { |a, b| ticks.include?(a.key) && ticks.include?(b.key) }.each_with_index do |row_fields, row|
        if ticks.include?(row_fields.first.key)
          boxes = Gtk::Box.new(:horizontal, 12)
          row_fields.each { boxes.pack_start(tick(it), expand: false, fill: false, padding: 0) }
          grid.attach(label("Cast distance"), 0, row, 1, 1)
          grid.attach(boxes, 1, row, 1, 1)
        else
          field = row_fields.first
          label = label(field.label)
          label.tooltip_text = field.tip
          @labels[field.key] = label
          grid.attach(label, 0, row, 1, 1)
          grid.attach(register(field, widget_for(field)), 1, row, 1, 1)
        end
      end
      grid
    end

    # Shows the lootsack, which isn't a tfish setting, without letting it be
    # edited here.
    #
    # @param grid [Gtk::Grid]
    # @param row [Integer] grid row to put it on
    def lootsack_row(grid, row)
      tip = "Container your finds are stored in. It's a Lich setting shared with other scripts, " \
            "so it's changed from the command line:\n;vars set lootsack=cloak"
      label = label("Lootsack")
      value = label(@lootsack)
      value.markup = "<span foreground='red'>not set</span>" if @lootsack.empty?
      value.margin_start = 6
      label.tooltip_text = value.tooltip_text = @lootsack.empty? ? "Not set: tfish won't start without it.\n\n#{tip}" : tip
      grid.attach(label, 0, row, 1, 1)
      grid.attach(value, 1, row, 1, 1)
    end

    # A tick box per depth, then that depth's lure and weight.
    #
    # @return [Gtk::Grid]
    def depths_table
      grid = new_grid
      grid.attach(label("Lure"), 1, 0, 1, 1)
      grid.attach(label("Weight"), 2, 0, 1, 1)
      Weights::DEPTHS.each.with_index(1) do |depth, row|
        grid.attach(tick(Setup::FIELDS[Setup::TICKS[:depths][depth]]), 0, row, 1, 1)
        grid.attach(register(Setup::FIELDS[:"lure_#{depth}"], widget_for(Setup::FIELDS[:"lure_#{depth}"], width: 20)), 1, row, 1, 1)
        weight = Setup::FIELDS[:"weight_#{depth}"]
        grid.attach(weight ? register(weight, widget_for(weight, width: 20)) : label("(none)"), 2, row, 1, 1)
      end
      note = label("Tick more than one depth to rotate through them.")
      note.wrap = true
      grid.attach(note, 0, Weights::DEPTHS.size + 1, 3, 1)
      grid
    end

    def new_grid
      Gtk::Grid.new.tap do |grid|
        grid.row_spacing = 6
        grid.column_spacing = 12
        grid.border_width = 10
      end
    end

    # @return [Gtk::Label] left-aligned
    def label(text) = Gtk::Label.new(text).tap { it.xalign = 0 }

    # @return [Gtk::Widget] the widget, with the field's tooltip, tracked for refresh
    def register(field, widget)
      widget.tooltip_text = field.tip
      @widgets[field.key] = widget
    end

    # @param field [Setup::Field] a tick box for one value of a list setting
    # @return [Gtk::CheckButton] labelled with the value
    def tick(field)
      check = Gtk::CheckButton.new(field.label)
      check.active = @values[field.key]
      check.signal_connect("toggled") { changed(field.key, check.active?) }
      register(field, check)
    end

    # @param field [Setup::Field]
    # @param width [Integer] characters wide, for a text entry
    # @return [Gtk::Widget]
    def widget_for(field, width: 28)
      key = field.key
      case field.type
      when :text
        Gtk::Entry.new.tap do |entry|
          entry.text = @values[key]
          entry.width_chars = width
          entry.signal_connect("changed") { changed(key, entry.text) }
        end
      when :check
        Gtk::CheckButton.new.tap do |check|
          check.active = @values[key]
          check.signal_connect("toggled") { changed(key, check.active?) }
        end
      when :number
        Gtk::SpinButton.new(field.range.min, field.range.max, 1).tap do |spin|
          spin.numeric = true
          spin.value = @values[key]
          spin.signal_connect("value-changed") { changed(key, spin.value.to_i) }
        end
      when :choice
        Gtk::ComboBoxText.new.tap do |combo|
          fill(combo, key)
          combo.signal_connect("changed") { changed(key, @choices[key][combo.active].first) if combo.active >= 0 }
        end
      end
    end

    # (Re)fills a drop-down with its options, keeping the current value if
    # it's still one of them.
    def fill(combo, key)
      @filling = true
      combo.remove_all
      @choices[key] = Setup.choices(key, @values)
      @choices[key].each { |_value, label| combo.append_text(label) }
      combo.active = @choices[key].index { it.first == @values[key] } || 0
      @values[key] = @choices[key][combo.active].first
      @filling = false
    end

    def changed(key, value)
      return if @filling

      @values[key] = value
      fill(@widgets[:fav_room], :fav_room) if key == :dock
      refresh
    end

    # Greys out settings that don't apply, marks invalid entries (a warning
    # sign on the label, error styling, and what's wrong in the tooltip), and
    # only allows Save once nothing is marked.
    def refresh
      errors = Setup.errors(@values)
      @widgets.each do |key, widget|
        enabled = Setup.enabled?(key, @values)
        label = @labels[key]
        widget.sensitive = enabled
        label.sensitive = enabled if label
        next unless widget.is_a?(Gtk::Entry)

        field = Setup::FIELDS[key]
        error = errors[key]
        label.text = error ? "#{[0x26A0].pack('U')} #{field.label}" : field.label if label # warning sign
        widget.tooltip_text = error ? "#{error}\n\n#{field.tip}" : field.tip
        error ? widget.style_context.add_class("error") : widget.style_context.remove_class("error")
      end
      @save.sensitive = errors.empty?
      problems = errors.map { |key, error| Setup::FIELDS[key].type == :check ? error : Setup::FIELDS[key].label }
      @status.text = errors.empty? ? "" : "Fix to save: #{problems.join(', ')}"
    end
  end

  # Drives the fishing loop against the live game.
  class Runner
    # @param bypass [Boolean] fish the current room, skipping Ebon Gate travel and dock entry
    def initialize(bypass: false)
      @bypass = bypass
      @home_room = Room.current.id
      @dock = Rooms.dock
      @cast_index = nil # set from the pole on the first rig
      @pole = nil
      @weight_noun = nil
      @weight_name = nil
      @fight_count = 0
      fput "fish status" if Config[:debug_my_script] # level and perks, for the log
      @totals = read_totals
    end

    # Main loop: restock check, travel, rig, fish, process the catch, repeat.
    #
    # @return [void]
    def run
      loop do
        check_supplies!
        @dock = Rooms.dock_for(Room.current.id)
        travel_to_ebon_gate! unless @bypass
        @pole = fetch_pole!
        rig_pole!
        enter_dock! unless @bypass || @dock.fishing?(Room.current.id)

        case (outcome = fish)
        when :caught
          process_catch
          pause_script if Config[:pause_me]
        when :lost, :empty
          Config.store[:snap_total] += 1 if outcome == :lost
          familiar(Familiar.loss_line(number: @fight_count, at: Time.now, cast: @cast_distance, depth: @depth, outcome:,
                                      fight: @fight_seconds, reels: @reels, pounds: @pounds))
          waitrt?
          stow_pole
        else
          stow_pole
        end
      end
    end

    private

    def container = Config[:supplies_container]

    def familiar(message)
      Lich::Messaging.stream_window(message, "familiar") if Config[:familiar_debug]
    end

    # Timestamped, so the log shows how long each part of a fight takes.
    def debug(message)
      echo("#{Time.now.strftime('%H:%M:%S')} #{message}") if Config[:debug_my_script]
    end

    # Debug only: LOOK at the pole so the log shows the line's distance,
    # depth and condition at this point.
    def debug_look(label)
      return unless Config[:debug_my_script]

      debug(label)
      # put, not fput: fput clears the script's pending game lines, which can
      # throw away a hook message that just arrived.
      put "look ##{@pole.id}"
    end

    def fail!(*lines)
      lines.each { Lich::Messaging.msg("error", it) }
      exit
    end

    # @return [Boolean] whether the supplies container is a Super-Fish-All Tackle Box
    def tackle? = Config[:tackle_box]

    # @return [Array<GameObj, Tackle::Tray>] what's in the supplies container;
    #   for a tackle box, one entry per piece in its trays
    def supplies_contents
      return Tackle.items(TFish.gaze) if tackle?

      GameObj[container]&.contents || []
    end

    # Gear settings are names the way you'd describe the item ("grey mandrake
    # lure"), which the game won't always accept in a command, so gear is
    # found in the container and always fetched by #id.
    #
    # @param wanted [String] gear setting (pole, line, lure, knife name)
    # @param from [String] container noun
    # @return [GameObj, nil] the item now in hand, nil if none matched
    def get_gear(wanted, from: container, refreshed: false, &only)
      return pluck(wanted, &only) if tackle? && from == container

      item = (GameObj[from]&.contents || []).find { Supplies.named?(it.name, wanted) && (only.nil? || only.(it)) }
      line = dothistimeout("get ##{item.id} from #{TFish.ref(from)}", 2, Regexp.union(Messages::GET_OK, Messages::GET_FAIL)) if item
      return item if line =~ Messages::GET_OK
      fail!("Your hands are full, so you can't get your #{wanted}. In hand: #{TFish.hands.map(&:name).join(', ')}") if line =~ Messages::HANDS_FULL
      return if refreshed

      # Lich's view of the container can be stale; look again and retry once.
      fput "look in #{TFish.ref(from)}"
      pause 0.5
      get_gear(wanted, from:, refreshed: true, &only)
    end

    # Tackle box: brings the tray holding the wanted gear to the top, then
    # PLUCKs one piece from it into hand.
    #
    # @return [GameObj, nil] the item now in hand, nil if no tray holds it
    def pluck(wanted, &only)
      trays = TFish.gaze
      tray = Tackle.pick(trays, wanted, &only) or return
      unless tray.ready || whisper_tray(tray) || tinker_to(tray, trays.size)
        fail!("Couldn't move the #{tray.name} tray to the top of your tackle box.")
      end
      held = TFish.hands.map(&:id)
      # Checked against the reply, not the item: Lich only knows a plucked item by its short name.
      took = Tackle.plucked(dothistimeout("pluck #{TFish.ref(container)}", 2, Tackle::PLUCKED))
      fail!("Plucking your tackle box didn't give you a #{tray.name}. Is a hand free?") unless took&.casecmp?(tray.name)
      held_besides(*held) || fail!("Plucked a #{tray.name} but can't see it in your hands.")
    end

    # WHISPER is the one tackle box verb that won't take an #id: only "my box".
    #
    # @return [Boolean] whether it moved that tray to the top
    def whisper_tray(tray)
      reply = dothistimeout("whisper my box #{tray.number}", 2, Regexp.union(Tackle::WHISPERED, /^USAGE: WHISPER|^What were you/))
      Tackle.whispered(reply)&.casecmp?(tray.name) || false
    end

    # Boxes without WHISPER: TINKER cycles the trays one at a time, so cycle
    # until the wanted gear is on top.
    #
    # @param tries [Integer] trays in the box, so one full cycle
    # @return [Boolean] whether it got there
    def tinker_to(tray, tries)
      tries.times.any? do
        Tackle.tinkered(dothistimeout("tinker my box", 2, Tackle::TINKERED))&.casecmp?(tray.name)
      end
    end

    # Tackle box: the pole hangs ON the box's loops, found with LOOK ON.
    #
    # @return [GameObj, nil] the pole, now in hand
    def pole_from_box
      found = TFish.on_box.find { Supplies.named?(it[:name], Config[:supplies_pole]) } or return
      held = TFish.hands.map(&:id)
      fput "get ##{found[:id]}"
      held_besides(*held)
    end

    # Into the supplies container, or ON a tackle box's loops.
    def put_pole_away = fput("put ##{@pole.id} #{tackle? ? 'on' : 'in'} #{TFish.ref(container)}")

    def check_supplies!
      shortages = Supplies.shortages(supplies_contents)
      return if shortages.empty?

      fail!("YOU NEED MORE SUPPLIES!", *shortages)
    end

    def travel_to_ebon_gate!
      Script.run("go2", @dock.entrance.to_s) unless @dock.here?(Room.current.id)
      return if @dock.here?(Room.current.id)

      fail!("Couldn't get to the #{@dock.name} dock entrance (room #{@dock.entrance}).",
            "Travel there yourself (from another dock's entrance the rafts don't always come), then run ;tfish again.")
    end

    # @return [GameObj] the pole, now in hand
    def fetch_pole!
      pole = tackle? ? pole_from_box : get_gear(Config[:supplies_pole])
      return pole if pole

      fail!(
        "CAN'T FIND YOUR FISHING POLE, CHECK THAT YOU HAVE THE FOLLOWING:",
        "   Fishing Pole: #{Config[:supplies_pole]}",
        "   Supplies Container: #{container}",
        "Set them with:",
        "   ;e UserVars.tfish[:supplies_pole] = \"pole\"",
        "   ;e UserVars.tfish[:supplies_container] = \"cloak\"",
      )
    end

    # @return [Pole::State]
    def look_pole
      Pole.look(@pole.id, quiet: !Config[:debug_my_script]) || fail!("Couldn't read your fishing pole's description.")
    end

    # Restrings, attaches a lure and sets the weight as needed.
    def rig_pole!
      state = look_pole
      if state.line.nil?
        restring
        state = look_pole
      end
      @lure_name, @lure_noun = state.lure ? [state.lure, state.lure_noun] : attach_lure

      # A frayed line only comes off with a lure on it (CUT is refused
      # otherwise), so this comes after attaching one. Fishing it instead
      # risks a snap that takes the lure with it.
      if state.replace?(Config[:replace_line_at])
        restring(cut_old: true)
        state = look_pole
        @lure_name, @lure_noun = state.lure ? [state.lure, state.lure_noun] : attach_lure
      end

      @weight_noun = state.weight_noun
      @weight_name = state.weight
      @cast_index ||= Weights.start_index(@weight_name)
      warn_deep_lure(state)
      debug("Pole: line #{state.line || 'none'}, lure #{@lure_name || 'none'}, weight #{@weight_name || 'none'}")
    end

    # Warns once per run when only fishing the surface with a lure that's
    # better deeper down.
    def warn_deep_lure(state)
      return if @lure_warned || Config.depths != %w[surface]
      return if state.lure.nil? || state.surface_lure?

      @lure_warned = true
      best = state.best_depth
      Lich::Messaging.msg("warn", "Your #{state.lure} is best #{Pole::BONUS_DEPTHS.key(best)} (+#{state.lure_bonus[best]}) " \
                                  "but you're fishing the surface with no weight (+#{state.lure_bonus[:surface]}). " \
                                  "A surface lure levels faster and wears your line less.")
    end

    # A spare "length of" line from the container goes straight on the pole;
    # otherwise PULL on the spool snaps a length off into the other hand, and
    # the spool goes back in the container.
    #
    # @param cut_old [Boolean] cut off the worn line already on the pole first
    def restring(cut_old: false)
      return if cut_old && !cut_line

      put_pole_away
      piece = get_gear("length #{Config[:supplies_line]}")
      unless piece
        spool = get_gear(Config[:supplies_line]) { !Supplies.named?(it.name, "length") }
        fail!("Couldn't find your #{Config[:supplies_line]} in your #{container}.") unless spool
        fput "pull ##{spool.id}"
        piece = held_besides(spool.id, @pole.id)
        fail!("Pulling your #{Config[:supplies_line]} didn't give a length of line.") unless piece
        fput "put ##{spool.id} in #{TFish.ref(container)}"
      end
      reply = dothistimeout("put ##{piece.id} on ##{@pole.id}", 2, Messages::RESTRING_REPLY)
      unless reply =~ Messages::RESTRUNG
        debug("Couldn't restring (#{reply || 'no reply'}), keeping the old line")
        fput "put ##{piece.id} in #{TFish.ref(container)}"
      end
      fput "get ##{@pole.id}"
    end

    # Cuts the worn line off the pole. Anything that was on it (the lure, a
    # weight) drops at your feet, so pick it up and put it back with the
    # supplies; rigging the pole puts it back on afterwards.
    #
    # @return [Boolean] whether the line came off
    def cut_line
      lines = Lich::Util.issue_command("cut ##{@pole.id}", Messages::CUT_REPLY, usexml: true, quiet: !Config[:debug_my_script])
      waitrt?
      text = lines.join("\n")
      return false unless text.include?("snap the line of your")

      Messages.dropped(text).each do |drop|
        item = drop[:id] ? "##{drop[:id]}" : drop[:noun]
        fput "get #{item}"
        fput "put #{drop[:id] ? item : "my #{item}"} in #{TFish.ref(container)}"
      end
      true
    end

    # Puts on the lure for the first depth fished; match_lure swaps it for
    # each cast's depth.
    #
    # @return [Array(String, String)] name and noun of the lure attached
    def attach_lure
      depth = Config.depths.first
      lure = get_gear(Weights.lure_for(depth))
      unless lure
        stow_pole
        lure_missing!(depth)
      end
      fput "put ##{lure.id} on ##{@pole.id}"
      [lure.name, lure.noun]
    end

    # @param depth [String] depth whose lure wasn't found
    def lure_missing!(depth)
      fail!(
        "Couldn't find a #{Weights.lure_for(depth)} in your #{container} for #{depth} fishing. You ran out, or your #{depth} lure setting is wrong.",
        "Set it in ;tfish setup, or with ;e UserVars.tfish[:lure_#{depth}] = \"grey lure\"",
      )
    end

    def remove_weight
      return unless @weight_noun

      take_off_pole(@weight_noun)
      @weight_noun = nil
      @weight_name = nil
    end

    # Attached gear has no #id of its own, so it comes off the pole by noun;
    # once in hand it's put away by #id.
    #
    # @param noun [String] noun of the lure or weight on the pole
    def take_off_pole(noun)
      fput "get #{noun} from ##{@pole.id}"
      item = held_besides(@pole.id)
      fput "put #{item ? "##{item.id}" : "my #{noun}"} in #{TFish.ref(container)}"
    end

    # @param name [String] weight name (or descriptor) to fetch from the container
    def put_weight_on(name)
      weight = get_gear(name) or fail!("Couldn't find a #{name} in your #{container}.")
      fput "put ##{weight.id} on ##{@pole.id}"
      @weight_noun = weight.noun
      @weight_name = weight.name
    end

    # Swaps in the weight for this depth (none at the surface), if it isn't
    # already on.
    #
    # @param depth [String]
    def match_weight(depth)
      weight = Weights.weight_for(depth)
      return if Weights.matches?(@weight_name, weight)

      remove_weight
      put_weight_on(weight) if weight
    end

    # Swaps in the lure set for this depth, if it isn't already on, so
    # changing a lure setting changes the lure on the next cast.
    #
    # @param depth [String]
    def match_lure(depth)
      wanted = Weights.lure_for(depth)
      return if Supplies.named?(@lure_name, wanted)

      # Check there's one before taking the old lure off, which needs the free hand.
      lure_missing!(depth) unless supplies_contents.any? { Supplies.named?(it.name, wanted) }
      take_off_pole(@lure_noun) if @lure_name
      lure = get_gear(wanted) or lure_missing!(depth)
      fput "put ##{lure.id} on ##{@pole.id}"
      @lure_name = lure.name
      @lure_noun = lure.noun
      debug("Lure for #{depth}: #{lure.name}")
    end

    # Casts, lets the line sit until a bite, then reels until it resolves.
    #
    # @return [Symbol] :caught, :lost (snapped), :empty (got away) or :left (walked off the dock)
    def fish
      waitrt?
      depth = Weights.depth(@cast_index)
      distance = Config.cast_distance_for(@cast_index)
      match_weight(depth)
      match_lure(depth)
      @cast_index += 1
      Config.store[:cast_total] += 1
      cast!(distance)
      @cast_at = Time.now
      @pounds = nil
      @cast_distance = distance
      @depth = depth
      debug_look("Cast #{distance} in room #{Room.current.id}")

      bite = wait_for_bite
      return :left unless bite

      @hooked_at = Time.now
      @bite_seconds = (@hooked_at - @cast_at).round
      @fight_count += 1
      if bite == :lost
        @reels = 0
        @fight_seconds = 0
        debug("Line snapped before the fish was reeled")
        return :lost
      end
      debug_look("Hooked")

      # Weighing the pole costs the first ~5s of the fight, where the fish
      # gets a free pull, so it's only done for debugging: it's the one way
      # to know how big a fish was if it snaps the line. Landed fish are
      # weighed after the catch either way.
      if Config[:debug_my_script]
        waitrt?
        @pounds = Messages.pounds(dothistimeout("weigh ##{@pole.id}", 2, Messages::WEIGHT))
        debug("Fish Weight: #{@pounds}") if @pounds
      end

      waitrt?
      reel
    end

    # Casts the line. If the spot is overfished (bypass mode only; there's
    # no overfishing at Ebon Gate), waits and tries again.
    #
    # @param distance [String] near, middle or far
    def cast!(distance)
      loop do
        waitrt?
        reply = dothistimeout("fish cast #{distance}", 3, Regexp.union(Messages::CAST_OK, Messages::CAST_FAIL, Messages::OVERFISHED))
        case reply
        when Messages::CAST_OK
          return
        when Messages::OVERFISHED
          Lich::Messaging.msg("warn", "This spot is overfished, waiting #{Config[:overfished_wait]} seconds before casting again.")
          pause Config[:overfished_wait]
        else
          fail!("Couldn't cast: #{reply || 'no reply'}")
        end
      end
    end

    # @return [Boolean] whether we're still where we should be fishing
    def on_fishing_spot?
      @bypass ? Room.current.id == @home_room : @dock.fishing?(Room.current.id)
    end

    # @return [Symbol, nil] :hooked, :lost if the line snapped first, nil if
    #   we left the fishing spot
    def wait_for_bite
      loop do
        _respond "<castTime value='#{Time.now.to_i - XMLData.server_time_offset + Config[:cast_timer]}'/>"
        line = matchtimeout(Config[:cast_timer], Messages::BITE_WAIT)
        if line
          _respond "<castTime value='#{Time.now.to_i - XMLData.server_time_offset}'/>"
          debug("Fish already on the line; the hook message was missed") if line !~ Messages::HOOKED && line !~ Messages::LOST
          return line =~ Messages::LOST ? :lost : :hooked
        end
        unless on_fishing_spot?
          fail!("You left the room you started fishing in. Run ;tfish again where you want to fish.") if @bypass
          return
        end

        debug_look("Still waiting for a bite")
      end
    end

    # Reels until the fish is landed, snaps the line, or gets away (the line
    # comes back empty). No reply at all three times in a row counts as away.
    #
    # @return [Symbol] :caught, :lost or :empty
    def reel
      reels = 0
      silent = 0
      loop do
        waitrt?
        outcome = Messages.reel_outcome(dothistimeout("fish reel", 5, Messages::REEL_REPLY))
        reels += 1
        @reels = reels
        @fight_seconds = (Time.now - @hooked_at).round
        outcome = :caught if catch_in_hand
        debug("Reel #{reels}: #{outcome || 'no reply'}")
        case outcome
        when :caught, :lost, :empty
          debug_look("#{outcome.to_s.capitalize} after #{reels} reels, #{(Time.now - @hooked_at).round}s on the line")
          fput "fish total" if Config[:debug_my_script] && outcome != :caught # a catch reads it anyway
          return outcome
        when nil
          silent += 1
          return :empty if silent >= 3
        else
          silent = 0
          debug_look("Line check after #{reels} reels") if (reels % 5).zero?
        end
      end
    end

    # @return [GameObj, nil] whatever is in hand that isn't the pole
    def catch_in_hand
      TFish.hands.find { it.id != @pole&.id }
    end

    # What's in hand besides the given items. Lich updates hands a moment
    # after the game's reply, so this checks again for up to `wait` seconds.
    #
    # @param ids [Array<String, nil>] ids of items to ignore
    # @return [GameObj, nil]
    def held_besides(*ids, wait: 2)
      deadline = Time.now + wait
      loop do
        item = TFish.hands.find { !ids.include?(it.id) }
        return item if item || Time.now > deadline

        sleep 0.1
      end
    end

    def stow_pole
      waitrt?
      put_pole_away if TFish.hands.any? { it.id == @pole&.id }
    end

    # Weighs, fillets and stores the catch and anything found inside it.
    def process_catch
      pause 1
      waitrt?
      fish = catch_in_hand
      Config.store[:fish_total] += 1
      stow_pole

      # Outside Ebon Gate the fish's LOOK states its rarity; Ebon Gate fish
      # don't, so there it comes from which FISH TOTAL count went up.
      looked = dothistimeout("look ##{fish.id}", 2, Messages::QUALITY)&.[](Messages::QUALITY, :rarity) if @bypass
      totals = read_totals
      rarity = looked || Messages.new_rarity(@totals, totals)
      @totals = totals unless totals.empty?
      caught = rarity ? "#{fish.name} (#{rarity})" : fish.name
      pounds = Messages.pounds(dothistimeout("weigh ##{fish.id}", 2, Messages::WEIGHT))
      waitrt?
      knife = get_gear(Config[:fillet_knife], from: Config[:knife_container])
      # Captured as XML so it ends at the prompt; the prize line comes before
      # the roundtime.
      cut = knife ? "cut ##{fish.id} with ##{knife.id}" : "cut ##{fish.id}"
      text = Lich::Util.issue_command(cut, Messages::CUT_FISH, usexml: true).join("\n").gsub(/<[^>]*>/, "")
      if (prize = text[Messages::FOUND, :item]) && Config[:announce_finds]
        Lich::Messaging.stream_window("#{Time.now.strftime('%H:%M:%S')} - #{caught}: #{prize}", "familiar")
      end
      if text.match?(Messages::INSPECT_ALERT)
        3.times { Lich::Messaging.msg("error", "POSSIBLE T5+ FOUND, LOOK AT ME!") }
        pause_script
      end
      pause 1
      waitrt?

      trashed = Config[:trash_cut] ? trash_fillets(knife&.id, @pole&.id) : []
      fput "put ##{knife.id} in #{TFish.ref(Config[:knife_container])}" if knife

      # Hands can still list the knife for a moment after it's put away.
      found = held_besides(knife&.id, @pole&.id, *trashed, wait: 1)
      if found
        multifput "analyze ##{found.id}", "inspect ##{found.id}", "look at ##{found.id}", "look in ##{found.id}"
        fput "put ##{found.id} in #{TFish.ref(Vars.lootsack)}"
      end
      familiar(Familiar.catch_line(number: @fight_count, at: Time.now, cast: @cast_distance, depth: @depth, fish: fish.name,
                                   rarity:, pounds:, bite: @bite_seconds, fight: @fight_seconds, reels: @reels, prize:))
    end

    # FISH TOTAL, captured as XML so it ends at the prompt.
    #
    # @return [Hash{String => Integer}] rarity => fish caught, empty if unreadable
    def read_totals
      lines = Lich::Util.issue_command("fish total", /Fishing Totals/, usexml: true, quiet: !Config[:debug_my_script])
      Messages.totals(lines.join("\n").gsub(/<[^>]*>/, ""))
    end

    # Trashes the fillet in hand and any fish carcass on the ground.
    #
    # @param keep [Array<String, nil>] ids never to trash: the knife (a
    #   "fillet knife" matches /fillet/ too) and the pole
    # @return [Array<String>] ids of what was trashed
    def trash_fillets(*keep)
      fillets = TFish.hands.select { it.name =~ /fillet/ && !keep.include?(it.id) } + Array(GameObj.loot).select { it.noun == "fish" }
      fillets.each { fput "trash ##{it.id}" }
      fillets.map(&:id)
    end

    def enter_dock!
      fput "stand" until standing? || checkdead
      exit if checkdead

      line = dothistimeout("go dock", 2, Regexp.union(Messages::DOCK_NO_SHARDS, Messages::DOCK_CONFIRM, Messages::DOCK_BLOCKED))
      case line
      when Messages::DOCK_BLOCKED
        stow_pole
        fail!("Something is still at your feet, which stops you going onto the dock. Pick it up, then run ;tfish again.")
      when Messages::DOCK_NO_SHARDS
        stow_pole
        fail!("You need to redeem more soul shards!")
      when Messages::DOCK_CONFIRM
        fput "go dock"
      else
        fail!("Couldn't get onto the dock. Unexpected reply: #{line.inspect}")
      end

      room = Config[:fav_room].to_i
      unless @dock.fishing?(room)
        counts = @dock.spots.to_h do |id|
          Script.run("go2", id.to_s)
          [id, Rooms.crowd(GameObj.pcs)]
        end
        room = Rooms.least_crowded(counts)
      end
      Script.run("go2", room.to_s)
    end
  end

  module_function

  # @return [Array<GameObj>] items currently held, empty hands excluded
  def hands = [GameObj.right_hand, GameObj.left_hand].compact.select(&:id)

  # @param name [String] a container setting ("cloak")
  # @return [String] the container as "#id" when Lich can see it, else "my <name>"
  def ref(name) = (container = GameObj[name]) ? "##{container.id}" : "my #{name}"

  # @return [Array<Tackle::Tray>] the tackle box's trays
  def gaze = Tackle.trays(Lich::Util.issue_command("gaze #{ref(Config[:supplies_container])}", Tackle::GAZE_START, usexml: true, quiet: !Config[:debug_my_script]).join("\n"))

  # @return [Array<Hash>] :id, :noun and :name of each item on the tackle box's loops
  def on_box = Tackle.on_box(Lich::Util.issue_command("look on #{ref(Config[:supplies_container])}", /On the /, usexml: true, quiet: true).join("\n"))

  # @return [Array<String>] containers to LOOK IN so Lich knows their
  #   contents; a tackle box is read with GAZE instead
  def look_in_containers = [(Config[:supplies_container] unless Config[:tackle_box]), Config[:knife_container]].compact.uniq

  # `;tfish check`: looks in the containers and at the pole, then reports
  # whether everything the current settings need was found.
  #
  # @return [void]
  def check_setup
    look_in_containers.each { fput "look in #{ref(it)}" }
    pause 0.5
    knife_box = GameObj[Config[:knife_container]]&.contents || []
    if Config[:tackle_box]
      # Tray gear has no #id to LOOK at, so weights' sink depths aren't checked.
      supplies = Tackle.items(gaze)
      pole_id = on_box.find { Supplies.named?(it[:name], Config[:supplies_pole]) }&.[](:id)
      sinks = {}
    else
      supplies = GameObj[Config[:supplies_container]]&.contents || []
      pole_id = supplies.find { Supplies.named?(it.name, Config[:supplies_pole]) }&.id
      sinks = weight_sinks(supplies)
    end
    state = (Pole.look(pole_id, quiet: true) if pole_id)

    rows = Supplies.check(supplies, knife_box, state, sinks)
    rows << [Vars.lootsack.to_s.empty? ? :missing : :ok, "Lootsack: #{Vars.lootsack.to_s.empty? ? 'not set (;vars set lootsack=...)' : Vars.lootsack}"]
    rows << [Script.exists?("tsquelch.lic") ? :ok : :missing, "Squelching needs ;tsquelch installed"] if Config[:squelch_script]
    where = Config.bypass? ? "fishing where you stand" : "dock #{Rooms.dock.name}"
    report("tfish check: depths #{Config.depths.join('/')}, cast #{Config.distances.join('/')}, #{where}", rows,
           failed: "Fix the MISSING items before fishing (;tfish list shows your settings).", passed: "Everything needed was found.")
  end

  # LOOKs at one of each weight the settings use, for ;tfish check.
  #
  # @param supplies [Array<GameObj>] supplies container contents
  # @return [Hash{String => String}] weight setting => where it sinks
  def weight_sinks(supplies)
    Supplies.weights_in_use.keys.to_h do |name|
      weight = supplies.find { Supplies.named?(it.name, name) }
      [name, (Weights.sink_depth(dothistimeout("look ##{weight.id}", 2, /heavy enough to sink a line|You see nothing unusual/)) if weight)]
    end.compact
  end

  # @param title [String]
  # @param rows [Array<Array(Symbol, String)>] [:ok, :missing or :warn, description]
  # @param failed [String] closing line when anything is :missing
  # @param passed [String] closing line otherwise
  # @return [void]
  def report(title, rows, failed:, passed:)
    labels = { ok: "  OK  ", missing: "MISSING", warn: " WARN " }
    Lich::Messaging.mono(<<~REPORT)
      #{title}
      #{rows.map { |status, text| "  [#{labels[status]}] #{text}" }.join("\n")}
      #{rows.any? { it.first == :missing } ? failed : passed}
    REPORT
  end

  # Script entry point.
  #
  # @return [void]
  # `;tfish setup`: the settings window, where GTK3 is available.
  def open_setup
    unless defined?(Gtk) && Gtk::Version::MAJOR == 3
      Lich::Messaging.msg("error", "The setup window needs GTK3. Change settings with ;e UserVars.tfish[:setting] = value (see ;tfish help).")
      return
    end
    if SetupWindow.new.show
      Lich::Messaging.msg("info", "tfish settings saved. Run ;tfish check to confirm your gear is found.")
    else
      Lich::Messaging.msg("info", "tfish setup closed without saving.")
    end
  end

  def start
    Config.setup!.each { Lich::Messaging.msg("info", it) }
    arg = Script.current.vars[1]&.downcase
    if arg == "help"
      respond "\n#{HELP_TEXT}"
      return
    end
    if arg == "list"
      Lich::Messaging.mono(Config.listing)
      return
    end
    if arg == "check"
      check_setup
      return
    end
    if arg == "setup"
      open_setup
      return
    end
    if arg == "bypass"
      Lich::Messaging.msg("warn", "Bypass is now a setting: Fishing mode in ;tfish setup, or ;e UserVars.tfish[:fishing_mode] = \"bypass\"")
      return
    end
    bypass = Config.bypass?

    silence_me unless Config[:debug_my_script]
    if hands.any?
      Lich::Messaging.msg("error", "Please empty your hands before running this script.")
      return
    end
    if Vars.lootsack.to_s.empty?
      Lich::Messaging.msg("error", "Set your lootsack first: ;vars set lootsack=cloak")
      return
    end
    # ;tsquelch only knows Ebon Gate's fishing rooms
    return unless bypass || start_squelch

    register_shutdown_hook
    register_toggle_hook
    # So Lich knows what's in them, for fetching gear by #id.
    look_in_containers.each { fput "look in #{ref(it)}" }
    pause 0.5
    Runner.new(bypass:).run
  end

  # Starts ;tsquelch if enabled and not already running.
  #
  # @return [Boolean] false if squelching is enabled but tsquelch isn't installed
  def start_squelch
    return true unless Config[:squelch_script]

    unless Script.exists?("tsquelch.lic")
      Lich::Messaging.msg("error", "You need ;tsquelch to squelch. Either ;repo download tsquelch, or disable it with ;e UserVars.tfish[:squelch_script] = false")
      return false
    end
    @started_squelch = !Script.running?("tsquelch")
    Script.start("tsquelch") if @started_squelch
    true
  end

  # Typing toggletfish while fishing turns pause_me on or off without
  # stopping the script. Removed again when the script ends.
  #
  # @return [void]
  def register_toggle_hook
    UpstreamHook.add("tfish_toggle", proc do |client_string|
      next client_string unless client_string.match?(Messages::TOGGLE)

      Config.store[:pause_me] = !Config[:pause_me]
      respond "[tfish] Pause after each catch is now #{Config[:pause_me] ? 'on' : 'off'}."
      nil
    rescue StandardError => e
      respond "[tfish] toggletfish failed: #{e.message}"
      UpstreamHook.remove("tfish_toggle")
      client_string
    end)
  end

  # Stops ;tsquelch if we started it, and stores fishing gear left in hand.
  #
  # @return [void]
  def register_shutdown_hook
    before_dying do
      UpstreamHook.remove("tfish_toggle")
      Script.kill("tsquelch") if @started_squelch && Script.running?("tsquelch")
      gear = {
        Config[:supplies_pole] => Config[:supplies_container],
        "weight"               => Config[:supplies_container],
        "lure"                 => Config[:supplies_container],
        Config[:supplies_line] => Config[:supplies_container],
        Config[:fillet_knife]  => Config[:knife_container],
      }
      hands.each do |item|
        destination = gear.find { |wanted, _| Supplies.named?(item.name, wanted) }&.last
        next unless destination

        pole_on_box = Config[:tackle_box] && Supplies.named?(item.name, Config[:supplies_pole])
        fput "put ##{item.id} #{pole_on_box ? 'on' : 'in'} #{ref(destination)}"
      end
    end
  end
end

TFish.start
