=begin

  Chat client for Lich.

  ;lnet help

    author: Tillmen (tillmen@lichproject.org)
      game: any
      tags: core
  required: Lich > 5.0.1
   version: 1.20

  changelog:
    1.20 (2026-11-05):
      Scripts can answer their own request types with LNet.add_callback (from 0net);
        like the stock ones, they are answered only for players you allow;
        it takes (type) { |request| ... }, without 0net's name argument
      Friend, enemy and ignore lists ignore case, so an old dr:Bob entry matches DR:Bob
      Start your own lnet-callbacks script, if you have one, with lnet
      LNet.safe_send sends at most one message every 3 seconds (from 0net)
      locate replies include the map room id, for go2 lookups (from 0net)
      Always answer a request, so a failed or unavailable one (e.g. skills in
        DragonRealms) is declined at once instead of timing out
    1.19 (2026-11-05):
      Refuse LNet replies that would take too much memory or time to show
    1.18 (2026-11-05):
      A server certificate with the wrong name no longer closes Lich
      Writes from different threads no longer interleave on the connection
      Sending while disconnected returns false instead of silently doing nothing
      Skip reading after a failed connection; a failed write reconnects
    1.17 (2026-11-05):
      Stop losing messages that arrive together with another LNet message
      A comment, CDATA or DOCTYPE from the server no longer drops the connection
    1.16 (2026-10-25):
      Ignore LNet replies that contain anything other than plain data, and say so
      Escape LNet names/channels in XML output, strip control codes and line breaks
      Stop sending each chat line to scripts twice on Wizard/Avalon
    1.15 (2026-03-29):
      Harden ssl criteria and set Timeout with rescue
    1.14 (2025-09-19):
      Add safeguards to REXML streams for non-valid XML, allows newer REXML ruby gem usage
    1.13 (2025-06-01):
      change class checks to is_a? checks
    1.12 (2024-12-14):
      put in prevention to not run on newer REXML gem versions (3.3.2+) due to compatibility issue
    1.11 (2024-06-06):
      Add option for custom preset highlights for lnet (none, lnet, thoughts)
    1.10 (2024-06-05):
      Update SSL cert (thanks Tillmen!!)
    1.9 (2024-01-08):
      Remove combat leadership skill
    1.8 (2023-11-08):
      rubocop cleanup
      remove spell-ranks data collection
      remove forage tracking thread that reported to lnet servers
    1.7 (2022-11-23):
      removed references to $SAFE
      rearranged some single line defs to be more readable
    1.6 (2016-01-10):
      fixed room id lookup for ;locate command
      added alias feature
    1.5 (2015-11-25):
      added reply command (DR:Etreu)
    1.4 (2015-05-13):
      move channel owners and moderators to the front of the ;who list

=end
=begin

    1.3 (2015-01-21):
      give a warning if the system date is outside the range of the CA cert date
      disable SSLv2 and SSLv3
    1.2 (2015-01-16):
      new host name
    1.1 (2014-10-25):
      workaround to deal with the plat_updater script disabling OpenSSL::SSL::VERIFY_PEER

=end

$lnet_debug = false

# fixme: option to separate private messages to familiar window
# fixme: scrub

require 'openssl'
require 'rexml/document'
require 'timeout'

toggle_unique
clear
hide_me

class LNet
  # Lich keeps classes for the whole session, so running a newer lnet reopens
  # this one. Drop the constants an earlier copy of this file defined, so each
  # comes from this file; constants other scripts add to LNet (inbox.lic's
  # LNet::Inbox) are left alone.
  %i[HOSTNAME PORT CONNECT_TIMEOUT TRUSTED_COMMON_NAMES PROTOCOL_VERSION KEEPALIVE_INTERVAL RECONNECT_INTERVAL RESTART_WAIT SAFE_SEND_INTERVAL USER_CALLBACKS_SCRIPT CA_CERTIFICATE StreamParser SafeMarshal Responders MARSHAL_MAX_DEPTH].each { |name| remove_const(name) if const_defined?(name, false) }

  @@server    ||= nil
  @@script    ||= nil
  @@options   ||= Hash.new
  @@waiting   ||= Array.new
  @@last_recv ||= Time.now
  @@last_send ||= Time.now
  @@last_priv ||= nil
  @@secret    ||= Array.new
  @@alias     ||= Hash.new
  @@write_lock ||= Mutex.new
  @@callbacks ||= Hash.new
  # Another script sharing this class in the Lich session (0net did) may have
  # left other objects here; only blocks from LNet.add_callback are handlers.
  @@callbacks = Hash.new unless @@callbacks.is_a?(Hash)
  @@callbacks.select! { |_type, handler| handler.is_a?(Proc) }
  @@last_safe_send ||= nil

  @@server_restart = false

  # LNet server address.
  HOSTNAME = 'lnet.lichproject.org'
  PORT = 7155
  # Seconds allowed for each of the TCP connect and the TLS handshake.
  CONNECT_TIMEOUT = 10
  # Common names a server certificate signed by CA_CERTIFICATE may carry.
  TRUSTED_COMMON_NAMES = %w[lichproject.org LichNet].freeze
  # Client protocol version sent at login; the server decides what it means.
  PROTOCOL_VERSION = '1.6'
  # Seconds without sending anything before a keepalive is sent.
  KEEPALIVE_INTERVAL = 50
  # Least seconds between two connection attempts.
  RECONNECT_INTERVAL = 300
  # Seconds to wait after the server announces a restart.
  RESTART_WAIT = 30
  # Least seconds between two LNet.safe_send messages.
  SAFE_SEND_INTERVAL = 3
  # A script of the user's own that lnet starts so it can add callbacks.
  USER_CALLBACKS_SCRIPT = 'lnet-callbacks'
  # The only certificate authority LNet trusts.
  CA_CERTIFICATE = "-----BEGIN CERTIFICATE-----\nMIIDoDCCAoigAwIBAgIUYwhIyTlqWaEd5mYGXoQQoC+ndKcwDQYJKoZIhvcNAQEL\nBQAwYTELMAkGA1UEBhMCVVMxETAPBgNVBAgMCElsbGlub2lzMRIwEAYDVQQKDAlN\nYXR0IExvd2UxDzANBgNVBAMMBlJvb3RDQTEaMBgGCSqGSIb3DQEJARYLbWF0dEBp\nbzQudXMwHhcNMjQwNjA1MTM1NzUxWhcNNDQwNTMxMTM1NzUxWjBhMQswCQYDVQQG\nEwJVUzERMA8GA1UECAwISWxsaW5vaXMxEjAQBgNVBAoMCU1hdHQgTG93ZTEPMA0G\nA1UEAwwGUm9vdENBMRowGAYJKoZIhvcNAQkBFgttYXR0QGlvNC51czCCASIwDQYJ\nKoZIhvcNAQEBBQADggEPADCCAQoCggEBAJwhGfQgwI1h4vlqAqaR152AlewjJMlL\nyoqtjoS9Cyri23SY7c6v0rwhoOXuoV1D2d9InmmE2CgLL3Bn2sNa/kWFjkyedUca\nvd8JrtGQzEkVH83CIPiKFCWLE5SXLvqCVx7Jz/pBBL1s173p69kOy0REYAV/OAdj\nioCXK6tHqYG70xvLIJGiTrExGeOttMw2S+86y4bSxj2i35IscaBTepPv7BWH8JtZ\nyN4Xv9DBr/99sWSarlzUW6+FTcNqdJLP5W5a508VLJnevmlisswlazKiYNriCQvZ\nsnmPJrYFYMxe9JIKl1CA8MiUKUx8AUt39KzxkgZrq40VxIrpdxrnUKUCAwEAAaNQ\nME4wHQYDVR0OBBYEFJxuCVGIbPP3LO6GAHAViOCKZ4HIMB8GA1UdIwQYMBaAFJxu\nCVGIbPP3LO6GAHAViOCKZ4HIMAwGA1UdEwQFMAMBAf8wDQYJKoZIhvcNAQELBQAD\nggEBAGKn0vYx9Ta5+/X1WRUuADuie6JuNMHUxzYtxwEba/m5lA4nE5f2yoO6Y/Y3\nLZDX2Y9kWt+7pGQ2SKOT79gNcnOSc3SGYWkX48J6C1hihhjD3AfD0hb1mgvlJuij\nzNnZ7vczOF8AcvBeu8ww5eIrkN6TTshjICg71/deVo9HvjhiCGK0XvL+WL6EQwLe\n6/nVVFrPfd0sRZZ5OTJR5nM1kA71oChUw9mHCyrAc3zYyW37k+p8ADRFfON8th8M\n1Blel1SpgqlQ22WpYoHbUCSjGt6JKC/HrSHdKBezTuRahOSfqwncAE77Dz4FJaQ5\nWD2mk3SZbB2ytAHUDEy3xr697EI=\n-----END CERTIFICATE-----".freeze

  # Prints a diagnostic line when LNet debugging is switched on.
  #
  # @param message [String]
  # @return [void]
  def LNet.debug(message)
    echo(message) if $lnet_debug
  end

  # Cuts the server's byte stream into complete top-level XML elements and
  # hands each one, as tag/text events, to a listener.
  #
  # The server writes one element after another on a single TLS stream with
  # no other framing, and REXML 3.3.2+ can no longer parse straight from a
  # socket. This class buffers what arrives, finds where each top-level
  # element ends by counting nested tags (so two elements that arrive in one
  # read are never mistaken for one), and parses every element on its own:
  # a broken element costs only itself, never the connection or the
  # elements around it.
  #
  # Each element is parsed into a tree before any event is sent, so an
  # element is either delivered whole or not at all; the listener never sees
  # the start of an element whose end failed to parse.
  class StreamParser
    # One markup token: a comment, a CDATA section, the opening of a comment
    # or CDATA section whose end hasn't arrived yet, a declaration or
    # processing instruction, or a tag. Tags capture the closing slash (1),
    # the name (2) and the self-closing slash (3); quoted attribute values may
    # contain '>'. A tag can't contain '<' (the server escapes it), so a stray
    # '<' in the stream never swallows the tag after it.
    TOKEN = %r{<!--.*?-->|<!\[CDATA\[.*?\]\]>|(?:<!--|<!\[CDATA\[)|<!(?!--|\[CDATA\[)[^>]*>|<\?[^>]*>|<(/?)([A-Za-z_:][-.\w:]*)(?:[^<>"']|"[^"]*"|'[^']*')*?(/?)>}m

    # Elements the server sends at the top level. None contains another, so
    # one starting inside an element means that element was never closed.
    TOP_LEVEL = %w[message data request notify ping].freeze

    # Largest unfinished element kept before the buffer is thrown away. The
    # server's biggest known reply (spell ranks) is under 2 MB.
    MAX_BUFFER = 16 * 1024 * 1024

    # @param listener [#tag_start, #text, #tag_end] receives the events of
    #   each complete element, in document order
    def initialize(listener)
      @listener = listener
      @buffer = String.new(encoding: Encoding::BINARY)
      reset_scan
    end

    # Adds bytes read from the server and delivers every element they
    # complete.
    #
    # @param chunk [String] raw bytes, in any encoding
    # @return [Integer] the number of elements delivered
    def feed(chunk)
      @buffer << chunk.b
      delivered = 0
      while (element = next_element)
        deliver(element)
        delivered += 1
      end
      overflow! if @buffer.bytesize > MAX_BUFFER
      delivered
    end

    private

    def reset_scan
      @scan_pos = 0
      @gt_seen = 0
      @start = nil
      @depth = 0
    end

    # Continues scanning where the last call stopped, so an element that
    # arrives in many chunks is scanned once, not once per chunk.
    #
    # @return [String, nil] the next complete element, or nil if the buffer
    #   holds only part of one
    def next_element
      while token_can_end? && (match = TOKEN.match(@buffer, @scan_pos))
        if match[0] == '<!--' || match[0] == '<![CDATA['
          # a comment or CDATA section still arriving: wait for its end rather
          # than read the markup inside it as tags
          @scan_pos = match.begin(0)
          @gt_seen = @buffer.bytesize
          return nil
        end
        @scan_pos = match.end(0)
        name = match[2]
        if @start.nil?
          next unless name # comments, declarations and stray text between elements

          @start = match.begin(0)
        elsif name && match[1] != '/' && TOP_LEVEL.include?(name)
          LNet.debug('dropping an element the server never closed')
          @start = match.begin(0)
          @depth = 0
        end
        if name
          if match[1] == '/'
            @depth -= 1
          elsif match[3] != '/'
            @depth += 1
          end
        end
        next if @depth.positive?

        element = @buffer.byteslice(@start, @scan_pos - @start)
        @buffer = @buffer.byteslice(@scan_pos, @buffer.bytesize - @scan_pos)
        reset_scan
        return element
      end
      # No complete token is left. One still arriving can only start at a
      # '<', so the next scan resumes at the first one instead of rescanning
      # a long element from where its last token ended.
      @scan_pos = @buffer.index('<', @scan_pos) || @buffer.bytesize
      @gt_seen = @buffer.bytesize
      drop_leading_text if @start.nil?
      nil
    end

    # A token can only end at a '>'. Looks only past where the last fruitless
    # scan reached, so a long tag that hasn't ended is not rescanned on every
    # read.
    #
    # @return [Boolean] whether a '>' arrived since then
    def token_can_end?
      !@buffer.index('>', [@scan_pos, @gt_seen].max).nil?
    end

    # Between elements, everything before the next '<' is stray text that can
    # never become part of an element.
    def drop_leading_text
      @gt_seen = [@gt_seen - @scan_pos, 0].max
      @buffer = @buffer.byteslice(@scan_pos, @buffer.bytesize - @scan_pos)
      @scan_pos = 0
    end

    def overflow!
      LNet.debug("discarding #{@buffer.bytesize} bytes of an element that never ended")
      @buffer = String.new(encoding: Encoding::BINARY)
      reset_scan
    end

    # Parses one element and sends its events. An element that is not
    # well-formed gets one repair attempt (see #repair); if that fails too it
    # is dropped.
    #
    # @param element [String] one complete top-level element, as bytes
    # @return [void]
    def deliver(element)
      text = element.dup.force_encoding(Encoding::UTF_8)
      text = text.scrub('?') unless text.valid_encoding?
      root = parse(text) || parse(repair(text))
      if root
        walk(root)
      else
        LNet.debug("dropped an element that is not valid XML: #{text[0, 200]}")
      end
    rescue StandardError, ScriptError, SystemStackError => e
      LNet.debug("error handling an element: #{e.class}: #{e.message}")
    end

    # @return [REXML::Element, nil]
    def parse(text)
      REXML::Document.new(text).root
    rescue StandardError => e
      LNet.debug("XML parse error: #{e.message.lines.first.to_s.strip}")
      nil
    end

    # Removes control characters XML forbids and escapes a '&' or '<' that
    # cannot start an entity or a tag.
    #
    # @param text [String]
    # @return [String]
    def repair(text)
      text.gsub(/[\x00-\x08\x0B\x0C\x0E-\x1F]/, '')
          .gsub(/&(?!(?:amp|lt|gt|quot|apos|#\d+|#x\h+);)/, '&amp;')
          .gsub(%r{<(?![/!?A-Za-z_:])}, '&lt;')
    end

    # Sends an element's events to the listener in document order. CDATA is
    # delivered as text; comments and processing instructions are skipped.
    # Walks with its own stack, so no nesting depth can overflow Ruby's.
    #
    # @param root [REXML::Element]
    # @return [void]
    def walk(root)
      pending = [[:open, root]]
      until pending.empty?
        step, node = pending.pop
        if step == :close
          @listener.tag_end(node.name)
        elsif node.is_a?(REXML::Element)
          attributes = {}
          node.attributes.each_attribute { |attribute| attributes[attribute.expanded_name] = attribute.value }
          @listener.tag_start(node.name, attributes)
          pending.push([:close, node])
          node.children.reverse_each { |child| pending.push([:open, child]) }
        elsif node.is_a?(REXML::Text)
          @listener.text(node.value)
        end
      end
    end
  end

  # @return [OpenSSL::SSL::SSLSocket, nil] the socket to the server (closed
  #   while disconnected), nil before the first connection
  def LNet.server
    @@server
  end

  # @param val [OpenSSL::SSL::SSLSocket, nil]
  def LNet.server=(val)
    @@server = val
  end

  # @return [Script, nil] the running lnet script
  def LNet.script
    @@script
  end

  # @param val [Script, nil]
  def LNet.script=(val)
    @@script = val
  end

  # @return [Hash] the character's LNet options (saved by Lich)
  def LNet.options
    @@options
  end

  # @param val [Hash]
  def LNet.options=(val)
    @@options = val
  end

  # @return [Hash{String => String}] display names for LNet senders
  def LNet.alias
    @@alias
  end

  # @param val [Hash{String => String}]
  def LNet.alias=(val)
    @@alias = val
  end

  # @return [Boolean] whether the server announced a restart
  def LNet.server_restart
    @@server_restart
  end

  # @param val [Boolean]
  def LNet.server_restart=(val)
    @@server_restart = val
  end

  # @param val [Array] the saved one-element array holding the password
  def LNet.store_secret=(val)
    @@secret = val
  end

  # @param val [String, nil] the LNet password, nil for none
  def LNet.secret=(val)
    @@secret[0] = val
  end

  # @return [Time] when anything was last written to the server
  def LNet.last_send
    @@last_send
  end

  # @return [Time] when anything was last read from the server
  def LNet.last_recv
    @@last_recv
  end

  # @return [String, nil] who sent the last private message
  def LNet.last_priv
    @@last_priv
  end

  # @return [Boolean] whether there is an open connection to the server
  def LNet.connected?
    server = @@server
    !server.nil? && !server.closed?
  end

  # Connects to the server and logs in. Never raises and never ends the
  # process: a refused certificate, a timeout or a network error is reported
  # and returns false.
  #
  # @return [Boolean] true once the login has been sent
  def LNet.connect
    LNet.disconnect
    warning = LNet.certificate_date_warning(LNet.ca_certificate, Time.now)
    if warning
      respond warning
      sleep 3
    end
    ssl_socket = LNet.open_tls
    LNet.debug(ssl_socket.peer_cert.inspect)
    unless LNet.trusted_peer?(ssl_socket.peer_cert)
      echo 'error: server certificate hostname mismatch'
      ssl_socket.close
      return false
    end
    # the login goes out before anything else can use the connection
    @@write_lock.synchronize { ssl_socket.puts(LNet.document('login', LNet.login_attributes).to_s) }
    @@last_send = Time.now
    @@server = ssl_socket
    true
  rescue Timeout::Error
    echo 'error: LNet connection timed out during TCP connect or SSL handshake'
    false
  rescue StandardError => e
    echo "error: LNet connection failed: #{e.message}"
    LNet.debug(e.backtrace.first(2).join("\n"))
    false
  ensure
    # a socket that never became the connection (refused, or the thread killed)
    unless ssl_socket.nil? || @@server.equal?(ssl_socket) || ssl_socket.closed?
      begin
        ssl_socket.close
      rescue StandardError
        nil
      end
    end
  end

  # Opens the TLS connection, closing whatever it opened if a step fails or
  # the thread is killed.
  #
  # @return [OpenSSL::SSL::SSLSocket] a connected socket whose peer
  #   certificate chains to CA_CERTIFICATE
  # @raise [Timeout::Error, SystemCallError, OpenSSL::SSL::SSLError]
  def LNet.open_tls
    opened = false
    LNet.debug("opening TCP socket to #{HOSTNAME}:#{PORT}")
    socket = Timeout.timeout(CONNECT_TIMEOUT) { TCPSocket.open(HOSTNAME, PORT) }
    ssl_socket = OpenSSL::SSL::SSLSocket.new(socket, LNet.ssl_context)
    ssl_socket.sync_close = true
    ssl_socket.hostname = HOSTNAME
    LNet.debug('starting SSL handshake')
    Timeout.timeout(CONNECT_TIMEOUT) { ssl_socket.connect }
    LNet.debug('SSL handshake complete')
    opened = true
    ssl_socket
  ensure
    [ssl_socket, socket].each { |io| io&.close rescue nil } unless opened
  end

  # @return [OpenSSL::X509::Certificate]
  def LNet.ca_certificate
    OpenSSL::X509::Certificate.new(CA_CERTIFICATE)
  end

  # @return [OpenSSL::SSL::SSLContext] verifies the peer against
  #   CA_CERTIFICATE alone, never the system store
  def LNet.ssl_context
    store = OpenSSL::X509::Store.new
    store.add_cert(LNet.ca_certificate)
    context = OpenSSL::SSL::SSLContext.new
    context.cert_store = store
    context.options = OpenSSL::SSL::OP_NO_SSLv2 | OpenSSL::SSL::OP_NO_SSLv3
    context.verify_mode = OpenSSL::SSL::VERIFY_PEER
    context
  end

  # @param cert [OpenSSL::X509::Certificate, nil]
  # @return [Boolean] whether the certificate names a trusted LNet server
  def LNet.trusted_peer?(cert)
    common_name = cert&.subject&.to_a&.find { |entry| entry[0] == 'CN' }&.at(1)
    TRUSTED_COMMON_NAMES.include?(common_name)
  end

  # @param cert [OpenSSL::X509::Certificate]
  # @param now [Time]
  # @return [String, nil] why the certificate will fail to verify on this
  #   computer, or nil if its dates are fine
  def LNet.certificate_date_warning(cert, now)
    if cert.not_before > now
      "\n---\n--- warning: The current date is set incorrectly on your computer. This will\n---          cause the SSL certificate verification to fail and prevent LNet\n---          from connecting to the server.  Fix it.\n---\n\n"
    elsif cert.not_after < now
      "\n---\n--- warning: Your computer thinks the date is #{now.strftime('%m-%d-%Y')}.  If this is the\n---          correct date, you need an updated version of this script.  If \n---          this is not the correct date, you need to change it.  In either\n---          case, this date makes the SSL certificate in this script\n---          invalid and will prevent LNet from connecting to the server.\n---\n\n"
    end
  end

  # @return [Hash{String => String, nil}] the login element's attributes;
  #   the password is left out when none is saved
  def LNet.login_attributes
    {
      'name'     => XMLData.name,
      'game'     => XMLData.game,
      'client'   => PROTOCOL_VERSION,
      'lich'     => $version,
      'password' => @@secret[0],
    }
  end

  # Closes the connection. LNet.server keeps the closed socket, as it always
  # has, so a script checking LNet.server.closed? sees the disconnect.
  # Passing the socket a failure happened on leaves a newer connection alone.
  #
  # @param socket [IO, nil] the connection to close; the current one by
  #   default
  # @return [void]
  def LNet.disconnect(socket = @@server)
    socket.close unless socket.nil? || socket.closed?
  rescue StandardError => e
    LNet.debug("error closing the connection: #{e.message}")
  end

  # Writes one XML document to the server. Writes from different threads
  # never interleave. A failed write closes the connection so the connection
  # thread reconnects.
  #
  # @param document [REXML::Document, String]
  # @return [Boolean] true if it was written, false if not connected or the
  #   write failed
  def LNet.transmit(document)
    server = nil
    @@write_lock.synchronize do
      server = @@server
      return false if server.nil? || server.closed?

      server.puts(document.to_s)
    end
    @@last_send = Time.now
    true
  rescue IOError, SystemCallError, OpenSSL::SSL::SSLError => e
    LNet.debug("error writing to the server: #{e.class}: #{e.message}")
    LNet.disconnect(server)
    false
  end

  # Sends one element. Attributes whose value is nil are left out.
  #
  # @param tag [String]
  # @param attributes [Hash{String => #to_s, nil}]
  # @param text [String, nil] the element's text
  # @return [Boolean] see #transmit
  def LNet.send_element(tag, attributes = {}, text = nil)
    LNet.transmit(LNet.document(tag, attributes, text))
  end

  # @param tag [String]
  # @param attributes [Hash{String => #to_s, nil}] nil values are left out
  # @param text [String, nil]
  # @return [REXML::Document] a document holding one element
  def LNet.document(tag, attributes = {}, text = nil)
    document = REXML::Document.new
    element = document.add_element(tag)
    attributes.each_pair { |name, value| element.add_attribute(name.to_s, value.to_s) unless value.nil? }
    element.text = text unless text.nil?
    document
  end

  # Sends an empty document, which keeps the connection from idling out.
  # @return [Boolean]
  def LNet.send_ping
    LNet.transmit(REXML::Document.new)
  end

  # @param attributes [Hash] 'type' ('private' or 'channel') plus 'to' or
  #   'channel'
  # @param message [String]
  # @return [Boolean]
  def LNet.send_message(attributes, message)
    LNet.send_element('message', attributes, message)
  end

  # @param attributes [Hash] 'type' plus any filter, e.g. 'name' or 'num'
  # @return [Boolean]
  def LNet.send_query(attributes)
    LNet.send_element('query', attributes)
  end

  # @param attributes [Hash] 'type' and 'to'
  # @return [Boolean]
  def LNet.send_request(attributes)
    LNet.send_element('request', attributes)
  end

  # @param attributes [Hash] 'type' and usually 'to'
  # @param data [Object] plain data (nil, booleans, numbers, strings,
  #   symbols, arrays and hashes of them)
  # @return [Boolean]
  def LNet.send_data(attributes, data)
    LNet.send_element('data', attributes, SafeMarshal.encode(data))
  end

  # Keeps the connection alive; call it in a loop.
  #
  # @param now [Time]
  # @return [Numeric] seconds to wait before calling it again
  def LNet.keepalive_tick(now = Time.now)
    idle = now - @@last_send
    if idle > KEEPALIVE_INTERVAL - 1 && LNet.send_ping
      idle = 0
    end
    [KEEPALIVE_INTERVAL - idle, 5].max
  end

  # Sends a keepalive whenever the connection has been quiet. Never returns.
  def LNet.keepalive_loop
    loop do
      sleep LNet.keepalive_tick
    rescue StandardError => e
      echo "error: #{e.message}"
      sleep 1
    end
  end

  # One connection attempt and, if it logs in, everything the server sends
  # until the connection ends.
  #
  # @param started_at [Time] when the attempt began
  # @return [Numeric] seconds to wait before the next attempt
  def LNet.connection_cycle(started_at = Time.now)
    server = LNet.connect ? @@server : nil
    LNet.read_session(server) if server
    LNet.reconnect_delay(started_at, Time.now)
  ensure
    LNet.disconnect(server) if server
  end

  # Reads from the server until the connection ends, feeding every element
  # to a fresh listener.
  #
  # @param server [IO]
  # @return [void]
  def LNet.read_session(server)
    parser = StreamParser.new(LNet.new)
    loop { parser.feed(server.readpartial(4096)) }
  rescue IOError, SystemCallError, OpenSSL::SSL::SSLError => e # EOFError is an IOError
    LNet.debug("connection ended: #{e.class}: #{e.message}")
  end

  # How long to wait before reconnecting: RESTART_WAIT after a restart
  # notice, otherwise whatever is left of RECONNECT_INTERVAL since the last
  # attempt began (at least 1 second). Says why it is waiting.
  #
  # @param started_at [Time] when the last attempt began
  # @param now [Time]
  # @return [Numeric] seconds
  def LNet.reconnect_delay(started_at, now)
    if @@server_restart
      @@server_restart = false
      echo "server is restarting; waiting #{RESTART_WAIT} seconds to reconnect..."
      return RESTART_WAIT
    end
    echo 'connection lost'
    delay = [RECONNECT_INTERVAL - (now - started_at), 1].max
    echo "waiting #{delay.to_i} seconds before trying to reconnect..." if delay > 1
    delay
  end

  # Connects, reads and reconnects for as long as the script runs.
  def LNet.connection_loop
    loop do
      started_at = Time.now
      delay = begin
        LNet.connection_cycle(started_at)
      rescue StandardError, ScriptError, SystemStackError => e
        echo "error: #{e.message}"
        LNet.reconnect_delay(started_at, Time.now)
      end
      sleep delay
    end
  end

  # Encodes and decodes the Marshal payloads of <data> elements.
  #
  # Payloads come from the server and from other players' clients, and
  # Marshal.load will instantiate any class and run its marshal_load/_load
  # hooks. #load walks the stream first and only hands it to Marshal.load
  # when every object in it is nil, true, false, an Integer, Float, String,
  # Symbol, Array or Hash -- the only things LNet ever sends, none of which
  # run code to load. Strings and symbols may only carry their encoding, and
  # links back to an array/hash that is still being read are refused, so the
  # result is a finite tree of plain values; links can't expand it past
  # MAX_VALUES values or MAX_BYTES bytes of text, and numbers are at most
  # MAX_BIGNUM_WORDS long.
  module SafeMarshal
    module_function

    # @param data [Object] plain data
    # @return [String] the base64 text of a <data> element
    def encode(data)
      [Marshal.dump(data)].pack('m').strip
    end

    # @param text [String] the base64 text of a <data> element
    # @return [Object] the plain data it holds
    # @raise [ArgumentError] if it holds anything else or is malformed
    def decode(text)
      load(text.to_s.unpack1('m'))
    end

    # @param bin [String] a Marshal stream
    # @return [Object] the plain data it holds
    # @raise [ArgumentError] if it holds anything else or is malformed
    def load(bin)
      bin = bin.b
      raise ArgumentError, 'unsupported marshal format' unless bin.byteslice(0, 2) == "\x04\x08".b

      limit = [(bin.bytesize * 64) + 1024, MAX_VALUES].min
      byte_limit = [(bin.bytesize * 64) + 65_536, MAX_BYTES].min
      seen = { 'objects' => [], 'symbols' => [], 'sizes' => [], 'values' => 0, 'limit' => limit,
               'byte_sizes' => [], 'bytes' => 0, 'byte_limit' => byte_limit }
      pos = check_value(bin, 2, 0, seen)
      raise ArgumentError, 'trailing marshal data' unless pos == bin.bytesize

      Marshal.load(bin)
    rescue EncodingError => e # older Rubies, for a symbol in a bad encoding
      raise ArgumentError, "bad marshal encoding: #{e.message}"
    end

    MAX_DEPTH = 32
    # Most values a payload may hold once its links are followed (and at most
    # 64 per byte of payload), so shared parts can't blow up into a huge tree.
    MAX_VALUES = 2_000_000
    # Longest bignum accepted, in 16-bit words (256 bits; LNet's numbers fit
    # in 64).
    MAX_BIGNUM_WORDS = 16
    # Most bytes of strings and symbols a payload may hold once its links are
    # followed (and at most 64 per byte of payload, plus 64 KB).
    MAX_BYTES = 8_000_000

    # seen mirrors Marshal.load's link tables: 'objects' has one entry per
    # linkable object (false while an array/hash is still being read, the text
    # of a string, true otherwise), 'symbols' the name of each symbol read,
    # 'sizes' how many values each array/hash holds (for links), 'values' how
    # many values the payload has expanded to so far, and 'byte_sizes' and
    # 'bytes' the same in bytes of text
    def check_value(bin, pos, depth, seen)
      raise ArgumentError, 'marshal data nested too deep' if depth > MAX_DEPTH

      seen['values'] += 1
      raise ArgumentError, 'marshal data expands too far' if seen['values'] > seen['limit']

      type = bin.getbyte(pos) or raise ArgumentError, 'truncated marshal data'
      pos += 1
      case type.chr
      when '0', 'T', 'F'
        pos
      when 'i'
        read_long(bin, pos)[1]
      when ':', ';'
        name, pos = read_symbol(bin, pos - 1, seen)
        add_bytes(seen, name.bytesize)
        pos
      when '@' # link to an earlier object
        index, pos = read_long(bin, pos)
        raise ArgumentError, 'bad or circular marshal link' unless index >= 0 and seen['objects'][index]

        seen['values'] += seen['sizes'][index].to_i
        raise ArgumentError, 'marshal data expands too far' if seen['values'] > seen['limit']

        add_bytes(seen, seen['byte_sizes'][index].to_i)
        pos
      when '"' # string
        text, pos = read_string(bin, pos)
        seen['byte_sizes'][seen['objects'].length] = text.bytesize
        seen['objects'].push(text)
        add_bytes(seen, text.bytesize)
        pos
      when 'f' # float
        seen['objects'].push(true)
        read_string(bin, pos)[1]
      when 'l' # bignum: sign, length in 16-bit words, digits
        raise ArgumentError, 'bad bignum sign' unless ['+', '-'].include?(bin.byteslice(pos, 1))

        seen['objects'].push(true)
        len, pos = read_long(bin, pos + 1)
        raise ArgumentError, 'marshal bignum too long' if len > MAX_BIGNUM_WORDS

        skip_bytes(bin, pos, len * 2)
      when '[', '{', '}' # array, hash, hash with default value
        index = seen['objects'].length
        seen['objects'].push(false)
        before = seen['values']
        before_bytes = seen['bytes']
        len, pos = read_count(bin, pos)
        len *= 2 unless type.chr == '['
        len += 1 if type.chr == '}'
        len.times { pos = check_value(bin, pos, depth + 1, seen) }
        seen['objects'][index] = true
        seen['sizes'][index] = seen['values'] - before
        seen['byte_sizes'][index] = seen['bytes'] - before_bytes
        pos
      when 'I' # a string or symbol followed by its encoding
        case bin.byteslice(pos, 1)
        when '"'
          text, pos = read_string(bin, pos + 1)
          seen['byte_sizes'][seen['objects'].length] = text.bytesize
          seen['objects'].push(text)
          add_bytes(seen, text.bytesize)
        when ':'
          name, pos = read_symbol(bin, pos, seen)
          add_bytes(seen, name.bytesize)
        else
          raise ArgumentError, 'instance variables on unsupported type'
        end
        len, pos = read_count(bin, pos)
        len.times {
          raise ArgumentError, 'bad instance variable name' unless [':', ';'].include?(bin.byteslice(pos, 1))

          name, pos = read_symbol(bin, pos, seen)
          value = bin.byteslice(pos, 1)
          if name == 'E' and ['T', 'F'].include?(value)
            pos += 1
          elsif name == 'encoding' and value == '"'
            encoding, pos = read_string(bin, pos + 1)
            seen['objects'].push(encoding)
            Encoding.find(encoding)
          elsif name == 'encoding' and value == '@' # the same encoding name as an earlier string
            index, pos = read_long(bin, pos + 1)
            encoding = seen['objects'][index] if index >= 0
            raise ArgumentError, 'bad marshal encoding link' unless encoding.is_a?(String)

            Encoding.find(encoding)
          else
            raise ArgumentError, "refusing instance variable #{name.inspect}"
          end
        }
        pos
      else
        raise ArgumentError, "refusing to load marshal type #{type.chr.inspect}"
      end
    end

    # Counts text a payload holds, links included, and refuses it past its
    # byte limit.
    #
    # @param seen [Hash] see #check_value
    # @param count [Integer] bytes to add
    # @return [void]
    # @raise [ArgumentError] past the limit
    def add_bytes(seen, count)
      seen['bytes'] += count
      raise ArgumentError, 'marshal data expands too far' if seen['bytes'] > seen['byte_limit']
    end

    def read_long(bin, pos)
      c = bin.getbyte(pos) or raise ArgumentError, 'truncated marshal data'
      c -= 256 if c > 127
      pos += 1
      return [0, pos] if c == 0
      return [c - 5, pos] if c > 4
      return [c + 5, pos] if c < -4

      n = c.abs
      raise ArgumentError, 'truncated marshal data' if pos + n > bin.bytesize

      x = 0
      n.times { |i| x |= bin.getbyte(pos + i) << (8 * i) }
      x -= 256**n if c < 0
      [x, pos + n]
    end

    # a length-prefixed element count that the remaining bytes could hold
    def read_count(bin, pos)
      len, pos = read_long(bin, pos)
      raise ArgumentError, 'bad marshal length' if len < 0 or len > bin.bytesize - pos

      [len, pos]
    end

    def read_string(bin, pos)
      len, pos = read_long(bin, pos)
      [bin.byteslice(pos, len), skip_bytes(bin, pos, len)]
    end

    # a ':' symbol or ';' symbol link starting at pos; returns its name
    def read_symbol(bin, pos, seen)
      if bin.byteslice(pos, 1) == ';'
        index, pos = read_long(bin, pos + 1)
        raise ArgumentError, 'bad marshal symbol link' unless index >= 0 and index < seen['symbols'].length

        [seen['symbols'][index], pos]
      else
        name, pos = read_string(bin, pos + 1)
        seen['symbols'].push(name)
        [name, pos]
      end
    end

    def skip_bytes(bin, pos, len)
      raise ArgumentError, 'bad marshal length' if len < 0 or pos + len > bin.bytesize

      pos + len
    end
  end

  # @param bin [String] a Marshal stream
  # @return [Object] the plain data it holds
  # @raise [ArgumentError] see SafeMarshal.load
  def LNet.safe_unmarshal(bin)
    SafeMarshal.load(bin)
  end

  # @param channel [String]
  # @return [Boolean]
  def LNet.tune_channel(channel)
    LNet.send_element('tune', { 'channel' => channel })
  end

  # @param channel [String]
  # @return [Boolean]
  def LNet.untune_channel(channel)
    LNet.send_element('untune', { 'channel' => channel })
  end

  # @param attributes [Hash] 'action', 'name', 'channel' and optionally 'length'
  # @return [Boolean]
  def LNet.moderate(attributes)
    LNet.send_element('moderate', attributes)
  end

  # @param attributes [Hash] 'action' plus what that action needs
  # @return [Boolean]
  def LNet.admin(attributes)
    LNet.send_element('admin', attributes)
  end

  # Drops control characters (Wizard/Avalon \034GS codes among them) and,
  # unless told otherwise, folds line breaks so one LNet message can't print
  # what looks like a separate game line.
  def LNet.clean_text(text, keep_newlines = false)
    text = text.gsub(/\r\n?|\n/, ' ') unless keep_newlines
    text.gsub(/[\x00-\x08\x0B-\x1F\x7F]/, '')
  end

  def LNet.xml_escape(text)
    text.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;')
  end

  def LNet.echo_thought(from, message, channel)
    aliased_from = LNet.clean_text(LNet.alias[from] || from)
    message = LNet.clean_text(message, from == '[server]')
    channel = LNet.clean_text(channel)
    channel = "[#{channel}]-" unless from == '[server]'
    xml_from = LNet.xml_escape("#{channel}#{aliased_from}")
    xml_message = LNet.xml_escape(message)
    if @@options['timestamps']
      timestamp = "  (#{Time.now.strftime('%X')})"
    else
      timestamp = String.new
    end
    if @@options['preset']
      preset_open = "<preset id='#{@@options['preset']}'>"
      preset_close = "</preset>"
    else
      preset_open = preset_close = ""
    end
    if @@options['fam_window']
      xml_thought = "<pushStream id=\"familiar\" ifClosedStyle=\"watching\"/>#{xml_from}: \"#{xml_message}\"#{timestamp}\n<popStream/>\n"
    else
      xml_thought = "<pushStream id=\"thoughts\"/>#{preset_open}#{xml_from}:#{preset_close} \"#{xml_message}\"#{timestamp}\n<popStream/>\n"
    end
    unless LNet.ignored?(from)
      if $frontend =~ /wizard|avalon/
        if @@options['fam_window']
          $_CLIENT_.puts("\034GSe\r\n#{channel}#{aliased_from}: \"#{message}\"#{timestamp}\r\n\034GSf\r\n")
        else
          $_CLIENT_.puts("You hear the faint thoughts of #{channel}#{aliased_from} echo in your mind:\r\n\"#{message}\"#{timestamp}\r\n")
        end
      else
        if defined?(_respond)
          _respond(xml_thought)
        else
          $_CLIENT_.puts(xml_thought)
        end
      end
    end
    $_SERVERBUFFER_.push(xml_thought)
    Script.new_downstream_xml(xml_thought)
    Script.new_downstream("#{channel}#{aliased_from}: \"#{message}\"#{timestamp}")
  end

  # Whether name may receive what action reveals, by the permission the user
  # set for it (';lnet allow'): 'all', 'friends', 'enemies' (everyone but
  # enemies) or anything else, including unset, for no one.
  #
  # @param action [String] a request type, e.g. 'locate'
  # @param name [String] who asked, e.g. 'GSIV:Bob'
  # @return [Boolean]
  def LNet.allow?(action, name)
    case (@@options['permission'] || {})[action]
    when 'all' then true
    when 'friends' then LNet.friend?(name)
    when 'enemies' then !LNet.enemy?(name)
    else false
    end
  end

  # @param name [String] e.g. 'GSIV:Bob' or 'Bob'
  # @return [Boolean] whether the user ignores name
  def LNet.ignored?(name)
    LNet.listed?('ignore', name)
  end

  # @param name [String]
  # @return [Boolean] whether name is on the friend list
  def LNet.friend?(name)
    LNet.listed?('friends', name)
  end

  # @param name [String]
  # @return [Boolean] whether name is on the enemy list
  def LNet.enemy?(name)
    LNet.listed?('enemies', name)
  end

  # A list entry matches the name, or any game's character of that name
  # when it has no game prefix ('Bob' matches 'GSIV:Bob'), regardless of
  # case, so an entry saved as 'dr:Bob' still matches 'DR:Bob'.
  #
  # @param list [String] 'ignore', 'friends' or 'enemies'
  # @param name [String]
  # @return [Boolean]
  def LNet.listed?(list, name)
    name = name.to_s
    bare = name[/[A-Za-z]+\z/]
    (@@options[list] || []).any? { |entry| entry.to_s.casecmp?(name) || (bare && entry.to_s.casecmp?(bare)) }
  end

  # @return [Hash{String => Proc}] request handlers scripts registered, by
  #   request type
  def LNet.callbacks
    @@callbacks
  end

  # Answers another player's request of the given type with whatever the
  # block returns. A later registration for the same type replaces the
  # earlier one; registering a stock type (e.g. 'locate') replaces lnet's own
  # answer until LNet.remove_callback.
  #
  # Like the stock requests, a type is answered only for those the user
  # allows with ';lnet allow <type> <group>'; everyone else, and anyone the
  # user ignores, gets nil.
  #
  # The block runs on lnet's connection thread, so keep it quick and don't
  # call LNet.get_data from it: no reply can be read until it returns.
  #
  # @example a script that tells allowed players its character's roundtime
  #   LNet.add_callback('roundtime') { |_request| { 'hard' => checkrt, 'soft' => checkcastrt } }
  #
  # @param type [String, Symbol] the request type
  # @yieldparam request [Hash{String => String}] the request's attributes,
  #   including 'from' and 'type'
  # @yieldreturn [Object] plain data (nil, booleans, numbers, strings,
  #   symbols, arrays and hashes of them); anything else is not sent
  # @return [Class] LNet
  # @raise [ArgumentError] without a block or with an empty type
  def LNet.add_callback(type, &block)
    type = type.to_s
    raise ArgumentError, 'LNet.add_callback needs a request type and a block' if type.empty? || block.nil?

    @@callbacks[type] = block
    self
  end

  # @param type [String, Symbol]
  # @return [Proc, nil] the handler that was registered
  def LNet.remove_callback(type)
    @@callbacks.delete(type.to_s)
  end

  # Removes every handler scripts registered.
  # @return [void]
  def LNet.clear_callbacks!
    @@callbacks.clear
  end

  # Starts the user's own 'lnet-callbacks' script, if there is one, so the
  # handlers it registers are there whenever lnet runs.
  #
  # @return [Boolean] whether it was started
  def LNet.start_user_callbacks
    return false unless Script.exists?(USER_CALLBACKS_SCRIPT)
    return false if Script.running?(USER_CALLBACKS_SCRIPT)

    echo "starting #{USER_CALLBACKS_SCRIPT}..."
    Script.start(USER_CALLBACKS_SCRIPT)
    true
  end

  # Sends a message at most once every SAFE_SEND_INTERVAL seconds, for
  # scripts that announce things automatically.
  #
  # @param attributes [Hash] see LNet.send_message
  # @param message [String]
  # @return [Boolean] false if it was too soon or the send failed
  def LNet.safe_send(attributes, message)
    now = Time.now
    return false if @@last_safe_send && now - @@last_safe_send < SAFE_SEND_INTERVAL

    @@last_safe_send = now
    LNet.send_message(attributes, message)
  end

  # Answers other players' requests for this character's information, and
  # the request types scripts register with LNet.add_callback.
  module Responders
    module_function

    # What each stock request reveals, as told to the user.
    DESCRIPTIONS = {
      'spells' => 'spell info',
      'skills' => 'skills',
      'info'   => 'stats',
      'locate' => 'location',
      'health' => 'health info',
      'bounty' => 'bounty info',
    }.freeze

    # How "sending ... to" names a reply where that differs from
    # DESCRIPTIONS, as lnet always has; nil sends without saying so (bounty,
    # which scripts poll).
    SENDING = { 'health' => 'health', 'bounty' => nil }.freeze

    # GemStone skills, in the order the skills display shows them.
    SKILLS = [
      ['Two Weapon Combat', :twoweaponcombat], ['Armor Use', :armoruse], ['Shield Use', :shielduse],
      ['Combat Maneuvers', :combatmaneuvers], ['Edged Weapons', :edgedweapons], ['Blunt Weapons', :bluntweapons],
      ['Two-Handed Weapons', :twohandedweapons], ['Ranged Weapons', :rangedweapons], ['Thrown Weapons', :thrownweapons],
      ['Polearm Weapons', :polearmweapons], ['Brawling', :brawling], ['Ambush', :ambush],
      ['Multi Opponent Combat', :multiopponentcombat], ['Physical Fitness', :physicalfitness], ['Dodging', :dodging],
      ['Arcane Symbols', :arcanesymbols], ['Magic Item Use', :magicitemuse], ['Spell Aiming', :spellaiming],
      ['Harness Power', :harnesspower], ['Elemental Mana Control', :emc], ['Mental Mana Control', :mmc],
      ['Spirit Mana Control', :smc], ['Elemental Lore - Air', :elair], ['Elemental Lore - Earth', :elearth],
      ['Elemental Lore - Fire', :elfire], ['Elemental Lore - Water', :elwater],
      ['Spiritual Lore - Blessings', :slblessings], ['Spiritual Lore - Religion', :slreligion],
      ['Spiritual Lore - Summoning', :slsummoning], ['Sorcerous Lore - Demonology', :sldemonology],
      ['Sorcerous Lore - Necromancy', :slnecromancy], ['Mental Lore - Divination', :mldivination],
      ['Mental Lore - Manipulation', :mlmanipulation], ['Mental Lore - Telepathy', :mltelepathy],
      ['Mental Lore - Transference', :mltransference], ['Mental Lore - Transformation', :mltransformation],
      ['Survival', :survival], ['Disarming Traps', :disarmingtraps], ['Picking Locks', :pickinglocks],
      ['Stalking and Hiding', :stalkingandhiding], ['Perception', :perception], ['Climbing', :climbing],
      ['Swimming', :swimming], ['First Aid', :firstaid], ['Trading', :trading], ['Pickpocketing', :pickpocketing],
    ].freeze

    # GemStone spell lists, in display order.
    SPELL_LISTS = [
      ['Major Elemental', :majorelemental], ['Minor Elemental', :minorelemental], ['Minor Mental', :minormental],
      ['Major Spirit', :majorspiritual], ['Minor Spirit', :minorspiritual], ['Wizard', :wizard],
      ['Sorcerer', :sorcerer], ['Ranger', :ranger], ['Paladin', :paladin], ['Empath', :empath],
      ['Cleric', :cleric], ['Bard', :bard],
    ].freeze

    # Stats in the info reply, as [reply key, Stats method].
    STATS = [
      ['Strength', :str], ['Constitution', :con], ['Dexterity', :dex], ['Agility', :agi], ['Discipline', :dis],
      ['Aura', :aur], ['Logic', :log], ['Intuition', :int], ['Wisdom', :wis], ['Influence', :inf],
    ].freeze

    # Answers one request. Every request gets a reply -- nil when it is
    # refused or fails -- so the asker never waits out a timeout.
    #
    # @param request [Hash{String => String}] the request's attributes
    #   ('type' and 'from')
    # @return [void]
    def handle(request)
      type = request['type']
      from = request['from']
      return if type.to_s.empty? || from.to_s.empty?
      return reply(type, from, nil) if LNet.ignored?(from)

      handler = LNet.callbacks[type] || stock_handler(type)
      unless handler
        echo "rejecting unknown request (#{type}) from #{from}..."
        return reply(type, from, nil)
      end
      what = DESCRIPTIONS.fetch(type, "#{type} info")
      unless LNet.allow?(type, from)
        echo "rejecting request from #{from} for #{what}..."
        return reply(type, from, nil)
      end
      sending = SENDING.fetch(type, what)
      echo "sending #{sending} to #{from}..." if sending
      reply(type, from, answer(handler, request, type))
    end

    # @return [Method, nil]
    def stock_handler(type)
      method(type) if DESCRIPTIONS.key?(type)
    end

    # Runs a handler and returns its data, or nil if it raises or returns
    # something other than plain data (which the asker would refuse anyway).
    def answer(handler, request, type)
      data = handler.call(request)
      SafeMarshal.load(Marshal.dump(data))
      data
    rescue StandardError, ScriptError, SystemExit => e
      echo "could not answer the #{type} request: #{e.class}: #{e.message}"
      nil
    end

    def reply(type, to, data)
      LNet.send_data({ 'type' => type, 'to' => to }, data)
    end

    # @return [Hash{String => Float}] active spell number => minutes left
    def spells(_request = nil)
      Spell.active.to_h { |spell| [spell.num.to_s, spell.timeleft] }
    end

    # @return [Hash{String => Integer}] trained skills and spell lists
    def skills(_request = nil)
      ranks = SKILLS.map { |name, method| [name, Skills.public_send(method)] }
      ranks += SPELL_LISTS.select { |_name, method| Spells.respond_to?(method) }.map { |name, method| [name, Spells.public_send(method)] }
      ranks.select { |_name, value| value.to_i.positive? }.to_h
    end

    # @return [Hash] race, profession, age, experience, level, stats, mana
    def info(_request = nil)
      data = {
        'Race'       => Stats.race,
        'Profession' => Stats.prof,
        'Gender'     => Stats.gender,
        'Age'        => Stats.age,
        'Expr'       => Stats.exp.to_s,
        'Level'      => XMLData.level,
      }
      STATS.each { |name, method| data[name] = Stats.public_send(method) }
      data['Mana'] = XMLData.mana
      data
    end

    # @return [Hash] the room as this character sees it: title, description,
    #   exits, map id, loot, characters (this one included unless hidden or
    #   invisible) and creatures
    def locate(_request = nil)
      pcs = GameObj.pcs.map { |pc| { 'name' => pc.name, 'status' => pc.status } }
      pcs.push({ 'name' => Char.name, 'status' => own_status }) unless hidden? || invisible?
      {
        'title'       => XMLData.room_title,
        'description' => XMLData.room_description,
        'exits'       => XMLData.room_exits_string,
        'id'          => Room.current&.id,
        'loot'        => GameObj.loot.map(&:name),
        'pcs'         => pcs,
        'npcs'        => GameObj.npcs.map { |npc| { 'name' => npc.name, 'status' => npc.status } },
      }
    end

    # @return [String, nil] e.g. 'stunned kneeling', nil when standing and well
    def own_status
      status = []
      status.push 'dead' if dead?
      status.push 'webbed' if webbed?
      status.push 'stunned' if stunned?
      if kneeling?
        status.push 'kneeling'
      elsif sitting?
        status.push 'sitting'
      elsif !standing?
        status.push(GameObj.pcs.any? { |pc| pc.status =~ /prone/ } ? 'prone' : 'lying down')
      end
      status.empty? ? nil : status.join(' ')
    end

    # @return [Hash] injuries and health, spirit and stamina
    def health(_request = nil)
      {
        'injuries'    => XMLData.injuries,
        'health'      => XMLData.health,
        'max_health'  => XMLData.max_health,
        'spirit'      => XMLData.spirit,
        'max_spirit'  => XMLData.max_spirit,
        'stamina'     => XMLData.stamina,
        'max_stamina' => XMLData.max_stamina,
      }
    end

    # @return [String, nil] the current task
    def bounty(_request = nil)
      checkbounty
    end
  end

  def LNet.get_data(name, type)
    return false if (!name.is_a?(String)) or name.empty? or (!type.is_a?(String)) or type.empty? or !LNet.connected?
    name.capitalize!
    waiter = { 'type' => type, 'name' => name, 'data' => :waiting }
    @@waiting.push(waiter)
    begin
      LNet.send_request({ 'type' => type, 'to' => name })
      80.times { sleep 0.1; break unless waiter['data'] == :waiting }
    ensure
      @@waiting.delete(waiter)
    end
    if waiter['data'] == :waiting
      false
    else
      waiter['data']
    end
  end

  def LNet.upload_spell_ranks
    begin
      return false unless LNet.connected?

      data = {
        'minorspiritual' => Spells.minorspiritual,
        'majorspiritual' => Spells.majorspiritual,
        'cleric'         => Spells.cleric,
        'minorelemental' => Spells.minorelemental,
        'majorelemental' => Spells.majorelemental,
        'ranger'         => Spells.ranger,
        'sorcerer'       => Spells.sorcerer,
        'wizard'         => Spells.wizard,
        'bard'           => Spells.bard,
        'empath'         => Spells.empath,
        'paladin'        => Spells.paladin,
        'arcanesymbols'  => Skills.arcanesymbols,
        'magicitemuse'   => Skills.magicitemuse,
      }
      begin
        data['minormental'] = Spells.minormental
      rescue
        nil
      end
      LNet.send_data({ 'type'=>'spell-ranks' }, data)
      return true
    rescue
      return false
    end
  end

  def initialize
    @active_tags = Array.new
    @active_attributes = Array.new
  end

  def tag_start(tag_name, attributes)
    begin
      @@last_recv = Time.now
      @active_tags.push(tag_name)
      @active_attributes.push(attributes)
      if tag_name == 'ping'
        LNet.send_element('pong')
      elsif tag_name == 'request'
        Responders.handle(attributes)
      elsif (tag_name == 'notify')
        if (attributes['type'] == 'new-spell-ranks') and defined?(SpellRanks)
          LNet.send_request({ 'type' => 'spell-ranks', 'to' => 'server', 'timestamp' => SpellRanks.timestamp.to_s })
        elsif attributes['type'] == 'server-restart'
          @@server_restart = true
          LNet.disconnect
        end
      end
    rescue
      echo $!
      respond $!.backtrace[0..1]
    end
  end

  def text(text)
    begin
      if @active_tags.last == 'message'
        if @active_attributes.last['type'] == 'greeting'
          respond text if @@options['greeting']
        elsif @active_attributes.last['type'] == 'server'
          if text =~ /(?!kill).*(?:incorrect password|password required)/
            output = "\n"
            output.concat "If you have forgotten your password, visit https://lnet.lichproject.org to reset it."
            output.concat "\n"
            output.concat "To attempt to log in with a different password, type: #{$clean_lich_char}#{@@script.name} password=<password>\n"
            output.concat "\n"
            respond output
            Script.self.kill
          end
          LNet.echo_thought('[server]', text, '')
        elsif (@active_attributes.last['type'] == 'private') and (from = @active_attributes.last['from'])
          @@last_priv = from
          LNet.echo_thought(from, text, 'Private')
        elsif (@active_attributes.last['type'] == 'privateto') and (to = @active_attributes.last['to'])
          if text.length < 512 # fixme
            LNet.echo_thought(to, text, 'PrivateTo')
          end
        elsif (@active_attributes.last['type'] == 'channel') and (from = @active_attributes.last['from']) and (channel = @active_attributes.last['channel'])
          LNet.echo_thought(from, text, channel)
        end
      elsif (@active_tags.last == 'data')
        if @active_attributes.last['from'] and @active_attributes.last['type']
          waiter = @@waiting.find { |w| (@active_attributes.last['from'] =~ /^#{Regexp.escape(w['name'])}/i) and (w['type'] == @active_attributes.last['type']) and w['data'] == :waiting }
        end
        begin
          data = SafeMarshal.decode(text)
        rescue
          echo "ignored #{@active_attributes.last['type']} data from #{@active_attributes.last['from']} that contained something other than plain values (#{$!.message})"
          # fail the waiting request now rather than letting it time out
          waiter['data'] = false if waiter
          return
        end
        if waiter
          waiter['data'] = data
        elsif (@active_attributes.last['type'] == 'connected') and (@active_attributes.last['from'] == 'server')
          output = String.new
          sort_by_game = Hash.new
          for name in data
            if name =~ /^(.+)\:(.+)$/
              sort_by_game[$1] ||= Array.new
              sort_by_game[$1].push($2)
            else
              sort_by_game['unknown'] ||= Array.new
              sort_by_game['unknown'].push(name)
            end
          end
          who_columns = 5
          sort_by_game.each_pair { |game, name_list|
            name_list = name_list.sort { |a, b| if (a =~ /\^$/) or (a =~ /\*$/ and b !~ /\^$/); 1; else; 0; end }
            output.concat "\n#{game} (#{name_list.length}):\n\n"
            column = Array.new
            longest = Array.new
            who_columns.times {
              column.push Array.new
              longest.push 0
            }
            until name_list.empty?
              for i in 0..(who_columns - 1)
                if (name = name_list.pop)
                  column[i].push(name)
                  longest[i] = [longest[i], name.length].max
                end
              end
            end
            until column[0].empty?
              for i in 0..(who_columns - 1)
                if (name = column[i].shift)
                  output.concat name.ljust(longest[i] + 3)
                end
              end
              output = output.strip.concat "\n"
            end
          }
          if (channel = @active_attributes.last['channel'])
            output.concat "\nTotal tuned to #{channel}: #{data.length}\n\n"
          else
            output.concat "\nTotal connected: #{data.length}\n\n"
          end
          respond "\n#{output}"
        elsif (@active_attributes.last['type'] == 'channels') and (@active_attributes.last['from'] == 'server')
          total = @active_attributes.last['total']
          name_width = tuned_width = 0
          data.each { |channel_info|
            name_width = [name_width, channel_info['name'].length].max
            tuned_width = [tuned_width, channel_info['tuned'].to_s.length].max
          }
          output = "\nAvailable channels:\n\n"
          data.each { |channel_info|
            output.concat "#{if channel_info['status'] == 'default'; '+' elsif channel_info['status'] == 'tuned'; '-'; else ' '; end} #{channel_info['name'].rjust(name_width)}   #{channel_info['tuned'].to_s.rjust(tuned_width)}   #{channel_info['description']}\n"
          }
          output.concat "\nuse \";channels full\" to see #{total.to_i - data.length} more\n" if data.length < total.to_i
          output.concat "\n"
          respond output
        elsif (@active_attributes.last['type'] == 'server stats') and (@active_attributes.last['from'] == 'server')
          format_time = proc { |time|
            seconds = time.to_i % 60
            difference = (time - seconds) / 60
            minutes = difference % 60
            difference = (difference - minutes) / 60
            hours = difference % 24
            days = (difference - hours) / 24
            formatted_time = Array.new
            formatted_time.push "#{days.to_i} day#{'s' unless days == 1}" if days > 0
            formatted_time.push "#{hours.to_i} hour#{'s' unless hours == 1}" if hours > 0
            formatted_time.push "#{minutes.to_i} minute#{'s' unless minutes == 1}" if minutes > 0
            formatted_time.push "#{seconds.to_i} second#{'s' unless seconds == 1}" if (seconds > 0) and (days < 1) and (hours < 1)
            formatted_time = formatted_time.join(', ').sub(/^1 day$/, '24 hours')
            formatted_time
          }
          output = "\n"
          if data['uptime'] and data['uptime'].to_i > 0
            output.concat "No major accidents in the last #{format_time.call(data['uptime'])}\n"
          end
          if data['character connections'] and not data['character connections'].empty?
            for length, num in data['character connections']
              output.concat "#{num} characters have connected in the last #{format_time.call(length)}\n"
            end
          end
          if data['ip connections'] and not data['ip connections'].empty?
            for length, num in data['ip connections']
              output.concat "About #{num} players have connected in the last #{format_time.call(length)}\n"
            end
          end
          output.concat "\n"
          for channel_name, channel_data in data['own_channels']
            output.concat "#{channel_name} (owner)\n"
            if channel_data['moderators'].empty?
              output.concat "   moderators: none\n"
            else
              output.concat "   moderators: #{channel_data['moderators'].join(', ')}\n"
            end
            if channel_data['invited'].nil?
              nil
            elsif channel_data['invited'].empty?
              output.concat "   invited: none\n"
            else
              output.concat "   invited: #{channel_data['invited'].join(', ')}\n"
            end
            if channel_data['banned'].nil?
              nil
            elsif channel_data['banned'].empty?
              output.concat "   banned: none\n"
            else
              output.concat "   banned:\n"
              for name, ban_time in channel_data['banned']
                if ban_time.nil?
                  ban_time = 'indefinite'
                else
                  ban_time = format_time.call(ban_time)
                end
                output.concat "      #{name.ljust(16)} (#{ban_time})\n"
              end
            end
            if channel_data['gagged'].empty?
              output.concat "   gagged: none\n"
            else
              output.concat "   gagged:\n"
              for name, gag_time in channel_data['gagged']
                if gag_time.nil?
                  gag_time = 'indefinite'
                else
                  # echo "gag_time: #{gag_time.inspect}"
                  gag_time = format_time.call(gag_time)
                end
                output.concat "      #{name.ljust(16)} (#{gag_time})\n"
              end
            end
          end
          for channel_name, channel_data in data['mod_channels']
            output.concat "#{channel_name} (moderator)\n"
            if channel_data['invited'].nil?
              nil
            elsif channel_data['invited'].empty?
              output.concat "   invited: none\n"
            else
              output.concat "   invited: #{channel_data['invited'].join(', ')}\n"
            end
            if channel_data['banned'].nil?
              nil
            elsif channel_data['banned'].empty?
              output.concat "   banned: none\n"
            else
              output.concat "   banned:\n"
              for name, ban_time in channel_data['banned']
                if ban_time.nil?
                  ban_time = 'indefinite'
                else
                  ban_time = format_time.call(ban_time)
                end
                output.concat "      #{name.ljust(16)} (#{ban_time})\n"
              end
            end
            if channel_data['gagged'].empty?
              output.concat "   gagged: none\n"
            else
              output.concat "   gagged:\n"
              for name, gag_time in channel_data['gagged']
                if gag_time.nil?
                  gag_time = 'indefinite'
                else
                  gag_time = format_time.call(gag_time)
                end
                output.concat "      #{name.ljust(16)} (#{gag_time})\n"
              end
            end
          end
          output.concat "\n" unless data['own_channels'].empty? and data['mod_channels'].empty?
          respond output
        elsif (@active_attributes.last['type'] == 'spell-ranks') and (@active_attributes.last['from'] == 'server') and defined?(SpellRanks)
          echo 'spell-ranks' if $lnet_debug
          begin
            # fixme: really really slow to do the whole list, also too large (1.7mb or something)
            for name, ranks in data
              next if name =~ /^_/
              name = name.sub(/^.*\:/, '')
              char = SpellRanks[name] || SpellRanks.new(name)
              data['_format_'].each_index { |i|
                char.send("#{data['_format_'][i]}=", ranks[i].to_i) rescue('spell-ranks formating send error!')
              }
            end
            SpellRanks.timestamp = data['_timestamp_']
            SpellRanks.save
          rescue
            echo $!
            echo $!.backtrace[0..2]
          end
        elsif (@active_attributes.last['type'] == 'spells') and (name = @active_attributes.last['from'])
          unless LNet.ignored?(name)
            if data.nil?
              echo "#{name} declined your request for spell information."
            elsif data == false
              echo 'no such user'
            elsif data.empty?
              echo "#{name} has no spells."
            else
              output = "\n#{name}:\n"
              last_circle = nil
              data.sort.each { |spell|
                unless last_circle == Spell[spell[0]].circlename
                  last_circle = Spell[spell[0]].circlename
                  output.concat "\n- #{last_circle}:\n"
                end
                output.concat "#{spell[0].to_s.rjust(4)}:  #{Spell[spell[0]].name.ljust(22)}- #{spell[1].as_time}\n"
              }
              output.concat "\n"
              respond output
            end
          end
        elsif (@active_attributes.last['type'] == 'skills') and (name = @active_attributes.last['from'])
          order = ['Two Weapon Combat', 'Armor Use', 'Shield Use', 'Combat Maneuvers', 'Edged Weapons', 'Blunt Weapons', 'Two-Handed Weapons', 'Ranged Weapons', 'Thrown Weapons', 'Polearm Weapons', 'Brawling', 'Ambush', 'Multi Opponent Combat', 'Physical Fitness', 'Dodging', 'Arcane Symbols', 'Magic Item Use', 'Spell Aiming', 'Harness Power', 'Elemental Mana Control', 'Mental Mana Control', 'Spirit Mana Control', 'Elemental Lore - Air', 'Elemental Lore - Earth', 'Elemental Lore - Fire', 'Elemental Lore - Water', 'Spiritual Lore - Blessings', 'Spiritual Lore - Religion', 'Spiritual Lore - Summoning', 'Sorcerous Lore - Demonology', 'Sorcerous Lore - Necromancy', 'Mental Lore - Divination', 'Mental Lore - Manipulation', 'Mental Lore - Telepathy', 'Mental Lore - Transference', 'Mental Lore - Transformation', 'Survival', 'Disarming Traps', 'Picking Locks', 'Stalking and Hiding', 'Perception', 'Climbing', 'Swimming', 'First Aid', 'Trading', 'Pickpocketing', 'Major Elemental', 'Minor Elemental', 'Minor Mental', 'Major Spirit', 'Minor Spirit', 'Wizard', 'Sorcerer', 'Ranger', 'Paladin', 'Empath', 'Cleric', 'Bard']
          unless LNet.ignored?(name)
            if data.nil?
              echo "#{name} declined your request for skill information."
            elsif data == false
              echo 'no such user'
            else
              output = "\n#{name}:\n\n"
              output.concat "  Skill Name                         | Current Current\n"
              output.concat "                                     |   Bonus   Ranks\n"
              order.each { |skill_name|
                if data[skill_name]
                  if skill_name =~ /Minor Elemental|Major Elemental|Minor Mental|Minor Spirit|Major Spirit|Wizard|Sorcerer|Ranger|Paladin|Empath|Cleric|Bard/
                    output.concat "\nSpell Lists\n"
                    output.concat "  #{skill_name.ljust(35, '.')}|#{data[skill_name].to_s.rjust(16)}\n"
                  else
                    output.concat "  #{skill_name.ljust(35, '.')}|#{Skills.to_bonus(data[skill_name]).to_s.rjust(8)}#{data[skill_name].to_s.rjust(8)}\n"
                  end
                  data.delete(skill_name)
                end
              }
              # data should be empty by now, but just in case..
              data.each_pair { |skill_name, skill_ranks|
                if skill_name =~ /Minor Elemental|Major Elemental|Minor Mental|Minor Spirit|Major Spirit|Wizard|Sorcerer|Ranger|Paladin|Empath|Cleric|Bard/
                  output.concat "\nSpell Lists\n"
                  output.concat "  #{skill_name.ljust(35, '.')}|#{skill_ranks.to_s.rjust(16)}\n"
                else
                  output.concat "  #{skill_name.ljust(35, '.')}|#{Skills.to_bonus(skill_ranks).to_s.rjust(8)}#{skill_ranks.to_s.rjust(8)}\n"
                end
              }
              output.concat "\n"
              respond output
            end
          end
        elsif (@active_attributes.last['type'] == 'info') and (name = @active_attributes.last['from'])
          unless LNet.ignored?(name)
            if data.nil?
              echo "#{name} declined your request for stat information."
            elsif data == false
              echo 'no such user'
            else
              output = String.new
              output.concat "\nName: #{name} Race: #{data['Race']}  Profession: #{data['Profession']}\n"
              output.concat "Gender: #{data['Gender']}    Age: #{data['Age']}    Expr: #{data['Expr']}    Level:  #{data['Level']}\n"
              output.concat "                  Normal (Bonus)  ...  Enhanced (Bonus)\n"
              output.concat "    Strength (STR):   #{data['Strength'][0].to_s.rjust(3)} (#{data['Strength'][1].to_s.rjust(2)})    ...  #{data['Strength'][0].to_s.rjust(3)} (#{data['Strength'][1].to_s.rjust(2)})\n"
              output.concat "Constitution (CON):   #{data['Constitution'][0].to_s.rjust(3)} (#{data['Constitution'][1].to_s.rjust(2)})    ...  #{data['Constitution'][0].to_s.rjust(3)} (#{data['Constitution'][1].to_s.rjust(2)})\n"
              output.concat "   Dexterity (DEX):   #{data['Dexterity'][0].to_s.rjust(3)} (#{data['Dexterity'][1].to_s.rjust(2)})    ...  #{data['Dexterity'][0].to_s.rjust(3)} (#{data['Dexterity'][1].to_s.rjust(2)})\n"
              output.concat "     Agility (AGI):   #{data['Agility'][0].to_s.rjust(3)} (#{data['Agility'][1].to_s.rjust(2)})    ...  #{data['Agility'][0].to_s.rjust(3)} (#{data['Agility'][1].to_s.rjust(2)})\n"
              output.concat "  Discipline (DIS):   #{data['Discipline'][0].to_s.rjust(3)} (#{data['Discipline'][1].to_s.rjust(2)})    ...  #{data['Discipline'][0].to_s.rjust(3)} (#{data['Discipline'][1].to_s.rjust(2)})\n"
              output.concat "        Aura (AUR):   #{data['Aura'][0].to_s.rjust(3)} (#{data['Aura'][1].to_s.rjust(2)})    ...  #{data['Aura'][0].to_s.rjust(3)} (#{data['Aura'][1].to_s.rjust(2)})\n"
              output.concat "       Logic (LOG):   #{data['Logic'][0].to_s.rjust(3)} (#{data['Logic'][1].to_s.rjust(2)})    ...  #{data['Logic'][0].to_s.rjust(3)} (#{data['Logic'][1].to_s.rjust(2)})\n"
              output.concat "   Intuition (INT):   #{data['Intuition'][0].to_s.rjust(3)} (#{data['Intuition'][1].to_s.rjust(2)})    ...  #{data['Intuition'][0].to_s.rjust(3)} (#{data['Intuition'][1].to_s.rjust(2)})\n"
              output.concat "      Wisdom (WIS):   #{data['Wisdom'][0].to_s.rjust(3)} (#{data['Wisdom'][1].to_s.rjust(2)})    ...  #{data['Wisdom'][0].to_s.rjust(3)} (#{data['Wisdom'][1].to_s.rjust(2)})\n"
              output.concat "   Influence (INF):   #{data['Influence'][0].to_s.rjust(3)} (#{data['Influence'][1].to_s.rjust(2)})    ...  #{data['Influence'][0].to_s.rjust(3)} (#{data['Influence'][1].to_s.rjust(2)})\n"
              output.concat "Mana:  #{data['Mana']}\n\n"
              respond output
            end
          end
        elsif (@active_attributes.last['type'] == 'health') and (name = @active_attributes.last['from'])
          unless LNet.ignored?(name)
            if data.nil?
              echo "#{name} declined your request for health information."
            elsif data == false
              echo 'no such user'
            else
              wound_message = {
                'head'      => ['', 'minor bruises about the head', 'minor lacerations about the head and a possible mild concussion', 'severe head trauma and bleeding from the ears'],
                'neck'      => ['', 'minor bruises on your neck', 'moderate bleeding from your neck', 'snapped bones and serious bleeding from the neck'],
                'chest'     => ['', 'minor cuts and bruises on your chest', 'deep lacerations across your chest', 'deep gashes and serious bleeding from your chest'],
                'abdomen'   => ['', 'minor cuts and bruises on your abdominal area', 'deep lacerations across your abdominal area', 'deep gashes and serious bleeding from your abdominal area'],
                'back'      => ['', 'minor cuts and bruises on your back', 'deep lacerations across your back', 'deep gashes and serious bleeding from your back'],
                'rightEye'  => ['', 'a bruised right eye', 'a swollen right eye', 'a blinded right eye'],
                'leftEye'   => ['', 'a bruised left eye', 'a swollen left eye', 'a blinded left eye'],
                'rightLeg'  => ['', 'some minor cuts and bruises on your right leg', 'a fractured and bleeding right leg', 'a completely severed right leg'],
                'leftLeg'   => ['', 'some minor cuts and bruises on your left leg', 'a fractured and bleeding left leg', 'a completely severed left leg'],
                'rightArm'  => ['', 'some minor cuts and bruises on your right arm', 'a fractured and bleeding right arm', 'a completely severed right arm'],
                'leftArm'   => ['', 'some minor cuts and bruises on your left arm', 'a fractured and bleeding left arm', 'a completely severed left arm'],
                'rightHand' => ['', 'some minor cuts and bruises on your right hand', 'a fractured and bleeding right hand', 'a completely severed right hand'],
                'leftHand'  => ['', 'some minor cuts and bruises on your left hand', 'a fractured and bleeding left hand', 'a completely severed left hand'],
                'nsys'      => ['', 'a strange case of muscle twitching', 'a case of sporadic convulsions', 'a case of uncontrollable convulsions'],
                'rightFoot' => ['', 'missing message', 'missing message', 'missing message'],
                'leftFoot'  => ['', 'missing message', 'missing message', 'missing message'],
              }
              scar_message = {
                'head'      => ['', 'a scar across your face', 'several facial scars', 'old mutilation wounds about your head'],
                'neck'      => ['', 'a scar across your neck', 'some old neck wounds', 'terrible scars from some serious neck injury'],
                'chest'     => ['', 'an old battle scar across your chest', 'several painful-looking scars across your chest', 'terrible, permanent mutilation of your chest muscles'],
                'abdomen'   => ['', 'an old battle scar across your abdominal area', 'several painful-looking scars across your abdominal area', 'terrible, permanent mutilation of your abdominal muscles'],
                'back'      => ['', 'an old battle scar across your back', 'several painful-looking scars across your back', 'terrible, permanent mutilation of your back muscles'],
                'rightEye'  => ['', 'a black-and-blue right eye', 'severe bruises and swelling around your right eye', 'a missing right eye'],
                'leftEye'   => ['', 'a black-and-blue left eye', 'severe bruises and swelling around your left eye', 'a missing left eye'],
                'rightLeg'  => ['', 'old battle scars on your right leg', 'a mangled right leg', 'a missing right leg'],
                'leftLeg'   => ['', 'old battle scars on your left leg', 'a mangled left leg', 'a missing left leg'],
                'rightArm'  => ['', 'old battle scars on your right arm', 'a mangled right arm', 'a missing right arm'],
                'leftArm'   => ['', 'old battle scars on your left arm', 'a mangled left arm', 'a missing left arm'],
                'rightHand' => ['', 'old battle scars on your right hand', 'a mangled right hand', 'a missing right hand'],
                'leftHand'  => ['', 'old battle scars on your left hand', 'a mangled left hand', 'a missing left hand'],
                'nsys'      => ['', 'developed slurred speech', 'constant muscle spasms', 'a very difficult time with muscle control'],
                'rightFoot' => ['', 'missing message', 'missing message', 'missing message'],
                'leftFoot'  => ['', 'missing message', 'missing message', 'missing message'],
              }
              output = "\n#{name}:\n\n"
              if data['injuries'].values.any? { |hash| (hash['wound'].to_i > 0) or (hash['scar'].to_i > 0) }
                wound_array = data['injuries'].to_a.collect { |inj| wound_message[inj[0]][inj[1]['wound'].to_i] }.delete_if { |msg| msg.nil? or msg.empty? }
                if wound_array.length == 1
                  output.concat "You have #{wound_array.first}.\n"
                elsif wound_array.length > 1
                  output.concat "You have #{wound_array[0..-2].join(', ')}, and #{wound_array[-1]}.\n"
                end
                scar_array = data['injuries'].to_a.collect { |inj| scar_message[inj[0]][inj[1]['scar'].to_i] }.delete_if { |msg| msg.nil? or msg.empty? }
                if scar_array.length == 1
                  output.concat "You have #{scar_array.first}.\n"
                elsif scar_array.length > 1
                  output.concat "You have #{scar_array[0..-2].join(', ')}, and #{scar_array[-1]}.\n"
                end
              else
                output.concat "You seem to be in one piece.\n"
              end
              output.concat "\n"
              output.concat "    Maximum Health Points: #{data['max_health']}\n"
              output.concat "  Remaining Health Points: #{data['health']}\n"
              output.concat "\n"
              output.concat "    Maximum Spirit Points: #{data['max_spirit']}\n"
              output.concat "  Remaining Spirit Points: #{data['spirit']}\n"
              output.concat "\n"
              output.concat "    Maximum Stamina Points: #{data['max_stamina']}\n"
              output.concat "  Remaining Stamina Points: #{data['stamina']}\n"
              output.concat "\n"
              respond output
            end
          end
        elsif (@active_attributes.last['type'] == 'locate') and (name = @active_attributes.last['from'])
          unless LNet.ignored?(name)
            if data.nil?
              echo "#{name} declined your request for location information."
            elsif data == false
              echo 'no such user'
            else
              output = "\n#{name}:\n\n"
              also_see = Array.new
              data['npcs'].each { |npc| if npc['status'].nil?; also_see.push(npc['name']); else; also_see.push("#{npc['name']} (#{npc['status']})"); end }
              also_see = (also_see + data['loot']) unless data['loot'].nil? or data['loot'].empty?
              also_here = Array.new
              data['pcs'].each { |pc| if pc['status'].nil?; also_here.push(pc['name']); else; also_here.push("#{pc['name']} (#{pc['status']})"); end }
              room = Map.list.find { |map_room| map_room.title.include?(data['title']) and map_room.desc.include?(data['description'].strip) and map_room.paths.include?(data['exits']) }
              unless room
                desc_regex = /#{Regexp.escape(data['description'].strip.sub(/\.+$/, '')).gsub(/\\\.(?:\\\.\\\.)?/, '|')}/
                room = Map.list.find { |map_room| map_room.title.include?(data['title']) and map_room.paths.include?(data['exits']) and map_room.desc.find { |desc| desc =~ desc_regex } }
              end
              output.concat "#{data['title']}#{' (' + room.id.to_s + ')' if room}\n"
              if also_see.empty?
                output.concat "#{data['description']}\n"
              else
                output.concat "#{data['description']}  You also see #{also_see.join(', ')}.\n"
              end
              output.concat "Also here: #{also_here.join(', ')}\n" unless also_here.empty?
              output.concat "#{data['exits']}\n"
              respond output
            end
          end
        elsif (@active_attributes.last['type'] == 'bounty') and (name = @active_attributes.last['from'])
          unless LNet.ignored?(name)
            if data.nil?
              echo "#{name} declined your request for bounty information."
            elsif data == false
              echo 'no such user'
            else
              respond "\n#{name}:\n#{data}\n\n"
            end
          end
        else
          # echo data.inspect
        end

      end
    rescue
      echo $!
      respond $!.backtrace[0..1]
    end
  end

  def tag_end(_tag_name)
    @active_tags.pop
    @active_attributes.pop
  end
end

unless defined?(UNTRUSTED_LNET_GET_DATA)
  UNTRUSTED_LNET_GET_DATA = proc { |name, type| LNet.get_data(name, type) }
end

unless defined?(UNTRUSTED_LNET_UPLOAD_SPELL_RANKS)
  UNTRUSTED_LNET_UPLOAD_SPELL_RANKS = proc { LNet.upload_spell_ranks }
end

def lichnet_get_spells(name)
  LNet.get_data(name, 'spells')
end

CharSettings['options'] ||= Hash.new
LNet.options = CharSettings['options']

CharSettings['secret'] ||= Array.new
LNet.store_secret = CharSettings['secret']

if LNet.options.empty?
  LNet.options['timestamps'] = Settings['options']['timestamps']
  LNet.options['fam_window'] = Settings['options']['fam_window']
  LNet.options['greeting']   = Settings['options']['greeting']
  LNet.options['friends']    = Settings['options']['friends'].dup
  LNet.options['enemies']    = Settings['options']['enemies'].dup
  LNet.options['permission'] = Settings['options']['permission'].dup
  LNet.options['ignore']     = Settings['options']['ignore'].dup
  LNet.secret                = Settings['options'][XMLData.name]['password'].dup
  Settings['options'][XMLData.name]['password'] = nil
end

if LNet.options['timestamps'].nil?
  LNet.options['timestamps'] = false
  LNet.options['fam_window'] = false
end

LNet.options['greeting']   = true if LNet.options['greeting'].nil?
LNet.options['friends']    = Array.new unless LNet.options['friends'].is_a?(Array)
LNet.options['enemies']    = Array.new unless LNet.options['enemies'].is_a?(Array)
LNet.options['permission'] = Hash.new  unless LNet.options['permission'].is_a?(Hash)
LNet.options['ignore']     = Array.new unless LNet.options['ignore'].is_a?(Array)

Settings['alias']          = Hash.new  unless Settings['alias'].is_a?(Hash)
LNet.alias = Settings['alias']

if script.vars[1] =~ /^password=([^\s]+)$/i
  if $1 == 'nil'
    LNet.secret = nil
    echo 'Password cleared.'
  else
    LNet.secret = $1
    echo 'Password saved locally.'
  end
elsif script.vars[1].downcase == 'help'
  script.unique_buffer.push('help')
end

before_dying { LNet.disconnect; LNet.script = nil }
LNet.script = Script.self

#
# capture input from the client
#
script_name = script.name.dup
action = proc { |client_string|
  begin
    if client_string =~ /^(?:<c>)?#{$lich_char}(,|chat |reply |who|locate |spells |info |skills |health |bounty |tune |untune |channels?)(.*)/
      cmd, extra = $1, $2
      cmd = 'chat ' if cmd == ','
      if (s = (Script.running + Script.hidden).find { |val| val.name == script_name })
        s.unique_buffer.push("#{cmd}#{extra}")
        nil
      else
        respond '--- Lich: lnet is not running'
        UpstreamHook.remove(script_name)
        nil
      end
    elsif client_string =~ /^(?:<c>)?#{$lich_char}([A-z]+):(.*)/
      name, message = $1, $2
      if (s = (Script.running + Script.hidden).find { |val| val.name == script_name })
        s.unique_buffer.push("chat ::#{name} #{message}")
        nil
      else
        respond '--- Lich: lnet is not running'
        UpstreamHook.remove(script_name)
        nil
      end
    elsif client_string =~ /^(?:<c>)?#{$lich_char}#{script_name}(.*)/
      cmd = $1
      if (s = (Script.running + Script.hidden).find { |val| val.name == script_name })
        s.unique_buffer.push(cmd)
        nil
      else
        UpstreamHook.remove(script_name)
        client_string
      end
    else
      client_string
    end
  rescue
    UpstreamHook.remove(script_name)
    client_string
  end
}
before_dying { UpstreamHook.remove(script_name) }
UpstreamHook.add(script_name, action)
LNet.start_user_callbacks

Thread.new { LNet.keepalive_loop }
Thread.new { LNet.connection_loop }

#
# listen to the user
#
while (msg = unique_get.strip)
  if msg =~ /^chat\s+\:\:(.+?) (.*)/i or msg =~ /^chat\s+to\s+(.+?) (.*)/i
    LNet.send_message(attr = { 'type' => 'private', 'to' => $1 }, $2)
  elsif msg =~ /^chat\s+\:([^\:].*?) (.*)/i or msg =~ /^chat\s+on\s+(.+?) (.*)/i
    LNet.send_message(attr = { 'type' => 'channel', 'channel' => $1 }, $2)
  elsif msg =~ /^chat\s+(?!:\:|to |on |ot )(.*)/i
    message = $1.sub(/^\.(to|on) /i, '\\1 ')
    LNet.send_message(attr = { 'type'=>'channel' }, message)
  elsif msg =~ /reply\s(.+)/i
    if LNet.last_priv
      LNet.send_message(attr = { 'type' => 'private', 'to' => LNet.last_priv }, $1)
    else
      echo "No private message to reply to."
    end
  elsif msg =~ /^who$/i
    LNet.send_query(attr = { 'type'=>'connected' })
  elsif msg =~ /^stats$/i
    LNet.send_query(attr = { 'type'=>'server stats' })
  elsif msg =~ /^who\s+([A-z\:]+)$/i
    LNet.send_query(attr = { 'type' => 'connected', 'name' => $1 })
  elsif msg =~ /^channels?\s*(full|all)?/i
    if $1
      LNet.send_query(attr = { 'type'=>'channels' })
    else
      LNet.send_query(attr = { 'type' => 'channels', 'num' => '15' })
    end
  elsif msg =~ /^tune\s+([A-z]+)$/i
    LNet.tune_channel($1)
  elsif msg =~ /^untune\s+([A-z]+)$/i
    LNet.untune_channel($1)
  elsif msg =~ /^(spells|skills|info|locate|health|bounty)\s+([A-z\:]+)$/i
    type = $1.downcase
    name = $2
    if LNet.ignored?(name)
      echo "There's no point in sending a request to someone you're ignoring."
    else
      LNet.send_request(attr = { 'type' => type, 'to' => name })
    end
  elsif msg =~ /^add\s?alias\s+([^\s]+)\s+(.+)$/i
    real_name = $1
    aliased_name = $2
    LNet.alias[real_name] = aliased_name
    echo "chats from #{real_name} will now appear as #{aliased_name}"
    if real_name !~ /^[A-Z][A-z]+:[A-Z][a-z]+$/
      echo "The name should be entered exactly as it appears in the thought window, for example:   ;lnet add alias GSIV:Jeril StrangerDanger"
      echo "If #{real_name} is incorrect, you can remove it using:   ;lnet remove alias #{aliased_name}"
    end
  elsif msg =~ /^(?:del|rem|delete|remove)\s?alias\s+(.+)$/i
    aliased_name = $1
    if LNet.alias.values.any? { |v| v == aliased_name }
      LNet.alias.delete_if { |_k, v| v == aliased_name }
      echo "alias deleted"
    else
      echo "couldn't find an alias by that name"
    end
  elsif msg =~ /^aliases$/i
    if LNet.alias.empty?
      echo 'You have no aliases.'
    else
      output = "\n"
      max_k = 0; max_v = 0; LNet.alias.each_pair { |k, v| max_k = [max_k, k.length].max; max_v = [max_v, v.length].max }
      LNet.alias.each_pair { |k, v|
        output.concat "   #{k.ljust(max_k)} => #{v.ljust(max_v)}\n"
      }
      output.concat "\n"
      respond output
    end
  elsif msg =~ /^add\s?friends?\s+([A-z]+\:)?([A-z]+)$/i
    fix_game = { 'gsf' => 'GSF', 'gsiv' => 'GSIV', 'gsplat' => 'GSPlat' }
    name = $2.capitalize
    if (game = $1.sub(/\:$/, ''))
      game = fix_game[game.downcase] if fix_game[game.downcase]
      name = "#{game}:#{name}"
    end
    if LNet.options['friends'].include?(name)
      echo "#{name} is already on your friend list."
    else
      LNet.options['friends'].push(name)
      echo "#{name} was added to your friend list."
    end
  elsif msg =~ /^(?:del|rem|delete|remove)\s?friends?\s+([A-z]+\:)?([A-z]+)$/i
    fix_game = { 'gsf' => 'GSF', 'gsiv' => 'GSIV', 'gsplat' => 'GSPlat' }
    name = $2.capitalize
    if (game = $1.sub(/\:$/, ''))
      game = fix_game[game.downcase] if fix_game[game.downcase]
      name = "#{game}:#{name}"
    end
    if LNet.options['friends'].delete(name)
      echo "#{name} was removed from your friend list."
    else
      echo "#{name} was not found on your friend list."
    end
  elsif msg =~ /^add\s?en[ie]m(?:y|ies)\s+([A-z]+\:)?([A-z]+)$/i
    fix_game = { 'gsf' => 'GSF', 'gsiv' => 'GSIV', 'gsplat' => 'GSPlat' }
    name = $2.capitalize
    if (game = $1.sub(/\:$/, ''))
      game = fix_game[game.downcase] if fix_game[game.downcase]
      name = "#{game}:#{name}"
    end
    if LNet.options['enemies'].include?(name)
      echo "#{name} is already on your enemy list."
    else
      LNet.options['enemies'].push(name)
      echo "#{name} was added to your enemy list."
    end
  elsif msg =~ /^(?:del|rem|delete|remove)\s?en[ie]m(?:y|ies)\s+([A-z]+\:)?([A-z]+)$/i
    fix_game = { 'gsf' => 'GSF', 'gsiv' => 'GSIV', 'gsplat' => 'GSPlat' }
    name = $2.capitalize
    if (game = $1.sub(/\:$/, ''))
      game = fix_game[game.downcase] if fix_game[game.downcase]
      name = "#{game}:#{name}"
    end
    if LNet.options['enemies'].delete(name)
      echo "#{name} was removed from your enemy list."
    else
      echo "#{name} was not found on your enemy list."
    end
  elsif msg =~ /^friends?$/i
    if LNet.options['friends'].empty?
      echo 'You have no friends.'
    else
      echo "friends: #{LNet.options['friends'].join(', ')}"
    end
  elsif msg =~ /^enem(?:y|ies)$/i
    if LNet.options['enemies'].empty?
      echo 'You have no enemies.'
    else
      echo "enemies: #{LNet.options['enemies'].join(', ')}"
    end
  elsif msg =~ /^allow$/i
    fix_type = { 'all' => 'everyone', 'friends' => 'only your friends', 'enemies' => 'everyone except your enemies', 'none' => 'no one', nil => 'no one' }
    fix_action = { 'locate' => 'locate you', 'spells' => 'view your active spells', 'skills' => "view your #{if rand(100) == 0; 'mad '; end}skills", 'info' => 'view your stats', 'health' => 'view your health', 'bounty' => 'view your bounties' }
    ['locate', 'spells', 'skills', 'info', 'health', 'bounty'].each { |lnet_action|
      respond "You are allowing #{fix_type[LNet.options['permission'][lnet_action]]} to #{fix_action[action]}."
    }
  elsif msg =~ /^allow\s+(locate|spells|skills|info|health|bounty|all)\s+(all|friend|friends|non\-enemies|nonenemies|enemies|enemy|none)$/i
    action, group = $1, $2
    fix_action = { 'locate' => 'locate you', 'spells' => 'view your active spells', 'skills' => "view your #{if rand(100) == 0; 'mad '; end}skills", 'info' => 'view your stats', 'health' => 'view your health', 'bounty' => 'view your bounties' }
    if action =~ /^all$/i
      for action in ['locate', 'spells', 'skills', 'info', 'health', 'bounty']
        if group =~ /^all$/i
          LNet.options['permission'][action] = 'all'
          echo "You are now allowing everyone to #{fix_action[action]}."
        elsif group =~ /^friends?$/i
          LNet.options['permission'][action] = 'friends'
          echo "You are now allowing only your friends to #{fix_action[action]}."
        elsif group =~ /enem/i
          LNet.options['permission'][action] = 'enemies'
          echo "You are now allowing everyone except your enemies to #{fix_action[action]}."
        elsif group =~ /^none$/i
          LNet.options['permission'][action] = 'none'
          echo "You are now allowing no one to #{fix_action[action]}."
        end
      end
    elsif group =~ /^all$/i
      LNet.options['permission'][action] = 'all'
      echo "You are now allowing everyone to #{fix_action[action]}."
    elsif group =~ /^friends?$/i
      LNet.options['permission'][action] = 'friends'
      echo "You are now allowing only your friends to #{fix_action[action]}."
    elsif group =~ /enem/i
      LNet.options['permission'][action] = 'enemies'
      echo "You are now allowing everyone except your enemies to #{fix_action[action]}."
    elsif group =~ /^none$/i
      LNet.options['permission'][action] = 'none'
      echo "You are now allowing no one to #{fix_action[action]}."
    end
  elsif msg =~ /^ignore$/i
    if LNet.options['ignore'].empty?
      echo 'You are not ignoring anyone.'
    else
      echo "You are ignoring the following people: #{LNet.options['ignore'].join(', ')}"
    end
  elsif msg =~ /^ignore\s+([A-z]+\:)?([A-z]+)$/i
    fix_game = { 'gsf' => 'GSF', 'gsiv' => 'GSIV', 'gsplat' => 'GSPlat' }
    name = $2.capitalize
    if (game = $1.sub(/\:$/, ''))
      game = fix_game[game.downcase] if fix_game[game.downcase]
      name = "#{game}:#{name}"
    end
    if LNet.options['ignore'].include?(name)
      echo "You were already ignoring #{name}."
    else
      LNet.options['ignore'].push(name)
      echo "You are now ignoring #{name}."
    end
  elsif msg =~ /^unignore\s+([A-z]+\:)?([A-z]+)$/i
    fix_game = { 'gsf' => 'GSF', 'gsiv' => 'GSIV', 'gsplat' => 'GSPlat' }
    name = $2.capitalize
    if (game = $1.sub(/\:$/, ''))
      game = fix_game[game.downcase] if fix_game[game.downcase]
      name = "#{game}:#{name}"
    end
    if LNet.options['ignore'].delete(name)
      echo "You are no longer ignoring #{name}."
    else
      echo "#{name} wasn't being ignored."
    end
  elsif msg =~ /^timestamps?=(on|off)$/i
    if $1 == 'on'
      LNet.options['timestamps'] = true
      echo 'timestamps will be shown'
    else
      LNet.options['timestamps'] = false
      echo 'timestamps will not be shown'
    end
  elsif msg =~ /^famwindow=(on|off)$/i
    if $1 == 'on'
      LNet.options['fam_window'] = true
      echo 'chats will be sent to the familiar window'
    else
      LNet.options['fam_window'] = false
      echo 'chats will be sent to the thought window'
    end
  elsif msg =~ /^greeting=(on|off)$/i
    if $1 == 'on'
      LNet.options['greeting'] = true
      echo 'greeting will be shown at login'
    else
      LNet.options['greeting'] = false
      echo 'getting will not be shown'
    end
  elsif msg =~ /^password=([^\s]+)$/i
    LNet.send_data(attr = { 'type'=>'newpassword' }, $1)
    if $1 == 'nil'
      LNet.secret = nil
      echo 'Password cleared.'
    else
      LNet.secret = $1
      echo 'Password saved locally.'
    end
  elsif msg =~ /^preset=([^\s]+)$/i
    case $1
    when /^nil$/i
      LNet.options['preset'] = nil
      echo 'Removed highlight preset for lnet messages.'
    when /^lnet$/i
      LNet.options['preset'] = 'lnet'
      echo "Set highlight preset for lnet messages to '#{LNet.options['preset']}', be sure your FrontEnd supports this."
    when /^thoughts?$/i
      LNet.options['preset'] = 'thought'
      echo "Set highlight preset for lnet message to '#{LNet.options['preset']}', be careful to distinguish lnet from ESP thoughts."
    else
      echo "Unknown option specified for preset - {#{$1}} - only 'lnet', 'thought' and 'nil' are supported."
    end
  elsif msg =~ /^email=([^\s]+)$/i
    LNet.send_data(attr = { 'type'=>'newemail' }, $1)
  elsif msg =~ /^(ban|gag|mod|banip)\s+([\:A-z0-9]+)\s+on\s+([A-z]+)$/i
    LNet.moderate(attr = { 'action' => $1.downcase, 'name' => $2, 'channel' => $3 })
  elsif msg =~ /^(ban|gag|banip)\s+([\:A-z0-9]+)\s+on\s+([A-z]+)\s+for\s+([0-9]+)\s*(seconds?|minutes?|hours?|days?|years?|s|m|h|d|y)$/i
    multiplier = { nil => 1, 's' => 1, 'second' => 1, 'seconds' => 1, 'm' => 60, 'minute' => 60, 'minutes' => 60, 'h' => 3600, 'hour' => 3600, 'hours' => 3600, 'd' => 86400, 'day' => 86400, 'days' => 86400, 'y' => 31536000, 'year' => 31536000, 'years' => 31536000 }
    LNet.moderate(attr = { 'action' => $1.downcase, 'name' => $2, 'channel' => $3, 'length' => ($4.to_i * multiplier[$5]).to_s })
  elsif msg =~ /^(unban|ungag|unmod)\s+([\:A-z0-9]+)\s+on\s+([A-z]+)$/i
    LNet.moderate(attr = { 'action' => $1.downcase, 'name' => $2, 'channel' => $3 })
  elsif msg =~ /^create\s+(hidden)?\s*(private)?\s*channel\s+([A-z]+)\s+(.+?)$/i
    attr = attr = { 'action' => 'create channel', 'name' => $3, 'description' => $4.strip }
    if $1
      attr['hidden'] = 'yes'
    else
      attr['hidden'] = 'no'
    end
    if $2
      attr['private'] = 'yes'
    else
      attr['private'] = 'no'
    end
    LNet.admin(attr)
  elsif msg =~ /^create\s+poll\s+/i
    if msg =~ /\-\-question\s+(.+?)\s*(?:\-\-|$)/
      question = $1[0, 512].strip
    else
      question = nil
    end
    if msg =~ /\-\-vote\-time\s+([0-9]+)\s*(seconds?|minutes?|hours?|days?|years?|s|m|h|d|y)(?:\-\-|$)/
      multiplier = { nil => 1, 's' => 1, 'second' => 1, 'seconds' => 1, 'm' => 60, 'minute' => 60, 'minutes' => 60, 'h' => 3600, 'hour' => 3600, 'hours' => 3600, 'd' => 86400, 'day' => 86400, 'days' => 86400, 'y' => 31536000, 'year' => 31536000, 'years' => 31536000 }
      vote_time = $1.to_i * multiplier[$2]
    else
      vote_time = nil
    end
    num = 1
    option = Hash.new
    while msg =~ /\-\-option\-#{num}\s+(.+?)\s*(?:\-\-|$)/
      option[num] = $1[0, 64].strip
      num += 1
    end
    if question and (option.length > 1)
      attr = { 'action' => 'create poll', 'question' => question }
      option.each_pair { |num_pair, opt_pair| attr["option #{num_pair}"] = opt_pair }
      if vote_time
        attr['length'] = vote_time
      end
      # fixme: confirm
      LNet.admin(attr)
    else
      echo "You're doing it wrong.  Type #{$clean_lich_char}#{script.name} help"
    end
  elsif msg =~ /^delete\s+channel\s+([A-z]+)$/i
    LNet.admin(attr = { 'action' => 'delete channel', 'name' => $1 })
  elsif msg =~ /^eval (.+)$/
    LNet.send_data(attr = { 'type'=>'eval' }, $1)
  elsif msg =~ /^help$/i
    output = String.new
    output.concat "\n"
    output.concat "#{$clean_lich_char}chat <message>                     send a message to your default channel\n"
    output.concat "#{$clean_lich_char},<message>                         ''\n"
    output.concat "#{$clean_lich_char}chat on <channel name> <message>   send a message to the given channel\n"
    output.concat "#{$clean_lich_char}chat :<channel name> <message>     ''\n"
    output.concat "#{$clean_lich_char}chat to <name> <message>           send a private message\n"
    output.concat "#{$clean_lich_char}chat ::<name> <message>            ''\n"
    output.concat "#{$clean_lich_char}<name>:<message>                   ''\n"
    output.concat "#{$clean_lich_char}who                                list who's connected\n"
    output.concat "#{$clean_lich_char}who <channel>                      list who's tuned into the given channel\n"
    output.concat "#{$clean_lich_char}who <name>                         tells if a user is connected\n"
    output.concat "#{$clean_lich_char}channels                           list the 15 most populated channels\n"
    output.concat "#{$clean_lich_char}channels full                      list all available channels\n"
    output.concat "#{$clean_lich_char}tune <channel name>                listen to the given channel, or set as default if already tuned\n"
    output.concat "#{$clean_lich_char}untune <channel name>              stop listening to the given channel\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}locate <name>                      show someone's current room\n"
    output.concat "#{$clean_lich_char}spells <name>                      show someone's active spells and time remaining\n"
    output.concat "#{$clean_lich_char}skills <name>                      show someone's skills\n"
    output.concat "#{$clean_lich_char}info <name>                        show someone's stats\n"
    output.concat "#{$clean_lich_char}health <name>                      show someone's health, spirit, stamina and injuries\n"
    output.concat "#{$clean_lich_char}bounty <name>                      show someone's current adventurer's guild task\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} stats                         unhelpful information\n"
    output.concat "#{$clean_lich_char}#{script.name} timestamps=<on/off>           turn on/off all chats having a timestamp\n"
    output.concat "#{$clean_lich_char}#{script.name} famwindow=<on/off>            turn on/off sending chats to your familiar window\n"
    output.concat "#{$clean_lich_char}#{script.name} greeting=<on/off>             turn on/off showing a server greeting at logon\n"
    output.concat "#{$clean_lich_char}#{script.name} preset=<lnet/thought/nil>     set preset highlights for your front end to use\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} friends                       list friends\n"
    output.concat "#{$clean_lich_char}#{script.name} add friend <name>             add a name to your friend list\n"
    output.concat "#{$clean_lich_char}#{script.name} del friend <name>             delete a name from your friend list\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} enemies                       list enemies\n"
    output.concat "#{$clean_lich_char}#{script.name} add enemy <name>              add a name to your enemy list\n"
    output.concat "#{$clean_lich_char}#{script.name} del enemy <name>              delete a name from your enemy list\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} allow                         list your current permissions\n"
    output.concat "#{$clean_lich_char}#{script.name} allow <action> <group>        set permissions\n"
    output.concat "      <action> can be one of: locate, spells, skills, info, health, bounty, all\n"
    output.concat "      <group> can be one of: all, friends, non-enemies, none\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} aliases                       list aliases\n"
    output.concat "#{$clean_lich_char}#{script.name} add alias <name> <new_name>   causes chats from name to appear as new_name\n"
    output.concat "#{$clean_lich_char}#{script.name} del alias <new_name>          delete an alias\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} ignore                        list names currently being ignored\n"
    output.concat "#{$clean_lich_char}#{script.name} ignore <name>                 ignore chats/private chats/data requests from a person\n"
    output.concat "#{$clean_lich_char}#{script.name} unignore <name>               unignore a person\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} password=<password>           protect your character name on the server with a password\n"
    output.concat "#{$clean_lich_char}#{script.name} password=nil                  remove password protection\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} create [hidden] [private] channel <name> <description>\n"
    output.concat "      hidden channels don't show up in the channel list\n"
    output.concat "      private channels ban everyone by default, and the owner (or moderator) must unban anyone he wants to allow in\n"
    output.concat "#{$clean_lich_char}#{script.name} delete channel <name>\n"
    output.concat "\n"
    output.concat "#{$clean_lich_char}#{script.name} ban <character> on <channel> for <time>\n"
    output.concat "#{$clean_lich_char}#{script.name} unban <character> on <channel>\n"
    output.concat "#{$clean_lich_char}#{script.name} gag <character> on <channel> for <time>\n"
    output.concat "#{$clean_lich_char}#{script.name} ungag <character> on <channel>\n"
    output.concat "#{$clean_lich_char}#{script.name} mod <character> on <channel>\n"
    output.concat "#{$clean_lich_char}#{script.name} unmod <character> on <channel>\n"
    output.concat "      <time> should be a number followed by one of: seconds, minutes, hours, days, or years (may be abbreviated to one letter)\n"
    output.concat "\n"
    respond output
  else
    echo "You're doing it wrong.  Type #{$clean_lich_char}#{script.name} help"
  end
end
