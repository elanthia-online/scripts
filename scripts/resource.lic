    "Bard"     => {
      "Harness Power"          => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 2),
      "Physical Fitness"       => SkillCost.new(ptp: 4, mtp: 0, max_per_level: 2),
      "Magic Item Use"         => SkillCost.new(ptp: 0, mtp: 4, max_per_level: 2),
      "Elemental Mana Control" => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 1),
      "Mental Mana Control"    => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 1),
      "Bard"                   => SkillCost.new(ptp: 0, mtp: 17, max_per_level: 2)
    },
    "Paladin"  => {
      "Harness Power"       => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 2),
      "Physical Fitness"    => SkillCost.new(ptp: 3, mtp: 0, max_per_level: 2),
      "Arcane Symbols"      => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 1),
      "Magic Item Use"      => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 1),
      "Spirit Mana Control" => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 1),
      "Paladin"             => SkillCost.new(ptp: 0, mtp: 17, max_per_level: 2)
    },
    "Monk"     => {
      "Harness Power"                => SkillCost.new(ptp: 0, mtp: 6, max_per_level: 1),
      "Physical Fitness"             => SkillCost.new(ptp: 2, mtp: 0, max_per_level: 3),
      "First Aid"                    => SkillCost.new(ptp: 1, mtp: 2, max_per_level: 2),
      "Arcane Symbols"               => SkillCost.new(ptp: 0, mtp: 6, max_per_level: 1),
      "Mental Mana Control"          => SkillCost.new(ptp: 0, mtp: 8, max_per_level: 1),
      "Spirit Mana Control"          => SkillCost.new(ptp: 0, mtp: 8, max_per_level: 1),
      "Mental Lore - Transformation" => SkillCost.new(ptp: 0, mtp: 12, max_per_level: 1),
      "Mental Lore - Telepathy"      => SkillCost.new(ptp: 0, mtp: 12, max_per_level: 1),
      "Minor Mental"                 => SkillCost.new(ptp: 0, mtp: 38, max_per_level: 1),
      "Minor Spiritual"              => SkillCost.new(ptp: 0, mtp: 38, max_per_level: 1)
    },
    "Ranger"   => {
      "Harness Power"              => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 2),
      "Physical Fitness"           => SkillCost.new(ptp: 4, mtp: 0, max_per_level: 2),
      "Survival"                   => SkillCost.new(ptp: 1, mtp: 1, max_per_level: 3),
      "Magic Item Use"             => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 1),
      "Spirit Mana Control"        => SkillCost.new(ptp: 0, mtp: 5, max_per_level: 1),
      "Spiritual Lore - Blessings" => SkillCost.new(ptp: 0, mtp: 10, max_per_level: 1),
      "Ranger"                     => SkillCost.new(ptp: 0, mtp: 17, max_per_level: 2)
    }
  }
  SERVICE_SKILLS ||= {
    "Wizard"   => ["Arcane Symbols", "Magic Item Use", "Elemental Mana Control", "Wizard"],
    "Sorcerer" => ["Arcane Symbols", "Magic Item Use", "Elemental Mana Control", "Spirit Mana Control", "Sorcerer"],
    "Cleric"   => ["Arcane Symbols", "Magic Item Use", "Spirit Mana Control", "Cleric"],
    "Empath"   => ["Physical Fitness", "First Aid", "Arcane Symbols", "Magic Item Use", "Spirit Mana Control", "Mental Mana Control", "Empath"],
    "Bard"     => ["Magic Item Use", "Elemental Mana Control", "Mental Mana Control", "Bard"],
    "Paladin"  => ["Arcane Symbols", "Magic Item Use", "Spirit Mana Control", "Paladin"],
    "Monk"     => ["Physical Fitness", "First Aid", "Arcane Symbols", "Mental Mana Control", "Spirit Mana Control", "Mental Lore - Transformation", "Mental Lore - Telepathy", "Minor Mental", "Minor Spiritual"],
    "Ranger"   => ["Harness Power", "Survival", "Magic Item Use", "Spirit Mana Control", "Spiritual Lore - Blessings", "Ranger"]
  }
  # The larger of these two mana controls counts at /2 and the smaller at /4, so they are planned together.
  PAIRED_CONTROLS ||= {
    "Sorcerer" => ["Elemental Mana Control", "Spirit Mana Control"],
    "Empath"   => ["Spirit Mana Control", "Mental Mana Control"]
  }
  # Monk lores share one per-level training counter, as do the two minor spell circles.
  MONK_LORES ||= ["Mental Lore - Transformation", "Mental Lore - Telepathy"]
  MONK_MINOR_CIRCLES ||= ["Minor Mental", "Minor Spiritual"]
  # Monk plans rank the weaker tattoo first, then the gap between tattoos. Lore splits keep the
  # gap at 5 or less, so this weight makes the weaker tattoo dominate.
  MONK_GAP_WEIGHT ||= 8
  SERVICE_RESERVE ||= { "Harness Power" => 6 }
  CAP_EXPERIENCE ||= 7_572_500
  POST_CAP_EXPERIENCE_PER_TP ||= 2_500

  FormulaRow ||= Struct.new(:value, :label)
  # One choice for a skill (or skill group): the ranks it sets, what they cost, and the score they add.
  ServiceOption ||= Struct.new(:ranks, :cost, :value)
  # A node in the MTP knapsack; `previous` links back through the options chosen so far.
  MentalPlan ||= Struct.new(:mtp, :value, :option, :previous)
  ServicePlan ||= Struct.new(:ranks, :spent, :score, keyword_init: true)

  def self.clean_xml(line)
    line.to_s.gsub(/<[^>]*>/, '').gsub('&gt;', '>').gsub('&lt;', '<').gsub('&amp;', '&')
  end

  # Skill bonus from ranks: 5 per rank for ranks 1-10, then 4, 3, 2, and 1 per rank after 40.
  def self.skill_bonus(ranks)
    remaining = ranks.to_i
    bonus = 0
    [5, 4, 3, 2].each { |per_rank|
      used = [remaining, 10].min
      bonus += used * per_rank
      remaining -= used
    }
    bonus + remaining
  end

  def self.spell_contribution(ranks, threshold)
    ranks > threshold ? threshold * 2 + ranks - threshold : ranks * 2
  end

  # Every row of a profession's service formula, keyed by tattoo/service title.
  # service_totals sums these rows, so the optimizer and the printed breakdown cannot disagree.
  def self.service_formula(profession, data)
    ranks = data[:ranks]
    stats = data[:stats]
    level = data[:level]
    location = data[:location_bonus].to_i
    rows = case profession
           when "Wizard"
             [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:log], "LOG Bonus"), FormulaRow.new(stats[:int], "INT Bonus"),
              FormulaRow.new(ranks["Magic Item Use"] / 10, "trunc(MIU ranks / 10)"),
              FormulaRow.new(ranks["Arcane Symbols"] / 10, "trunc(AS ranks / 10)"),
              FormulaRow.new(ranks["Elemental Mana Control"] / 2, "trunc(EMC ranks / 2)"),
              FormulaRow.new(spell_contribution(ranks["Wizard"], level + 1), "Wizard Spells"),
              FormulaRow.new(25, "Familiar Bonus"), FormulaRow.new(location, "Public Workshop Bonus")]
           when "Sorcerer"
             larger, smaller = PAIRED_CONTROLS[profession].sort_by { |skill| -ranks[skill] }
             [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:wis], "WIS Bonus"), FormulaRow.new(stats[:int], "INT Bonus"),
              FormulaRow.new(ranks["Magic Item Use"] / 10, "trunc(MIU ranks / 10)"),
              FormulaRow.new(ranks["Arcane Symbols"] / 10, "trunc(AS ranks / 10)"),
              FormulaRow.new(ranks[larger] / 2, "trunc(#{larger} ranks / 2)"),
              FormulaRow.new(ranks[smaller] / 4, "trunc(#{smaller} ranks / 4)"),
              FormulaRow.new(spell_contribution(ranks["Sorcerer"], level + 1), "Sorcerer Spells"),
              FormulaRow.new(location, "Public Workshop Bonus")]
           when "Cleric"
             [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:wis], "WIS Bonus"), FormulaRow.new(stats[:inf], "INF Bonus"),
              FormulaRow.new(ranks["Magic Item Use"] / 10, "trunc(MIU ranks / 10)"),
              FormulaRow.new(ranks["Arcane Symbols"] / 10, "trunc(AS ranks / 10)"),
              FormulaRow.new(ranks["Spirit Mana Control"] / 2, "trunc(SMC ranks / 2)"),
              FormulaRow.new(spell_contribution(ranks["Cleric"], level + 1), "Cleric Spells"),
              FormulaRow.new(location, "Shrine Bonus")]
           when "Empath"
             larger, smaller = PAIRED_CONTROLS[profession].sort_by { |skill| -ranks[skill] }
             [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:con], "CON Bonus"), FormulaRow.new(stats[:inf], "INF Bonus"),
              FormulaRow.new(spell_contribution(ranks["Empath"], level), "Empath Spells"),
              FormulaRow.new(ranks[larger] / 2, "trunc(#{larger} ranks / 2)"),
              FormulaRow.new(ranks[smaller] / 4, "trunc(#{smaller} ranks / 4)"),
              FormulaRow.new(ranks["Arcane Symbols"] / 10, "trunc(AS ranks / 10)"),
              FormulaRow.new(ranks["Magic Item Use"] / 10, "trunc(MIU ranks / 10)"),
              FormulaRow.new(ranks["Physical Fitness"] / 20, "trunc(PF ranks / 20)"),
              FormulaRow.new(ranks["First Aid"] / 20, "trunc(First Aid ranks / 20)")]
           when "Bard"
             [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:int], "INT Bonus"), FormulaRow.new(stats[:inf], "INF Bonus"),
              FormulaRow.new(spell_contribution(ranks["Bard"], level), "Bard Spells"),
              FormulaRow.new(ranks["Mental Mana Control"], "MMC ranks"),
              FormulaRow.new(ranks["Elemental Mana Control"], "EMC ranks"),
              FormulaRow.new(ranks["Magic Item Use"], "MIU ranks"), FormulaRow.new(location, "Tavern/Shrine Bonus")]
           when "Paladin"
             [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:wis], "WIS Bonus"), FormulaRow.new(stats[:inf], "INF Bonus"),
              FormulaRow.new(ranks["Magic Item Use"] * 3 / 2, "trunc(MIU ranks * 1.5)"),
              FormulaRow.new(ranks["Arcane Symbols"] * 3 / 2, "trunc(AS ranks * 1.5)"),
              FormulaRow.new(ranks["Spirit Mana Control"], "SMC ranks"),
              FormulaRow.new(spell_contribution(ranks["Paladin"], level + 1), "Paladin Spells"),
              FormulaRow.new(location, "Shrine Bonus")]
           when "Monk"
             shared = [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:dex] * 2, "DEX Bonus * 2"), FormulaRow.new(stats[:dis] * 2, "DIS Bonus * 2"),
                       FormulaRow.new(ranks["Physical Fitness"] * 3 / 4, "trunc(PF ranks * 0.75)"),
                       FormulaRow.new(ranks["First Aid"] / 2, "trunc(First Aid ranks / 2)"),
                       FormulaRow.new((ranks["Minor Mental"] + ranks["Minor Spiritual"]) * 2, "Minor spell ranks * 2"),
                       FormulaRow.new(ranks["Arcane Symbols"], "AS ranks"), FormulaRow.new(ranks["Mental Mana Control"], "MMC ranks"),
                       FormulaRow.new(ranks["Spirit Mana Control"], "SMC ranks")]
             return {
               "Self Tattoo"  => shared + [FormulaRow.new(skill_bonus(ranks["Mental Lore - Transformation"]), "ML:Transformation Bonus")],
               "Other Tattoo" => shared + [FormulaRow.new(skill_bonus(ranks["Mental Lore - Telepathy"]), "ML:Telepathy Bonus")]
             }
           when "Ranger"
             [FormulaRow.new(level, "Level"), FormulaRow.new(stats[:wis] * 2, "WIS Bonus * 2"), FormulaRow.new(stats[:int] * 2, "INT Bonus * 2"),
              FormulaRow.new(ranks["Survival"] * 3 / 4, "trunc(Survival ranks * 0.75)"),
              FormulaRow.new(ranks["Magic Item Use"], "MIU ranks"), FormulaRow.new(ranks["Harness Power"], "Harness Power ranks"),
              FormulaRow.new(ranks["Spirit Mana Control"], "SMC ranks"),
              FormulaRow.new(ranks["Spiritual Lore - Blessings"], "SL:Blessings ranks"),
              FormulaRow.new(ranks["Ranger"] * 3 / 2, "trunc(Ranger spell ranks * 1.5)"),
              FormulaRow.new(location, location == 20 ? "Outdoors Bonus" : "Indoors Bonus")]
           end
    { SERVICE_NAMES[profession] => rows }
  end

  # Service bonus per title, e.g. { "Enchanting" => 540 } or { "Self Tattoo" => 800, "Other Tattoo" => 795 }.
  def self.service_totals(profession, data)
    service_formula(profession, data).transform_values { |rows| rows.sum(&:value) }
  end

  # The single number the optimizer maximizes for a set of service totals.
  def self.service_objective(totals)
    return totals.values.first if totals.size == 1
    weaker, stronger = totals.values.minmax
    MONK_GAP_WEIGHT * weaker + (stronger - weaker)
  end

  def self.show_service_formula(profession, data)
    respond ""
    respond "FIXSKILLS maximum formula:"
    service_formula(profession, data).each { |title, rows|
      respond "#{title}:"
      rows.each_with_index { |row, index|
        respond "#{index.zero? ? '  ' : '+ '}#{row.value.to_s.rjust(4)} : #{row.label}"
      }
      respond "  ======"
      respond "  #{rows.sum(&:value).to_s.rjust(4)} : Total"
    }
  end

  # Cost of training one rank, or nil past the per-level rank cap. Each further rank in the same
  # level (each block of `cycles` ranks) doubles the cost.
  def self.rank_cost(profession, skill, rank, cycles)
    base = TRAINING[profession][skill]
    tier = (rank - 1) / cycles
    return nil if tier >= base.max_per_level
    TrainingPoints.new(base.ptp * 2**tier, base.mtp * 2**tier)
  end

  # Running totals: element n is the cost of training n more ranks on top of `current_rank`.
  def self.cumulative_costs(profession, skill, cycles, current_rank = 0)
    totals = [TrainingPoints.new(0, 0)]
    rank = current_rank + 1
    while (cost = rank_cost(profession, skill, rank, cycles))
      totals << totals.last + cost
      rank += 1
    end
    totals
  end

  # Training auto-converts at 2:1 in either direction and unconverting refunds exactly, so a spend
  # fits the raw lifetime budget exactly when both conversion limits hold.
  def self.affordable?(budget, spent)
    2 * spent.ptp + spent.mtp <= 2 * budget.ptp + budget.mtp &&
      spent.ptp + 2 * spent.mtp <= budget.ptp + 2 * budget.mtp
  end

  # Most MTP that can be spent in total alongside `spent_ptp` (negative when even that PTP does not fit).
  def self.max_mtp_spend(budget, spent_ptp)
    [2 * budget.ptp + budget.mtp - 2 * spent_ptp, (budget.ptp + 2 * budget.mtp - spent_ptp) / 2].min
  end

  # How a planned spend is paid for: which pool is converted into which, how many, and what is left.
  def self.conversion_summary(budget, spent)
    if spent.mtp > budget.mtp
      converted = 2 * (spent.mtp - budget.mtp)
      { :from => "PTP", :to => "MTP", :converted => converted, :unspent => TrainingPoints.new(budget.ptp - spent.ptp - converted, 0) }
    elsif spent.ptp > budget.ptp
      converted = 2 * (spent.ptp - budget.ptp)
      { :from => "MTP", :to => "PTP", :converted => converted, :unspent => TrainingPoints.new(0, budget.mtp - spent.mtp - converted) }
    else
      { :from => nil, :to => nil, :converted => 0, :unspent => TrainingPoints.new(budget.ptp - spent.ptp, budget.mtp - spent.mtp) }
    end
  end

  # Lifetime PTP/MTP from level 0 through `level`, replaying stat growth from the level-0 stats.
  # Returns nil for an unknown race/profession or missing starting stats.
  def self.replay_training_points(profession, race, level, starting_stats)
    profession_growth = PROFESSION_GROWTH[profession]
    race_adjustment = RACE_GROWTH_ADJUSTMENT[race]
    return nil unless profession_growth && race_adjustment
    return nil if STAT_KEYS.any? { |stat| starting_stats[stat].nil? }
    stats = starting_stats.slice(*STAT_KEYS)
    growth_index = STAT_KEYS.to_h { |stat| [stat, profession_growth[:growth_index][stat] + race_adjustment[stat]] }
    weight = STAT_KEYS.to_h { |stat| [stat, profession_growth[:prime_stats].include?(stat) ? 2 : 1] }
    weighted = lambda { |stat| stats[stat] * weight[stat] }
    lifetime = TrainingPoints.new(0, 0)
    (0..level).each { |cycle|
      if cycle > 0
        STAT_KEYS.each { |stat|
          interval = [stats[stat] / growth_index[stat], 1].max
          stats[stat] = [stats[stat] + 1, 100].min if (cycle % interval).zero?
        }
      end
      shared = (weighted.call(:aur) + weighted.call(:dis)) / 2
      physical = [:str, :con, :dex, :agi].sum(&weighted) + shared
      mental = [:log, :int, :wis, :inf].sum(&weighted) + shared
      lifetime += TrainingPoints.new(25 + physical / 20, 25 + mental / 20)
    }
    lifetime
  end

  SKILL_RANK_PATTERNS ||= TRAINING.values.flat_map(&:keys).uniq.to_h { |skill|
    [skill, /^\s*#{Regexp.escape(skill).gsub('\\ ', '\\s+')}(?:\.{2,}|\s+\|).*?(\d+)\s*(?:\d+\s*)?$/i]
  }
  SPELL_CIRCLES ||= %w[Wizard Sorcerer Cleric Empath Bard Paladin Ranger Minor\ Mental Minor\ Spiritual]

  def self.parse_snapshot(exp_lines, info_lines, start_lines, skill_lines)
    snapshot = { :stats => {}, :starting_stats => {}, :ranks => Hash.new(0) }
    info_lines.each { |raw|
      line = clean_xml(raw)
      snapshot[:race] = $1.strip if line =~ /Race:\s*(.+?)\s+Profession:/i
      snapshot[:level] = $1.to_i if line =~ /Level:\s*(\d+)/
      STAT_NAMES.each { |stat, name|
        if line =~ /#{name}(?:\s+\([A-Z]{3}\))?:\s*\d+\s+\((-?\d+)\)/
          snapshot[:stats][stat] = $1.to_i
        elsif line =~ /#{name}.*?\((-?\d+)\)\s*$/
          snapshot[:stats][stat] = $1.to_i
        end
      }
    }
    start_lines.each { |raw|
      line = clean_xml(raw)
      snapshot[:race] ||= $1.strip if line =~ /Level 0 Stats for .*,\s*(.+)\s+(?:Wizard|Sorcerer|Cleric|Empath|Bard|Paladin|Monk|Ranger|Rogue|Warrior)\s*$/i
      STAT_NAMES.each { |stat, name| snapshot[:starting_stats][stat] = $1.to_i if line =~ /#{name}(?:\s+\([A-Z]{3}\))?:\s*(\d+)/ }
    }
    exp_lines.each { |raw|
      line = clean_xml(raw)
      snapshot[:normal_experience] = $1.delete(',').to_i if line !~ /(?:Total|Ascension) Exp/ && line =~ /\bExperience:\s*([\d,]+)/
      snapshot[:total_experience] = $1.delete(',').to_i if line =~ /^\s*Total Exp(?:erience)?:\s*([\d,]+)/
      snapshot[:ascension_experience] = $1.delete(',').to_i if line =~ /^\s*Ascension Exp(?:erience)?:\s*([\d,]+)/
    }
    skill_lines.each { |raw|
      line = clean_xml(raw)
      SKILL_RANK_PATTERNS.each { |skill, pattern|
        next unless line =~ pattern
        # Spell circles show only ranks; other skills show bonus then ranks.
        columns = line.scan(/\d+/).map(&:to_i)
        rank_column = SPELL_CIRCLES.include?(skill) ? 0 : 1
        snapshot[:ranks][skill] = columns[rank_column] if columns.length > rank_column
      }
    }
    if snapshot[:normal_experience].nil? && snapshot[:total_experience]
      snapshot[:normal_experience] = snapshot[:total_experience] - snapshot[:ascension_experience].to_i
    end
    snapshot
  end

  # Drops options that cost at least as much (in both PTP and MTP) as an option worth at least as much.
  def self.pareto_options(options)
    cheapest_per_value = options.group_by(&:value).map { |_value, same_value| same_value.min_by { |option| option.cost.ptp + option.cost.mtp } }
    cheapest_per_value.sort_by { |option| -option.value }.each_with_object([]) { |option, kept|
      kept << option unless kept.any? { |better| better.cost.ptp <= option.cost.ptp && better.cost.mtp <= option.cost.mtp }
    }
  end

  # The rank choices for each independent part of the service formula. Every part's score adds
  # independently, so a plan's value is the sum of the chosen options' values.
  def self.service_option_sets(profession, formula_data, base_ranks)
    cycles = formula_data[:level] + 1
    base_value = service_objective(service_totals(profession, formula_data.merge(:ranks => base_ranks)))
    value_of = lambda { |ranks| service_objective(service_totals(profession, formula_data.merge(:ranks => base_ranks.merge(ranks)))) - base_value }
    remaining_skills = SERVICE_SKILLS[profession].dup
    option_sets = []
    if (controls = PAIRED_CONTROLS[profession])
      remaining_skills -= controls
      first_costs = cumulative_costs(profession, controls[0], cycles)
      second_costs = cumulative_costs(profession, controls[1], cycles)
      option_sets << first_costs.each_with_index.flat_map { |first_cost, first_rank|
        second_costs.each_with_index.map { |second_cost, second_rank|
          ServiceOption.new({ controls[0] => first_rank, controls[1] => second_rank }, first_cost + second_cost)
        }
      }
    end
    if profession == "Monk"
      remaining_skills -= MONK_LORES + MONK_MINOR_CIRCLES
      # An even lore split maximizes the weaker tattoo and the total; the odd rank goes to Self (Transformation).
      option_sets << cumulative_costs(profession, MONK_LORES[0], cycles).each_with_index.map { |cost, combined|
        ServiceOption.new({ MONK_LORES[0] => (combined + 1) / 2, MONK_LORES[1] => combined / 2 }, cost)
      }
      # Both minor circles score the same, so all minor ranks go to Minor Mental.
      option_sets << cumulative_costs(profession, MONK_MINOR_CIRCLES[0], cycles).each_with_index.map { |cost, combined|
        ServiceOption.new({ MONK_MINOR_CIRCLES[0] => combined }, cost)
      }
    end
    remaining_skills.each { |skill|
      current_rank = base_ranks[skill]
      option_sets << cumulative_costs(profession, skill, cycles, current_rank).each_with_index.map { |cost, added|
        ServiceOption.new({ skill => current_rank + added }, cost)
      }
    }
    option_sets.map { |options|
      options.each { |option| option.value = value_of.call(option.ranks) }
      pareto_options(options)
    }
  end

  # MTP-only knapsack. Values are small integers, so keeping the cheapest plan per value stays small.
  # Returns plans sorted by MTP cost with strictly increasing value.
  def self.mental_frontier(option_sets, mtp_limit)
    frontier = [MentalPlan.new(0, 0, nil, nil)]
    option_sets.each { |options|
      cheapest_by_value = {}
      frontier.each { |plan|
        options.each { |option|
          mtp = plan.mtp + option.cost.mtp
          next if mtp > mtp_limit
          value = plan.value + option.value
          known = cheapest_by_value[value]
          cheapest_by_value[value] = MentalPlan.new(mtp, value, option, plan) if known.nil? || mtp < known.mtp
        }
      }
      frontier = cheapest_by_value.values.sort_by { |plan| [plan.mtp, -plan.value] }.each_with_object([]) { |plan, kept|
        kept << plan if kept.empty? || plan.value > kept.last.value
      }
    }
    frontier
  end

  # Best service plan for a raw lifetime budget after the reserved ranks are paid for.
  # Options that spend PTP are few, so every combination of them is tried against the best
  # MTP-only plan that still fits.
  def self.optimize_service(profession, formula_data, budget, reserved_ranks, reserved_cost)
    return nil unless affordable?(budget, reserved_cost)
    base_ranks = Hash.new(0).merge(reserved_ranks)
    mental_sets, physical_sets = service_option_sets(profession, formula_data, base_ranks).partition { |options| options.all? { |option| option.cost.ptp.zero? } }
    frontier = mental_frontier(mental_sets, max_mtp_spend(budget, reserved_cost.ptp) - reserved_cost.mtp)
    physical_combinations = physical_sets.empty? ? [[]] : physical_sets.first.product(*physical_sets.drop(1))
    best = nil
    physical_combinations.each { |physical_options|
      physical_spent = physical_options.reduce(reserved_cost) { |sum, option| sum + option.cost }
      mtp_room = max_mtp_spend(budget, physical_spent.ptp) - physical_spent.mtp
      next if mtp_room < 0
      affordable_index = frontier.bsearch_index { |plan| plan.mtp > mtp_room } || frontier.size
      mental = frontier[affordable_index - 1]
      value = physical_options.sum(&:value) + mental.value
      spent = physical_spent + TrainingPoints.new(0, mental.mtp)
      if best.nil? || value > best[:value] || (value == best[:value] && spent.ptp + spent.mtp < best[:spent].ptp + best[:spent].mtp)
        best = { :value => value, :spent => spent, :physical_options => physical_options, :mental => mental }
      end
    }
    ranks = base_ranks.dup
    best[:physical_options].each { |option| ranks.merge!(option.ranks) }
    plan = best[:mental]
    while plan.option
      ranks.merge!(plan.option.ranks)
      plan = plan.previous
    end
    ServicePlan.new(ranks: ranks, spent: best[:spent], score: service_totals(profession, formula_data.merge(:ranks => ranks)))
  end

  # Trains Physical Fitness with whatever the service plan left, one rank at a time.
  def self.train_survivability(profession, budget, spent, cycles)
    ranks = 0
    while (cost = rank_cost(profession, "Physical Fitness", ranks + 1, cycles)) && affordable?(budget, spent + cost)
      spent += cost
      ranks += 1
    end
    { :ranks => ranks, :spent => spent }
  end

  def self.location_bonus(profession)
    case profession
    when "Wizard" then 50
    when "Sorcerer", "Cleric", "Bard", "Paladin" then 20
    when "Ranger" then outside? ? 20 : 0
    else 0
    end
  end

  def self.maximum
    profession = Stats.prof.to_s
    unless TRAINING.key?(profession)
      respond ";resource max is not yet supported for #{profession.empty? ? 'this profession' : profession}; no estimate was produced."
      return
    end

    # Each end pattern also stops at the prompt, so an unexpected trailing line cannot stall the capture.
    snapshot = parse_snapshot(
      Lich::Util.quiet_command_xml("exp", /Level:|Experience:/, /Your mind|<prompt/),
      Lich::Util.quiet_command_xml("info", /^Name: /),
      Lich::Util.quiet_command_xml("info start", /Level 0 Stats for/, /This character was created|<prompt/),
      Lich::Util.quiet_command_xml("skills base full", /base skill bonuses, ranks and goals|base skill bonuses and ranks/, /Further information can be found/)
    )
    if snapshot[:level].nil? || snapshot[:race].nil? || STAT_KEYS.any? { |stat| snapshot[:stats][stat].nil? }
      respond ";resource max could not parse INFO; no estimate was produced."
      return
    end
    if STAT_KEYS.any? { |stat| snapshot[:starting_stats][stat].nil? }
      respond ";resource max requires INFO START to read level-0 stats; no estimate was produced."
      return
    end
    if snapshot[:normal_experience].nil?
      respond ";resource max could not parse EXP; no estimate was produced."
      return
    end

    lifetime = replay_training_points(profession, snapshot[:race], snapshot[:level], snapshot[:starting_stats])
    unless lifetime
      respond "Could not replay stat growth for #{snapshot[:race]} #{profession}; no estimate was produced."
      return
    end
    post_cap_each = [snapshot[:normal_experience] - CAP_EXPERIENCE, 0].max / POST_CAP_EXPERIENCE_PER_TP
    post_cap = TrainingPoints.new(post_cap_each, post_cap_each)
    budget = lifetime + post_cap
    cycles = snapshot[:level] + 1

    reserve_costs = SERVICE_RESERVE.map { |skill, count| cumulative_costs(profession, skill, cycles)[count] }
    if reserve_costs.any?(&:nil?)
      respond "The required #{SERVICE_RESERVE.map { |skill, count| "#{count} #{skill}" }.join(', ')} ranks exceed the level-based rank cap; no estimate was produced."
      return
    end
    reserved_cost = reserve_costs.reduce(:+)
    formula_data = { :level => snapshot[:level], :stats => snapshot[:stats], :location_bonus => location_bonus(profession) }
    plan = optimize_service(profession, formula_data, budget, SERVICE_RESERVE, reserved_cost)
    unless plan
      respond "The lifetime training-point budget cannot cover #{SERVICE_RESERVE.map { |skill, count| "#{count} #{skill} ranks" }.join(', ')}; no estimate was produced."
      return
    end
    service_ptp_mtp = TrainingPoints.new(plan.spent.ptp - reserved_cost.ptp, plan.spent.mtp - reserved_cost.mtp)
    survivability = if SERVICE_SKILLS[profession].include?("Physical Fitness")
                      { :ranks => plan.ranks["Physical Fitness"], :spent => plan.spent }
                    else
                      train_survivability(profession, budget, plan.spent, cycles)
                    end
    survivability_spent = TrainingPoints.new(survivability[:spent].ptp - plan.spent.ptp, survivability[:spent].mtp - plan.spent.mtp)
    conversion = conversion_summary(budget, survivability[:spent])
    current_totals = service_totals(profession, formula_data.merge(:ranks => snapshot[:ranks]))

    respond "With Fixskills - #{profession} #{SERVICE_NAMES[profession]}"
    respond ""
    respond "Current service bonus (base stats and ranks):"
    current_totals.each { |title, total| respond "  #{title}: #{total}" }
    respond "FIXSKILLS maximum:"
    plan.score.each { |title, total| respond "  #{title}: #{total}" }
    respond ""
    respond "Lifetime PTP/MTP earned: #{lifetime.ptp} / #{lifetime.mtp}"
    respond "Post-cap PTP/MTP earned: #{post_cap.ptp} / #{post_cap.mtp}"
    respond "Reserved PTP/MTP: #{reserved_cost.ptp} / #{reserved_cost.mtp}"
    respond "Service PTP/MTP spent: #{service_ptp_mtp.ptp} / #{service_ptp_mtp.mtp}"
    respond "Survivability PTP/MTP spent: #{survivability_spent.ptp} / #{survivability_spent.mtp}"
    respond "Unspent PTP/MTP: #{conversion[:unspent].ptp} / #{conversion[:unspent].mtp}"
    respond ""
    respond "Required training:"
    SERVICE_RESERVE.each { |skill, count| respond "  #{skill}: #{count}" }
    respond ""
    respond "Service training:"
    SERVICE_SKILLS[profession].each { |skill|
      respond "  #{skill}: #{plan.ranks[skill]}" unless SERVICE_RESERVE[skill] == plan.ranks[skill]
    }
    respond ""
    respond "Survivability training:"
    respond "  Physical Fitness: #{survivability[:ranks]}"
    respond ""
    respond "Assumptions:"
    case profession
    when "Wizard" then respond "  Public workshop: +50 (private workshop not assumed)"; respond "  Familiar present: +25"
    when "Sorcerer" then respond "  Public workshop: +20"
    when "Cleric" then respond "  Maximum matching-deity shrine: +20"
    when "Bard" then respond "  Tavern or qualifying shrine: +20"
    when "Paladin" then respond "  Matching-deity shrine: +20"
    when "Ranger" then respond "  Current location: #{formula_data[:location_bonus] == 20 ? 'outdoors (+20)' : 'indoors (+0)'}"
    else respond "  No non-skill location bonus assumed"
    end
    respond "  Base stats only (enhancives not counted)"
    respond "  Ascension experience excluded from training points"
    if conversion[:from]
      respond "  Planned conversion: #{conversion[:converted]} #{conversion[:from]} converted to #{conversion[:to]}"
    else
      respond "  Planned conversion: none"
    end
    show_service_formula(profession, formula_data.merge(:ranks => plan.ranks))
  end

  def self.load_bonuses()
    dir = File.join(DATA_DIR, "resource")
    filename = File.join(dir, "bonuses.yaml")
    if File.exist?(filename)
      return YAML.load_file(filename)
    else
      return nil
    end
  end

  def self.save_bonuses(bonus)
    dir = File.join(DATA_DIR, "resource")
    Dir.mkdir(dir) unless File.exist?(dir)
    filename = File.join(dir, "bonuses.yaml")
    all_bonuses = Resource.load_bonuses
    all_bonuses = {} if all_bonuses.nil?
    weekly_resource = nil
    total_resource = nil
    suffused = nil

    res = Lich::Util.quiet_command_xml("resource", /^Health: /)
    res.each { |line|
      line = line.gsub('<pushBold/>', '').gsub('<popBold/>', '')
      if line =~ /([\d,]+)\/50,000 \(Weekly\)\s+([\d,]+)\/200,000 \(Total\)$/
        weekly_resource = $1
        total_resource = $2
      elsif line =~ /Suffused.+: ([\d,]+)$/
        suffused = $1
      end
    }

    return if ((all_bonuses["#{XMLData.game}:#{Char.name}"][:bonus] == bonus) &&
      (all_bonuses["#{XMLData.game}:#{Char.name}"][:prof] == Stats.prof) &&
      (all_bonuses["#{XMLData.game}:#{Char.name}"][:weekly] == weekly_resource) &&
      (all_bonuses["#{XMLData.game}:#{Char.name}"][:total] == total_resource) &&
      (all_bonuses["#{XMLData.game}:#{Char.name}"][:suffused] == suffused)
              )

    if Stats.prof == "Warrior"
      all_bonuses["#{XMLData.game}:#{Char.name}"] = {
        :game     => XMLData.game,
        :name     => Char.name,
        :prof     => Stats.prof,
        :bonus    => {
          "Armor"  => bonus[0],
          "Weapon" => bonus[1],
        },
        :weekly   => weekly_resource,
        :total    => total_resource,
        :suffused => suffused
      }
    elsif Stats.prof == "Rogue"
      all_bonuses["#{XMLData.game}:#{Char.name}"] = {
        :game     => XMLData.game,
        :name     => Char.name,
        :prof     => Stats.prof,
        :bonus    => {
          "Sidestep"       => bonus[0],
          "Keen Eye"       => bonus[1],
          "Escape Artist"  => bonus[2],
          "Swift Recovery" => bonus[3],
          "Poisoncraft"    => bonus[4],
          "Recharge"       => bonus[5],
        },
        :weekly   => weekly_resource,
        :total    => total_resource,
        :suffused => suffused
      }
    elsif Stats.prof == "Monk"
      all_bonuses["#{XMLData.game}:#{Char.name}"] = {
        :game     => XMLData.game,
        :name     => Char.name,
        :prof     => Stats.prof,
        :bonus    => {
          "Self"  => bonus[0],
          "Other" => bonus[1],
        },
        :weekly   => weekly_resource,
        :total    => total_resource,
        :suffused => suffused
      }
    else
      all_bonuses["#{XMLData.game}:#{Char.name}"] = {
        :game     => XMLData.game,
        :name     => Char.name,
        :prof     => Stats.prof,
        :bonus    => bonus,
        :weekly   => weekly_resource,
        :total    => total_resource,
        :suffused => suffused
      }
    end
    File.write(filename, all_bonuses.to_yaml)
  end

  def self.show_bonuses
    all_bonuses = Resource.load_bonuses
    unless all_bonuses.nil?
      all_bonuses = all_bonuses.sort

      headers = %i[Game Character Profession Bonus Suffused Weekly Total]
      table_rows = []

      all_bonuses.each { |character|
        game = character[1][:game]
        name = character[1][:name]
        prof = character[1][:prof]
        bonus = character[1][:bonus]
        weekly = character[1][:weekly]
        total = character[1][:total]
        suffused = character[1][:suffused]

        if prof =~ /^(?:Warrior|Monk|Rogue)$/
          bonus.each { |title, bonusValue|
            table_rows.push([game, name, prof, "#{bonusValue} #{title}", suffused, weekly, total])
          }
        else
          table_rows.push([game, name, prof, bonus, suffused, weekly, total])
        end
      }

      table = Terminal::Table.new(
        headings: headers,
        rows: table_rows
      )
      table = table.to_s
      if table =~ /\n\|([\w\s\|]+)\|\n/
        header = $1
        headerbold = Lich::Messaging.monsterbold(header)
        table = table.gsub(header, headerbold)
      end
      row_lines = /\| \w+ \| [\w\s]+ \| [\w\s]+\| [\d\s,]+ \| [\d\s,]+ \| [\d\s,]+ \| ([\d\s,]+) \|/
      totals = table.scan(row_lines).flatten
      totals.each { |total|
        if (!total.nil? && total.to_s.gsub(',', '').to_i >= 150000)
          total_bold = Lich::Messaging.monsterbold(total)
          table = table.gsub(total, total_bold)
        end
      }
      _respond "<output class=\"mono\"/>\n" + table + "\n<output class=\"\"/>"

    else
      echo "No characters currently found."
    end
  end

  def self.rowout(msg_arr, mbold = false, delimiter = 12)
    out = '| '
    msg_arr.each { |m|
      out += "%-#{delimiter}.#{delimiter}s | " % m
    }
    if mbold == true
      _respond "#{monsterbold_start}#{out}#{monsterbold_end}"
    else
      _respond out
    end
  end

  def self.number_commas(number)
    return number.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
  end

  def self.silver_to_dollar(silvers, dollar_per)
    return '%.2f' % ((silvers / 1000000 * dollar_per).to_f.round(2))
  end

  def self.calc_rate_row(rate, running_total_ess)
    silver_cost = rate.to_f * running_total_ess.to_f
    row_label = "#{rate} silver"
    orig_rate = rate * 3.125
    silver_cost_comma = number_commas(silver_cost)
    output = [
      row_label,
      "#{orig_rate} silver",
      silver_cost_comma,
      silver_to_dollar(silver_cost, SILVER_COST_LOW),
      silver_to_dollar(silver_cost, SILVER_COST_HIGH)
    ]
    return output
  end

  def self.materials
    respond "|--------------------------------------------------------------|"
    respond "|                    Material Difficulty Modifiers             |"
    respond "|--------------------------------------------------------------|"
    respond "|   Material   | Weapons | Shields | Armor | Bows | Runestaves |"
    respond "|--------------------------------------------------------------|"
    MAT_LIST.each { |mat, weap, shie, arm, bow, rune|
      respond "| #{mat} |  #{weap}   |  #{shie}   | #{arm}  | #{bow} |    #{rune}    |"
    }
    respond "|--------------------------------------------------------------|"
  end

  def self.chance(item_difficulty, type, bonus)
    if !item_difficulty.nil? && (!bonus.nil? || Stats.prof =~ /^Wizard|Sorcerer|Monk|Cleric|Ranger|Rogue|Bard|Empath|Paladin$/)
      unless type =~ /^(e(?:50|[1-4][0-9]|[0-9])|[tmj](?:[1-5])|[slb](?:[1-6])|[ra](?:2[0-5]|1[0-9]|[1-9]))$/i
        respond "Need to provide an item difficulty and bonus type too use advanced chance option."
        respond "  ;resource chance <ItemDifficulty> <BonusType> <SkillBonus>"
        respond ""
        respond "  Types:"
        respond "    Enchant            - E1 to E50"
        respond "    Ensorcell          - T1 to T5"
        respond "    Sanctify           - S1 to S6"
        respond "    Tattooing          - M1 to M5"
        respond "    Resistance         - R1 to R25"
        respond "    Covert Arts        - A1 to A25"
        respond "    Luck               - L1 to L6"
        respond "    Battle Standard    - B1 to B6"
        respond "    Bloodstone Jewelry - J1 to J5"
        respond ""
        respond "  Will attempt to be smart if no SkillBonus given."
        return
      end
      item_difficulty = item_difficulty.to_i
      bonus = bonus.nil? ? Resource.bonus(false) : bonus.to_i
      case type
      when /^e(50|[1-4][0-9]|[0-9])/i
        penalty = (((($1.to_f - 1) / 3)**2) - ((($1.to_f - 2) / 3)**2)).truncate
      when /^t([1-5])/i
        penalty = 50
      when /m([1-5])/i
        penalty = 100 * $1.to_i
      when /s([1-6])/i
        penalty = (($1.to_i == 6) ? 50 : 20)
      when /l([1-6])/i
        penalty = (($1.to_i == 1) ? 150 : 75)
      when /b([1-6])/i
        penalty = 75 + ($1.to_i * 75)
        item_difficulty = 0
      when /j([1-5])/i
        penalty = 75 + ($1.to_i * 75)
        item_difficulty = 0
      when /r(2[0-5]|1[0-9]|[1-9])/i
        penalty = $1.to_i
        item_difficulty = 0
        case penalty
        when 1..5
          penalty = penalty * 100
        when 6..10
          penalty = (penalty - 5) * 100 + 150 * 1
        when 11..15
          penalty = (penalty - 10) * 100 + 150 * 2
        when 16..20
          penalty = (penalty - 15) * 100 + 150 * 3
        when 21..25
          penalty = (penalty - 20) * 100 + 150 * 4
        end
      when /a(2[0-5]|1[0-9]|[1-9])/i
        penalty = $1.to_i
        item_difficulty = 0
        case penalty
        when 1..5
          penalty = penalty * 100
        when 6..10
          penalty = (penalty - 5) * 100 + 150 * 1
        when 11..15
          penalty = (penalty - 10) * 100 + 150 * 2
        when 16..20
          penalty = (penalty - 15) * 100 + 150 * 3
        when 21..25
          penalty = (penalty - 20) * 100 + 150 * 4
        end
      end

      new_difficulty = item_difficulty + penalty

      respond "Chance to Succeed"
      respond "----------------------------------------"
      respond "  #{item_difficulty.to_s.rjust(4)} - Item Difficulty"
      respond "+ #{penalty.to_s.rjust(4)} - #{type.upcase}"
      respond "========================================"
      respond "  #{new_difficulty.to_s.rjust(4)} - Total Difficulty"
      respond "  #{bonus.to_s.rjust(4)} - Current Skill Bonus"
      respond "========================================"
      Resource.show_odds(new_difficulty, bonus)

    else
      respond "|-------------------------------------------------------------------------------------------------------------------------|"
      respond "|                                  Description Of Test CASTs And Chance To Succeed                                        |"
      respond "|-------------------------------------------------------------------------------------------------------------------------|"
      respond "| Chance To Get A Successful CHANNEL |                       Messaging On Test CAST                                       |"
      respond "|-------------------------------------------------------------------------------------------------------------------------|"
      R_NEED.each { |rchan, rmes|
        respond "| #{rchan}  | #{rmes} |"
      }
      respond "|-------------------------------------------------------------------------------------------------------------------------|"
    end
  end

  def self.rolls
    respond "|-------------------------------------------------------|"
    respond "|          Numeric Values For Roll Descriptions         |"
    respond "|-------------------------------------------------------|"
    respond "|          Roll Result Description         | Roll Value |"
    respond "|-------------------------------------------------------|"
    R_RESULT.each { |rdesc, rval|
      respond "| #{rdesc} |    #{rval}  |"
    }
    respond "|-------------------------------------------------------|"
  end

  def self.do_calc
    starting_bonus = variable[2].to_i
    if variable[3] and variable[3].to_i <= 50
      ending_bonus = variable[3].to_i
    elsif not variable[3] or variable[3].to_i > 50
      ending_bonus = 50
    end
    if variable[4]
      tears_rate = variable[4].to_i
    end
    if ending_bonus <= starting_bonus
      _respond "Ending bonus must be greater than starting bonus"
      _respond ";resource calc [starting bonus] [ending bonus]"
      return
    end

    _respond "Calculating essence needed to take an item from #{starting_bonus} to #{ending_bonus}"
    _respond ""

    headers = ['Current', 'New', 'Cost (ess)', 'Cost (wks)', 'Total (ess)', 'Total (wks)']
    table_rows = []

    current_bonus = starting_bonus
    running_total_ess = 0
    while current_bonus < ending_bonus
      if current_bonus < 0
        step_cost = 0
      else
        step_cost = COST_ESSENCE[current_bonus].to_i
      end
      running_total_ess += step_cost
      response_array = [
        current_bonus,
        current_bonus + 1,
        step_cost,
        (step_cost / WEEKLY_RESOURCE).round(2),
        running_total_ess,
        (running_total_ess / WEEKLY_RESOURCE).round(2)
      ]
      table_rows.push(response_array)
      current_bonus += 1
    end
    table = Terminal::Table.new(
      headings: headers,
      rows: table_rows
    )
    table = table.to_s
    if table =~ /\n\|([\w\d\s\|\$\/\(\)]+)\|\n/
      header = $1
      headerbold = Lich::Messaging.monsterbold(header)
      table = table.gsub(header, headerbold)
    end
    _respond "<output class=\"mono\"/>\n" + table + "\n<output class=\"\"/>"
    respond ""

    headers = ["Cost per Essence", "Old Cost per Ess", "Total Cost", "$#{SILVER_COST_LOW}/1m Silver", "$#{SILVER_COST_HIGH}/1m Silver"]
    table_rows = []

    if variable[4]
      table_rows.push(calc_rate_row(tears_rate, running_total_ess))
    else
      (4..10).to_a.each { |rate_multi|
        rate = 16 * rate_multi
        table_rows.push(calc_rate_row(rate, running_total_ess))
      }
    end
    table = Terminal::Table.new(
      headings: headers,
      rows: table_rows
    )
    table = table.to_s
    if table =~ /\n\|([\w\d\s\|\$\/\(\)\.]+)\|\n/
      header = $1
      headerbold = Lich::Messaging.monsterbold(header)
      table = table.gsub(header, headerbold)
    end
    _respond "<output class=\"mono\"/>\n" + table + "\n<output class=\"\"/>"
  end

  def self.chart
    respond "Resource needed per tier profession services"
    respond ""
    if (Stats.prof == "Wizard" && variable[2].nil?) || variable[2] =~ /^wiz/i
      COST_ESSENCE.each_index { |resource|
        respond "+#{resource.to_s.rjust(2, " ")} -> +#{(resource + 1).to_s.rjust(2, " ")} - #{number_commas(COST_ESSENCE[resource]).rjust(7, " ")} Essence"
      }
    elsif (Stats.prof == "Sorcerer" && variable[2].nil?) || variable[2] =~ /^sorc/i
      headers = ['Step', 'Resource Cost', 'Difficulty Increase']
      table_rows = []

      COST_OTHER.each_index { |resource|
        table_rows.push(["T#{resource} -> T#{(resource + 1)}", "#{number_commas(COST_OTHER[resource])} Necrotic Energy", "#{number_commas(DIFFICULTY_OTHER[resource])}"])
      }

      table = Terminal::Table.new(
        headings: headers,
        rows: table_rows
      )
      table = table.to_s
      if table =~ /\n\|([\w\d\s\|\$\/\(\)]+)\|\n/
        header = $1
        headerbold = Lich::Messaging.monsterbold(header)
        table = table.gsub(header, headerbold)
      end
      _respond "<output class=\"mono\"/>\n" + table + "\n<output class=\"\"/>"
    elsif (Stats.prof == "Empath" && variable[2].nil?) || variable[2] =~ /^emp/i
      headers = ['Step', 'Resource Cost', 'Difficulty Increase']
      table_rows = []

      COST_OTHER.each_index { |resource|
        table_rows.push(["J#{resource} -> J#{(resource + 1)}", "#{number_commas(COST_OTHER[resource])} Vitality", "#{number_commas(DIFFICULTY_BARD[resource])}"])
      }

      table = Terminal::Table.new(
        headings: headers,
        rows: table_rows
      )
      table = table.to_s
      if table =~ /\n\|([\w\d\s\|\$\/\(\)]+)\|\n/
        header = $1
        headerbold = Lich::Messaging.monsterbold(header)
        table = table.gsub(header, headerbold)
      end
      _respond "<output class=\"mono\"/>\n" + table + "\n<output class=\"\"/>"
    elsif (Stats.prof == "Bard" && variable[2].nil?) || variable[2] =~ /^bard/i
      COST_OTHER.each_index { |resource|
        respond "L#{(resource + 1).to_s.rjust(1, " ")} - #{number_commas(COST_OTHER[resource]).rjust(7, " ")} Luck Inspiration"
      }
      respond "Add Fated Fortune to B5".to_s.rjust(1, " ") + " Luck Talisman - #{number_commas(200000).rjust(7, " ")} Luck Inspiration"
    elsif (Stats.prof == "Monk" && variable[2].nil?) || variable[2] =~ /^monk/i
      COST_OTHER.each_index { |resource|
        respond "T#{(resource + 1).to_s.rjust(1, " ")} Tattoo - #{number_commas(COST_OTHER[resource]).rjust(7, " ")} Motes of Tranquility"
      }
      respond ""
      respond "Tattoos come with 100 max charges and are fully charged upon applying or upgrading to next tier."
      respond "To recharge a tattoo, it costs 1,000 Motes of Tranquility per charge being filled."
    elsif (Stats.prof == "Cleric" && variable[2].nil?) || variable[2] =~ /^cleric/i
      COST_OTHER.each_index { |resource|
        respond "T#{(resource + 1).to_s.rjust(1, " ")} Sanctify - #{number_commas(COST_OTHER[resource]).rjust(7, " ")} Devotion"
      }
      respond "Add Perm Holy Water Flares to T5".to_s.rjust(1, " ") + " Sanctify - #{number_commas(200000).rjust(7, " ")} Devotion"
    elsif (Stats.prof == "Paladin" && variable[2].nil?) || variable[2] =~ /^paladin/i
      COST_OTHER.each_index { |resource|
        respond "B#{(resource + 1).to_s.rjust(1, " ")} Battle Standard - #{number_commas(COST_OTHER[resource]).rjust(7, " ")} Devotion"
      }
      respond "B6 Battle Standard - #{number_commas('200000').rjust(7, " ")} Devotion"
    elsif (Stats.prof == "Warrior" && variable[2].nil?) || variable[2] =~ /^warrior/i
      respond "25,000 Grit per service on weapons and armor"
      respond ""
      respond "10,000 Grit per service on armor accessories"
    elsif (Stats.prof == "Ranger" && variable[2].nil?) || variable[2] =~ /^ranger/i
      COST_OTHER.each_index { |resource|
        respond "T#{(resource + 1).to_s.rjust(1, " ")} Resist - #{number_commas(COST_OTHER[resource]).rjust(7, " ")} Nature's Grace"
      }
      respond "The costs are the same for each new type of resist added"
      respond ""
      respond "Updating the imbedible mana storage to your current lore bonus threshold: 25,000 Nature's Grace"
    elsif (Stats.prof == "Rogue" && variable[2].nil?) || variable[2] =~ /^rogue/i
      COST_OTHER.each_index { |resource|
        respond "T#{(resource + 1).to_s.rjust(1, " ")} Covert Art - #{number_commas(COST_OTHER[resource]).rjust(7, " ")} Guile"
      }
      respond "The costs are the same for each new type of covert arts added"
      respond ""
    else
      respond "You're not a class with a currently supported resource calculation. Please use the following to show an appropriate table:"
      respond "   ;resource chart <PROFESSION>"
      respond "   Professions supported: wizard, sorcerer, bard, monk, cleric, warrior, ranger, rogue"
    end
    respond ""
  end

  def self.bonus(show_chart = true, profession = nil)
    level = 0
    arcanesymbols = magicitemuse = physicalfitness = firstaid = 0
    dodging = perception = combatmaneuvers = ambush = pickpocketing = 0
    gldranks = 0
    elementalmanacontrol = spiritmanacontrol = mentalmanacontrol = 0
    mentalloretelepathy = mentalloretelepathybonus = mentalloretransformation = mentalloretransformationbonus = 0
    spiritloreblessingsbonus = spiritloreblessings = survival = harnesspower = 0
    bardranks = sorcererranks = wizardranks = clericranks = rangerranks = empathranks = paladinranks = minormentalranks = minorspiritranks = 0
    strength = constitution = dexterity = agility = discipline = 0
    aura = logic = intuition = wisdom = influence = 0
    armoruse = shielduse = 0
    edgedweapons = bluntweapons = twohandedweapons = rangedweapons = thrownweapons = polearmweapons = brawling = 0

    if Stats.prof !~ /^(?:Wizard|Sorcerer|Bard|Monk|Cleric|Warrior|Ranger|Rogue|Paladin|Empath)$/ && variable[2].nil?
      respond "You're not a class with a currently supported resource calculation. Please use the following to show an appropriate table:"
      respond "   ;resource chart <PROFESSION>"
      respond "   Professions supported: wizard, sorcerer, bard, monk, cleric, warrior, ranger, rogue, empath"
      return
    end

    gritSkills = Hash.new

    res = Lich::Util.quiet_command_xml("skills full", /your current skill bonuses and ranks/, /Further information can be found in the/, 8)
    res.each { |line|
      line = line.gsub('<pushBold/>', '').gsub('<popBold/>', '')
      if line =~ /Arcane Symbols.*?(\d+)$/
        arcanesymbols = $1.to_i
      elsif line =~ /Magic Item Use.*?(\d+)$/
        magicitemuse = $1.to_i
      elsif line =~ /Physical Fitness.*?(\d+)$/
        physicalfitness = $1.to_i
      elsif line =~ /First Aid.*?(\d+)$/
        firstaid = $1.to_i
      elsif line =~ /Ambush.*?(\d+)$/
        ambush = $1.to_i
      elsif line =~ /Pickpocketing.*?(\d+)$/
        pickpocketing = $1.to_i
      elsif line =~ /Mental Lore - Telepathy.*?(\d+)\s+(\d+)$/
        mentalloretelepathybonus = $1.to_i
        mentalloretelepathy = $2.to_i
      elsif line =~ /Mental Lore - Transformation.*?(\d+)\s+(\d+)$/
        mentalloretransformationbonus = $1.to_i
        mentalloretransformation = $2.to_i
      elsif line =~ /Elemental Mana Control.*?(\d+)$/
        elementalmanacontrol = $1.to_i
      elsif line =~ /Spirit Mana Control.*?(\d+)$/
        spiritmanacontrol = $1.to_i
      elsif line =~ /Mental Mana Control.*?(\d+)$/
        mentalmanacontrol = $1.to_i
      elsif line =~ /Wizard.*?(\d+)$/
        wizardranks = $1.to_i
      elsif line =~ /Sorcerer.*?(\d+)$/
        sorcererranks = $1.to_i
      elsif line =~ /Paladin.*?(\d+)$/
        paladinranks = $1.to_i
      elsif line =~ /Cleric.*?(\d+)$/
        clericranks = $1.to_i
      elsif line =~ /Minor Mental.*?(\d+)$/
        minormentalranks = $1.to_i
      elsif line =~ /Minor Spiritual.*?(\d+)$/
        minorspiritranks = $1.to_i
      elsif line =~ /Bard.*?(\d+)$/
        bardranks = $1.to_i
      elsif line =~ /Ranger.*?(\d+)$/
        rangerranks = $1.to_i
      elsif line =~ /Empath.*?(\d+)$/
        empathranks = $1.to_i
      elsif line =~ /Armor Use.*?(\d+)$/
        armoruse = $1.to_i
      elsif line =~ /Shield Use.*?(\d+)$/
        shielduse = $1.to_i
      elsif line =~ /Edged Weapons.*?(\d+)$/
        edgedweapons = $1.to_i
        gritSkills["Edged Weapons"] = edgedweapons
      elsif line =~ /Blunt Weapons.*?(\d+)$/
        bluntweapons = $1.to_i
        gritSkills["Blunt Weapons"] = bluntweapons
      elsif line =~ /Two-Handed Weapons.*?(\d+)$/
        twohandedweapons = $1.to_i
        gritSkills["Two-Handed Weapons"] = twohandedweapons
      elsif line =~ /Ranged Weapons.*?(\d+)$/
        rangedweapons = $1.to_i
        gritSkills["Ranged Weapons"] = rangedweapons
      elsif line =~ /Thrown Weapons.*?(\d+)$/
        thrownweapons = $1.to_i
        gritSkills["Thrown Weapons"] = thrownweapons
      elsif line =~ /Polearm Weapons.*?(\d+)$/
        polearmweapons = $1.to_i
        gritSkills["Polearm Weapons"] = polearmweapons
      elsif line =~ /Brawling.*?(\d+)$/
        brawling = $1.to_i
        gritSkills["Brawling Weapons"] = brawling
      elsif line =~ /Survival.*?(\d+)$/
        survival = $1.to_i
      elsif line =~ /Spiritual Lore - Blessings.*?(\d+)\s+(\d+)$/
        spiritloreblessingsbonus = $1.to_i
        spiritloreblessings = $2.to_i
      elsif line =~ /Harness Power.*?(\d+)\s+(\d+)$/
        # harnesspowerbonus = $1.to_i
        harnesspower = $2.to_i
      elsif line =~ /Dodging.*?(\d+)$/
        dodging = $1.to_i
      elsif line =~ /Perception.*?(\d+)$/
        perception = $1.to_i
      elsif line =~ /Combat Maneuvers.*?(\d+)$/
        combatmaneuvers = $1.to_i
      end
    }

    res = Lich::Util.quiet_command_xml("info", /^Name: /)
    res.each { |line|
      line = line.gsub('<pushBold/>', '').gsub('<popBold/>', '')
      if line =~ /Level:\s+(\d+)$/
        level = $1.to_i
      elsif line =~ /Strength.*?\((\-*\d+)\)$/
        strength = $1.to_i
      elsif line =~ /Constitution.*?\((\-*\d+)\)$/
        constitution = $1.to_i
      elsif line =~ /Dexterity.*?\((\-*\d+)\)$/
        dexterity = $1.to_i
      elsif line =~ /Agility.*?\((\-*\d+)\)$/
        agility = $1.to_i
      elsif line =~ /Discipline.*?\((\-*\d+)\)$/
        discipline = $1.to_i
      elsif line =~ /Aura.*?\((\-*\d+)\)$/
        aura = $1.to_i
      elsif line =~ /Logic.*?\((\-*\d+)\)$/
        logic = $1.to_i
      elsif line =~ /Intuition.*?\((\-*\d+)\)$/
        intuition = $1.to_i
      elsif line =~ /Wisdom.*?\((\-*\d+)\)$/
        wisdom = $1.to_i
      elsif line =~ /Influence.*?\((\-*\d+)\)$/
        influence = $1.to_i
      end
    }

    if (Stats.prof == "Rogue" && profession.nil?) || profession =~ /^rogue/i
      res = Lich::Util.quiet_command_xml("gld", /<output class="mono"\/>/, /<output class=""\/>/)
      res.each { |line|
        if line =~ /You currently have (\d+) ranks? out of a possible \d+ for your training\./
          gldranks = $1.to_i
        end
      }
    end

    if DEBUG_ME
      echo "Arcane Symbols: #{arcanesymbols}"
      echo "Magic Item Use: #{magicitemuse}"
      echo "Physical Fitness: #{physicalfitness}"
      echo "First Aid: #{firstaid}"
      echo "EMC: #{elementalmanacontrol}"
      echo "SMC: #{spiritmanacontrol}"
      echo "MMC: #{mentalmanacontrol}"
      echo "ML:Telepathy: #{mentalloretelepathy}"
      echo "ML:Transformation: #{mentalloretransformation}"
      echo "SL:Blessings: #{spiritloreblessings}"
      echo "Harness Power: #{harnesspower}"
      echo "Survival: #{survival}"
      echo "Bard Ranks: #{bardranks}"
      echo "Cleric Ranks: #{clericranks}"
      echo "Paladin Ranks: #{paladinranks}"
      echo "Ranger Ranks: #{rangerranks}"
      echo "Sorcerer Ranks: #{sorcererranks}"
      echo "Wizard Ranks: #{wizardranks}"
      echo "Empath Ranks: #{empathranks}"
      echo "Minor Mental: #{minormentalranks}"
      echo "Minor Spiritual: #{minorspiritranks}"
      echo "Level: #{level}"
      echo "Strength: #{strength}"
      echo "Constitution: #{constitution}"
      echo "Dexterity: #{dexterity}"
      echo "Agility: #{agility}"
      echo "Discipline: #{discipline}"
      echo "Aura: #{aura}"
      echo "Logic: #{logic}"
      echo "Intuition: #{intuition}"
      echo "Wisdom: #{wisdom}"
      echo "Influence: #{influence}"
      echo gritSkills
    end

    if (Stats.prof == "Wizard" && profession.nil?) || profession =~ /^wiz/i
      if show_chart
        respond "Enchanting Success Formula"
        respond "---------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(logic).to_s.rjust(3)} : LOG Bonus"
        respond "+ #{(intuition).to_s.rjust(3)} : INT Bonus"
        respond "+ #{((magicitemuse / 10).truncate).to_s.rjust(3)} : trunc(MIU ranks/10)"
        respond "+ #{((arcanesymbols / 10).truncate).to_s.rjust(3)} : trunc(AS ranks/10)"
        respond "+ #{((elementalmanacontrol / 2).truncate).to_s.rjust(3)} : trunc(EMC ranks/2)"
        respond "+ #{((wizardranks > (level + 1) ? (level + 1) * 2 + (wizardranks - (level + 1)) : wizardranks * 2)).to_s.rjust(3)} : Wizard Spells"
        respond "+  25 : Familiar Bonus"
        respond "+  #{PRIVATE_WORKSHOP.include?(Char.name) ? 75 : 50} : Workshop Bonus"
        respond "==========================="
        respond "Total of #{level + logic + intuition + (magicitemuse / 10).truncate + (arcanesymbols / 10).truncate + (elementalmanacontrol / 2).truncate + (wizardranks > (level + 1) ? (level + 1) * 2 + (wizardranks - (level + 1)) : wizardranks * 2) + 25 + (PRIVATE_WORKSHOP.include?(Char.name) ? 75 : 50)}"
      end
      bonus = (level + logic + intuition + (magicitemuse / 10).truncate + (arcanesymbols / 10).truncate + (elementalmanacontrol / 2).truncate + (wizardranks > (level + 1) ? (level + 1) * 2 + (wizardranks - (level + 1)) : wizardranks * 2) + 25 + (PRIVATE_WORKSHOP.include?(Char.name) ? 75 : 50))
      Resource.save_bonuses(bonus) if Stats.prof == "Wizard"
      return bonus
    elsif (Stats.prof == "Sorcerer" && profession.nil?) || profession =~ /^sorc/i
      if show_chart
        respond "Ensorcelling Success Formula"
        respond "---------------------------"
        respond "  #{level.to_s.rjust(3)} : Level"
        respond "+ #{wisdom.to_s.rjust(3)} : WIS Bonus"
        respond "+ #{intuition.to_s.rjust(3)} : INT Bonus"
        respond "+ #{((magicitemuse / 10).truncate).to_s.rjust(3)} : trunc(MIU ranks/10)"
        respond "+ #{((arcanesymbols / 10).truncate).to_s.rjust(3)} : trunc(AS ranks/10)"
        respond "+ #{((elementalmanacontrol >= spiritmanacontrol) ? (elementalmanacontrol / 2).truncate : (elementalmanacontrol / 4).truncate).to_s.rjust(3)} : trunc(EMC ranks/#{(elementalmanacontrol >= spiritmanacontrol) ? "2" : "4"})"
        respond "+ #{((spiritmanacontrol > elementalmanacontrol) ? (spiritmanacontrol / 2).truncate : (spiritmanacontrol / 4).truncate).to_s.rjust(3)} : trunc(SMC ranks/#{(spiritmanacontrol > elementalmanacontrol) ? "2" : "4"})"
        respond "+ #{((sorcererranks > (level + 1) ? (level + 1) * 2 + (sorcererranks - (level + 1)) : sorcererranks * 2)).to_s.rjust(3)} : Sorcerer Spells"
        respond "+  20 : Workshop Bonus"
        respond "==========================="
        respond "Total of #{level + wisdom + intuition + (magicitemuse / 10).truncate + (arcanesymbols / 10).truncate + ((elementalmanacontrol >= spiritmanacontrol) ? (elementalmanacontrol / 2).truncate : (elementalmanacontrol / 4).truncate) + ((spiritmanacontrol > elementalmanacontrol) ? (spiritmanacontrol / 2).truncate : (spiritmanacontrol / 4).truncate) + (sorcererranks > (level + 1) ? (level + 1) * 2 + (sorcererranks - (level + 1)) : sorcererranks * 2) + 20}"
      end
      bonus = (level + wisdom + intuition + (magicitemuse / 10).truncate + (arcanesymbols / 10).truncate + ((elementalmanacontrol >= spiritmanacontrol) ? (elementalmanacontrol / 2).truncate : (elementalmanacontrol / 4).truncate) + ((spiritmanacontrol > elementalmanacontrol) ? (spiritmanacontrol / 2).truncate : (spiritmanacontrol / 4).truncate) + (sorcererranks > (level + 1) ? (level + 1) * 2 + (sorcererranks - (level + 1)) : sorcererranks * 2) + 20)
      Resource.save_bonuses(bonus) if Stats.prof == "Sorcerer"
      return bonus
    elsif (Stats.prof == "Bard" && profession.nil?) || profession =~ /^bard/i
      if show_chart
        respond "Total Luck's Reverberation Success Formula"
        respond "------------------------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(intuition).to_s.rjust(3)} : INT Bonus"
        respond "+ #{(influence).to_s.rjust(3)} : INF Bonus"
        respond "+ #{((bardranks > level) ? (level * 2) + (bardranks - level) : bardranks * 2).to_s.rjust(3)} : Bard Spells (to level *2)+(over level)"
        respond "+ #{(mentalmanacontrol).to_s.rjust(3)} : MMC ranks"
        respond "+ #{(elementalmanacontrol).to_s.rjust(3)} : EMC ranks"
        respond "+ #{(magicitemuse).to_s.rjust(3)} : MIU ranks"
        respond "+ #{'20'.to_s.rjust(3)} : Tavern or Shrine of Cholen, Jastev, or Tilamaire Bonus"
        respond "=========================================="
        respond "Total of #{level + (intuition) + (influence) + (magicitemuse) + (elementalmanacontrol) + (mentalmanacontrol) + (20) + ((bardranks > level) ? (level * 2) + (bardranks - level) : bardranks * 2).truncate}"
      end
      bonus = (level + (intuition) + (influence) + (magicitemuse) + (elementalmanacontrol) + (mentalmanacontrol) + (20) + ((bardranks > level) ? (level * 2) + (bardranks - level) : bardranks * 2).truncate)
      Resource.save_bonuses(bonus) if Stats.prof == "Bard"
      return bonus
    elsif (Stats.prof == "Cleric" && profession.nil?) || profession =~ /^cleric/i
      if show_chart
        respond "Sanctify Success Formula"
        respond "---------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(wisdom).to_s.rjust(3)} : WIS Bonus"
        respond "+ #{(influence).to_s.rjust(3)} : INF Bonus"
        respond "+ #{((magicitemuse / 10).truncate).to_s.rjust(3)} : trunc(MIU ranks/10)"
        respond "+ #{((arcanesymbols / 10).truncate).to_s.rjust(3)} : trunc(AS ranks/10)"
        respond "+ #{((spiritmanacontrol / 2).truncate).to_s.rjust(3)} : trunc(SMC ranks/2)"
        respond "+ #{((clericranks > (level + 1) ? (level + 1) * 2 + (clericranks - (level + 1)) : clericranks * 2)).to_s.rjust(3)} : Cleric Spells"
        respond "+  20 : Shrine Bonus (10 if aligned to pantheon but not your specific deity)"
        respond "==========================="
        respond "Total of #{level + wisdom + influence + (magicitemuse / 10).truncate + (arcanesymbols / 10).truncate + (spiritmanacontrol / 2).truncate + (clericranks > (level + 1) ? (level + 1) * 2 + (clericranks - (level + 1)) : clericranks * 2) + 20}"
      end
      bonus = (level + wisdom + influence + (magicitemuse / 10).truncate + (arcanesymbols / 10).truncate + (spiritmanacontrol / 2).truncate + (clericranks > (level + 1) ? (level + 1) * 2 + (clericranks - (level + 1)) : clericranks * 2) + 20)
      Resource.save_bonuses(bonus) if Stats.prof == "Cleric"
      return bonus
    elsif (Stats.prof == "Paladin" && profession.nil?) || profession =~ /^Paladin/i
      if show_chart
        respond "Battle Standard Success Formula"
        respond "---------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(wisdom).to_s.rjust(3)} : WIS Bonus"
        respond "+ #{(influence).to_s.rjust(3)} : INF Bonus"
        respond "+ #{(magicitemuse * 1.5).truncate.to_s.rjust(3)} : trunc(MIU ranks * 1.5)"
        respond "+ #{(arcanesymbols * 1.5).truncate.to_s.rjust(3)} : trunc(AS ranks * 1.5)"
        respond "+ #{(spiritmanacontrol).to_s.rjust(3)} : SMC ranks"
        respond "+ #{((paladinranks > (level + 1) ? (level + 1) * 2 + (paladinranks - (level + 1)) : paladinranks * 2)).to_s.rjust(3)} : Paladin Spells"
        respond "+  20 : Shrine Bonus (Must match Paladin's deity)"
        respond "==========================="
        respond "Total of #{level + wisdom + influence + (magicitemuse * 1.5).truncate + (arcanesymbols * 1.5).truncate + spiritmanacontrol + (paladinranks > (level + 1) ? (level + 1) * 2 + (paladinranks - (level + 1)) : paladinranks * 2) + 20}"
      end
      bonus = (level + wisdom + influence + (magicitemuse * 1.5).truncate + (arcanesymbols * 1.5).truncate + spiritmanacontrol + (paladinranks > (level + 1) ? (level + 1) * 2 + (paladinranks - (level + 1)) : paladinranks * 2) + 20)
      Resource.save_bonuses(bonus) if Stats.prof == "Paladin"
      return bonus
    elsif (Stats.prof == "Warrior" && profession.nil?) || profession =~ /^warrior/i
      if show_chart
        respond "Grit (WPS) Success Formula"
        respond "---------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(strength).to_s.rjust(3)} : STR Bonus"
        respond "+ #{(discipline).to_s.rjust(3)} : DIS Bonus"
        respond "+ #{(physicalfitness / 10).to_s.rjust(3)} : Physical Fitness"
        respond "+  20 : Workshop Bonus"
        respond "+ Weapon Bonus:"
        weaponRanks = gritSkills.sort_by { |_k, v| v }.pop(3).reverse
        respond "  #{((weaponRanks[0][1] > (level + 1) ? (level + 1) * 2 + (weaponRanks[0][1] - (level + 1)) : weaponRanks[0][1] * 2)).to_s.rjust(3)} : Primary Skill   : #{weaponRanks[0][0]}"
        respond "  #{((weaponRanks[1][1] / 2)).to_s.rjust(3)} : Secondary Skill : #{weaponRanks[1][0]}"
        respond "  #{((weaponRanks[2][1] / 2)).to_s.rjust(3)} : Tertiary Skill  : #{weaponRanks[2][0]}"
        respond "+ Armor Bonus:"
        respond "  #{((armoruse > (level + 1) ? (level + 1) * 2 + (armoruse - (level + 1)) : armoruse * 2)).to_s.rjust(3)} : Primary Skill   : Armor Use"
        respond "  #{(shielduse / 3).to_s.rjust(3)} : Secondary Skill : Shield Use"
        respond "==========================="
      end
      gritCommonBase = level + strength + discipline + (physicalfitness / 10) + 20
      weaponRanks = gritSkills.sort_by { |_k, v| v }.pop(3).reverse
      grit_bonuses = [(gritCommonBase + ((armoruse > (level + 1) ? (level + 1) * 2 + (armoruse - (level + 1)) : armoruse * 2)) + (shielduse / 3))]
      grit_bonuses.push(gritCommonBase + ((weaponRanks[0][1] > (level + 1) ? (level + 1) * 2 + (weaponRanks[0][1] - (level + 1)) : weaponRanks[0][1] * 2)) + ((weaponRanks[1][1] + weaponRanks[2][1]) / 2))
      respond "  #{gritCommonBase + ((weaponRanks[0][1] > (level + 1) ? (level + 1) * 2 + (weaponRanks[0][1] - (level + 1)) : weaponRanks[0][1] * 2)) + ((weaponRanks[1][1] + weaponRanks[2][1]) / 2)} : Weapon" if show_chart
      respond "  #{gritCommonBase + ((armoruse > (level + 1) ? (level + 1) * 2 + (armoruse - (level + 1)) : armoruse * 2)) + (shielduse / 3)} : Armor" if show_chart
      respond "" if show_chart
      Resource.save_bonuses(grit_bonuses) if Stats.prof == "Warrior"
      return grit_bonuses
    elsif (Stats.prof == "Monk" && profession.nil?) || profession =~ /^monk/i
      if show_chart
        respond "Tattoo Success Formula"
        respond "---------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(dexterity * 2).to_s.rjust(3)} : DEX Bonus * 2"
        respond "+ #{(discipline * 2).to_s.rjust(3)} : DIS Bonus * 2"
        respond "+ #{((physicalfitness * (0.75)).truncate).to_s.rjust(3)} : trunc(PF ranks*(3/4))"
        respond "+ #{(((firstaid / 2)).truncate).to_s.rjust(3)} : trunc(FA ranks/2)"
        respond "+ #{((minormentalranks + minorspiritranks) * 2).to_s.rjust(3)} : Spell Ranks * 2"
        respond "+ #{((arcanesymbols)).to_s.rjust(3)} : AS ranks"
        respond "+ #{((mentalmanacontrol)).to_s.rjust(3)} : MMC ranks"
        respond "+ #{((spiritmanacontrol)).to_s.rjust(3)} : SMC ranks"
        respond "+ #{((mentalloretransformationbonus)).to_s.rjust(3)} : ML:Transformation Bonus - Self Tattoo"
        respond "+ #{((mentalloretelepathybonus)).to_s.rjust(3)} : ML:Telepathy Bonus - Other Tattoo"
        respond "==========================="
        respond "Self-Tattoo Total of #{level + (dexterity * 2) + (discipline * 2) + (physicalfitness * (0.75)).truncate + (firstaid / 2).truncate + ((minormentalranks + minorspiritranks) * 2) + arcanesymbols + mentalmanacontrol + spiritmanacontrol + mentalloretransformationbonus}"
        respond "Other-Tattoo Total of #{level + (dexterity * 2) + (discipline * 2) + (physicalfitness * (0.75)).truncate + (firstaid / 2).truncate + ((minormentalranks + minorspiritranks) * 2) + arcanesymbols + mentalmanacontrol + spiritmanacontrol + mentalloretelepathybonus}"
      end
      bonus = [
        (level + (dexterity * 2) + (discipline * 2) + (physicalfitness * (0.75)).truncate + (firstaid / 2).truncate + ((minormentalranks + minorspiritranks) * 2) + arcanesymbols + mentalmanacontrol + spiritmanacontrol + mentalloretransformationbonus),
        (level + (dexterity * 2) + (discipline * 2) + (physicalfitness * (0.75)).truncate + (firstaid / 2).truncate + ((minormentalranks + minorspiritranks) * 2) + arcanesymbols + mentalmanacontrol + spiritmanacontrol + mentalloretelepathybonus)
      ]
      Resource.save_bonuses(bonus) if Stats.prof == "Monk"
      return bonus
    elsif (Stats.prof == "Ranger" && profession.nil?) || profession =~ /^ranger/i
      if show_chart
        respond "Resist Nature Success Formula"
        respond "---------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(wisdom * 2).to_s.rjust(3)} : WIS Bonus * 2"
        respond "+ #{(intuition * 2).to_s.rjust(3)} : INT Bonus * 2"
        respond "+ #{((survival * 0.75).truncate).to_s.rjust(3)} : trunc(Survival ranks * 0.75)"
        respond "+ #{(magicitemuse).to_s.rjust(3)} : MIU ranks"
        respond "+ #{(harnesspower).to_s.rjust(3)} : Harness Power ranks"
        respond "+ #{(spiritmanacontrol).truncate.to_s.rjust(3)} : SMC ranks"
        respond "+ #{(spiritloreblessings).truncate.to_s.rjust(3)} : SL:Blessings ranks"
        respond "+ #{(rangerranks * 1.5).truncate.to_s.rjust(3)} : trunc(Ranger Spells * 1.5)"
        respond "+ #{(outside? ? 20 : 0).to_s.rjust(3)} : #{outside? ? 'outdoors' : 'indoors'}"
        respond "==========================="
        respond "Total of #{level + (wisdom * 2) + (intuition * 2) + (survival * 0.75).truncate + magicitemuse + harnesspower + spiritmanacontrol + spiritloreblessings + (rangerranks * 1.5).truncate + (outside? ? 20 : 0)}"
      end
      bonus = (level + (wisdom * 2) + (intuition * 2) + (survival * 0.75).truncate + magicitemuse + harnesspower + spiritmanacontrol + spiritloreblessings + (rangerranks * 1.5).truncate + (outside? ? 20 : 0))
      Resource.save_bonuses(bonus) if Stats.prof == "Ranger"
      return bonus
    elsif (Stats.prof == "Empath" && profession.nil?) || profession =~ /^emp/i
      if show_chart
        respond "Bloodstone Jewelry Success Formula"
        respond "----------------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(constitution).to_s.rjust(3)} : CON Bonus"
        respond "+ #{(influence).to_s.rjust(3)} : INF Bonus"
        respond "+ #{((empathranks > level) ? (level * 2) + (empathranks - level) : empathranks * 2).to_s.rjust(3)} : Empath Spells (to level *2)+(over level)"
        respond "+ #{((spiritmanacontrol >= mentalmanacontrol) ? (spiritmanacontrol / 2).truncate : (spiritmanacontrol / 4).truncate).to_s.rjust(3)} : trunc(SMC ranks/#{(spiritmanacontrol >= mentalmanacontrol) ? "2" : "4"})"
        respond "+ #{((mentalmanacontrol > spiritmanacontrol) ? (mentalmanacontrol / 2).truncate : (mentalmanacontrol / 4).truncate).to_s.rjust(3)} : trunc(MMC ranks/#{(mentalmanacontrol > spiritmanacontrol) ? "2" : "4"})"
        respond "+ #{((arcanesymbols / 10).truncate).to_s.rjust(3)} : AS ranks / 10"
        respond "+ #{((magicitemuse / 10).truncate).to_s.rjust(3)} : MIU ranks / 10"
        respond "+ #{((physicalfitness / 20).truncate).to_s.rjust(3)} : PF ranks / 20"
        respond "+ #{((firstaid / 20).truncate).to_s.rjust(3)} : FA ranks / 20"
        respond "=================================="
        respond "Total of #{level + (constitution) + (influence) + ((empathranks > level) ? (level * 2) + (empathranks - level) : empathranks * 2) + ((spiritmanacontrol >= mentalmanacontrol) ? (spiritmanacontrol / 2).truncate : (spiritmanacontrol / 4).truncate) + ((mentalmanacontrol > spiritmanacontrol) ? (mentalmanacontrol / 2).truncate : (mentalmanacontrol / 4).truncate) + ((arcanesymbols / 10).truncate) + ((magicitemuse / 10).truncate) + ((physicalfitness / 20).truncate) + ((firstaid / 20).truncate)}"
      end
      bonus = (level + (constitution) + (influence) + ((empathranks > level) ? (level * 2) + (empathranks - level) : empathranks * 2) + ((spiritmanacontrol >= mentalmanacontrol) ? (spiritmanacontrol / 2).truncate : (spiritmanacontrol / 4).truncate) + ((mentalmanacontrol > spiritmanacontrol) ? (mentalmanacontrol / 2).truncate : (mentalmanacontrol / 4).truncate) + ((arcanesymbols / 10).truncate) + ((magicitemuse / 10).truncate) + ((physicalfitness / 20).truncate) + ((firstaid / 20).truncate))
      Resource.save_bonuses(bonus) if Stats.prof == "Empath"
      return bonus
    elsif (Stats.prof == "Rogue" && profession.nil?) || profession =~ /^rogue/i
      if show_chart
        respond "Covert Arts Success Formula"
        respond "---------------------------"
        respond "  #{(level).to_s.rjust(3)} : Level"
        respond "+ #{(influence * 2).to_s.rjust(3)} : INF Bonus * 2"
        respond "+ #{(gldranks).to_s.rjust(3)} : Guild Ranks"
        respond "+ #{(ambush).to_s.rjust(3)} : Ambush Ranks"
        respond "+ #{(pickpocketing * 0.5).truncate.to_s.rjust(3)} : Pickpocketing ranks / 2"
        respond "  Sidestep"
        respond "+ #{(discipline * 2).to_s.rjust(3)} : DIS Bonus * 2"
        respond "+ #{(dodging).to_s.rjust(3)} : Dodging Ranks"
        respond "  Keen Eye"
        respond "+ #{(intuition * 2).to_s.rjust(3)} : INT Bonus * 2"
        respond "+ #{(perception).to_s.rjust(3)} : Perception Ranks"
        respond "  Escape Artist"
        respond "+ #{(agility * 2).to_s.rjust(3)} : AGI Bonus * 2"
        respond "+ #{(combatmaneuvers).to_s.rjust(3)} : Combat Maneuvers Ranks"
        respond "  Swift Recovery"
        respond "+ #{(constitution * 2).to_s.rjust(3)} : CON Bonus * 2"
        respond "+ #{(physicalfitness).to_s.rjust(3)} : Physical Fitness Ranks"
        respond "  Poisoncraft"
        respond "+ #{(dexterity * 2).to_s.rjust(3)} : DEX Bonus * 2"
        respond "+ #{(survival).to_s.rjust(3)} : Survival Ranks"
        respond "  Recharge"
        respond "+ #{(((discipline * 2) + (intuition * 2) + (agility * 2) + (constitution * 2) + (dexterity * 2)) / 5).to_s.rjust(3)} : Avg Stat Bonus * 2"
        respond "+ #{((dodging + perception + combatmaneuvers + physicalfitness + survival) / 5).to_s.rjust(3)} : Avg Skill Ranks"
        respond "==========================="
        respond "  #{(level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (discipline * 2) + dodging).truncate.to_s.rjust(4)} : Sidestep Total"
        respond "  #{(level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (intuition * 2) + perception).truncate.to_s.rjust(4)} : Keen Eye Total"
        respond "  #{(level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (agility * 2) + combatmaneuvers).truncate.to_s.rjust(4)} : Escape Artist Total"
        respond "  #{(level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (constitution * 2) + physicalfitness).truncate.to_s.rjust(4)} : Swift Recovery Total"
        respond "  #{(level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (dexterity * 2) + survival).truncate.to_s.rjust(4)} : Poisoncraft Total"
        respond "  #{(level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (((discipline * 2) + (intuition * 2) + (agility * 2) + (constitution * 2) + (dexterity * 2)) / 5) + ((dodging + perception + combatmaneuvers + physicalfitness + survival) / 5)).truncate.to_s.rjust(4)} : Recharge Total"
      end
      bonus = [
        (level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (discipline * 2) + dodging).truncate,
        (level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (intuition * 2) + perception).truncate,
        (level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (agility * 2) + combatmaneuvers).truncate,
        (level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (constitution * 2) + physicalfitness).truncate,
        (level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (dexterity * 2) + survival).truncate,
        (level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate + (((discipline * 2) + (intuition * 2) + (agility * 2) + (constitution * 2) + (dexterity * 2)) / 5) + ((dodging + perception + combatmaneuvers + physicalfitness + survival) / 5)).truncate
      ]
      Resource.save_bonuses(bonus) if Stats.prof == "Rogue"
      return bonus
    end
  end

  def self.show_odds(new_difficulty, skill_bonus)
    if new_difficulty + 101 <= skill_bonus
      respond "  You got this with 100% certainty! (except fumbles)"
    elsif (new_difficulty + 100 - skill_bonus < 100) && (new_difficulty + 100 - skill_bonus >= 0)
      respond "  #{((skill_bonus - new_difficulty)).to_s.rjust(3)}% Chance or #{(new_difficulty + 100 - skill_bonus) + 1}+ endroll"
    else # no chance without potions/suffusion
      respond "Suffusion or +Potions Needed"
      respond " 100% - Need #{new_difficulty + 101 - skill_bonus} Additional Bonus"
    end
    respond '  Always be sure to SUFFUSE ESTIMATE with the item in hand to ensure accuracy!'
  end

  def self.item(recall_item = nil)
    if Stats.prof !~ /^(?:Wizard|Sorcerer|Cleric)$/
      respond "You're not a class with a currently supported auto-item chance calculation. Please use the following to show an appropriate table:"
      respond "   Professions supported: wizard, sorcerer, cleric"
      return
    end

    return if recall_item.nil?

    res = Lich::Util.quiet_command_xml("recall #{recall_item}", /^As you recall \w+'s song, you feel a faint resonating vibration|^You are unable to recall the|^Usage:/)
    if res.any? { |line| line =~ /^You are unable to recall the|^Usage:/ }
      respond "Item (#{recall_item}) not unlocked. Please permanently or temporarily unlock item to use this feature."
      return
    end
    line = res.find { |l| l =~ />(.*)<\/a> in your hand, and you learn something about it/ }
    if line =~ />(.*)<\/a> in your hand, and you learn something about it/
      recall_item = $1.to_s
    end
    item_bonus = 0.0
    item_ensorcell = 0
    item_sanctify = 0
    item_difficulty = 0
    # new_difficulty = 0
    skill_bonus = Resource.bonus(false)

    res.each { |l|
      if l =~ /It imparts a bonus of \+(\d+) more than usual\./
        item_bonus = $1.to_f
      elsif l =~ /It has been ensorcelled (\d) time/
        item_ensorcell = $1.to_i
      elsif l =~ /\((\d+) difficulty\) for an adventurer to modify\./
        item_difficulty = $1.to_i
      elsif l =~ /It has been sanctified (\d) times\.(  It has permanent Holy Fire flares\.)?/
        if $2
          item_sanctify = 6
        else
          item_sanctify = $1.to_i
        end
      end
    }

    case Stats.prof
    when "Wizard"
      if item_bonus == 50
        respond "Item (#{recall_item}) already at max enchant"
      else
        penalty = ((((item_bonus - 1) / 3)**2) - (((item_bonus - 2) / 3)**2)).truncate
        new_difficulty = (item_difficulty + penalty).truncate
        respond "Item (#{recall_item}) Enchant Chance"
        respond "----------------------------------------"
        respond "  #{item_difficulty.to_s.rjust(4)} - Item Difficulty"
        respond "+ #{penalty.to_s.rjust(4)} - +#{item_bonus.to_i} -> +#{item_bonus.to_i + 1}"
        respond "========================================"
        respond "  #{new_difficulty.to_s.rjust(4)} - Total Difficulty"
        respond "  #{skill_bonus.to_s.rjust(4)} - Current Skill Bonus"
        respond "========================================"
        Resource.show_odds(new_difficulty, skill_bonus)
      end
    when "Sorcerer"
      if item_ensorcell == 5
        respond "Item (#{recall_item}) already at max ensorcell"
      else
        penalty = 50
        new_difficulty = (item_difficulty + penalty)
        respond "Item (#{recall_item}) Ensorcell Chance"
        respond "----------------------------------------"
        respond "  #{item_difficulty.to_s.rjust(4)} - Item Difficulty"
        respond "+   #{penalty} - T#{item_ensorcell} -> T#{item_ensorcell + 1}"
        respond "========================================"
        respond "  #{new_difficulty.to_s.rjust(4)} - Total Difficulty"
        respond "  #{skill_bonus.to_s.rjust(4)} - Current Skill Bonus"
        respond "========================================"
        Resource.show_odds(new_difficulty, skill_bonus)
      end
    when "Cleric"
      if item_sanctify == 6
        respond "Item (#{recall_item}) already at max sanctify"
      else
        penalty = ((item_sanctify == 5) ? 50 : 20)
        new_difficulty = (item_difficulty + penalty)
        respond "Item (#{recall_item}) Sanctify Chance"
        respond "---------------------------------------"
        respond "  #{item_difficulty.to_s.rjust(4)} - Item Difficulty"
        respond "+   #{penalty} - S#{item_sanctify} -> S#{item_sanctify + 1}"
        respond "======================================="
        respond "  #{new_difficulty.to_s.rjust(4)} - Total Difficulty"
        respond "  #{skill_bonus.to_s.rjust(4)} - Current Skill Bonus"
        respond "======================================="
        Resource.show_odds(new_difficulty, skill_bonus)
      end
    end
  end

  def self.help
    respond "You need to give an option. See below:"
    respond ""
    respond "   ;resource bonus <PROFESSION> - Show's profession success bonus formula"
    respond "   ;resource max - Show the maximum profession-service bonus possible with FIXSKILLS"
    respond "                   Read-only; uses current character, stats, experience, and training-point conversion"
    respond "                   Not yet supported: Rogue, Warrior"
    respond "   ;resource all                - Show's all known bonuses from previous BONUS checks"
    respond "   ;resource chart <PROFESSION> - Prints off cost chart for each increase"
    respond "       If no profession given, will use current character profession"
    respond "       Professions supported: all"
    respond ""
    respond "   ;resource calc [starting bonus] [ending bonus] [silver rate per essence]"
    respond "       Tells you the cost for enchanting an item from starting bonus to ending bonus"
    respond ""
    respond "   ;resource item [NOUN] - Will attempt to RECALL NOUN and show current chance of success"
    respond "       Professions supported: wizard, sorcerer, cleric"
    respond "   ;resource chance <DIFFICULTY> <TYPE> <BONUS> - Will calculate the chance to succeed"
    respond "       Supports Enchant(E1-E50), Ensorcell(T1-T5), Sanctify(S1-S6), Tattooing(M1-M5),"
    respond "                Resistance(R1-R25), Arts(A1-A25), Luck(L1-L6), Battle Standard(B1-B6),"
    respond "                Bloodstone Jewelry(J1-J5)"
    respond ""
    respond "   ;resource chance - Description Of Test CASTs And Chance To Succeed"
    respond "   ;resource rolls  - Numeric Values For Roll Descriptions"
    respond "   ;resource mats   - Material Difficulty Modifiers"
    respond "   ;resource silent - Silently update the saved resource data"
    if variable.empty?
      respond ""
      silence_me
      fput "resource"
    end
  end
end

case variable[1]
when /^mat/i
  Resource.materials
when /^chance/i
  Resource.chance(variable[2], variable[3], variable[4])
when /^rolls/i
  Resource.rolls
when /^calc/i
  Resource.do_calc
when /^chart/i
  Resource.chart
when /^bonus/i
  Resource.bonus(true, variable[2])
when /^max$/i
  Resource.maximum
when /^item/i
  Resource.item(variable[2])
when /^character|^all$/i
  Resource.show_bonuses
when /^silent$/i # causes an update of the saved data without any output to the user
  Resource.bonus(false)
else
  Resource.help if defined?(script.name)
end
