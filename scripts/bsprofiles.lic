        ]],
        [:frame, 'MStrike', [
          [:pair, 'MStrike during cooldown stamina requirement:', :entry, 'mstrike_stamina_cooldown'],
          [:pair, 'QuickStrike stamina requirement:', :entry, 'mstrike_stamina_quickstrike'],
          [:pair, 'Unfocused MStrike when Creatures >=', :entry, 'mstrike_mob'],
          [:checks, [['mstrike_cooldown', 'MStrike during cooldown'], ['mstrike_quickstrike', 'Use QuickStrike for MStrike']]]
        ]]
      ]],
      [:cols, [
        [:frame, 'Ammo/Wands', [
          [:pair, 'Find ammo in this container:', :entry, 'ammo_container'],
          [:pair, 'Use this ammo type:', :entry, 'ammo'],
          [:pair, 'Fresh wand container', :entry, 'fresh_wand_container'],
          [:pair, 'Dead wand container', :entry, 'dead_wand_container'],
          [:pair, 'Use this wand type', :entry, 'wand'],
          [:check, 'hide_for_ammo', 'Hide to pick up ammo'],
          [:check, 'wand_if_oom', 'Use wands when out of mana']
        ]],
        [:frame, 'MA Grouping', [
          [:check, 'independent_travel', 'Travel TO hunting grounds independently'],
          [:check, 'independent_return', 'Travel FROM hunting grounds independently'],
          [:check, 'group_deader', 'Stop for dead group members'],
          [:check, 'random_loot', 'Loot randomly based on lowest encumbrance'],
          [:check, 'final_loot', 'Leader(MA) or solo performs a final loot before leaving the room'],
          [:pair, 'Primary Looter', :entry, 'ma_looter'],
          [:pair, 'List of Characters that should never loot', :entry, 'never_loot']
        ]]
      ]]
    ]],
    ['Monitoring', [
      [:frame, nil, [
        [:check, 'dead_man_switch', "Engage dead man's switch (Shattered Only)"],
        [:check, 'depart_switch', 'Depart/rerun if dead'],
        [:check, 'quiet_followers', 'Quiet Followers'],
        [:check, 'monitor_interaction', 'Monitor Interactions'],
        [:check, 'ignore_disks', 'Ignore disks without obvious hiders'],
        [:area, 'monitor_strings', 'Watch for strings (or regexes) that contain'],
        [:area, 'monitor_safe_strings', '....except if they also contain']
      ]]
    ]]
  ].freeze

  BIGSHOT_INFO = "Bigshot is designed to handle combat routines, including moving to and from hunting areas, " \
                 "defining creatures to hunt and accompanying attack routines.\n\n" \
                 "Afk scripting on any server but Shattered is in violation of game policy.\n\n" \
                 'Additional details: https://gswiki.play.net/Lich:Script_Bigshot'.freeze

  BOON_INFO = 'Boss Creatures or the Boss Creature System upgrades newly created creatures into bosses, minibosses, or packs. ' \
              'Upgraded creatures have their level and basic stats boosted, and are granted a number of special abilities ' \
              'called boons which are denoted by a special adjective. Players have alternatively called this "glam critters", ' \
              "\"gifted creatures\", or \"boosted critters\".\n\n" \
              'Additional details: https://gswiki.play.net/Category:Boss_creatures'.freeze

  # --------------------------------------------------------- boon matrix ----
  #
  # Bigshot stores the boon tab as arrays: @settings['immunity'] holds entries
  # like "crit_death_immune_flee" (one boon) or "flee" (the whole group), and
  # 'boons_all' holds the modes ticked for every group. 'boons_ignore' and
  # 'boons_flee' are derived lists of boon names. This is a straight port of
  # Bigshot::Setup#update_boon, #check_group and #refresh_boon_settings over a
  # hash of "group:value" => true instead of a hash of checkbuttons.
  class BoonMatrix
    GROUPS = {
      'immunity'  => %w[crit_death_immune damage_padding elemental_negation magic_resistance physical_negation stun_immune],
      'misc'      => %w[boosted_hp boosted_mana diseased extra_elem extra_spirit extra_other ethereal jack regen soul terrifying weaken],
      'offensive' => %w[boosted_offense cheat_death counter_attack crit_weighting dmg_weighting dispelling elem_flares frenzy mind_blast parting_shot poisonous],
      'defensive' => %w[blink bolt_shield boosted_defense confuse crit_padding]
    }.freeze
    MODES = %w[common ignore flee].freeze
    TITLES = { 'immunity' => 'Immunity', 'misc' => 'Stats / Misc', 'offensive' => 'Offensive', 'defensive' => 'Defensive' }.freeze
    LABELS = {
      'crit_death_immune' => ['Crit Death Immune', 'Similar to constructs or golems'],
      'damage_padding' => ['Damage Padding', 'Absorbs magic attacks'],
      'elemental_negation' => ['Elem Negation', 'Absorbs elemental magic attacks'],
      'magic_resistance' => ['Magic Resistance', 'Reduces magic damage by 50%'],
      'physical_negation' => ['Physical Negation', 'Physical damage resist shield'],
      'stun_immune' => ['Stun Immune', ''],
      'boosted_hp' => ['Boosted HP', ''], 'boosted_mana' => ['Boosted Mana', ''], 'diseased' => ['Diseased', ''],
      'extra_elem' => ['Extra Spells - Elem', ''], 'extra_spirit' => ['Extra Spells - Spirit', ''],
      'extra_other' => ['Extra Spells - Other', ''],
      'ethereal' => ['Ethereal', 'Noncorporeal undead. No Sheer Fear.'],
      'jack' => ['Jack of all Trades', ''],
      'regen' => ['Regeneration', "Similar to Troll's Blood (1125)"],
      'soul' => ['Soul Stealing', 'May possess 1204, 1601, and 1712'],
      'terrifying' => ['Terrifying', 'Pre-attack SMR can force player into defensive'],
      'weaken' => ['Weaken', 'Weaker creature than normal'],
      'boosted_offense' => ['Boosted Offense', ''],
      'cheat_death' => ['Cheat Death', 'Raises self after death'],
      'counter_attack' => ['Counter Attack', 'SMR counter-attack'],
      'crit_weighting' => ['Crit Weighting', ''], 'dmg_weighting' => ['Dmg Weighting', ''],
      'dispelling' => ['Dispelling', 'Spirit Dispel (119) and Elem Dispel (417)'],
      'elem_flares' => ['Elemental Flares', ''], 'frenzy' => ['Frenzy', ''], 'mind_blast' => ['Mind Blast', ''],
      'parting_shot' => ['Parting Shot', 'Deals damage one last time upon death'],
      'poisonous' => ['Poisonous', 'SMR poison gas cloud'],
      'blink' => ['Blink', 'Temporary phase ability'], 'bolt_shield' => ['Bolt Shield', ''],
      'boosted_defense' => ['Boosted Defense', 'High damage padding (+12 CER)'],
      'confuse' => ['Confuse', 'May give hard RT for casting at them'],
      'crit_padding' => ['Crit Padding', '']
    }.freeze

    Cell = Struct.new(:matrix, :id) do
      def active? = matrix.active[id] ? true : false

      def active=(flag)
        matrix.active[id] = flag ? true : false
      end
    end

    attr_reader :active

    def initialize
      @active = {}
      @updating = false
    end

    def [](id)
      Cell.new(self, id.to_s)
    end

    # Pour bigshot's array settings into the matrix, like load_settings does
    # for its "key:value" checkbuttons.
    def load(settings)
      @active.clear
      (GROUPS.keys + ['boons_all']).each do |key|
        Array(settings[key]).each { |value| @active["#{key}:#{value}"] = true }
      end
      self
    end

    # The matrix back as settings (refresh_boon_settings).
    def store(settings)
      (GROUPS.keys + %w[boons_all boons_ignore boons_flee]).each { |k| settings[k] = [] }
      MODES.each do |mode|
        settings['boons_all'] << mode if self["boons_all:#{mode}"].active?
        GROUPS.each do |group_key, items|
          settings[group_key] << mode if self["#{group_key}:#{mode}"].active?
          items.each do |item|
            next unless self["#{group_key}:#{item}_#{mode}"].active?

            settings[group_key] << "#{item}_#{mode}"
            settings['boons_ignore'] << item if mode == 'ignore'
            settings['boons_flee'] << item if mode == 'flee'
          end
        end
      end
      settings
    end

    # A checkbox changed: +key+ is the group ("immunity" or "boons_all"),
    # +value+ is "flee" for the group row or "blink_flee" for one boon.
    def update(key, value, checked)
      self["#{key}:#{value}"].active = checked
      return if @updating

      unless checked
        @updating = true
        check_group(key, value)
        @updating = false
        return
      end

      result = value.scan(/\A([a-z0-9_]+)_(common|ignore|flee)\z/i).first
      if result.nil?
        other_modes = MODES - [value]
        other_modes.each { |m| self["#{key}:#{m}"].active = false }
        if key == 'boons_all'
          GROUPS.each_key { |group_key| self["#{group_key}:#{value}"].active = true }
        else
          GROUPS[key].each do |section|
            self["#{key}:#{section}_#{value}"].active = true
            other_modes.each { |m| self["#{key}:#{section}_#{m}"].active = false }
          end
          unless self["boons_all:#{value}"].active?
            MODES.each { |m| self["boons_all:#{m}"].active = false }
          end
        end
      else
        return unless GROUPS.key?(key)

        section, mode = result
        other_modes = MODES - [mode]
        other_modes.each { |m| self["#{key}:#{section}_#{m}"].active = false }
        unless self["#{key}:#{mode}"].active?
          MODES.each do |m|
            self["#{key}:#{m}"].active = false
            self["boons_all:#{m}"].active = false
          end
        end
        self["#{key}:#{mode}"].active = true if GROUPS[key].all? { |s| self["#{key}:#{s}_#{mode}"].active? }
        if GROUPS.all? { |group_key, items| items.all? { |item| self["#{group_key}:#{item}_#{mode}"].active? } }
          self["boons_all:#{mode}"].active = true
        end
      end
    end

    def check_group(key, value)
      return unless MODES.include?(value)

      if key == 'boons_all'
        if GROUPS.all? { |group_key, items| items.all? { |item| self["#{group_key}:#{item}_#{value}"].active? } }
          GROUPS.each do |sub_key, sections|
            self["#{sub_key}:#{value}"].active = false
            sections.each { |item| self["#{sub_key}:#{item}_#{value}"].active = false }
          end
        end
      elsif GROUPS[key].all? { |s| self["#{key}:#{s}_#{value}"].active? }
        self["boons_all:#{value}"].active = false
        GROUPS[key].each { |section| self["#{key}:#{section}_#{value}"].active = false }
      end
    end
  end

  # --------------------------------------------------------------- editor --
  class Editor
    PAGE_ID = 'bsprofiles'.freeze
    DIFF_COLOR = { r: 165, g: 29, b: 45, a: 1.0 }.freeze
    MAP_COLORS = {
      checked: { r: 0, g: 153, b: 0, a: 1.0 }, area: { r: 140, g: 140, b: 140, a: 1.0 }, start: { r: 217, g: 0, b: 0, a: 1.0 },
      rally: { r: 0, g: 76, b: 230, a: 1.0 }, boundary: { r: 242, g: 128, b: 0, a: 1.0 }, perimeter: { r: 179, g: 0, b: 204, a: 1.0 }
    }.freeze
    MAP_ENTRIES = %w[hunting_room_id rallypoint_room_ids hunting_boundaries].freeze
    MAP_MIN_SCALE = 0.2
    MAP_MAX_SCALE = 6.0
    LAYER_BUDGET = 500
    TAB_NAMES = (['Profiles'] + TABS.map(&:first) + ['Boon Creatures'] + %w[Compare Creatures Map]).freeze

    # @param name [String, nil] profile to open; nil opens defaults
    def self.open(name = nil)
      data = name ? BSProfiles.load(name) : nil
      if name && data.nil?
        respond "bsprofiles: no profile named '#{name}'"
        return
      end
      data ||= BSProfiles.defaults
      BSProfiles.templates # warm the creature cache on the script thread
      new(data, name).run
    end

    def initialize(settings, profile_name)
      @owner = Script.current
      @profile = profile_name.to_s
      @dirty = false
      @closed = Queue.new
      @status = {}
      @settings = {}
      @boons = BoonMatrix.new
      load_settings(settings)
      # compare
      @cmp_a = EDITOR_CHOICE
      @cmp_b = @profile.empty? ? EDITOR_CHOICE : @profile
      @cmp_only_diff = true
      @cmp_rows = nil
      # creatures
      @lvl_min, @lvl_max = BSProfiles.default_band
      @cr_name = ''
      @cr_area = ''
      @cr_undead = 'any'
      @cr_room = ''
      @cr_list = []
      @cr_selected = nil
      @template = nil
      @area_index = 0
      @rooms = []        # [{id:, uid:, title:, checked:}]
      @room_selected = []
      @unmapped = 0
      @cospawns = []     # [{name:, level:, checked:}]
      # map
      @map_scale = 1.0
      @map_current = nil
      @map_list = []
      @map_click_toggles = true
      @map_show_perimeter = true
      @map_dark = BSProfiles.map_dark_default
      @map_sizes = {}
      @map_route = nil
      @map_dark_route = nil
      @save_name = ''
      @load_choice = ''
      refresh_creature_list
    end

    # ---------------------------------------------------------- lifecycle --

    def run
      editor = self
      @page = Lich::API.webui_page(owner: @owner, id: PAGE_ID, title: title, props: { size: [1100, 760] },
                                   on: { close: ->(_ev) { editor.viewer_closed } }) do |ui|
        editor.render(ui)
      end
      register_maps
      Lich::API.webui_refresh(@page)
      Lich::API.webui_start
      unless Lich::API.webui_open(page: @page)
        respond 'bsprofiles: could not open a browser window for the editor.'
        return
      end
      @closed.pop
      Lich::Messaging.msg('plain', " bsprofiles: editor closed.#{@dirty ? ' Nothing was written: there were UNSAVED changes.' : ''}")
    ensure
      begin
        Lich::WebUI.terminate_owner(@owner)
      rescue StandardError
        nil
      end
    end

    def viewer_closed
      @closed << :viewer
    end

    def close_clicked
      Lich::WebUI.close(@page)
      @closed << :close
    end

    def title
      label = @profile.empty? ? 'new profile' : @profile
      "Bigshot Profiles: #{label}#{@dirty ? ' *' : ''}"
    end

    # Run a UI callback: contain errors, then re-render.
    def act
      yield
    rescue StandardError => e
      respond "bsprofiles: #{e.class}: #{e.message}"
      respond e.backtrace.first(5).join("\n") if $bigshot_debug
    ensure
      Lich::API.webui_refresh(@page) if @page
    end

    def cb(&block)
      editor = self
      ->(ev) { editor.act { block.call(ev) } }
    end

    def status(tab, msg)
      @status[tab] = msg.to_s
    end

    # ----------------------------------------------------------- settings --

    # Bigshot's own load rules: fill defaults, drop unknown keys, keep the
    # file name authoritative over profile_current.
    def load_settings(data)
      s = (data || {}).transform_keys(&:to_s)
      BSProfiles.schema.each { |key, meta| s[key.to_s] = meta[:default] if s[key.to_s].nil? }
      s.delete_if { |key, _| !BSProfiles.schema.key?(key.to_sym) }
      s['profile_current'] = @profile
      s['save_profile_name'] = ''
      @settings = s
      @boons.load(@settings)
    end

    def set(key, value)
      @settings[key.to_s] = value
      @dirty = true
    end

    def mark_dirty
      @dirty = true
    end

    # A string-keyed, file-shaped copy of the editor's current state.
    def snapshot
      @boons.store(@settings)
      copy = Marshal.load(Marshal.dump(@settings))
      copy['profile_current'] = @profile
      BSProfiles::TRANSIENT_KEYS.each { |k| copy.delete(k) }
      copy
    end

    def saved(name)
      @profile = name
      @settings['profile_current'] = name
      @dirty = false
    end

    def apply_to_bigshot
      data = snapshot
      data['profile_current'] = @profile
      data['save_profile_name'] = ''
      UserVars.op = data
      Lich::Messaging.msg('plain', " bsprofiles: editor settings applied to bigshot (UserVars.op)#{@dirty ? ' - remember they are not saved to a profile yet' : ''}.")
      status(:footer, 'Applied to bigshot.')
    end

    # ----------------------------------------------------------- profiles --

    def load_profile(name)
      return status(:profiles, 'Pick a profile first.') if name.to_s.empty?

      data = BSProfiles.load(name) or return status(:profiles, "No profile named #{name}.")
      @profile = name
      load_settings(data)
      @dirty = false
      @cmp_b = name
      @cmp_rows = nil
      status(:profiles, "Loaded '#{name}'.")
    end

    def update_profile
      return status(:profiles, 'This window is not a saved profile yet. Use Save Current Settings as... below.') if @profile.empty?
      return status(:profiles, bad_name_message) unless BSProfiles.valid_name?(@profile)

      BSProfiles.save(@profile, snapshot)
      saved(@profile)
      status(:profiles, "#{@profile} has been saved with current settings.")
    end

    def save_as(name)
      name = name.to_s.strip
      return status(:profiles, 'Please enter a name before saving the profile.') if name.empty?
      return status(:profiles, bad_name_message) unless BSProfiles.valid_name?(name)

      if BSProfiles.exist?(name)
        confirm_overwrite(name)
        return status(:profiles, "'#{name}' exists. Answer the overwrite question.")
      end
      write_profile(name)
    end

    def write_profile(name)
      path = BSProfiles.save(name, snapshot)
      saved(name)
      @save_name = ''
      @cmp_b = name
      status(:profiles, "The profile has been saved to #{path}")
    end

    def confirm_overwrite(name)
      editor = self
      future = Lich::API.webui_modal(owner: @owner, id: 'overwrite', title: 'Profile exists',
                                     body: "A profile named '#{name}' already exists. Overwrite it?",
                                     buttons: [{ id: 'overwrite', label: 'Overwrite' }, { id: 'cancel', label: 'Keep existing' }],
                                     no_viewer: :abort, cancel_button: 'cancel', default_button: 'cancel')
      future.then do |result|
        editor.act do
          if result.button == 'overwrite'
            editor.write_profile(name)
          else
            editor.status(:profiles, 'The profile save has been canceled.')
          end
        end
      end
    end

    def bad_name_message
      'Profile names cannot contain \\ / : * ? " < > | or start with a dot.'
    end

    # ------------------------------------------------------------ compare --

    def settings_for_choice(choice)
      return snapshot if choice.nil? || choice.empty? || choice == EDITOR_CHOICE

      BSProfiles.load(choice) || {}
    end

    def run_compare
      @cmp_rows = BSProfiles.compare(settings_for_choice(@cmp_a), settings_for_choice(@cmp_b))
    end

    def open_choice(choice)
      return if choice.nil? || choice == EDITOR_CHOICE || choice.empty?

      load_profile(choice)
      status(:compare, "Opened '#{choice}' in the editor.")
    end

    # ---------------------------------------------------------- creatures --

    def reset_filters
      @lvl_min, @lvl_max = BSProfiles.default_band
      @cr_room = ''
      @cr_name = ''
      @cr_area = ''
      @cr_undead = 'any'
      refresh_creature_list
    end

    def creatures_at_room
      if @cr_room.to_s.strip.empty?
        fallback = @settings['hunting_room_id'].to_s.strip
        return status(:creatures, 'type a room, or set a hunting room on the Hunting tab first') if fallback.empty?

        @cr_room = fallback
      end
      refresh_creature_list
    end

    def refresh_creature_list
      lo = @lvl_min.to_i
      hi = @lvl_max.to_i
      lo, hi = hi, lo if lo > hi
      name = @cr_name.to_s.strip.downcase
      area = @cr_area.to_s.empty? ? nil : @cr_area
      room = nil
      room_text = @cr_room.to_s.strip
      unless room_text.empty?
        room = BSProfiles.resolve_room(room_text)
        return status(:creatures, "room '#{room_text}' not found in the map database") if room.nil?
      end

      list = BSProfiles.templates.select { |t| t.level.to_i.between?(lo, hi) }
      list = list.select { |t| t.name.to_s.downcase.include?(name) } unless name.empty?
      list = list.select { |t| t.areas.any? { |a| a[:name].to_s == area } } if area
      case @cr_undead
      when 'undead' then list = list.select(&:undead)
      when 'living' then list = list.reject(&:undead)
      end
      list = BSProfiles.templates_at_room(room) & list if room
      @cr_list = list
      where = room ? " at room #{room.id}" : ''
      kind = { 'undead' => ', undead', 'living' => ', living' }[@cr_undead].to_s
      @cr_count = "#{list.size} creature(s), level #{lo}-#{hi}#{kind}#{area ? ", #{area}" : ''}#{where}"
      first = list.first
      if first
        show_creature(first)
      else
        clear_creature
      end
    end

    def creature_key(t)
      "c#{BSProfiles.templates.index(t)}"
    end

    def template_for_key(key)
      idx = key.to_s.sub(/\Ac/, '').to_i
      BSProfiles.templates[idx]
    end

    def clear_creature
      @template = nil
      @cr_selected = nil
      @rooms = []
      @room_selected = []
      @cospawns = []
      @unmapped = 0
      refresh_map_tab
    end

    def show_creature(t)
      @template = t
      @cr_selected = creature_key(t)
      @area_index = 0
      select_area(0)
    end

    def select_area(index)
      @area_index = index.to_i
      @rooms = []
      @room_selected = []
      @cospawns = []
      @unmapped = 0
      area = @template && @template.areas[@area_index]
      return refresh_map_tab if area.nil?

      uids = BSProfiles.area_uids(area)
      uids.each do |uid|
        ids = Map.ids_from_uid(uid)
        if ids.empty?
          @unmapped += 1
          next
        end
        ids.each do |id|
          room = Map[id]
          @rooms << { id: id.to_i, uid: uid, title: Array(room&.title).first.to_s.gsub(/[\[\]]/, ''), checked: true }
        end
      end
      BSProfiles.cospawns(@template, uids).each do |o|
        @cospawns << { name: o.name.to_s, level: o.level.to_i, checked: false, key: creature_key(o) }
      end
      refresh_map_tab
    end

    def room_summary
      checked = @rooms.count { |r| r[:checked] }
      extra = @unmapped.positive? ? ", #{@unmapped} uid(s) not in the map database" : ''
      "#{checked} of #{@rooms.size} mapped room(s) checked#{extra}"
    end

    def checked_rooms
      @rooms.select { |r| r[:checked] }.map { |r| r[:id] }.uniq.sort
    end

    def set_all_rooms(flag)
      @rooms.each { |r| r[:checked] = flag }
    end

    def toggle_room(id, flag = nil)
      hit = false
      @rooms.each do |r|
        next unless r[:id] == id.to_i

        r[:checked] = flag.nil? ? !r[:checked] : flag
        hit = true
      end
      hit
    end

    def selected_room_ids
      @room_selected.map(&:to_i).select(&:positive?).uniq
    end

    def set_entry(id, text)
      set(id, text.to_s)
      refresh_map_tab if MAP_ENTRIES.include?(id.to_s)
    end

    def append_list_entry(id, item)
      current = @settings[id].to_s.strip
      items = current.empty? ? [] : current.split(/\s*,\s*/)
      return if items.any? { |i| i.sub(/\(.*\)\z/, '').strip.casecmp?(item) }

      set_entry(id, (items + [item]).join(', '))
    end

    def room_to_entry(id)
      ids = selected_room_ids
      return status(:creatures, 'highlight a room row first') if ids.empty?

      set_entry(id, ids.first.to_s)
      status(:creatures, "#{id} set to #{ids.first}")
    end

    def rooms_to_entry(id)
      ids = selected_room_ids
      return status(:creatures, 'highlight one or more room rows first') if ids.empty?

      set_entry(id, ids.join(', '))
      status(:creatures, "#{id} set to #{ids.join(', ')}")
    end

    def boundaries_from(ids, replace:, what:)
      return status(:creatures, 'no rooms checked') if ids.empty?

      if replace
        set_entry('hunting_boundaries', ids.join(', '))
      else
        current = @settings['hunting_boundaries'].to_s.split(/\s*,\s*/).map(&:strip).reject(&:empty?)
        set_entry('hunting_boundaries', (current + ids.map(&:to_s)).uniq.join(', '))
      end
      status(:creatures, "hunting_boundaries #{replace ? 'set from' : 'extended with'} #{what}: #{ids.size} room(s)")
    end

    def noun_to_entry(id)
      return status(:creatures, 'pick a creature first') if @template.nil?

      noun = BSProfiles.noun_for(@template)
      append_list_entry(id, noun)
      status(:creatures, "#{id}: added #{noun}")
    end

    def cospawns_to_entry(id)
      names = @cospawns.select { |c| c[:checked] }.map { |c| c[:name] }
      return status(:creatures, 'no co-spawns checked') if names.empty?

      nouns = names.map { |n| n.split.last.to_s }.uniq
      nouns.each { |n| append_list_entry(id, n) }
      status(:creatures, "#{id}: added #{nouns.join(', ')}")
    end

    # ---------------------------------------------------------------- map --

    def register_maps
      @map_route = Lich::WebUI.service.register_files('bsprofiles-maps', BSProfiles.map_dir, owner: @owner,
                                                                                             script_root: BSProfiles.map_dir)
      dark = BSProfiles.map_dark_dir
      @map_dark_route = dark && Lich::WebUI.service.register_files('bsprofiles-maps-dark', dark, owner: @owner, script_root: dark)
    rescue StandardError => e
      @map_route = nil
      @map_dark_route = nil
      respond "bsprofiles: the map directory cannot be served (#{e.message}); the Map tab shows markers only."
    end

    def entry_room_ids(id)
      @settings[id].to_s.split(/\s*,\s*/).map { |s| BSProfiles.resolve_room(s)&.id }.compact
    end

    # {room_id => [kinds]} for every room the map should show.
    def map_rooms_of_interest
      rooms = Hash.new { |h, k| h[k] = [] }
      @rooms.each { |r| rooms[r[:id]] << (r[:checked] ? :checked : :area) }
      entry_room_ids('hunting_room_id').each { |id| rooms[id] << :start }
      entry_room_ids('rallypoint_room_ids').each { |id| rooms[id] << :rally }
      entry_room_ids('hunting_boundaries').each { |id| rooms[id] << :boundary }
      BSProfiles.perimeter(checked_rooms).each { |id| rooms[id] << :perimeter } if @map_show_perimeter
      rooms
    end

    def refresh_map_tab
      interest = map_rooms_of_interest
      counts = Hash.new(0)
      area_counts = Hash.new(0)
      interest.each do |id, kinds|
        room = Map[id]
        next if room.nil? || room.image.to_s.empty?
        next unless File.exist?(File.join(BSProfiles.map_dir, room.image))

        counts[room.image] += 1
        area_counts[room.image] += 1 if kinds.include?(:checked) || kinds.include?(:area)
      end
      @map_list = counts.keys.sort_by { |img| [-area_counts[img], -counts[img], img] }
      @map_counts = counts
      @map_current = @map_list.include?(@map_current) ? @map_current : @map_list.first
    end

    def map_size(image)
      @map_sizes[image] ||= Lich::WebUI::ImageSize.read(File.join(BSProfiles.map_dir, image))
    rescue StandardError
      @map_sizes[image] = [800, 600]
    end

    def map_source(image)
      if @map_dark && @map_dark_route && File.exist?(File.join(BSProfiles.map_dark_dir.to_s, image))
        "#{@map_dark_route}#{ERB::Util.url_encode(image)}"
      elsif @map_route
        "#{@map_route}#{ERB::Util.url_encode(image)}"
      end
    end

    def map_zoom(scale)
      @map_scale = scale.clamp(MAP_MIN_SCALE, MAP_MAX_SCALE).round(3)
    end

    # The composite's layers in the image's own pixels; `scale` does the zoom.
    def map_layers
      return [] if @map_current.nil?

      layers = []
      src = map_source(@map_current)
      w, h = map_size(@map_current)
      layers << { kind: 'image', x: 0, y: 0, w: w, h: h, src: src } if src
      interest = map_rooms_of_interest
      shown = 0
      cut = false
      interest.each do |id, kinds|
        room = Map[id]
        next if room.nil? || room.image != @map_current
        next unless (coords = room.image_coords)

        x1, y1, x2, y2 = coords.map(&:to_i)
        bw = [x2 - x1, 10].max
        bh = [y2 - y1, 10].max
        marks = []
        if kinds.include?(:checked)
          marks << { kind: 'marker', shape: 'cross', x: x1, y: y1, w: bw, h: bh, color: MAP_COLORS[:checked], line_width: 3 }
        elsif kinds.include?(:area)
          marks << { kind: 'marker', shape: 'cross', x: x1, y: y1, w: bw, h: bh, color: MAP_COLORS[:area], line_width: 1 }
        end
        marks << { kind: 'marker', shape: 'cross', x: x1, y: y1, w: bw, h: bh, color: MAP_COLORS[:perimeter], line_width: 2 } if kinds.include?(:perimeter)
        marks << { kind: 'rectangle', mode: 'stroke', x: x1 - 3, y: y1 - 3, w: bw + 6, h: bh + 6, color: MAP_COLORS[:boundary], line_width: 3 } if kinds.include?(:boundary)
        marks << { kind: 'marker', shape: 'ring', x: x1 - 5, y: y1 - 5, w: bw + 10, h: bh + 10, color: MAP_COLORS[:rally], line_width: 3 } if kinds.include?(:rally)
        marks << { kind: 'marker', shape: 'ring', x: x1 - 5, y: y1 - 5, w: bw + 10, h: bh + 10, color: MAP_COLORS[:start], line_width: 3 } if kinds.include?(:start)
        if @map_click_toggles && (kinds.include?(:checked) || kinds.include?(:area))
          title = Array(room.title).first.to_s.gsub(/[\[\]]/, '')
          marks << { kind: 'region', key: "room-#{id}", x1: x1, y1: y1, x2: x2, y2: y2, label: "#{id}: #{title}"[0, 200], activates: true }
        end
        if layers.size + marks.size > LAYER_BUDGET
          cut = true
          next
        end
        layers.concat(marks)
        shown += 1
      end
      checked = interest.count { |_, k| k.include?(:checked) }
      @map_status = "#{BSProfiles.map_display_name(@map_current)}: #{shown} of #{interest.size} room(s) of interest are on this map, " \
                    "#{checked} ticked. Zoom #{(@map_scale * 100).round}%.#{cut ? ' Too many rooms to mark them all.' : ''}"
      layers
    end

    def map_region_clicked(region)
      id = region.to_s[/\Aroom-(\d+)\z/, 1]
      return if id.nil?

      if toggle_room(id)
        status(:map, "Room #{id} #{@rooms.find { |r| r[:id] == id.to_i }[:checked] ? 'ticked' : 'unticked'}.")
      else
        status(:map, "Room #{id} is not in the chosen area's room list, so it cannot be ticked here.")
      end
    end

    # ------------------------------------------------------------- render --

    def tip(id)
      BSProfiles.tooltips[id.to_s]
    end

    # Tooltip keyword only when bigshot has one; the contract refuses nil.
    def tipp(id)
      text = tip(id)
      text.nil? || text.empty? ? {} : { tooltip: text }
    end

    def render(ui)
      editor = self
      ui.tabs(key: 'tabs', names: TAB_NAMES, selected: 0, on: { select: proc {} }) do
        ui.scroll(slot: 'Profiles', key: 'tab-profiles', fill: true) { editor.render_profiles(ui) }
        TABS.each do |name, sections|
          ui.scroll(slot: name, key: "tab-#{name.downcase}", fill: true) do
            ui.stack(key: "stack-#{name.downcase}", gap: 8, margin: 8) do
              sections.each_with_index { |section, i| editor.render_section(ui, section, "#{name}-#{i}") }
            end
          end
        end
        ui.scroll(slot: 'Boon Creatures', key: 'tab-boons', fill: true) { editor.render_boons(ui) }
        ui.scroll(slot: 'Compare', key: 'tab-compare', fill: true) { editor.render_compare(ui) }
        ui.scroll(slot: 'Creatures', key: 'tab-creatures', fill: true) { editor.render_creatures(ui) }
        ui.scroll(slot: 'Map', key: 'tab-map', fill: true) { editor.render_map(ui) }
      end
      render_footer(ui)
    end

    def render_footer(ui)
      editor = self
      state = if @profile.empty?
                @dirty ? 'new profile, not yet saved' : 'new profile'
              else
                @dirty ? "#{@profile}  (unsaved changes)" : "#{@profile}  (saved)"
              end
      ui.divider(key: 'footer-div')
      ui.columns(key: 'footer', count: 3, weights: [6, 1, 1], compact: true, row_align: :center, margin: 6) do
        ui.text(slot: '0', key: 'footer-text', wrap: true,
                content: "Editing: #{state}    Profiles: #{BSProfiles.names.size} in #{BSProfiles.dir}    Bigshot: v#{$bigshot_version}" \
                         "#{editor.status_text(:footer).empty? ? '' : "    #{editor.status_text(:footer)}"}",
                tooltip: "Close does not write anything. Save with Update Profile or Save Current Settings as... on the Profiles tab.\n" \
                         "Apply to Bigshot copies the current settings into bigshot's live settings without writing a file.")
        ui.button(slot: '1', key: 'apply', label: 'Apply to Bigshot',
                  tooltip: "Copy the editor's settings into bigshot's live settings (UserVars.op), which bigshot reads when it starts.\n" \
                           'Same effect as ;bigshot profile load. Does not write a profile file.',
                  on: { activate: editor.cb { editor.apply_to_bigshot } })
        ui.button(slot: '2', key: 'close', label: 'Close',
                  tooltip: 'Close the editor. Nothing is written: save on the Profiles tab first if you made changes.',
                  on: { activate: ->(_ev) { editor.close_clicked } })
      end
    end

    # ---- bigshot tabs ----

    def render_section(ui, section, key)
      editor = self
      case section[0]
      when :frame
        _, label, rows = section
        props = { key: key }
        props[:label] = label if label
        ui.group(**props) do
          ui.stack(key: "#{key}-s", gap: 4, margin: 4) do
            rows.each_with_index { |row, i| editor.render_row(ui, row, "#{key}-#{i}") }
          end
        end
      when :cols
        parts = section[1]
        ui.columns(key: key, count: parts.size, gap: 8) do
          parts.each_with_index { |part, i| editor.render_section_in_slot(ui, part, "#{key}-c#{i}", i.to_s) }
        end
      end
    end

    def render_section_in_slot(ui, section, key, slot)
      editor = self
      ui.stack(slot: slot, key: key, gap: 8) { editor.render_section(ui, section, "#{key}-i") }
    end

    def render_row(ui, row, key)
      editor = self
      case row[0]
      when :pair
        _, label, kind, id, extra = row
        ui.columns(key: key, count: 2, weights: [2, 3], compact: true, row_align: :center) do
          ui.text(slot: '0', key: "#{key}-l", content: label, **editor.tipp(id))
          editor.render_input(ui, kind, id, extra, '1')
        end
      when :check
        render_check(ui, row[1], row[2])
      when :checks
        ui.stack(key: key, orientation: :horizontal, gap: 16) do
          row[1].each { |id, label| editor.render_check(ui, id, label) }
        end
      when :area
        _, id, label = row
        ui.group(key: key, label: label) do
          ui.textarea(key: id, value: editor.settings[id].to_s, rows: 4, **editor.tipp(id),
                      on: { change: editor.cb { |ev| editor.set(id, ev.payload[:value].to_s) } })
        end
      when :note
        ui.text(key: key, content: row[1], emphasis: :subtle, wrap: true)
      when :frame, :cols
        render_section(ui, row, key)
      end
    end

    def render_check(ui, id, label)
      editor = self
      ui.checkbox(key: id, label: label, checked: @settings[id] ? true : false, **tipp(id),
                  on: { change: editor.cb { |ev| editor.set(id, ev.payload[:value] ? true : false) } })
    end

    def render_input(ui, kind, id, extra, slot)
      editor = self
      value = @settings[id]
      case kind
      when :entry
        ui.text_input(slot: slot, key: id, value: value.to_s, **tipp(id),
                      on: { change: editor.cb { |ev| editor.set(id, ev.payload[:value].to_s.strip) } })
      when :spin
        min, max, step = SPINS.fetch(id, [0, 100_000, 1])
        float = step.is_a?(Float)
        num = float ? value.to_f : value.to_i
        num = num.clamp(min, max)
        ui.number_input(slot: slot, key: id, value: num, min: min, max: max, step: step, stepper_buttons: true,
                        digits: float ? 1 : 0, **tipp(id),
                        on: { change: editor.cb { |ev|
                          v = ev.payload[:value]
                          editor.set(id, float ? v.to_f.round(1).to_s : v.to_i.to_s)
                        } })
      when :select
        options = extra.map { |v, l| { value: v.to_s, label: l } }
        current = value.to_s
        current = options.first[:value] unless options.any? { |o| o[:value] == current }
        ui.select(slot: slot, key: id, options: options, value: current, **tipp(id),
                  on: { change: editor.cb { |ev| editor.set(id, ev.payload[:value].to_s) } })
      when :combo
        options = extra.map { |v| { value: v.to_s, label: v.to_s } }
        ui.select(slot: slot, key: id, options: options, editable: true, value: value.to_s, **tipp(id),
                  on: { change: editor.cb { |ev| editor.set(id, ev.payload[:value].to_s.strip) } })
      end
    end

    attr_reader :settings

    # ---- profiles ----

    def render_profiles(ui)
      editor = self
      names = BSProfiles.names
      ui.stack(key: 'profiles', gap: 8, margin: 8) do
        ui.group(key: 'p-load', label: 'Load Profile') do
          ui.columns(key: 'p-load-row', count: 3, weights: [3, 1, 1], compact: true, row_align: :end) do
            options = [{ value: '', label: names.empty? ? '(no saved profiles)' : '(choose a profile)' }] +
                      names.map { |n| { value: n, label: n } }
            ui.select(slot: '0', key: 'profile_name', label: 'Saved profiles', options: options, value: editor.load_choice,
                      tooltip: 'Saved profiles for this character. Pick one and click Load Profile.',
                      on: { change: editor.cb { |ev| editor.load_choice = ev.payload[:value].to_s } })
            ui.button(slot: '1', key: 'profile_button', label: 'Load Profile',
                      tooltip: "Load the chosen profile into the editor, replacing what is here.\nUnsaved edits are lost.",
                      on: { activate: editor.cb { editor.load_profile(editor.load_choice) } })
            ui.button(slot: '2', key: 'save_current', label: 'Update Profile', variant: :primary,
                      tooltip: 'Write the current settings to the profile named below.',
                      on: { activate: editor.cb { editor.update_profile } })
          end
          ui.text_input(key: 'profile_current', label: 'Current Profile:', value: editor.profile, read_only: true,
                        tooltip: 'The profile file this window represents. Update Profile writes to it.')
        end
        ui.group(key: 'p-save', label: 'Save Profile') do
          ui.columns(key: 'p-save-row', count: 2, weights: [3, 2], compact: true, row_align: :end) do
            ui.text_input(slot: '0', key: 'save_profile_name', label: 'New profile name', value: editor.save_name,
                          placeholder: 'name for the new profile', tooltip: 'Name for the new profile. Spaces are fine.',
                          on: { change: editor.cb { |ev| editor.save_name = ev.payload[:value].to_s }, submit: editor.cb { editor.save_as(editor.save_name) } })
            ui.button(slot: '1', key: 'profile_save', label: 'Save Current Settings as...',
                      tooltip: 'Write the current settings to a new profile with the name typed here.',
                      on: { activate: editor.cb { editor.save_as(editor.save_name) } })
          end
        end
        ui.text(key: 'p-status', content: editor.status_text(:profiles), tone: :caution, wrap: true) unless editor.status_text(:profiles).empty?
        ui.group(key: 'p-notes', label: 'Notes') do
          ui.textarea(key: 'notes', value: editor.settings['notes'].to_s, rows: 5, tooltip: 'Free-form notes stored with the profile.',
                      on: { change: editor.cb { |ev| editor.set('notes', ev.payload[:value].to_s) } })
        end
        ui.text(key: 'p-info', wrap: true, emphasis: :subtle,
                content: "Standalone profile editor. Profiles are read from and written to:\n#{BSProfiles.dir}\n\n" \
                         "Close does not save. Use Update Profile or Save Current Settings as...\n" \
                         "Apply to Bigshot (bottom right) copies these settings into bigshot's live settings.\n\n#{BIGSHOT_INFO}")
      end
    end

    attr_accessor :load_choice, :save_name
    attr_reader :profile

    def status_text(tab)
      @status[tab].to_s
    end

    # ---- boons ----

    def render_boons(ui)
      editor = self
      ui.stack(key: 'boons', gap: 8, margin: 8) do
        ui.group(key: 'boons-all', label: 'All Boon Creatures') do
          ui.stack(key: 'boons-all-row', orientation: :horizontal, gap: 24) do
            BoonMatrix::MODES.each do |mode|
              ui.checkbox(key: "boons_all:#{mode}", label: mode.capitalize, checked: editor.boons["boons_all:#{mode}"].active?,
                          **editor.tipp("all:#{mode}_label"),
                          on: { change: editor.cb { |ev| editor.boon_changed('boons_all', mode, ev.payload[:value]) } })
            end
          end
        end
        ui.text(key: 'boons-info', content: BOON_INFO, wrap: true, emphasis: :subtle)
        BoonMatrix::GROUPS.each do |group, items|
          ui.expander(key: "boons-#{group}", label: BoonMatrix::TITLES[group], open: true) do
            editor.render_boon_table(ui, group, items)
          end
        end
      end
    end

    attr_reader :boons

    def render_boon_table(ui, group, items)
      editor = self
      columns = [{ key: 'boon', label: 'Boon', min_width: 160 }] +
                BoonMatrix::MODES.map { |m| { key: m, label: m.capitalize, align: :center, width: 90, editor: { type: :checkbox } } } +
                [{ key: 'notes', label: 'Notes', expand: true }]
      rows = [{ key: 'group', cells: { 'boon' => 'Entire Group', 'notes' => '' }.merge(BoonMatrix::MODES.to_h { |m| [m, editor.boons["#{group}:#{m}"].active?] }) }]
      items.each do |item|
        label, note = BoonMatrix::LABELS.fetch(item, [item, ''])
        rows << { key: item, cells: { 'boon' => label, 'notes' => note }.merge(BoonMatrix::MODES.to_h { |m| [m, editor.boons["#{group}:#{item}_#{m}"].active?] }) }
      end
      ui.table(key: "boons-#{group}-table", columns: columns, rows: rows, headers: true, scrollable: false, wrap: true,
               on: { cell_edit: editor.cb { |ev|
                 row = ev.payload[:row].to_s
                 mode = ev.payload[:column].to_s
                 value = row == 'group' ? mode : "#{row}_#{mode}"
                 editor.boon_changed(group, value, ev.payload[:value])
               } })
    end

    def boon_changed(group, value, checked)
      @boons.update(group, value, checked ? true : false)
      @boons.store(@settings)
      mark_dirty
    end

    # ---- compare ----

    def render_compare(ui)
      editor = self
      choices = [{ value: EDITOR_CHOICE, label: EDITOR_CHOICE }] + BSProfiles.names.map { |n| { value: n, label: n } }
      side_tip = 'A saved profile, or <editor> for the unsaved state of this window.'
      ui.stack(key: 'compare', gap: 8, margin: 8) do
        ui.columns(key: 'cmp-row', count: 6, weights: [3, 3, 1, 2, 2, 2], compact: true, row_align: :end) do
          ui.select(slot: '0', key: 'cmp_a', label: 'A', options: choices, value: editor.cmp_a, tooltip: "Left side of the comparison.\n#{side_tip}",
                    on: { change: editor.cb { |ev| editor.cmp_a = ev.payload[:value].to_s } })
          ui.select(slot: '1', key: 'cmp_b', label: 'B', options: choices, value: editor.cmp_b, tooltip: "Right side of the comparison.\n#{side_tip}",
                    on: { change: editor.cb { |ev| editor.cmp_b = ev.payload[:value].to_s } })
          ui.button(slot: '2', key: 'cmp_run', label: 'Compare', variant: :primary, tooltip: 'Run the comparison. Differences are shown in red.',
                    on: { activate: editor.cb { editor.run_compare } })
          ui.checkbox(slot: '3', key: 'cmp_only_diff', label: 'Only differences', checked: editor.cmp_only_diff,
                      tooltip: 'Hide settings that are the same on both sides.',
                      on: { change: editor.cb { |ev| editor.cmp_only_diff = ev.payload[:value] ? true : false } })
          open_tip = "Load this profile into the editor tabs, replacing what is there.\nUnsaved edits in the window are lost."
          ui.button(slot: '4', key: 'cmp_open_a', label: 'Open A in editor', tooltip: open_tip, on: { activate: editor.cb { editor.open_choice(editor.cmp_a) } })
          ui.button(slot: '5', key: 'cmp_open_b', label: 'Open B in editor', tooltip: open_tip, on: { activate: editor.cb { editor.open_choice(editor.cmp_b) } })
        end
        ui.text(key: 'cmp-status', content: editor.status_text(:compare), wrap: true) unless editor.status_text(:compare).empty?
        rows = editor.cmp_rows
        if rows
          diffs = rows.count { |r| r[3] }
          ui.text(key: 'cmp-summary', content: "#{diffs} of #{rows.size} settings differ between '#{editor.cmp_a}' and '#{editor.cmp_b}'.")
          shown = editor.cmp_only_diff ? rows.select { |r| r[3] } : rows
          table_rows = shown.map do |key, va, vb, differs|
            row = { key: key, cells: { 'setting' => key, 'a' => BSProfiles.display_value(va), 'b' => BSProfiles.display_value(vb) } }
            row[:cell_foregrounds] = %w[setting a b].map { |c| { column: c, color: DIFF_COLOR } } if differs
            row
          end
          ui.table(key: 'cmp-table', headers: true, wrap: true,
                   tooltip: 'Every bigshot setting, side by side. Red rows differ.',
                   columns: [{ key: 'setting', label: 'Setting', min_width: 160, resizable: true },
                             { key: 'a', label: 'A', resizable: true, expand: true },
                             { key: 'b', label: 'B', resizable: true, expand: true }],
                   rows: table_rows)
        else
          ui.text(key: 'cmp-hint', content: 'Pick two profiles and click Compare.', emphasis: :subtle)
        end
      end
    end

    attr_accessor :cmp_a, :cmp_b, :cmp_only_diff
    attr_reader :cmp_rows

    # ---- creatures ----

    def render_creatures(ui)
      editor = self
      ui.stack(key: 'creatures', gap: 6, margin: 8) do
        editor.render_creature_filters(ui)
        ui.columns(key: 'cr-cols', count: 3, weights: [3, 4, 4], gap: 8) do
          ui.stack(slot: '0', key: 'cr-left', gap: 4) do
            editor.render_creature_table(ui)
            ui.text(key: 'cr-count', content: editor.cr_count.to_s, emphasis: :subtle, tooltip: 'How many creatures match the current filters.')
          end
          ui.scroll(slot: '1', key: 'cr-detail-scroll', max_height: 560) do
            if editor.template
              ui.markdown(key: 'cr-detail', content: BSProfiles.detail_markdown(editor.template))
            else
              ui.text(key: 'cr-detail-empty', content: 'Select a creature.', emphasis: :subtle)
            end
          end
          ui.stack(slot: '2', key: 'cr-right', gap: 6) { editor.render_creature_right(ui) }
        end
      end
    end

    attr_reader :cr_count, :template

    def render_creature_filters(ui)
      editor = self
      band_tip = "Only creatures in this level range are listed.\nOpens at your level -5 to +10. Set 1 to 120 to see everything."
      ui.columns(key: 'cr-filters', count: 8, weights: [1, 1, 2, 3, 2, 2, 2, 1], compact: true, row_align: :end, gap: 6) do
        ui.number_input(slot: '0', key: 'lvl_min', label: 'Level', value: editor.lvl_min, min: 1, max: 120, step: 1, tooltip: "Lowest level to list.\n#{band_tip}",
                        on: { change: editor.cb { |ev| editor.lvl_min = ev.payload[:value].to_i; editor.refresh_creature_list } })
        ui.number_input(slot: '1', key: 'lvl_max', label: 'to', value: editor.lvl_max, min: 1, max: 120, step: 1, tooltip: "Highest level to list.\n#{band_tip}",
                        on: { change: editor.cb { |ev| editor.lvl_max = ev.payload[:value].to_i; editor.refresh_creature_list } })
        ui.text_input(slot: '2', key: 'cr_name', label: 'Name', value: editor.cr_name, placeholder: 'name contains', search: true,
                      tooltip: 'Keep only creatures whose name contains this text.',
                      on: { change: editor.cb { |ev| editor.cr_name = ev.payload[:value].to_s; editor.refresh_creature_list } })
        areas = [{ value: '', label: 'All areas' }] + BSProfiles.area_names.map { |n| { value: n, label: n } }
        ui.select(slot: '3', key: 'cr_area', label: 'Area', options: areas, value: editor.cr_area,
                  tooltip: 'Keep only creatures that spawn in this area. Combine with the level band to see what a hunting ground holds for you.',
                  on: { change: editor.cb { |ev| editor.cr_area = ev.payload[:value].to_s; editor.refresh_creature_list } })
        ui.select(slot: '4', key: 'cr_undead', label: 'Kind', value: editor.cr_undead,
                  options: [{ value: 'any', label: 'Any' }, { value: 'undead', label: 'Undead' }, { value: 'living', label: 'Living' }],
                  tooltip: "Any: all creatures. Undead: only undead. Living: only non-undead.\nUseful for clerics and paladins, or for skipping undead when hunting for blood.",
                  on: { change: editor.cb { |ev| editor.cr_undead = ev.payload[:value].to_s; editor.refresh_creature_list } })
        ui.text_input(slot: '5', key: 'cr_room', label: 'Room', value: editor.cr_room, placeholder: 'room id or uNNN',
                      tooltip: "A Lich room id (29882) or a game uid (u7503101).\nPress Enter or click Creatures at room. Blank uses the profile's hunting room.",
                      on: { change: editor.cb { |ev| editor.cr_room = ev.payload[:value].to_s }, submit: editor.cb { editor.creatures_at_room } })
        ui.button(slot: '6', key: 'cr_here', label: 'Creatures at room',
                  tooltip: "Limit the list to creatures whose spawn areas include this room.\nBlank uses the profile's hunting room. Clear the room to go back to the level band.",
                  on: { activate: editor.cb { editor.creatures_at_room } })
        ui.button(slot: '7', key: 'cr_reset', label: 'Reset', tooltip: 'Back to the level band around your character, all areas, no name filter.',
                  on: { activate: editor.cb { editor.reset_filters } })
      end
    end

    attr_accessor :lvl_min, :lvl_max, :cr_name, :cr_area, :cr_undead, :cr_room

    def render_creature_table(ui)
      editor = self
      rows = @cr_list.map do |t|
        { key: creature_key(t), cells: { 'lvl' => t.level.to_i, 'name' => t.name.to_s, 'areas' => t.areas.map { |a| a[:name].to_s }.uniq.join(', ') } }
      end
      selected = rows.any? { |r| r[:key] == @cr_selected } ? [@cr_selected] : []
      ui.table(key: 'cr-table', headers: true, selection: :single, selected: selected, max_height: 480, sortable: true,
               tooltip: 'Creatures matching the filters. Click a row to see its details, areas and rooms. Click a column header to sort.',
               columns: [{ key: 'lvl', label: 'Lvl', width: 50, sortable: true, align: :end },
                         { key: 'name', label: 'Creature', sortable: true, resizable: true, expand: true },
                         { key: 'areas', label: 'Areas', sortable: true, resizable: true }],
               rows: rows,
               on: { selection_change: editor.cb { |ev|
                 key = Array(ev.payload[:rows]).first
                 t = key && editor.template_for_key(key)
                 t ? editor.show_creature(t) : editor.clear_creature
               } })
    end

    def render_creature_right(ui)
      editor = self
      areas = if @template
                @template.areas.each_with_index.map do |area, i|
                  uids = BSProfiles.area_uids(area)
                  mapped = uids.count { |u| !Map.ids_from_uid(u).empty? }
                  { value: i.to_s, label: "#{area[:name]}  (#{mapped}/#{uids.size} rooms mapped)  [#{i + 1}/#{@template.areas.size}]" }
                end
              else
                [{ value: '0', label: '(select a creature)' }]
              end
      ui.select(key: 'area_combo', label: 'Area', options: areas, value: @area_index.to_s,
                tooltip: "The selected creature's spawn areas, with how many of the area's rooms are in your map database.\nPicking one fills the room list and the co-spawn list below.",
                on: { change: editor.cb { |ev| editor.select_area(ev.payload[:value].to_i) } })
      room_rows = @rooms.map do |r|
        { key: r[:id].to_s, cells: { 'use' => r[:checked], 'room' => r[:id].to_s, 'uid' => "u#{r[:uid]}", 'title' => r[:title] } }
      end
      room_keys = room_rows.map { |r| r[:key] }
      ui.table(key: 'room-table', headers: true, selection: :multi, selected: @room_selected.map(&:to_s) & room_keys, max_height: 180, scrollable: true,
               tooltip: "Mapped rooms in the chosen area. Tick the rooms you want the fence to enclose,\nhighlight rows (Ctrl+click for several) to use as the start room or rally points.",
               columns: [{ key: 'use', label: '', width: 36, editor: { type: :checkbox } },
                         { key: 'room', label: 'Room', width: 70 }, { key: 'uid', label: 'UID', width: 80 },
                         { key: 'title', label: 'Title', expand: true, resizable: true }],
               rows: room_rows,
               on: { cell_edit: editor.cb { |ev| editor.toggle_room(ev.payload[:row], ev.payload[:value] ? true : false) },
                     selection_change: editor.cb { |ev| editor.room_selected = Array(ev.payload[:rows]) } })
      ui.columns(key: 'room-btns', count: 3, weights: [1, 1, 3], compact: true, row_align: :center) do
        ui.button(slot: '0', key: 'check_all', label: 'Check all', tooltip: 'Tick every mapped room in the list.',
                  on: { activate: editor.cb { editor.set_all_rooms(true) } })
        ui.button(slot: '1', key: 'uncheck_all', label: 'Uncheck all', tooltip: 'Clear every tick in the list.',
                  on: { activate: editor.cb { editor.set_all_rooms(false) } })
        ui.text(slot: '2', key: 'room-summary', content: editor.room_summary, emphasis: :subtle,
                tooltip: 'Ticked rooms are what the Boundaries buttons use. Uids not in the map database cannot be used.')
      end
      ui.text(key: 'cos-label', content: 'Also spawns in this area')
      cos_rows = @cospawns.map { |c| { key: c[:key], cells: { 'use' => c[:checked], 'lvl' => c[:level], 'name' => c[:name] } } }
      ui.table(key: 'cos-table', headers: true, selection: :none, max_height: 150, scrollable: true, sortable: true, activation: :double,
               tooltip: "Other creatures that spawn in the chosen area, so you know what else you will meet there.\n" \
                        'Tick the ones you also want to hunt, then use the co-spawn buttons below. Double-click a row to view that creature.',
               columns: [{ key: 'use', label: '', width: 36, editor: { type: :checkbox } },
                         { key: 'lvl', label: 'Lvl', width: 50, sortable: true, align: :end },
                         { key: 'name', label: 'Creature', sortable: true, expand: true }],
               rows: cos_rows,
               on: { cell_edit: editor.cb { |ev| editor.toggle_cospawn(ev.payload[:row], ev.payload[:value]) },
                     row_activate: editor.cb { |ev|
                       t = editor.template_for_key(ev.payload[:row])
                       editor.show_creature(t) if t
                     } })
      ui.group(key: 'send', label: 'Send to profile',
               tooltip: "These buttons write into the profile being edited (the Hunting and Commands tabs).\nNothing is saved to disk until you save on the Profiles tab.") do
        ui.grid(key: 'send-grid', cols: 2, gap: 4) do
          ui.button(key: 'start_btn', label: 'Start room <- row', on: { activate: editor.cb { editor.room_to_entry('hunting_room_id') } },
                    tooltip: "Set the profile's hunting start room (hunting_room_id) to the highlighted room.\nIf several rows are highlighted the first one is used.")
          ui.button(key: 'rest_btn', label: 'Rally points <- rows', on: { activate: editor.cb { editor.rooms_to_entry('rallypoint_room_ids') } },
                    tooltip: "Replace the profile's rally points (rallypoint_room_ids) with the highlighted rooms.\nCtrl+click or Shift+click to highlight more than one row.\n" \
                             "Bigshot stops at a rally point before the start room to cast hunting spells and start hunting scripts, and a group leader waits there for the group.\nBlank means bigshot uses the start room.")
          ui.button(key: 'perim_btn', label: 'Boundaries <- perimeter',
                    on: { activate: editor.cb { editor.boundaries_from(BSProfiles.perimeter(editor.checked_rooms), replace: true, what: 'perimeter') } },
                    tooltip: "Replace hunting_boundaries with the ring of rooms just outside the ticked rooms.\n" \
                             "This is how bigshot's boundaries work: it hunts every room it can reach from the start room without stepping into a boundary room.\nTick the rooms you want to hunt, and this builds the fence around them.")
          ui.button(key: 'fence_add_btn', label: 'Boundaries += perimeter',
                    on: { activate: editor.cb { editor.boundaries_from(BSProfiles.perimeter(editor.checked_rooms), replace: false, what: 'perimeter') } },
                    tooltip: "Add the perimeter of the ticked rooms to hunting_boundaries, keeping what is already there.\nUse this to fence a second area into the same profile.")
          ui.button(key: 'target_btn', label: 'Targets += creature', on: { activate: editor.cb { editor.noun_to_entry('targets') } },
                    tooltip: "Add the selected creature's noun to the profile's target list (Commands tab).\nAdd a command letter afterwards if you want it, e.g. wendigo(a). Already-listed nouns are skipped.")
          ui.button(key: 'quick_btn', label: 'Quick targets += creature', on: { activate: editor.cb { editor.noun_to_entry('quickhunt_targets') } },
                    tooltip: "Add the selected creature's noun to the quick-hunt target list used by ;bigshot quick.")
          ui.button(key: 'cos_target_btn', label: 'Targets += checked co-spawns', on: { activate: editor.cb { editor.cospawns_to_entry('targets') } },
                    tooltip: 'Add the noun of every ticked co-spawn to the profile\'s target list. Already-listed nouns are skipped.')
          ui.button(key: 'cos_quick_btn', label: 'Quick += checked co-spawns', on: { activate: editor.cb { editor.cospawns_to_entry('quickhunt_targets') } },
                    tooltip: 'Add the noun of every ticked co-spawn to the quick-hunt target list.')
        end
      end
      ui.text(key: 'cr-status', content: editor.status_text(:creatures), tone: :caution, wrap: true, tooltip: 'Result of the last action on this tab.') unless editor.status_text(:creatures).empty?
    end

    attr_accessor :room_selected

    def toggle_cospawn(key, flag)
      c = @cospawns.find { |x| x[:key] == key.to_s } or return
      c[:checked] = flag ? true : false
    end

    # ---- map ----

    def render_map(ui)
      editor = self
      ui.stack(key: 'map', gap: 6, margin: 8) do
        ui.columns(key: 'map-bar', count: 7, weights: [4, 1, 1, 1, 2, 2, 1], compact: true, row_align: :end, gap: 6) do
          options = editor.map_list.map { |img| { value: img, label: "#{BSProfiles.map_display_name(img)}  (#{editor.map_counts[img]} rooms)" } }
          options = [{ value: '', label: '(no maps for these rooms)' }] if options.empty?
          ui.select(slot: '0', key: 'map_combo', label: 'Map', options: options, value: editor.map_current.to_s,
                    tooltip: "Maps that contain rooms from the chosen area or the profile.\nThe count is how many of those rooms are on that map.",
                    on: { change: editor.cb { |ev| editor.map_current = ev.payload[:value].to_s.empty? ? nil : ev.payload[:value].to_s } })
          ui.button(slot: '1', key: 'zoom_out', label: '-', tooltip: 'Zoom out. Ctrl + mouse wheel over the map also zooms.',
                    on: { activate: editor.cb { editor.map_zoom(editor.map_scale / 1.25) } })
          ui.button(slot: '2', key: 'zoom_in', label: '+', tooltip: 'Zoom in. Ctrl + mouse wheel over the map also zooms.',
                    on: { activate: editor.cb { editor.map_zoom(editor.map_scale * 1.25) } })
          ui.button(slot: '3', key: 'zoom_100', label: '100%', tooltip: 'Show the map at its natural size.',
                    on: { activate: editor.cb { editor.map_zoom(1.0) } })
          ui.checkbox(slot: '4', key: 'map_click_toggles', label: 'Click toggles room', checked: editor.map_click_toggles,
                      tooltip: 'When on, clicking a room on the map ticks or unticks it in the Creatures tab room list.',
                      on: { change: editor.cb { |ev| editor.map_click_toggles = ev.payload[:value] ? true : false } })
          ui.checkbox(slot: '5', key: 'map_show_perimeter', label: 'Preview perimeter', checked: editor.map_show_perimeter,
                      tooltip: "Show the rooms that \"Boundaries <- perimeter\" would set right now: the ring just outside the ticked rooms.\nPurple X. Changes as you tick and untick.",
                      on: { change: editor.cb { |ev| editor.map_show_perimeter = ev.payload[:value] ? true : false; editor.refresh_map_tab } })
          ui.checkbox(slot: '6', key: 'map_dark', label: 'Dark', checked: editor.map_dark,
                      tooltip: "Use the dark map images from the maps-dark folder when they exist, as ;map does.\nStarts from ;map's own dark mode setting.",
                      on: { change: editor.cb { |ev| editor.map_dark = ev.payload[:value] ? true : false } })
        end
        ui.text(key: 'map-legend', emphasis: :subtle, wrap: true,
                content: 'Green X ticked room   Grey X area room, not ticked   Red O start room   Blue O rally point   Orange box boundary   Purple X perimeter preview',
                tooltip: 'Start room, rally points and boundaries come from the profile being edited, so this shows the fence as bigshot will see it.')
        if editor.map_current
          w, h = editor.map_size(editor.map_current)
          ui.scroll(key: 'map-scroll', max_height: 560, fill: true) do
            ui.composite(key: 'map-canvas', width: w, height: h, scale: editor.map_scale, layers: editor.map_layers,
                         on: { region_activate: editor.cb { |ev| editor.map_region_clicked(ev.payload[:region]) },
                               zoom: editor.cb { |ev| editor.map_zoom(ev.payload[:direction].to_s == 'in' ? editor.map_scale * 1.15 : editor.map_scale / 1.15) } })
          end
          ui.text(key: 'map-status', content: editor.map_status.to_s, emphasis: :subtle, wrap: true,
                  tooltip: 'Which map is shown and how many of the rooms of interest are on it.')
        else
          ui.text(key: 'map-empty', emphasis: :subtle,
                  content: 'No map images for these rooms. Pick an area on the Creatures tab, or set rooms on the Hunting tab.')
        end
        ui.text(key: 'map-action', content: editor.status_text(:map), tone: :caution) unless editor.status_text(:map).empty?
      end
    end

    attr_accessor :map_current, :map_click_toggles, :map_show_perimeter, :map_dark
    attr_reader :map_list, :map_counts, :map_scale, :map_status
  end
end

# ------------------------------------------------------------------ main --

args = Script.current.vars
cmd = args[1].to_s.downcase
rest = args[0].to_s.sub(/\A\s*#{Regexp.escape(args[1].to_s)}\s*/i, '').strip

two_names = lambda do
  parts = rest.include?('|') ? rest.split('|', 2) : rest.split(/\s+/, 2)
  parts.map { |p| p.to_s.strip }
end

gui_ok = BSProfiles.gui_available?
no_gui = 'bsprofiles: the editor needs the Lich WebUI (not available with --no-gui). Command-line actions still work (;bsprofiles help).'

case cmd
when '', 'edit'
  if gui_ok
    BSProfiles::Editor.open(rest.empty? ? nil : rest)
  else
    respond no_gui
  end
when 'new'
  if rest.empty?
    respond 'bsprofiles: name required. ;bsprofiles new <name>'
  elsif !BSProfiles.valid_name?(rest)
    respond "bsprofiles: '#{rest}' is not a valid file name."
  elsif BSProfiles.exist?(rest)
    respond "bsprofiles: '#{rest}' already exists. Use ;bsprofiles edit #{rest}"
  else
    BSProfiles.save(rest, BSProfiles.defaults)
    respond "bsprofiles: created #{BSProfiles.path(rest)}"
    gui_ok ? BSProfiles::Editor.open(rest) : respond(no_gui)
  end
when 'list'
  BSProfiles.print_list
when 'show'
  rest.empty? ? respond('bsprofiles: name required.') : BSProfiles.print_show(rest)
when 'compare', 'diff'
  a, b = two_names.call
  if a.to_s.empty? || b.to_s.empty?
    respond 'bsprofiles: two names required. ;bsprofiles compare <a> | <b>'
  else
    BSProfiles.print_compare(a, b)
  end
when 'copy', 'rename'
  a, b = two_names.call
  if a.to_s.empty? || b.to_s.empty?
    respond "bsprofiles: two names required. ;bsprofiles #{cmd} <a> | <b>"
  elsif !BSProfiles.exist?(a)
    respond "bsprofiles: no profile named '#{a}'"
  elsif !BSProfiles.valid_name?(b)
    respond "bsprofiles: '#{b}' is not a valid file name."
  elsif BSProfiles.exist?(b)
    respond "bsprofiles: '#{b}' already exists."
  else
    if cmd == 'copy'
      FileUtils.cp(BSProfiles.path(a), BSProfiles.path(b))
    else
      FileUtils.mv(BSProfiles.path(a), BSProfiles.path(b))
    end
    respond "bsprofiles: #{cmd == 'copy' ? 'copied' : 'renamed'} '#{a}' to '#{b}'"
  end
when 'delete', 'remove'
  name = rest.sub(/\s+confirm\z/i, '').strip
  if name.empty?
    respond 'bsprofiles: name required.'
  elsif !BSProfiles.exist?(name)
    respond "bsprofiles: no profile named '#{name}'"
  elsif rest !~ /\s+confirm\z/i
    respond "bsprofiles: this deletes #{BSProfiles.path(name)}. Run: ;bsprofiles delete #{name} confirm"
  else
    File.delete(BSProfiles.path(name))
    respond "bsprofiles: deleted '#{name}'"
  end
when 'apply', 'load'
  rest.empty? ? respond('bsprofiles: name required.') : BSProfiles.apply(rest)
else
  BSProfiles.help
end
