    def render_footer(ui, save)
      setup = self
      ui.divider(key: 'footer-div')
      ui.columns(key: 'footer', count: 3, weights: [5, 1, 1], compact: true, row_align: :center, margin: 6) do
        ui.text(slot: '0', key: 'footer-text', wrap: true, content: 'Save & Close saves your settings. Cancel or closing the window discards your changes.')
        ui.button(slot: '1', key: 'cancel', label: 'Cancel', tooltip: 'Close this window without saving.', on: { activate: ->(_ev) { setup.cancel } })
        save.call(ui, slot: '2', variant: :primary, tooltip: 'Save the settings to your ebounty profile and close this window.')
      end
