      ui.group(key: 'escort-travel', label: 'Travel Preferences') do
        ui.columns(key: 'escort-head', count: count, gap: 4, compact: true) do
          ui.text(slot: '0', key: 'escort-corner', content: 'Start From / Destination', emphasis: :strong, wrap: true)
          ESCORT_TOWNS.each_with_index do |(_, label), column|
            ui.text(slot: (column + 1).to_s, key: "escort-to-#{column}", content: label, emphasis: :strong)
          end
        end
        ESCORT_TOWNS.each do |from, from_label|
          ui.columns(key: "escort-row-#{from}", count: count, gap: 4, compact: true, row_align: :center) do
            ui.text(slot: '0', key: "escort-from-#{from}", content: from_label, emphasis: :strong)
            ESCORT_TOWNS.each_with_index do |(to, to_label), column|
              if from == to
                ui.text(slot: (column + 1).to_s, key: "escort-same-#{from}", content: '--')
              else
                setup.control(ui, setup.member_key(:escort_types, "#{from}_to_#{to}"), slot: (column + 1).to_s, label: '', tooltip: "#{from_label} to #{to_label}")
              end
            end
          end
        end
      end
      render_command_group(ui, 'escort-pre', 'Pre-Escort', [[:escort_prep_commands, 'Pre-Escort Commands:'], [:escort_prep_scripts, 'Active Escort Scripts:']])
      render_command_group(ui, 'escort-post', 'Post-Escort', [[:escort_post_commands, 'Post-Escort Commands:'], [:escort_post_scripts, 'Post-Escort Scripts:']])
    end

