=end

lich_gem_requires = Script.list.find { |x| x.name == Script.current.name }.inspect[/required: Lich >= (\d+\.\d+\.\d+)/i, 1]

if Gem::Version.new(LICH_VERSION) < Gem::Version.new(lich_gem_requires)
  if $frontend == 'stormfront' || $frontend == 'profanity'
    _respond "\<preset id=\"speech\"\>" + "########################################" + "\<\/preset\>"
    _respond "\<preset id=\"thought\"\>" + "Script:#{script.name} now requires a newer version of Lich(#{lich_gem_requires}+) to run." + "\<\/preset\>"
    _respond "\<preset id=\"thought\"\>" + "Please update to a newer version." + "\<\/preset\>"
    _respond ""
    _respond "\<preset id=\"thought\"\>" + "Currently Running Lich Version: #{Gem::Version.new(LICH_VERSION)}" + "\<\/preset\>"
    _respond "\<preset id=\"thought\"\>" + "For help updating visit: https://gswiki.play.net/Lich_(software)/Installation" + "\<\/preset\>"
    _respond "\<preset id=\"speech\"\>" + "########################################" + "\<\/preset\>"
  else
    _respond "##" + "########################################"
    _respond ">" + "Script:#{script.name} now requires a newer version of Lich(#{lich_gem_requires}+) to run."
    _respond ">" + "Please update to a newer version."
    _respond ">" + ""
    _respond ">" + "Currently Running Lich Version: #{Gem::Version.new(LICH_VERSION)}"
    _respond ">" + "For help updating visit: https://gswiki.play.net/Lich_(software)/Installation"
    _respond "##" + "########################################"
  end
  exit
end

require 'yaml'
require 'terminal-table'

module EBounty
  @@data ||= nil

  ##### Data & Setup Start #####
  def self.help
    rows = []
    rows << ["#{$lich_char}#{Script.current.name}", "Starts hunting/collecting bounties using saved settings"]
    rows << ["#{$lich_char}#{Script.current.name} once", "Single run with full features enabled, exits after one bounty"]
    rows << ["#{$lich_char}#{Script.current.name} basic", "Single run with just the basics enabled"]
    rows << ["#{$lich_char}#{Script.current.name} setup", "UI configuration tool"]
    rows << ["#{$lich_char}#{Script.current.name} settings <key> <value>", "Updates a single setting directly, without opening the UI"]
    rows << ["#{$lich_char}#{Script.current.name} settings help", "Shows the CLI syntax for each setting value type"]
    rows << ["#{$lich_char}#{Script.current.name} remove", "Removes current bounty"]
    rows << ["#{$lich_char}#{Script.current.name} forage", "Forages requested herbs"]
    rows << ["#{$lich_char}#{Script.current.name} load", "Reloads all settings"]
    rows << ["#{$lich_char}#{Script.current.name} list", "Lists all settings"]
    rows << ["#{$lich_char}#{Script.current.name} location", "Lists the current bounty location"]
    rows << ["#{$lich_char}#{Script.current.name} creature", "Lists the current bounty creature"]
    rows << ["#{$lich_char}#{Script.current.name} bounty", "Lists the current bounty"]
    rows << ["#{$lich_char}#{Script.current.name} debug", "Toggles debug output on/off"]
    rows << ["#{$lich_char}#{Script.current.name} test", "Displays script version and a raw settings dump"]
    rows << ["#{$lich_char}#{Script.current.name} version", "Displays the current script version"]
    rows << [{ value: ' ', colspan: 2, alignment: :center }]
    rows << [{ value: "#{Script.current.name.capitalize} requires Bigshot", colspan: 2, alignment: :center }]
    rows << [{ value: 'Review each tab for options', colspan: 2, alignment: :center }]

    table = Terminal::Table.new :title => "#{Script.current.name.capitalize} Help", :rows => rows
    respond
    respond table
    respond
  end

  def self.settings_cli_notice
    EBounty.msg("info", " The setup window is not available. Please use CLI to change options")
    EBounty.msg("info", " Format is #{$lich_char}#{Script.current.name} settings <setting_to_change> <new_value>")
    EBounty.msg("info", " For list/array setting syntax #{$lich_char}#{Script.current.name} settings help")
  end

  def self.settings_help
    rows = []
    rows << [{ value: 'Setting types and CLI syntax for', colspan: 2, alignment: :center }]
    rows << [{ value: "#{$lich_char}#{Script.current.name} settings <key> <value>", colspan: 2, alignment: :center }]
    rows << [{ value: ' ', colspan: 2, alignment: :center }]
    rows << ["#{$lich_char}#{Script.current.name} settings skip_healing true", "Boolean: on/true/yes or off/false/no (lowercase)"]
    rows << ["#{$lich_char}#{Script.current.name} settings culling_max 30", "Integer: a whole number"]
    rows << ["#{$lich_char}#{Script.current.name} settings wander_wait 1.5", "Float: a decimal number"]
    rows << ["#{$lich_char}#{Script.current.name} settings bounty_types culling gem_collecting", "Array: space-separated values, replaces the full list"]
    rows << ["#{$lich_char}#{Script.current.name} settings selling_script eloot", "String: remaining words are joined with a single space"]
    rows << [{ value: ' ', colspan: 2, alignment: :center }]
    rows << [{ value: 'Some String settings (resting rooms, bad rooms, locations) store', colspan: 2, alignment: :center }]
    rows << [{ value: 'comma-separated values. Quote the whole value as one argument', colspan: 2, alignment: :center }]
    rows << [{ value: 'to preserve the commas instead of joining values with spaces:', colspan: 2, alignment: :center }]
    rows << ["#{$lich_char}#{Script.current.name} settings zul_resting \"1005, 5751\"", "Preserves the commas as a single value"]
    rows << [{ value: ' ', colspan: 2, alignment: :center }]
    rows << [{ value: "Use #{$lich_char}#{Script.current.name} list to see each setting's current value", colspan: 2, alignment: :center }]
    rows << [{ value: "and to confirm which type it expects.", colspan: 2, alignment: :center }]

    table = Terminal::Table.new :title => "#{Script.current.name.capitalize} Settings Syntax Help", :rows => rows
    respond
    respond table
    respond
  end

  def self.load_defaults
    default_hash = {
      :bounty_types    => ["boss_culling", "culling", "gem_collecting", "heirloom_loot", "skinning"],
      :selling_script  => "",
      :default_profile => ""
    }
    Dir.mkdir("#{$data_dir}#{XMLData.game}") unless File.exist?("#{$data_dir}#{XMLData.game}")
    Dir.mkdir("#{$data_dir}#{XMLData.game}/#{Char.name}") unless File.exist?("#{$data_dir}#{XMLData.game}/#{Char.name}")
    Dir.mkdir("#{$data_dir}#{XMLData.game}/#{Char.name}/bigshot_profiles") unless File.exist?("#{$data_dir}#{XMLData.game}/#{Char.name}/bigshot_profiles")

    File.write("#{$data_dir}#{XMLData.game}/#{Char.name}/ebounty.yaml", default_hash.to_yaml)

    default_hash
  end

  def self.load_default_profile
    profile = File.join(EBounty.data.dir, "#{EBounty.data.settings[:default_profile]}.yaml")
    UserVars.op = YAML.load_file(profile)
  end

  def self.load_profile
    filename = File.join(DATA_DIR, XMLData.game, Char.name, "ebounty.yaml")

    if File.exist?("#{filename}")
      settings_hash = YAML.load_file(filename)
    elsif !File.exist?("#{filename}")
      EBounty.msg("info", " No current settings found.  Loading defaults for configurtion.")
      EBounty.msg("info", " Suggest you configure to your needs with ;ebounty setup")
      settings_hash = EBounty.load_defaults()
    end

    settings_hash
  end

  def self.save_profile(settings)
    filename = File.join(DATA_DIR, XMLData.game, Char.name, "ebounty.yaml")
    File.write(filename, settings.to_yaml)
    EBounty.msg("info", " Settings saved to file: #{filename}.")
  end

  def self.load(settings)
    @@data = Data.new(settings)
  end

  def self.update_setting(input)
    setting_to_update = normalize_setting_name(input.first)
    EBounty.msg("debug", "Normalized #{input.first} as #{setting_to_update}") unless setting_to_update =~ /debug/
    settings = EBounty.load_profile

    if settings.keys.include?(setting_to_update)
      default_value = settings[setting_to_update].dup
      EBounty.msg("debug", "recognized #{setting_to_update} as as valid #{default_value.class} setting") unless setting_to_update =~ /debug/
      new_value = coerce_setting_value(setting_to_update, default_value, input[1..-1])
      EBounty.msg("debug", "Normalized #{input[1..-1]} as #{new_value.inspect}") unless setting_to_update =~ /debug/

      settings[setting_to_update] = new_value
      EBounty.msg("info", " Updated #{setting_to_update} to #{new_value}")

      EBounty.save_profile(settings)
    else
      EBounty.msg("error", " #{setting_to_update} is not a recognized setting. Recognized setting names:")
      EBounty.msg("error", EBounty.data.settings.keys.sort.join("\n"))
    end
  end

  def self.coerce_setting_value(setting_name, default, input)
    case default
    when TrueClass, FalseClass
      fix_option = { 'on' => true, 'true' => true, 'yes' => true, 'off' => false, 'false' => false, 'no' => false }
      fix_option.fetch(input[0]) do |v|
        EBounty.msg("error", %{Expected a boolean (true/false/yes/no) value for "#{setting_name} but got "#{v}"})
        exit
      end
    when Array
      input
    when Integer
      v = input[0]
      if v =~ /\A[+-]?\d+\z/
        v.to_i
      else
        EBounty.msg("error", %{Expected an integer value for #{setting_name} value but got "#{v}"})
        exit
      end
    when Float
      v = input[0]
      if v =~ /\A[+-]?\d+(?:\.\d+)?\z/
        v.to_f
      else
        EBounty.msg("error", %{Expected a decimal value for #{setting_name} value but got "#{v}"})
        exit
      end
    when String
      input.join(" ")
    else
      EBounty.msg("error", "Recognized #{setting_name} but don't know how to normalize a #{default.class} type setting")
      exit
    end
  end

  def self.normalize_setting_name(input)
    input.downcase.tr('-', '_').to_sym
  end

  def self.bounty_change(original_checkbounty)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")
    end_wait = Time.now + 3

    until Time.now > end_wait
      return true if checkbounty != original_checkbounty
      sleep 0.2
    end

    return false
  end

  def self.change_stance(new_stance)
    return if Effects::Debuffs.active?("Frenzy") || dead?
    return if percentstance == new_stance
    return if new_stance == 100 && percentstance(80)

    stances = {
      0   => 'offensive',
      20  => 'advanced',
      40  => 'forward',
      60  => 'neutral',
      80  => 'guarded',
      100 => 'defensive'
    }

    if CMan.available?('Stance Perfection') && ![0, 20, 40, 60, 80, 100].include?(new_stance)
      cmd = "cman stance #{new_stance}"
    elsif stances[new_stance]
      cmd = "stance #{stances[new_stance]}"
    else
      cmd = 'stance defensive'
    end

    expiry = Time.now + 2
    while percentstance != new_stance
      res = dothistimeout(cmd, 2, /You are now|You move into|Roundtime|wait|Your rage causes you/i)
      if res =~ /Roundtime: (\d+)|wait (\d+)/i
        sleep((Regexp.last_match(1) || Regexp.last_match(2)).strip.to_f - 1)
        expiry = Time.now + 2
      elsif Time.now > expiry
        break
      else
        break
      end
      sleep 0.5
    end
  end

  def self.check_exp(need_percent = false)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

    if need_percent
      return Lich::Gemstone::Experience.percent_fxp
    end

    # how saturated are we?
    extra_exp = [Lich::Gemstone::Experience.fxp_current - Lich::Gemstone::Experience.fxp_max, 0].max

    # estimated absorption per pulse = 25 + log/5 + 2(supernode) + Lich::Gemstone::Experience.fxp_current/200(max 10) + 1(grouped)
    absorption = 25 + (Stats.enhanced_log[1] / 5) + 2 + [Lich::Gemstone::Experience.fxp_current / 200, 10].min + 1

    # estimated time to must rest in minutes = (extra_exp / absorption) * 2 mintes per pulse, round down? divided by 60 sec per minute
    return ((extra_exp / absorption) * 120) / 60
  end

  def self.check_health
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

    return if EBounty.data.settings[:skip_healing]

    if XMLData.injuries.any? { |_a, h| h['wound'] > 0 || h['scar'] > 1 } || (Char.percent_health < 95 && (Char.health + 7) < Char.max_health)
      Script.run(EBounty.data.healing_script)
    end
  end

  def self.over_watch
    # No need to run this if its just the basics
    return if EBounty.data.settings[:basic]

    current_script = Script.current.name
    ebo_vars = Script.current.vars[1]

    unless EBounty.data.settings[:death_script].to_s.empty?
      eof_string = <<-EOF
        while running?("#{current_script}")
          # Handle character death and try to recover
          if dead?
            stop_script("bigshot") if Script.running?("bigshot")
            stop_script("go2") if Script.running?("go2")
            stop_script("#{current_script}")

            EBounty.run_scripts(EBounty.data.settings[:death_script])
            start_script("#{current_script}", ["#{ebo_vars}"])
            Script.self.kill
          end

          sleep(1)
        end

        Script.self.kill
      EOF

      start_exec_script(eof_string, { :quiet => true, :name => 'ebo_watch' });
    else
      Thread.new { loop { Script.self.kill if dead?; sleep(5); } }
    end

    Thread.new do
      loop do
        if Script.running?("bigshot") && checkbounty =~ /suppress bandit activity/ && !$bigshot_bandits
          $bigshot_bandits = true
        end

        sleep(5)
      end
    end
  end

  def self.data
    @@data
  end

  def self.duration(elapsed)
    rest, secs = elapsed.divmod(60)
    rest, mins = rest.divmod(60)
    days, hours = rest.divmod(24)

    result = []
    result << "#{days} Days" if days > 0
    result << "#{hours} Hours" if hours > 0
    result << "#{mins} Minutes" if mins > 0
    result << "#{secs.round(0)} Seconds" if secs > 0
    return " #{result.join(' ')}"
  end

  def self.elapsed
    elapsed = Time.now - EBounty.data.elapsed_time
    duration(elapsed)
  end

  def self.exit_script
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")
    before_dying { sleep 0.5 }
    exit
  end

  def self.mana_pulse(spell_id)
    return unless Spell[spell_id].known? && !Spell[spell_id].affordable?

    mana_regex = Regexp.union(
      /An invigorating rush of mana pulses through you/i,
      /You are too mentally fatigued to attempt this ability/i,
      /You're already at full mana./i,
      /Your mana control skills are not yet advanced/i,
    )

    EBounty.get_res("mana pulse", mana_regex)
    sleep 0.2
  end

  def self.fog_return_spirit(from_voln = false)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | from_voln: #{from_voln}")

    current_room = Room.current.id
    EBounty.mana_pulse(130)
    if Spell[130].known? && Spell[130].affordable?
      Spell[130].cast()
      sleep 0.5
      waitcastrt?
      if Room.current.id == 2635 && UserVars.op['fog_rift'] && UserVars.op['resting_room_id'].to_i != 2635 && current_room != Room.current.id
        EBounty.mana_pulse(130)

        Spell[130].cast() if Spell[130].known? && Spell[130].affordable?
        sleep 0.5
        waitcastrt?
      end
    end

    # Something went wrong and 130 didn't work. Trying symbol of return
    if current_room == Room.current.id && Spell[9825].known? && !from_voln
      EBounty.fog_return_voln(true)
    end
  end

  def self.fog_return_voln(from_130 = false)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | from_130: #{from_130}")

    current_room = Room.current.id
    if Spell[9825].known?
      fput 'symbol of return'
      sleep(0.5)

      if current_room != Room.current.id && Room.current.id == 2635 && UserVars.op['fog_rift'] && UserVars.op['resting_room_id'].to_i != 2635
        fput 'symbol of return'
        sleep 0.5
      end
    end

    # Something went wrong and sym of return didn't work. Trying 130
    if current_room == Room.current.id && Spell[130].known? && !from_130
      EBounty.fog_return_spirit(true)
    end
  end

  def self.fog
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

    return if UserVars.op['fog_return'].to_i.zero?
    return if UserVars.op['fog_optional'] && $rest_reason !~ /wounded|encumbered/

    sleep(0.5)
    waitcastrt?
    waitrt?

    case UserVars.op['fog_return'].to_i
    when 1 # Spirit Guide(130)
      EBounty.fog_return_spirit
    when 2 # Symbol of Return
      EBounty.fog_return_voln
    when 3 # Travelers Song(1020)
      EBounty.mana_pulse(1020)
      sleep(0.2)
      Spell[1020].cast() if Spell[1020].known? && Spell[1020].affordable?
    when 4 # GoS - Sigil of Escape
      if Spell[9720].known? && Spell[9720].affordable?
        Spell[9720].cast()
        sleep(0.5)
        waitcastrt?
        waitrt?
      end
    when 5 # Familiar Gate
      EBounty.mana_pulse(930)

      if Spell[930].known? && Spell[930].affordable?
        Spell[930].cast()
        fput 'go portal'
        sleep(0.5)
        waitcastrt?
        waitrt?
      end
    end
  end

  def self.get_command(command, regex, silent: nil, quiet: false)
    lines = []
    regex = Regexp.union(regex, /(?:Roundtime:|\.\.\.wait) (\d+) [Ss]ec(?:onds)?\./)

    loop do
      lines = Lich::Util.issue_command(command, regex, silent: silent, quiet: quiet)
      EBounty.msg("debug", "#{__method__} | caller: #{caller[0]} | command: #{command} | lines: #{lines}")

      if lines.any? { |line| line.match?(/(?:Roundtime:|\.\.\.wait) (\d+) [Ss]ec(?:onds)?\./i) }
        waitrt?
        next
      end

      break
    end

    return lines
  end

  def self.get_res(command, regex)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

    regex = Regexp.union(regex, /(?:Roundtime:|\.\.\.wait) (\d+) [Ss]ec(?:onds)?\./i)
    result = nil

    loop do
      result = dothistimeout(command, 3, regex)

      if result.match?(/(?:Roundtime:|\.\.\.wait) (\d+) [Ss]ec(?:onds)?\./i)
        waitrt?
        next
      end

      break
    end

    return result
  end

  def self.get_script_version
    data = Script.list.find { |x| x.name == Script.current.name }.inspect
    return data[/version: (\d+\.\d+\.\d+)/i, 1]
  end

  def self.open_container(container)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | container: #{container.inspect}")

    return if GameObj.containers.keys.include?(container.id) && container.contents.is_a?(Array)
    return if container.name =~ /keyring/

    # Look before opening. An open container answers with its contents, so it
    # never gets an OPEN and can't end up on the close list. Custom open/close
    # messages vary too much to trust, so the only proof we opened something
    # is LOOK IN saying it was closed and OPEN not saying it was already open.
    id = container.id
    shown_regex = /In the <a exist="#{id}"|This <a exist="#{id}"[^>]*>.*?<\/a>.*?inside|There is nothing in there/
    look_regex = Regexp.union(shown_regex, /<exposeContainer id=['"]#{id}['"]|<container id=['"]#{id}['"]|\bis closed\b/i)
    lines = EBounty.get_command("look in ##{id}", look_regex, silent: true, quiet: true)
    EBounty.msg("debug", " open_container: look in ##{id} lines - #{lines}")
    return if lines.any? { |l| l =~ shown_regex }

    was_closed = lines.any? { |l| l =~ /\bis closed\b/i }
    not_opened_regex = /\bis (?:already open|open already)\b|There doesn't seem to be any way to do that|You can't do that|You must remove|What were you referring to|I could not find/i
    lines = EBounty.get_command("open ##{id}", Regexp.union(not_opened_regex, /exist="#{id}"|<exposeContainer|^You\b/i), silent: true, quiet: true)
    EBounty.msg("debug", " open_container: open ##{id} lines - #{lines}")
    opened = was_closed && lines.none? { |l| l =~ not_opened_regex }

    # Refresh what's inside so later steps can see the contents.
    EBounty.get_command("look in ##{id}", look_regex, silent: true, quiet: true)
    20.times {
      break if GameObj.containers.keys.include?(id) && container.contents.is_a?(Array)

      sleep 0.1
    }

    # We opened it, so close it again before the script dies
    EBounty.data.close_containers.push(id) if opened && !EBounty.data.close_containers.include?(id)
  end

  def self.regroup
    return if EBounty.data.settings[:leader].to_s.empty? || EBounty.data.settings[:leader] == "Self"
    return unless checkpcs.include?(EBounty.data.settings[:leader])
    return if Lich::Gemstone::Group.leader.to_s == EBounty.data.settings[:leader]

    dothistimeout("join #{EBounty.data.settings[:leader]}", 3, /You are already a member|You join|What were you referring to/)
    EBounty.data.settings[:leader] = ''
  end

  def self.set_variables(load_profile: true)
    EBounty.data.elapsed_time = Time.now

    unless EBounty.data.settings[:basic] || !load_profile
      # Check if a default profile was selected
      if EBounty.data.settings[:default_profile].to_s.empty?
        EBounty.msg "error", 'Please select a Gem/Default profile in "Profiles" tab. Ebounty needs this to work right.'
        EBounty.exit_script
      end

      # Load the default profile
      EBounty.load_default_profile
    end

    # Make sure StowList is populated
    StowList.check(silent: true, quiet: true) unless StowList.checked?

    EBounty.data.containers = []
    exist = %r{<a exist=(?:'|")(?<id>.*?)(?:'|") noun=(?:'|")(?<noun>.*?)(?:'|")>(?<name>.*?)</a>}
    lines = Lich::Util.quiet_command_xml("inventory containers", /You are (wearing|holding)/)
    lines.delete_if { |l| l =~ /You are holding/ }
    lines.each do |line|
      line.scan(exist).each do |matches|
        EBounty.data.containers << GameObj.new(*matches) unless EBounty.data.containers.any? { |sack| sack.id == GameObj.new(*matches).id }
      end
    end
  end

  def self.run_scripts(scripts)
    scripts.split(/,\s*/).each do |i|
      tokens = i.split(/\s+/)
      if (tokens.size > 1)
        Script.run(tokens[0], tokens[1..-1].join(" "))
      else
        Script.run(tokens[0])
      end
    end
  end

  def self.msg(type = info, text)
    # color options - set type to use
    # yellow, orange, teal, green, plain

    return if type == "debug" && !EBounty.data.settings[:debug]

    if text.class == Hash
      text = text.inspect.gsub("#<", "#")
    elsif text.class == Array
      text = text.to_s
    elsif text.class == String
      text = text.gsub("#<", "#")
    end

    type = type == "debug" ? "speech" : type

    Lich::Messaging.msg(type, text)
  end

  def self.switch_profile(creature = nil)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | creature: #{creature}")

    EBounty.data.creature = creature
    profile_letter = nil

    options = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]

    # Check for full name first
    options.each { |letter| profile_letter = letter if EBounty.data.settings["names_#{letter}".to_sym] =~ /#{creature}/i }

    if profile_letter != nil
      EBounty.data.settings[:only_required_creatures] = EBounty.data.settings["kill_#{profile_letter}".to_sym] ? true : false
      profile = File.join(EBounty.data.dir, "#{EBounty.data.settings["profile_#{profile_letter}".to_sym]}.yaml")
      UserVars.op = YAML.load_file(profile)
    elsif creature == "bandits" && !EBounty.data.settings[:bandits_profile].to_s.empty?
      EBounty.data.settings[:only_required_creatures] = EBounty.data.settings[:kill_bandits] ? true : false
      profile = File.join(EBounty.data.dir, "#{EBounty.data.settings[:bandits_profile]}.yaml")
      UserVars.op = YAML.load_file(profile)
    elsif EBounty.data.settings[:keep_hunting]
      Hunting.keep_hunting
    else
      EBounty.go2_rest
      EBounty.msg "info", " No Profile found for #{creature}. Please check the Profiles tab. Exiting..."
      EBounty.exit_script
    end
  end

  def self.test
    echo " Ebounty Version: #{EBounty.get_script_version}"
    echo ""
    echo "--------------- Settings ---------------"
    EBounty.data.settings.each { |item| echo item }
    echo "----------------------------------------"
    echo ""
  end

  def self.go2(place)
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | place: #{place}")

    fput('unhide') if (hidden? || invisible?)

    return if Room.current.id == place.to_i || Room.current.tags.include?(place)

    if Room.current.id.nil?
      if EBounty.data.settings[:debug]
        EBounty.msg "info", "unknown room location: hope you know what you're doing"
      else
        EBounty.msg "error", 'unknown room location'
      end
    end
    Script.run('go2', "#{place} --disable-confirm", { quiet: true })
  end

  def self.go2_rest
    town_uid = "u#{Room[Room.current.find_nearest_by_tag("town")].uid.first}"
    current_room = Room.current.id.to_s

    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | town_id: #{town_uid}")

    if EBounty.data.settings[:bigshot_rest]
      where_to = EBounty.uid_match(UserVars.op['resting_room_id'])
    elsif EBounty.data.settings[:custom_rest]
      where_to = EBounty.data.settings[:resting_room].include?(current_room) ? current_room : EBounty.data.settings[:resting_room].sample
    elsif EBounty.data.settings[:rest_random]
      where_to = EBounty.data.resting_spots[town_uid].include?(current_room) ? current_room : EBounty.data.resting_spots[town_uid].sample
    elsif EBounty.data.settings[:table_rest]
      where_to = 'table'
    elsif EBounty.data.settings[:use_script]
      where_to = 'script'
      EBounty.run_scripts(EBounty.data.settings[:use_script_name])
    elsif XMLData.game == "GSF"
      where_to = 'nexus'
    else
      where_to = town_uid
    end

    # getting reports of where_to being nil for some reason
    where_to = where_to.nil? ? town_uid : where_to

    EBounty.msg("debug", "go2_rest | current room: #{current_room} | where_to: #{where_to}")

    EBounty.go2(where_to) unless where_to == 'script'

    if where_to == 'table'
      fput 'go table'
    end

    EBounty.wait_rt

    if EBounty.data.settings[:join_player]
      EBounty.data.settings[:join_list].split(',').each { |pc|
        if checkpcs.include?(pc)
          fput "join #{pc}"
          break
        end
      }
    end

    if EBounty.data.settings[:use_buff_script]
      EBounty.run_scripts(EBounty.data.settings[:buff_script])
    end
  end

  def self.silver_check
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")
    return Lich::Util.silver_count
  end

  def self.silver_deposit
    EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

    silvers = EBounty.silver_check

    return unless silvers.positive?

    keep_silver = defined?(ELoot) ? ELoot.data.settings[:sell_keep_silver].to_i : 0

    return if (silvers - keep_silver).zero?

    EBounty.go2('bank')

    if silvers > keep_silver
      amount = silvers - keep_silver
      fput("deposit #{amount}")
    elsif silvers < keep_silver
      amount = keep_silver - silvers
      fput("withdrawl #{amount}")
    end
  end

  def self.uid_match(room)
    uid_pattern = /u(?<uid>\d+)/
    if (m = uid_pattern.match(room))
      uid = m[:uid].to_i
      lookup_id = Map.ids_from_uid(uid)
      if lookup_id.size > 0
        room = lookup_id[0]
      else
        echo "Not able to find #{room} in the map database! Exiting..."
        EBounty.exit_script
      end
    end
    return room.to_i
  end

  def self.wait_rt
    sleep 0.2
    waitcastrt?
    waitrt?
    sleep 0.2
  end

  ##### Data & Setup End #####

  # Global data used by EBounty
  class Data
    attr_accessor :settings, :reason, :rest_time, :rest_options, :hunting_spots, :herbalist_rooms, :remaining_skins, :skin, :remaining_gems, :gem, :dir,
                  :creature, :sacks, :start_room, :location_start, :location_boundaries, :guard_regex, :forage_result, :forage_injury, :elapsed_time, :bundle_skin,
                  :close_containers, :containers, :gambits_available, :get_regex, :put_regex, :bad_rooms, :loot_script, :healing_script, :crosswalk, :reject_bounties,
                  :bounty_towns_uid, :escort_script, :rescue_script, :furrier_names, :jeweler_names, :herbalist_names, :info_time, :converted, :complete_mind,
                  :boost_type, :taskmaster_responses, :resting_spots, :leader

    def initialize(settings)
      @settings = settings
      @settings[:gems] ||= {}
      @leader = ''
      @elapsed_time = Time.now
      @reason = ''
      @rest_time = Time.now
      @info_time = Time.now
      @sacks = {}
      @containers = []
      @converted = 0
      @complete_mind = 0
      @rest_options = ["experience", "inventory", "health", "resources", "info"]
      @get_regex = /^You (?:shield the opening of .*? from view as you |discreetly |carefully |deftly )?(?:remove|draw|grab|reach|slip|tuck|retrieve|already have|unsheathe|detach|swap)|^Get what\?$|^Why don't you leave some for others\?$|^You need a free hand|^You already have that/
      @put_regex = /^You (?:put|(?:discreetly )?tuck|attach|toss|attempt to shield your|place|.* place|slip|wipe off the blade and sheathe|absent-mindedly drop|carefully add|find an incomplete bundle|untie your drawstring pouch)|^The .+ is already a bundle|^Your bundle would be too large if you if you tried to add that|^The .+ is too large to be bundled\.|^As you place your .+ inside your .+, you notice another .+ inside the .+ and carefully arrange the two .+ into a neat bundle\.|If you wish to continue, throw the item away again within fifteen seconds|you feel pleased with yourself at having cleaned up the surrounding area|over your shoulder|two items in that location|wear three functional items|^Your .*? won't fit in .*?\.$/

      @loot_script = @settings[:selling_script].to_s.empty? ? 'eloot' : @settings[:selling_script]
      @healing_script = @settings[:healing_script].to_s.empty? ? 'eherbs' : @settings[:healing_script]
      @escort_script = @settings[:escort_script].to_s.empty? ? 'escortgo2' : @settings[:escort_script]
      @rescue_script = @settings[:rescue_script].to_s.empty? ? 'echild' : @settings[:rescue_script]

      @crosswalk = {
        :bandit_assignment   => "kill_bandits",
        :bandit              => "kill_bandits",
        :creature_assignment => "kill_creatures",
        :cull                => "culling",
        :dangerous           => "boss_culling",
        :escort              => "escort",
        :gem_assignment      => "gem_collecting",
        :gem                 => "gem_collecting",
        :heirloom_assignment => "heirloom_both",
        :heirloom            => "heirloom_both",
        :herb_assignment     => "foraging",
        :herb                => "foraging",
        :rescue_assignment   => "rescue",
        :rescue              => "rescue",
        :skin_assignment     => "skinning",
        :skin                => "skinning"
      }

      @reject_bounties = ["boss_culling", "culling", "heirloom_loot", "skinning", "heirloom_search", "foraging", "rescue", "escort", "kill_bandits", "gem_collecting"] - @settings[:bounty_types]

      @taskmaster_responses = Regexp.union(
        /The local gem dealer, .*, has an order to fill and wants our help./,
        /The local furrier .* has an order to fill and wants our help./,
        /It appears they have a .* problem they'd like you to solve./,
        /It appears that a local resident urgently needs our help in some matter.  Go report to .* to find out more./,
        /The local (healer|herbalist), .*, has asked for our aid./,
        /You have already been assigned a task, \w+./,
        /It appears they need your help in tracking down some kind of lost heirloom.  Go report to .* to find out more./,
        /Come back in about .* (?:minute|minutes) if you want another task./,
        /I have removed you from your current assignment/,
        /Who are you trying to ask/
      )

      @furrier_names = Regexp.union(
        /Bramblefist/i,
        /Delosa/i,
        /dwarven clerk/i,
        /furrier/i,
        /patchwork flesh merchant/i
      )

      @jeweler_names = Regexp.union(
        /areacne/i,
        /Brindlestoat/i,
        /dwarven clerk/i,
        /gem dealer/i,
        /jeweler/i,
        /plump purple-robed trader/i,
        /Zirconia/i
      )

      @herbalist_names = Regexp.union(
        /Akrash/i,
        /alchemist/i,
        /brother Barnstel/i,
        /famed baker Leaftoe/i,
        /healer/i,
        /herbalist/i,
        /Libram Greenleaf/i,
        /Maraene/i,
        /merchant Kelph/i,
        /old Mistress Lomara/i,
        /scarred Agarnil kris/i,
        /Sparkfinger/i,
        /spectral quartermaster/i
      )

      herbalist_rooms_uid = [
        'u4043601',    # Icemule Trace
        'u1015',       # Wehnimer's Landing
        'u3003056',    # Kharam-Dzu
        'u14103400',   # Ta'Vaalor
        'u13104200',   # Ta'Illistim
        'u4740011',    # Solhaven
        'u2101052',    # River's Rest
        'u13010004',   # Zul Logoth
        'u7118358',    # Kraken's Fall
        'u7503253',    # Hinterwilds
        'u3201291',    # Mist Harbor
        'u7150621',    # Sailor's Grief
      ]

      @herbalist_rooms = herbalist_rooms_uid.map { |uid| Room[uid].id }.select(&:positive?)

      if @settings[:location1].empty? && @settings[:bad_room1].empty?
        @settings[:location1] = "Whistler's Pass"
        @settings[:bad_room1] = "37,38,39,40,41"
      end

      if @settings[:location2].empty? && @settings[:bad_room2].empty?
        @settings[:location2] = "Widowmaker's Road"
        @settings[:bad_room2] = "30609,30610,30611,30613,30614,30615,30616,30617,30618,30619,30811,30817,28918,28919,28920,28921,28922,28923,28929,28930,28931,28932,28978,29078,29079,29081,29089"
      end

      if @settings[:location3].empty? && @settings[:bad_room3].empty?
        @settings[:location3] = "Old Logging Road"
        @settings[:bad_room3] = "12532,12533,14729,3548,3762,3763"
      end

      @bad_rooms = []
      x = 1
      while x < 13
        bad_room = "bad_room#{x}".to_sym
        unless @settings[bad_room].empty?
          @settings[bad_room].split(/,\s?/).each { |room|
            @bad_rooms.push(EBounty.uid_match(room))
          }
        end
        x += 1
      end

      @remaining_skins = 0
      @skin = nil
      @remaining_gems = 0
      @gem = nil
      @dir = File.join($data_dir, XMLData.game, Char.name, "bigshot_profiles")
      @creature = nil
      @start_room = nil
      @location_start = nil
      @location_boundaries = nil
      @bundle_skin = nil
      @close_containers = []
      @boost_type = nil

      @gambits_available = false
      if @settings[:forage_options].include?("use_gambit") && Stats.prof == "Rogue"
        lines = EBounty.get_command("gld", /<output class="mono"\/>/, silent: true, quiet: true)
        if lines.any? { |l| l =~ /[put {item} [IN|ON|UNDER|BEHIND] {container}]/ }
          @gambits_available = true
        end
      end

      @guard_regex = Regexp.union(
        /suppress bandit activity|bandits you encounter/,
        /particularly dangerous|cull their numbers|(?!.*bandit)suppress .* activity/,
        /SEARCH the area|do a thorough SEARCH/,
        /LOOT the item from its corpse/,
        /I don't have any tasks for you right now/,
        /Try bugging me later/,
        /Ah, so you have returned/,
        /You have completed your task/
      )

      @forage_result = Regexp.union(
        /^You begin to forage around when suddenly you feel a burning sensation in your hand\.$/,
        /^You begin to forage around when your hand comes into contact with something that stabs you in the finger\.$/,
        /^You forage/,
        /^You fumble about so badly in your search that you can only hope no one was watching you\.$/,
        /^You make so much noise that only the dead would not notice you thrashing about in your unsuccessful search\.$/,
        /^You stumble about in a fruitless attempt at foraging\.$/,
        /you are unable to find anything useful/,
        /^As you carefully forage around you (?:can find no (?:hint|trace)|see no evidence) of what you are looking for(?: right now, though you are fairly certain this is where it can be found)?\.(?:  You briefly wonder if it could even thrive in this place\.)?/,
        /^As you forage around you suddenly feel a sharp pain/,
      )

      @forage_injury = Regexp.union(
        /^You begin to forage around when your hand comes into contact with something that stabs you in the finger./,
        /^As you forage around you suddenly feel a sharp pain in your/,
        /suddenly you feel a burning sensation in your hand/
      )

      @bounty_towns_uid = {
        'Icemule Trace'      => 'u4042150',
        'Kharam-Dzu'         => 'u3001025',
        "Kraken's Fall"      => 'u7118221',
        'Mist Harbor'        => 'u3201029',
        "River's Rest"       => 'u2101008',
        'Solhaven'           => 'u4209030',
        'Vornavis'           => 'u4209030',
        "Ta'Illistim"        => 'u13100042',
        "Ta'Vaalor"          => 'u14100047',
        "Wehnimer's Landing" => 'u7120',
        'Zul Logoth'         => 'u13006016',
        'Cold River'         => 'u7503205',
        "Contempt"           => "#{XMLData.game.eql?('GSF') ? 'u7150607' : 'u7150608'}",
      }

      resting_keys = [
        :icemule_resting,
        :teras_resting,
        :kf_resting,
        :fwi_resting,
        :rr_resting,
        :solhaven_resting,
        :illy_resting,
        :vaalor_resting,
        :landing_resting,
        :zul_resting,
        :hw_resting,
        :contempt_resting
      ]

      # convert custom resting to an array
      @settings[:resting_room] = @settings[:resting_room].split(",").map(&:strip)

      # converts any uids to room ids
      resting_keys.each do |key|
        @settings[key] = @settings[key].split(',').map { |r| EBounty.uid_match(r).to_s }
      end

      @resting_spots = {
        "u4042150"  => @settings[:icemule_resting],     # Icemule Trace
        "u3001025"  => @settings[:teras_resting],       # Kharam Dzu
        "u7118221"  => @settings[:kf_resting],          # Kraken's Fall
        "u3201029"  => @settings[:fwi_resting],         # Mist Harbor
        "u2101008"  => @settings[:rr_resting],          # River's Rest
        "u4209030"  => @settings[:solhaven_resting],    # Solhaven
        "u13100042" => @settings[:illy_resting],        # Ta'llistim
        "u14100047" => @settings[:vaalor_resting],      # Ta'Vaalor
        "u7120"     => @settings[:landing_resting],     # Wehnimer's Landing
        "u13006016" => @settings[:zul_resting],         # Zul Logoth
        'u7503205'  => @settings[:hw_resting],          # Hinterwilds
      }
      if XMLData.game.eql?('GSF')
        @resting_spots['u7150607'] = @settings[:contempt_resting]  # Sailor's Grief Shattered
      else
        @resting_spots['u7150608'] = @settings[:contempt_resting]  # Sailor's Grief
      end
    end
  end

  # The setting catalog, the WebUI setup window, and `;ebounty list`. The window is a
  # Lich::WebUI::ListSettingsForm: Save & Close returns the edited settings, which
  # are saved to the profile; Cancel or closing the window discards them.
  class Setup
    attr_reader :settings

    # Lich keeps this class between runs in a session. Drop the old constants so an
    # updated script never renders with the ones from the version that ran first.
    constants(false).each { |name| remove_const(name) }

    PAGE_ID = 'ebounty-setup'
    TABS = %w[General Resting Foraging Heirloom Bandits Escort Exclusions Profiles].freeze

    # key => [max, step, digits]. Every spinner starts at zero.
    SPINS = {
      culling_max: [100, 1, 0],
      gem_max: [100, 1, 0],
      herb_max: [100, 1, 0],
      skin_max: [100, 1, 0],
      extra_skin: [100, 1, 0],
      wander_wait: [100, 0.1, 1]
    }.freeze

    # Checkboxes in one group: turning one on turns the others off.
    REST_CHOICES = %i[bigshot_rest custom_rest rest_random table_rest use_script].freeze
    EXCLUSIVE = { exp_pause: :hunting, keep_hunting: :hunting, **REST_CHOICES.to_h { |key| [key, :resting] } }.freeze

    BOUNTY_TYPES = [
      ['boss_culling', 'Boss Creature'], ['culling', 'Culling'], ['escort', 'Escort'], ['foraging', 'Foraging'], ['gem_collecting', 'Gem Collecting'],
      ['heirloom_loot', 'Heirloom (loot)'], ['heirloom_search', 'Heirloom (search)'], ['kill_bandits', 'Kill Bandits'], ['rescue', 'Rescue'], ['skinning', 'Skinning']
    ].freeze
    BOOST_TYPES = %w[Any Kill Heirloom Skin Gem Escort Herb Dangerous Child Bandit].freeze

    # Columns of [stored value, label, spell that enables it].
    FORAGE_OPTIONS = [
      [['run', 'Run from creatures'], ['hiding', 'Hide when foraging'], ['use_gambit', 'Rogue Gambits: Stealth'], ['use_resolve', 'Sigil of Resolve', 9704], ['use_709', 'Grasp of the Grave (709)', 709]],
      [['use_604', "Nature's Bounty (604)", 604], ['use_604evoke', "Nature's Bounty Evoke (604)", 604], ['use_608', 'Camouflage (608)', 608], ['use_619', 'Mass Calm (619)', 619], ['use_650', 'Assume Aspect (650) Yierka', 650]],
      [['use_506', 'Celerity (506)', 506], ['use_919', "Wizard's Shield (919)", 919]],
      [['use_140', 'Wall of Force (140)', 140], ['use_213', 'Minor Sanctuary (213)', 213], ['use_1011', 'Song of Peace (1011)', 1011], ['use_1035', 'Song of Tonis (1035)', 1035]]
    ].freeze
    HEIRLOOM_OPTIONS = [
      [['run', 'Run from creatures'], ['use_709', 'Grasp of the Grave (709)', 709], ['use_140', 'Wall of Force (140)', 140]],
      [['use_402', 'Presence (402)', 402], ['use_506', 'Celerity (506)', 506], ['use_919', "Wizard's Shield (919)", 919]],
      [['use_213', 'Minor Sanctuary (213)', 213], ['use_619', 'Mass Calm (619)', 619]],
      [['use_1011', 'Song of Peace (1011)', 1011], ['use_1035', 'Song of Tonis (1035)', 1035]]
    ].freeze

    RESTING_LEFT = [
      [:hw_resting, 'Hinter Wilds:'], [:icemule_resting, 'Icemule Trace:'], [:teras_resting, 'Kharam Dzu:'],
      [:kf_resting, "Kraken's Fall:"], [:fwi_resting, 'Mist Harbor:'], [:rr_resting, "River's Rest:"]
    ].freeze
    RESTING_RIGHT = [
      [:contempt_resting, "Sailor's Grief:"], [:solhaven_resting, 'Solhaven:'], [:illy_resting, "Ta'llistim:"],
      [:vaalor_resting, "Ta'Vaalor:"], [:landing_resting, "Wehnimer's Landing:"], [:zul_resting, 'Zul Logoth:']
    ].freeze

    ESCORT_TOWNS = [
      ['landing', "Wehnimer's"], ['solhaven', 'Solhaven'], ['icemule', 'Icemule'], ['zul', 'Zul Logoth'], ['illy', "Ta'llistim"], ['vaalor', "Ta'Vaalor"]
    ].freeze

    EXCLUSION_TIP = "Exclusions should be entered one line at a time. Regular expressions are supported."

    # Array settings shown as one checkbox per value.
    MEMBERS = {
      bounty_types: BOUNTY_TYPES,
      escort_types: ESCORT_TOWNS.product(ESCORT_TOWNS).reject { |(from, _), (to, _)| from == to }.map { |(from, _), (to, _)| ["#{from}_to_#{to}"] },
      forage_options: FORAGE_OPTIONS.flatten(1),
      heirloom_options: HEIRLOOM_OPTIONS.flatten(1) + [['use_right', 'Flag right hand (?)']]
    }.freeze
    # Array settings shown as an Add/Delete table.
    LISTS = %i[creature_exclude herb_exclude gem_exclude location_exclude].freeze
    # Profile dropdowns and the name setting each one also fills.
    PROFILES = { default_profile: :default_name, bandits_profile: :profile_name_bandits,
                 **('a'..'j').to_h { |letter| [:"profile_#{letter}", :"profile_name_#{letter}"] } }.freeze
    # Settings the window does not show.
    HIDDEN = ([:only_required_creatures] + PROFILES.values).freeze

    @@categories = {
      general: {
        bounty_types: { default: [] },
        escort_types: { default: [] },
        boost_type: { default: '' },
        forage_options: { default: [] },
        heirloom_options: { default: [] },
        creature_exclude: { default: [] },
        herb_exclude: { default: [] },
        gem_exclude: { default: [] },
        location_exclude: { default: [] },
        culling_max: { default: 30 },
        gem_max: { default: 30 },
        herb_max: { default: 30 },
        skin_max: { default: 30 },
        extra_skin: { default:  0 },
        exp_pause: { default: false },
        only_required_creatures: { default: false },
        use_boosts: { default: false },
        use_vouchers: { default: false },
        skip_healing: { default: false },
        remove_heirloom: { default: false },
        once_and_done: { default: false },
        new_bounty_on_exit: { default: false },
        keep_hunting: { default: false },
        basic: { default: false },
        ranger_track: { default: false },
        return_to_group: { default: false },
        selling_script: { default: 'eloot' },
        healing_script: { default: 'eherbs' },
        death_script: { default: '' },
        hording_script: { default: '' },
        escort_script: { default: 'escortgo2' },
        rescue_script: { default: 'echild' },
        gem_history: { default: '' },

        # Resting Tab
        table_rest: { default: false },
        bigshot_rest: { default: false },
        custom_rest: { default: false },
        resting_room: { default: '' },
        rest_random: { default: false },
        use_script: { default: false },
        use_script_name: { default: '' },
        join_player: { default: false },
        join_list: { default: '' },
        use_buff_script: { default: false },
        buff_script: { default: '' },

        # Foraging
        forage_prep_commands: { default: '' },
        forage_prep_scripts: { default: '' },
        forage_post_commands: { default: '' },
        forage_post_scripts: { default: '' },

        # Heirloom
        heirloom_prep_commands: { default: '' },
        heirloom_prep_scripts: { default: '' },
        heirloom_post_commands: { default: '' },
        heirloom_post_scripts: { default: '' },

        # Bandits - Location Labels
        wander_wait: { default:  0.5 },
        location1: { default: '' },
        location2: { default: '' },
        location3: { default: '' },
        location4: { default: '' },
        location5: { default: '' },
        location6: { default: '' },
        location7: { default: '' },
        location8: { default: '' },
        location9: { default: '' },
        location10: { default: '' },
        location11: { default: '' },
        location12: { default: '' },

        # Bandits - Bad Rooms
        bad_room1: { default: '' },
        bad_room2: { default: '' },
        bad_room3: { default: '' },
        bad_room4: { default: '' },
        bad_room5: { default: '' },
        bad_room6: { default: '' },
        bad_room7: { default: '' },
        bad_room8: { default: '' },
        bad_room9: { default: '' },
        bad_room10: { default: '' },
        bad_room11: { default: '' },
        bad_room12: { default: '' },

        # Escort
        escort_prep_commands: { default: '' },
        escort_prep_scripts: { default: '' },
        escort_post_commands: { default: '' },
        escort_post_scripts: { default: '' },

        # Profiles
        default_name: { default: '' },
        default_profile: { default: '' },
        profile_name_bandits: { default: '' },
        bandits_profile: { default: '' },
        kill_bandits: { default: false },
        names_a: { default: '' },
        profile_a: { default: '' },
        profile_name_a: { default: '' },
        kill_a: { default: false },
        names_b: { default: '' },
        profile_b: { default: '' },
        profile_name_b: { default: '' },
        kill_b: { default: false },
        names_c: { default: '' },
        profile_c: { default: '' },
        profile_name_c: { default: '' },
        kill_c: { default: false },
        names_d: { default: '' },
        profile_d: { default: '' },
        profile_name_d: { default: '' },
        kill_d: { default: false },
        names_e: { default: '' },
        profile_e: { default: '' },
        profile_name_e: { default: '' },
        kill_e: { default: false },
        names_f: { default: '' },
        profile_f: { default: '' },
        profile_name_f: { default: '' },
        kill_f: { default: false },
        names_g: { default: '' },
        profile_g: { default: '' },
        profile_name_g: { default: '' },
        kill_g: { default: false },
        names_h: { default: '' },
        profile_h: { default: '' },
        profile_name_h: { default: '' },
        kill_h: { default: false },
        names_i: { default: '' },
        profile_i: { default: '' },
        profile_name_i: { default: '' },
        kill_i: { default: false },
        names_j: { default: '' },
        profile_j: { default: '' },
        profile_name_j: { default: '' },
        kill_j: { default: false },
      },
      internal: {
        silence: { default: true },
        debug: { default: false },
      }
    }

    if XMLData.game == "GSF"
      @@categories[:general][:icemule_resting]  = { default: '2429, 2468, 3449, 3428, 2300, 3365' }
      @@categories[:general][:teras_resting]    = { default: '1844, 1932' }
      @@categories[:general][:kf_resting]       = { default: '28813, 21495, 21592' }
      @@categories[:general][:fwi_resting]      = { default: '3668' }
      @@categories[:general][:rr_resting]       = { default: '10861, 10855, 20964' }
      @@categories[:general][:solhaven_resting] = { default: '14234, 1481, 5732, 1438, 1572' }
      @@categories[:general][:illy_resting]     = { default: '156, 638, 728, 188, 13362, 601, 24555' }
      @@categories[:general][:vaalor_resting]   = { default: '3486, 10374, 3519, 3542' }
      @@categories[:general][:landing_resting]  = { default: '1263, 318, 477, 8859, 288, 228, 1259' }
      @@categories[:general][:zul_resting]      = { default: '1005, 5751' }
      @@categories[:general][:hw_resting]       = { default: '21951,21940' }
      @@categories[:general][:contempt_resting] = { default: '' }
    else
      @@categories[:general][:icemule_resting]  = { default: '21689, 2468, 3449, 3428, 2300, 3365' }
      @@categories[:general][:teras_resting]    = { default: '1844, 1932' }
      @@categories[:general][:kf_resting]       = { default: '28813, 28950, 28916' }
      @@categories[:general][:fwi_resting]      = { default: '3668, 28742, 18258, 17587' }
      @@categories[:general][:rr_resting]       = { default: '10861, 10855, 28717' }
      @@categories[:general][:solhaven_resting] = { default: '14234, 1481, 5732, 1438, 1572' }
      @@categories[:general][:illy_resting]     = { default: '156, 638, 728, 188, 13362, 601, 24555' }
      @@categories[:general][:vaalor_resting]   = { default: '3486, 10374, 3519, 3542' }
      @@categories[:general][:landing_resting]  = { default: '1263, 318, 477, 8859, 288, 228, 1259' }
      @@categories[:general][:zul_resting]      = { default: '1005, 5751' }
      @@categories[:general][:hw_resting]       = { default: '29870, 29881' }
      @@categories[:general][:contempt_resting] = { default: '35603' }
    end

    # True when Lich can open a WebUI window for this script.
    def self.available?
      defined?(Lich::WebUI) && Lich::WebUI.respond_to?(:presentation_enabled?) && Lich::WebUI.presentation_enabled? &&
        defined?(Lich::WebUI::ListSettingsForm)
    end

    def self.get_category(key)
      @@categories.each { |category, data| return category unless data[key].nil? }
      nil
    end

    def self.get_setting(key)
      cat = Setup.get_category(key)
      return nil if cat.nil?

      @@categories[cat].each { |setting, data| return data if setting == key }
      nil
    end

    # ListSettingsForm keys rows by position and seeds each viewer's table
    # selection only once, so after Add or Delete the window would keep
    # highlighting a row the form no longer has selected (and Delete would do
    # nothing). Clearing that viewer's selection keeps the two in step.
    @form_class = nil

    def self.form_class
      @form_class ||= Class.new(Lich::WebUI::ListSettingsForm) do
        private

        def render_field(tree, field, refs, **overrides)
          ref = super
          (@tables ||= {})[field[:key]] = ref if field && @lists.key?(field[:key])
          ref
        end

        def change_list(key, action, event)
          super
          table = @tables&.[](key)
          @page.set(table.cid, :selected, [], viewer: event.viewer_id) if table
        end
      end
    end

    def initialize(settings)
      @owner = Script.current
      @script_ver = EBounty.get_script_version
      @settings = settings

      # set default values if they don't exist
      @@categories.each do |_, data|
        data.each { |key, value| @settings[key] = value[:default].dup if @settings[key].to_s.empty? }
      end

      # remove settings that doesn't exist
      @settings.delete_if { |key, _| next Setup.get_category(key).nil? }
    end

    # ---------------------------------------------------------- lifecycle --

    # Opens the window and waits. Save & Close returns the edited settings, which
    # are saved to the profile; Cancel or closing the window discards them.
    def start
      result = form.show.wait
      if result
        apply(result)
        EBounty.msg("info", " Setup saved.")
      else
        EBounty.msg("info", " Setup closed without saving.")
      end
    end

    # The window, ready to show. Lists are edited on copies so Cancel discards them too.
    def form
      setup = self
      @live = form_values
      @drafts = LISTS.to_h { |key| [key, Array(@settings[key]).dup] }
      @refs = {}
      @form = Setup.form_class.new(owner: @owner, id: PAGE_ID, title: title, values: @live, fields: fields,
                                   lists: LISTS.to_h { |key| [key, list_spec(key)] },
                                   normalize: ->(draft) { setup.normalize(draft) },
                                   layout: ->(ui, field, save) { setup.layout(ui, field, save) },
                                   props: { size: [900, 820] })
    end

    attr_reader :drafts, :live

    def apply(result)
      @settings.merge!(result)
      EBounty.save_profile(@settings)
    end

    def title
      "EBounty Setup v#{@script_ver}"
    end

    # ------------------------------------------------------ fields and values --

    def shown_keys
      @@categories[:general].keys - HIDDEN
    end

    def boolean?(key)
      [true, false].include?(Setup.get_setting(key)[:default])
    end

    def member_key(key, value)
      :"#{key}-#{value}"
    end

    def fields
      list = shown_keys.reject { |key| LISTS.include?(key) || MEMBERS.key?(key) }.map do |key|
        if SPINS.key?(key)
          max, step, digits = SPINS[key]
          { key: key, type: :number_input, min: 0, max: max, step: step, digits: digits, stepper_buttons: true, align: :start }
        elsif key == :boost_type
          { key: key, type: :select, options: BOOST_TYPES.map { |type| { value: type, label: type } } }
        elsif PROFILES.key?(key)
          { key: key, type: :select, editable: true, options: profile_options }
        elsif boolean?(key)
          { key: key, type: :checkbox, exclusive: EXCLUSIVE[key] }.compact
        else
          { key: key, type: :text_input }
        end
      end
      MEMBERS.each { |key, items| items.each { |value, _| list << { key: member_key(key, value), type: :checkbox } } }
      list
    end

    def form_values
      shown_keys.each_with_object({}) do |key, values|
        if MEMBERS.key?(key)
          MEMBERS[key].each { |value, _| values[member_key(key, value)] = Array(@settings[key]).include?(value) }
        elsif LISTS.include?(key)
          values[key] = Array(@settings[key]).dup
        elsif SPINS.key?(key)
          values[key] = spin_value(key)
        elsif key == :boost_type
          values[key] = boost_value
        elsif boolean?(key)
          values[key] = @settings[key] ? true : false
        else
          values[key] = @settings[key].to_s
        end
      end
    end

    # Display value for a spinner: inside min..max and on a step, as the contract requires.
    def spin_value(key)
      max, step, digits = SPINS.fetch(key)
      number = digits.zero? ? @settings[key].to_i : @settings[key].to_f
      ((number.clamp(0, max) / step).round * step).round(digits)
    end

    # A blank or unknown boost choice shows Any.
    def boost_value
      BOOST_TYPES.include?(@settings[:boost_type]) ? @settings[:boost_type] : 'Any'
    end

    # Turns the submitted window values back into settings. A number or choice the
    # player left as displayed keeps its saved value, even one the window had to adjust.
    def normalize(draft)
      result = shown_keys.to_h do |key|
        value =
          if MEMBERS.key?(key)
            known = MEMBERS[key].map(&:first)
            (Array(@settings[key]) - known + known.select { |item| draft[member_key(key, item)] }).uniq.sort
          elsif LISTS.include?(key)
            Array(draft[key]).dup
          elsif SPINS.key?(key)
            number_setting(key, draft[key])
          elsif key == :boost_type
            draft[key] == boost_value ? @settings[key] : draft[key].to_s
          elsif boolean?(key)
            draft[key] ? true : false
          else
            draft[key].to_s.strip
          end
        [key, value]
      end
      result[:new_bounty_on_exit] = false unless result[:once_and_done]
      # The dropdown and its name setting have always held the same name.
      PROFILES.each { |profile, name| result[name] = result[profile] unless result[profile] == @settings[profile].to_s.strip }
      result
    end

    def number_setting(key, value)
      raise ArgumentError, "#{key} must be a number." unless value.is_a?(Numeric)
      return @settings[key] if value == spin_value(key)

      max, _step, digits = SPINS.fetch(key)
      (digits.zero? ? value.round : value.to_f.round(digits)).clamp(0, max)
    end

    def profile_options
      @profile_options ||= begin
        dir = "#{$data_dir}#{XMLData.game}/#{Char.name}/bigshot_profiles"
        names = Dir.exist?(dir) ? Dir.children(dir).select { |name| name =~ /.yaml/ }.map { |name| name.sub('.yaml', '') }.sort : []
        [{ value: '', label: '' }] + names.map { |name| { value: name, label: name } }
      end
    end

    # Whether an option group's checkbox can be used by this character.
    def option_known?(key, value, spell)
      return Stats.prof =~ /rogue/i ? true : false if key == :forage_options && value == 'use_gambit'
      return Spell[604].known? && Skills.slblessings > 15 if key == :forage_options && value == 'use_604evoke'

      spell.nil? || Spell[spell].known?
    end

    # ------------------------------------------------------------------ lists --

    def list_spec(key)
      setup = self
      { columns: [{ key: 'entry', label: 'Entry', expand: true }],
        rows: proc { setup.drafts[key].map { |entry| { 'entry' => entry.to_s } } }, value: proc { setup.drafts[key].dup },
        add: ->(text) { setup.add_entry(key, text) }, delete: ->(index) { setup.delete_entry(key, index) },
        clear_after_add: true }
    end

    def add_entry(key, text)
      text = text.to_s.strip
      return if text.empty?

      list = @drafts[key]
      list.push(text) unless list.map(&:to_s).include?(text)
      sort_list(list)
    end

    def delete_entry(key, index)
      @drafts[key].delete_at(index)
      sort_list(@drafts[key])
    end

    def sort_list(list)
      list.uniq!
      list.sort_by!(&:to_s)
    end

    # ---------------------------------------------------------- live gating --

    # Run one bounty and quit enables Get new bounty before quitting; turning it
    # off clears that box too. Nothing else in this window depends on another control.
    def once_and_done_changed(value, viewer)
      @live[:once_and_done] = value
      if value
        Lich::WebUI.refresh(@form.page)
      else
        @form.page.set(@refs.fetch(:new_bounty_on_exit).cid, :checked, false, viewer: viewer) # re-renders
      end
    end

    # ------------------------------------------------------------- render --

    def control(ui, key, **props)
      @refs[key] = @field.call(ui, key, **props)
    end

    def layout(ui, field, save)
      setup = self
      @field = field
      ui.presentation(always_on_top: true)
      ui.stack(key: 'main', gap: 8, margin: 8) do
        ui.tabs(key: 'tabs', names: TABS, selected: 0, on: { select: ->(_ev) {} }) do
          ui.stack(slot: 'General', key: 'tab-general', gap: 8) { setup.render_general(ui) }
          ui.stack(slot: 'Resting', key: 'tab-resting', gap: 8) { setup.render_resting(ui) }
          ui.stack(slot: 'Foraging', key: 'tab-foraging', gap: 8) { setup.render_foraging(ui) }
          ui.stack(slot: 'Heirloom', key: 'tab-heirloom', gap: 8) { setup.render_heirloom(ui) }
          ui.stack(slot: 'Bandits', key: 'tab-bandits', gap: 8) { setup.render_bandits(ui) }
          ui.stack(slot: 'Escort', key: 'tab-escort', gap: 8) { setup.render_escort(ui) }
          ui.stack(slot: 'Exclusions', key: 'tab-exclusions', gap: 8) { setup.render_exclusions(ui) }
          ui.stack(slot: 'Profiles', key: 'tab-profiles', gap: 8) { setup.render_profiles(ui) }
        end
      end
      render_footer(ui, save)
    end

    def render_general(ui)
      setup = self
      ui.group(key: 'general-types', label: 'Bounty Types') do
        setup.render_members(ui, :bounty_types, BOUNTY_TYPES, columns: 5)
      end
      ui.group(key: 'general-misc', label: 'Misc') do
        ui.columns(key: 'general-misc-cols', count: 3, gap: 8, row_align: :start) do
